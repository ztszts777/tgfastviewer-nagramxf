class PluginFeature:
    def __init__(self, owner, flags):
        self.flags = flags
        self.log = owner.log
        self.hook_method = owner.hook_method
        self.hook_all_constructors = owner.hook_all_constructors
        self.unhook_method = owner.unhook_method


TIMER_MENU_ID = 65347
VIDEO_TIMER_CONTROL_TAG = "nagramxf_media_suite.video_timer"
ALBUM_THUMB_WIDTH = 48
ALBUM_THUMB_HEIGHT = 64
ALBUM_THUMB_PADDING = 8
WHITE = -1
PLAY_STATES = (1, 2, 3, 4)
SCRUBBER_HEIGHT = 28
NATIVE_THIN_BAR_BOTTOM_GAP = 3
VIDEO_TOOL_SIZE = 44
VIDEO_ICON_SIZE = 24
VIDEO_CONTROLS_HEIGHT = SCRUBBER_HEIGHT + VIDEO_TOOL_SIZE
COMPACT_HEADER_HEIGHT = 44
COMPACT_BOTTOM_GAP = 8
FORWARD_MENU_ID = 4
EXTERNAL_SHARE_MENU_ID = 9
NATIVE_FORWARD_MENU_ID = 201
SHADOW_GRAY = 0x131418
TOP_SHADOW_ALPHA = 212
BOTTOM_SHADOW_ALPHA = 208
CAPTION_SHADE_ALPHA = 230
CAPTION_SHADE_COLOR = ((CAPTION_SHADE_ALPHA << 24) | SHADOW_GRAY) - (1 << 32)
SENSOR_LANDSCAPE = 6
SENSOR_PORTRAIT = 7
HOLD_SPEED_PRESETS = (1.5, 2.0, 2.5, 3.0, 4.0)
DEFAULT_HOLD_SPEED_INDEX = HOLD_SPEED_PRESETS.index(2.5)
DEFAULT_HOLD_SPEED = HOLD_SPEED_PRESETS[DEFAULT_HOLD_SPEED_INDEX]
DEFAULT_DOUBLE_TAP_SECONDS = 15


def field(owner, name):
    result = owner.getDeclaredField(name)
    result.setAccessible(True)
    return result


def method(owner, name, arity):
    result, = (m for m in owner.getDeclaredMethods()
               if m.getName() == name and len(m.getParameterTypes()) == arity)
    result.setAccessible(True)
    return result


def needed_lift(bottom, side, native_clearance, padding, fallback):
    if not bottom:
        if side:
            return 0
        bottom = fallback
    return max(padding, bottom + padding - native_clearance)


def row_spacing(row_height, scrubber_lift, tap_inset, gap=0):
    below_row = max(tap_inset + gap, scrubber_lift - row_height)
    return row_height + below_row, below_row


def double_tap_action(x, width):
    if width <= 0 or width <= 3 * x < 2 * width:
        return "play"
    return "back" if 3 * x < width else "forward"


def selected_hold_speed(preset, custom):
    try:
        index = int(preset)
        if 0 <= index < len(HOLD_SPEED_PRESETS):
            return HOLD_SPEED_PRESETS[index]
        if index == len(HOLD_SPEED_PRESETS):
            speed = float(str(custom).strip().replace(",", "."))
            if 1.0 <= speed <= 3.402823466e38:
                return speed
    except (ValueError, TypeError, OverflowError):
        pass
    return DEFAULT_HOLD_SPEED


def selected_double_tap_seconds(value):
    try:
        seconds = int(value)
        if 1 <= seconds <= 2147483:
            return seconds
    except (ValueError, TypeError, OverflowError):
        pass
    return DEFAULT_DOUBLE_TAP_SECONDS


def popup_offsets(left, top, right, anchor_x, anchor_y, anchor_width, anchor_height,
                  content_width, content_height, gap, edge):
    max_left = max(left + edge, right - edge - content_width)
    desired_left = anchor_x + (anchor_width - content_width) // 2
    popup_left = min(max_left, max(left + edge, desired_left))
    popup_height = min(content_height, max(1, anchor_y - gap - top - edge))
    y_offset = -anchor_height - gap - popup_height
    return popup_left - anchor_x, y_offset, popup_height


def fullscreen_swipe(dx, dy, fullscreen, threshold):
    return vertical_swipe(dx, dy, threshold) and (dy > 0) != fullscreen


def vertical_swipe(dx, dy, threshold):
    return abs(dy) >= threshold and abs(dx) * 1.6 <= abs(dy)


def swipe_level(initial, dy, height, minimum):
    return max(minimum, min(1.0, initial - dy / max(1, height * 0.55)))


def video_orientation(width, height):
    return SENSOR_PORTRAIT if width > 0 and height > width else SENSOR_LANDSCAPE


def auto_video_orientation(width, height):
    if width <= 0 or height <= 0:
        return None
    if width > height:
        return SENSOR_LANDSCAPE
    return SENSOR_PORTRAIT if height > width else None


def device_orientation_axis(degrees):
    if not 0 <= degrees < 360 or abs(degrees % 90 - 45) < 15:
        return None
    return SENSOR_LANDSCAPE if ((degrees + 45) // 90) % 2 else SENSOR_PORTRAIT


def gravity_axis(x, y, z):
    if 4 * (x * x + y * y) < z * z:
        return None
    if x * x > 3 * y * y:
        return SENSOR_LANDSCAPE
    if y * y > 3 * x * x:
        return SENSOR_PORTRAIT
    return None


class ControlMargin:
    def __init__(self, reference, margin):
        self.reference = reference
        self.base = margin
        self.lift = 0

    def update(self, params, lift, fresh_base=False):
        if fresh_base or params.bottomMargin != self.base + self.lift:
            self.base = params.bottomMargin
        target = self.base + lift
        if params.bottomMargin != target:
            params.bottomMargin = target
        self.lift = lift


def shadow_ramp(start, end, opacity):
    colors = []
    for step in range(9):
        edge_fraction = start + (end - start) * step / 8
        smooth = edge_fraction ** 2 * (3 - 2 * edge_fraction)
        alpha = round(opacity * (1 - (1 - smooth) ** 2))
        color = (alpha << 24) | SHADOW_GRAY
        colors.append(color - ((color >> 31) << 32))
    return tuple(colors)


def footer_gradient_colors(content_height, navigation_height):
    split = content_height / (content_height + navigation_height)
    return (shadow_ramp(0.0, split, BOTTOM_SHADOW_ALPHA),
            shadow_ramp(split, 1.0, BOTTOM_SHADOW_ALPHA))


def caption_viewport(layout, total, available, padding_top, fade_padding, expanded):
    has_more = layout is not None and layout.getLineCount() > 4
    fade_length = 0
    preview = total
    if has_more and not expanded:
        line_bottom = layout.getLineBottom(3)
        line_height = line_bottom - layout.getLineTop(3)
        fade_length = max(1, round(line_height * 0.8)) + fade_padding
        preview = padding_top + line_bottom + fade_padding
    height = min(preview, max(0, available))
    return height, has_more, min(fade_length, height)


def smoothstep(value):
    value = max(0.0, min(1.0, value))
    return value * value * (3 - 2 * value)


def caption_shadow_profile(header, text_bottom, fade_end):
    fast_start = (header + (text_bottom - header) * 0.58) / fade_end
    return tuple(
        CAPTION_SHADE_ALPHA * (1 - 0.64 * smoothstep(fraction)
                              - 0.36 * smoothstep((fraction - fast_start) / (1 - fast_start)))
        for fraction in (index / 64 for index in range(65)))


def caption_shadow_color(alpha):
    color = (round(alpha) << 24) | SHADOW_GRAY
    return color - ((color >> 31) << 32)


class TopVideoCaption:
    def __init__(self, viewer_ref, scroll, title, subtitle, switcher, shade, button):
        self.viewer_ref = viewer_ref
        self.scroll, self.title, self.subtitle = scroll, title, subtitle
        self.switcher, self.shade, self.button = switcher, shade, button
        params = scroll.getLayoutParams() if scroll is not None else None
        self.original_frame = ((params.gravity, params.leftMargin, params.topMargin, params.rightMargin)
                               if params is not None else None)
        self.title_visibility = title.getVisibility()
        self.subtitle_translation = subtitle.getTranslationY()
        self.caption_visibility = switcher.getVisibility() if scroll is not None else None
        self.original_fade = scroll.getVerticalFadingEdgeLength() if scroll is not None else 0
        self.preview_fade = 0
        self.caption_key = None
        self.expanded = False
        self.has_more = False
        self.touch = None
        self.shadow_geometry = None
        self.text_layouts = []


def centered_toolbar_gutters(left_safe, right_safe, left_consumed, right_consumed, minimum, gap):
    edge = max(minimum, max(left_safe, right_safe, left_consumed, right_consumed) + gap)
    return edge - left_consumed, edge - right_consumed


