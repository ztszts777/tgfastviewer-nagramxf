def thumbnail_dimensions(dp, width_dp, landscape, available_width):
    width = dp(width_dp)
    if available_width > 0:
        cap = available_width * (0.32 if landscape else 0.44)
        width = min(width, max(1, int(cap) - 2 * dp(THUMBNAIL_EDGE_PADDING)))
    return width, max(1, round(width * (0.75 if landscape else 1.2)))


def thumbnail_gaps(width):
    return tuple(max(1, round(width * space / THUMBNAIL_REFERENCE_WIDTH))
                 for space in (THUMBNAIL_SPACING, THUMBNAIL_MESSAGE_GAP, THUMBNAIL_CHAT_GAP))


def thumbnail_entries(messages, tile, message_gap, chat_gap, padding, scope=None):
    entries, peer, block, offset = [], None, None, padding
    for message in messages:
        if message is None or not (message.isPhoto() or message.isVideo()):
            continue
        key = message.currentAccount, message.getDialogId()
        if scope is not None and (key[0] != scope[0] or key[1] not in scope[1]):
            continue
        group = message.getGroupId()
        current_block = (True, group) if group else (False, message.getId())
        if peer is not None:
            if peer != key:
                entries.append((offset, THUMBNAIL_CHAT_DIVIDER))
                offset += chat_gap
            elif block != current_block:
                entries.append((offset, THUMBNAIL_MESSAGE_DIVIDER))
                offset += message_gap
        entries.append((offset, message))
        offset += tile
        peer, block = key, current_block
    return entries, offset + padding


def album_caption_source(message, messages, is_empty, allowed=None):
    group = message.getGroupId()
    if not group or messages is None:
        return None
    account, dialog = message.currentAccount, message.getDialogId()
    source = None
    for index in range(messages.size()):
        item = messages.get(index)
        if (item is not None and item.currentAccount == account and item.getDialogId() == dialog
                and item.getGroupId() == group and not is_empty(item.caption)
                and (allowed is None or allowed(item))
                and (source is None or item.getId() < source.getId())):
            source = item
    return source


def thumbnail_divider(item):
    return item is THUMBNAIL_MESSAGE_DIVIDER or item is THUMBNAIL_CHAT_DIVIDER


def same_thumbnail_item(left, right):
    if left is right:
        return True
    if left is None or right is None or thumbnail_divider(left) or thumbnail_divider(right):
        return False
    # Chaquopy forwards equality to MessageObject.equals, which rejects Python sentinels.
    return left == right


def thumbnail_item_key(item):
    return item.currentAccount, item.getDialogId(), item.getId()


def thumbnail_range(offsets, position, viewport, padding):
    start = max(0, bisect_right(offsets, position - padding) - 1)
    return range(start, bisect_left(offsets, position + viewport + padding))


def needed_lift(bottom, side, native_clearance, padding, fallback):
    if not bottom:
        if side:
            return 0
        bottom = fallback
    return max(padding, bottom + padding - native_clearance)


def row_spacing(row_height, scrubber_lift, tap_inset, gap=0, text_bottom=0):
    gap = max(gap, (scrubber_lift - row_height - tap_inset + text_bottom + 1) // 2)
    return row_height + tap_inset + 2 * gap - text_bottom, tap_inset + gap


def symmetric_rail_bounds(height, top, bottom):
    inset = min(height // 2, max(0, top, height - bottom))
    return inset, height - 2 * inset


def double_tap_action(x, width):
    third = width // 3
    if third <= 0 or third <= x < 2 * third:
        return "play"
    return "back" if x < third else "forward"


def seek_edge_geometry(width, height, dp, left_side):
    depth = min(dp(112), width * 0.20, height * 0.32)
    # Keep the oval wide enough at the top and bottom to reach both edges.
    radius_x, radius_y = 2 * depth, height * 0.65
    x = -depth if left_side else width + depth
    y = height / 2
    label_x = depth / 2 if left_side else width - depth / 2
    return (x - radius_x, y - radius_y, x + radius_x, y + radius_y), label_x, y, depth


def selected_hold_speed(preset, custom):
    try:
        index = int(preset)
        if 0 <= index < len(HOLD_SPEED_PRESETS):
            return HOLD_SPEED_PRESETS[index]
        if index == len(HOLD_SPEED_PRESETS):
            speed = float(str(custom).strip().replace(",", "."))
            if 1.0 <= speed <= 3.402823466e38:
                return speed
    except (ValueError, TypeError, OverflowError):
        pass
    return DEFAULT_HOLD_SPEED


def popup_offsets(left, top, right, anchor_x, anchor_y, anchor_width, anchor_height,
                  content_width, content_height, gap, edge):
    max_left = max(left + edge, right - edge - content_width)
    desired_left = anchor_x + (anchor_width - content_width) // 2
    popup_left = min(max_left, max(left + edge, desired_left))
    popup_height = min(content_height, max(1, anchor_y - gap - top - edge))
    y_offset = -anchor_height - gap - popup_height
    return popup_left - anchor_x, y_offset, popup_height


def side_popup_offsets(left, top, right, bottom, anchor_x, anchor_y, anchor_height,
                       content_width, content_height, gap, edge, vertical_edge, lift):
    left, top, right, bottom = left + edge, top + vertical_edge, right - edge, bottom - vertical_edge
    anchor_bottom = anchor_y + anchor_height
    height_limit = bottom - top
    if right <= left or height_limit <= 0:
        return None
    width, height = min(content_width, right - left), min(content_height, height_limit)
    popup_left = max(left, min(right - width, anchor_x - gap - width))
    popup_top = max(top, min(bottom - height, anchor_y + (anchor_height - height) // 2) - lift)
    return popup_left - anchor_x, popup_top - anchor_bottom, width, height


def fullscreen_swipe(dx, dy, fullscreen, threshold):
    return vertical_swipe(dx, dy, threshold) and (dy > 0) != fullscreen


def vertical_swipe(dx, dy, threshold):
    return abs(dy) >= threshold and abs(dx) * 1.6 <= abs(dy)


def swipe_level(initial, dy, height, minimum):
    return max(minimum, min(1.0, initial - dy / max(1, height * 0.55)))


def adjustment_tick_value(value, default, minimum, maximum):
    try:
        number = int(str(value).strip())
    except (TypeError, ValueError):
        return default
    return number if minimum <= number <= maximum else default


def adjustment_tick_settings(change):
    from ui.settings import Input

    return [
        Input(key="adjustment_tick_percent", text=tr("滑动振动刻度（%）"), default="1",
              subtext=tr("每跨过多少个百分点振一下，范围 1–100"),
              on_change=lambda value: change("adjustment_tick_percent", value)),
        Input(key="adjustment_tick_rate", text=tr("滑动振动上限（次/秒）"), default="12",
              subtext=tr("范围 0–30，填 0 关闭亮度与音量手势振动"),
              on_change=lambda value: change("adjustment_tick_rate", value)),
        Input(key="adjustment_tick_strength", text=tr("振动强度（%）"), default="42",
              subtext=tr("范围 0–100，适用于亮度和音量手势"),
              on_change=lambda value: change("adjustment_tick_strength", value)),
    ]


def auto_video_orientation(width, height):
    if width <= 0 or height <= 0:
        return None
    if width > height:
        return SENSOR_LANDSCAPE
    return SENSOR_PORTRAIT if height > width else None


def media_grid_anchor(result, message_id):
    if result is None or result.messages.isEmpty():
        return None
    messages = result.messages
    if not any(messages.get(i).id == message_id for i in range(messages.size())):
        return None
    if result.flags & 4:
        start = result.offset_id_offset
    elif result.count <= messages.size():
        start = 0
    else:
        return None
    return messages.get(0).id + 1, start, max(result.count, start + messages.size())


def media_grid_index(messages, dialog, message_id):
    for index in range(messages.size()):
        message = messages.get(index)
        if message.getId() == message_id and message.getDialogId() == dialog:
            return index
    return -1


def media_grid_scroll_target(position, count, columns, viewport, tile, obscured_top=0, obscured_bottom=0):
    if not 0 <= position < count or viewport <= 0:
        return None
    row = position // columns
    last_row = (count - 1) // columns
    center = max(0, (viewport + obscured_top - obscured_bottom - tile) // 2)
    scroll = row * tile - center
    max_scroll = max(0, (last_row + 1) * tile - viewport)
    if not max_scroll or scroll <= 0:
        return 0, 0
    if scroll >= max_scroll:
        return last_row * columns, viewport - tile
    return position, center


def surface_rotation_from_angle(degrees):
    if not 0 <= degrees < 360 or abs(degrees % 90 - 45) < 15:
        return None
    # Display graphics compensate for the physical rotation, so the angles run in opposite directions.
    return (-((degrees + 45) // 90)) % 4


def surface_rotation_from_gravity(x, y, z):
    if 4 * (x * x + y * y) < z * z:
        return None
    if x * x > 3 * y * y:
        return 1 if x > 0 else 3
    if y * y > 3 * x * x:
        return 0 if y > 0 else 2
    return None


def device_orientation_request(rotation, natural_landscape, reverse_default):
    if rotation is None:
        return None
    if natural_landscape:
        if rotation % 2:
            return SENSOR_PORTRAIT
        return LANDSCAPE if rotation == 0 else REVERSE_LANDSCAPE
    if rotation % 2 == 0:
        return SENSOR_PORTRAIT
    return LANDSCAPE if (rotation == 1) != reverse_default else REVERSE_LANDSCAPE


class ControlMargin:
    def __init__(self, reference, margin):
        self.reference = reference
        self.base = margin
        self.lift = 0

    def update(self, params, lift, fresh_base=False):
        if fresh_base or params.bottomMargin != self.base + self.lift:
            self.base = params.bottomMargin
        target = self.base + lift
        if params.bottomMargin != target:
            params.bottomMargin = target
        self.lift = lift


def shadow_ramp(start, end, opacity):
    colors = []
    for step in range(9):
        edge_fraction = start + (end - start) * step / 8
        smooth = edge_fraction ** 2 * (3 - 2 * edge_fraction)
        alpha = round(opacity * (1 - (1 - smooth) ** 2))
        color = (alpha << 24) | SHADOW_GRAY
        colors.append(color - ((color >> 31) << 32))
    return tuple(colors)


def caption_last_text_line(layout, line):
    content = layout.getText()
    utf16 = content.encode("utf-16-le", "surrogatepass") if isinstance(content, str) else None
    while line >= 0:
        start, end = layout.getLineStart(line), layout.getLineVisibleEnd(line)
        if end > start:
            part = (utf16[2 * start:2 * end].decode("utf-16-le", "surrogatepass") if utf16 is not None
                    else str(content.subSequence(start, end)))
            if part.strip():
                return line
        line -= 1
    return line


def caption_viewport(layout, total, available, padding_top, padding_bottom, expanded, arrow_height=0):
    lines = layout.getLineCount() if layout is not None else 0
    last = caption_last_text_line(layout, lines - 1) if lines else -1
    if last < 0:
        return 0, False
    end = padding_top + layout.getLineBottom(last)
    has_more = last >= 4 or end > available
    available = max(0, available - (arrow_height if has_more and available > arrow_height else 0))
    full_height = total if last == lines - 1 else end + padding_bottom
    if expanded or not has_more:
        return min(full_height, available), has_more
    last_visible = min(3, last)
    while last_visible >= 0 and padding_top + layout.getLineBottom(last_visible) > available:
        last_visible -= 1
    last_visible = caption_last_text_line(layout, last_visible)
    return (padding_top + layout.getLineBottom(last_visible) if last_visible >= 0 else 0), has_more


def caption_complete_line_height(layout, padding_top, viewport, scroll_y):
    bottom = scroll_y + viewport
    index = layout.getLineForVertical(max(0, bottom - padding_top - 1))
    while index >= 0:
        line_bottom = padding_top + layout.getLineBottom(index)
        if line_bottom <= bottom:
            return max(0, line_bottom - scroll_y)
        index -= 1
    return 0


def smoothstep(value):
    value = max(0.0, min(1.0, value))
    return value * value * (3 - 2 * value)


def player_shadow_edge_alpha(distance):
    return smoothstep(1 - distance) ** 1.3


def player_shadow_texture(samples):
    ramp = []
    for i in range(samples):
        distance = ((i + 0.5) / samples) ** 2.4
        alpha = round(PLAYER_SHADOW_ALPHA * player_shadow_edge_alpha(distance))
        ramp.append(((alpha << 24) | SHADOW_GRAY) - ((alpha >> 7) << 32))
    return ramp + [0] * samples + ramp[::-1]


def player_shadow_mesh(width, height, top, bottom):
    total = top + bottom
    if total > height:
        top = height * (top / total)
        bottom = height - top
    columns = 0.0, float(width)
    rows = 0.0, top, height - bottom, float(height)
    return tuple(point for y in rows for x in columns for point in (x, y))


class TopMediaCaption:
    def __init__(self, viewer_ref, scroll, subtitle, switcher, shade, title_sizes, subtitle_size):
        self.viewer_ref = viewer_ref
        self.scroll, self.subtitle = scroll, subtitle
