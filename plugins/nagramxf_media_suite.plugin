        def install_existing():
            if self.active:
                for instance in self.viewer_instances:
                    current = instance.get(None)
                    if current is not None:
                        self.install_row(current)
                        self.hook_orientation_listener(current)
                        self.check_auto_fullscreen(current)

        run_on_ui_thread(install_existing)

    def option(self, key):
        return getattr(self, "flags", {}).get(key, key != "auto_fullscreen_on_switch")

    def navigation_area(self, view):
        insets = view.getRootWindowInsets()
        if insets is None:
            return 0, 0, 0
        if self.sdk >= 30:
            nav = insets.getInsetsIgnoringVisibility(self.nav_type)
            return (max(nav.bottom, insets.getInsets(self.gesture_types).bottom),
                    max(nav.left, nav.right), insets.getInsets(self.nav_type).bottom)
        bottom = insets.getStableInsetBottom()
        if self.sdk == 29:
            bottom = max(bottom, insets.getSystemGestureInsets().bottom,
                         insets.getMandatorySystemGestureInsets().bottom)
        return (bottom, max(insets.getStableInsetLeft(), insets.getStableInsetRight()),
                min(bottom, insets.getSystemWindowInsetBottom()))

    def footer_lift(self, viewer, window, container):
        bottom, side, visible_nav = self.navigation_area(window)
        if not bottom:
            activity = viewer.getParentActivity()
            if activity is not None:
                decor = activity.getWindow().peekDecorView()
                if decor is not None:
                    decor_bottom, decor_side, decor_nav = self.navigation_area(decor)
                    bottom, side = decor_bottom, max(side, decor_side)
                    visible_nav = max(visible_nav, decor_nav)
        native_clearance = max(0, window.getMeasuredHeight() - container.getMeasuredHeight())
        native_clearance += container.getPaddingBottom()
        return (needed_lift(bottom, side, native_clearance, self.padding, self.fallback),
                max(0, visible_nav - native_clearance))

    def scrubber_margins(self, viewer, control, compact=False, width=0):
        insets = control.getRootWindowInsets()
        if insets is None:
            activity = viewer.getParentActivity()
            decor = activity.getWindow().peekDecorView() if activity is not None else None
            insets = decor.getRootWindowInsets() if decor is not None else None
        left = right = 0
        if insets is not None:
            left, right = insets.getStableInsetLeft(), insets.getStableInsetRight()
            if self.sdk >= 30:
                gestures = insets.getInsets(self.gesture_types)
                left, right = max(left, gestures.left), max(right, gestures.right)
            elif self.sdk == 29:
                gestures = insets.getSystemGestureInsets()
                left, right = max(left, gestures.left), max(right, gestures.right)
        if compact:
            container = control.getParent()
            window = self.window.get(viewer)
            left_consumed = container.getPaddingLeft() if container is not None else 0
            right_consumed = container.getPaddingRight() if container is not None else 0
            right_consumed += self.thumbnail_right_reservation(viewer)
            if window is not None:
                left_consumed += window.getPaddingLeft()
                right_consumed += window.getPaddingRight()
            return landscape_toolbar_gutters(self.dp, width, left, right, left_consumed, right_consumed)
        return max(self.dp(14), left + self.padding), max(self.dp(14), right + self.padding)

    def lookup_row(self, background):
        self.rows = [(b, r) for b, r in self.rows if b.get() is not None and r.get() is not None]
        return next((r.get() for b, r in self.rows if b.get() == background), None)

    def install_row(self, viewer):
        if not self.active:
            return
        background = self.background.get(viewer)
        if background is None or self.lookup_row(background) is not None:
            return
        row = self.linear_layout(background.getContext())
        row.setVisibility(8)
        viewer_ref = self.weak_reference(viewer)
        tools = (
            ("定时停止", self.drawable.msg_timer, "timer"),
            ("视频设置", self.drawable.video_settings, "settings"),
            ("在媒体库中查看", self.drawable.msg_media, "media_library"),
        )
        for label, icon, action in tools:
            button = self.make_video_control(row.getContext(), label, icon, action, viewer_ref)
            row.addView(button, self.linear_params(0, -1, 1.0))
        background.addView(row, self.frame_params(-1, self.row_height, 81))
        self.rows.append((self.weak_reference(background), self.weak_reference(row)))
        self.install_footer_shade(background)
        self.install_video_control_buttons(viewer, viewer_ref, tools)

    def make_video_control(self, context, label, icon, action, viewer_ref, compact=False):
        if action == "timer":
            button = self.frame_layout(context)
            button.setTag(VIDEO_TIMER_CONTROL_TAG + (".compact" if compact else ""))
            button.setContentDescription(label)
            button.setBackground(self.theme.createSelectorDrawable(0x24FFFFFF, 1, self.ripple_radius))
            image = self.image_view(context)
            image.setImageResource(icon)
            image.setColorFilter(WHITE)
            image.setScaleType(self.fit_center)
            clock = self.dp(VIDEO_ICON_BOXES["timer"])
            button.addView(image, self.frame_params(clock, clock, 17))
        else:
            button = image = self.make_button(context, label, icon)
            size = VIDEO_ICON_BOXES.get(action, VIDEO_ICON_SIZE)
            height = VIDEO_TOOLS_ROW_HEIGHT if compact or action in ("settings", "media_library") else VIDEO_TOOL_SIZE
            hpad, vpad = self.dp((VIDEO_TOOL_SIZE - size) // 2), self.dp((height - size) // 2)
            image.setPadding(hpad, vpad, hpad, vpad)
            image.setScaleType(self.fit_center)
        button.setOnClickListener(OnClickListener(
            lambda view: self.on_button(viewer_ref, action, view)))
        return button

    def shrink_icon(self, view, padding):
        pad = self.dp(padding)
        view.setPadding(pad, pad, pad, pad)
        view.setScaleType(self.fit_center)

    def make_button(self, context, label, icon):
        if isinstance(icon, str):
            button = self.text_view(context)
            button.setText(icon)
            button.setTextColor(WHITE)
            button.setTextSize(16)
            button.setGravity(17)
        else:
            button = self.image_view(context)
            button.setImageResource(icon)
            button.setColorFilter(WHITE)
            button.setScaleType(self.center)
        button.setContentDescription(label)
        if self.sdk >= 26:
            button.setTooltipText(label)
        button.setBackground(self.theme.createSelectorDrawable(0x24FFFFFF, 1, self.ripple_radius))
        return button

    def timer_action(self, viewer):
        menu = self.video_menu.get(viewer)
        popup = menu.getPopupLayout() if menu is not None else None
        return popup.findViewWithTag(self.integer(TIMER_MENU_ID)) if popup is not None else None

    def refresh_row(self, viewer):
        row = self.lookup_row(self.background.get(viewer))
        if row is None:
            return
        playing = bool(self.call(viewer, "isVideoPlaying"))
        can_time = self.timer_action(viewer) is not None
        can_open_library = self.can_show_media_library(viewer)
        play = self.playback_control(viewer)
        if play is not None:
            play.setImageResource(
                self.drawable.baseline_pause_36_white if playing else self.drawable.baseline_play_arrow_36_white)
            play.setContentDescription("暂停" if playing else "播放")
        for tools in (row, self.compact_control(viewer)):
            if tools is not None:
                self.enabled(tools.getChildAt(0), can_time)
                self.enabled(tools.getChildAt(tools.getChildCount() - 1), can_open_library)
        self.refresh_zoom(viewer)
        self.refresh_fullscreen_button(viewer)

    def after_media_bitmap(self, param):
        if not param.getResult():
            return
        receiver = param.thisObject
        container = receiver.getParentView()
        if container is not None and self.drawer_type.isInstance(container):
            viewer = self.outer.get(container)
            if receiver == self.center_image.get(viewer) and self.photo_surface(viewer):
                self.check_auto_fullscreen(viewer)

    def install_video_control_buttons(self, viewer, viewer_ref, compact_items):
        controls = self.controls.get(viewer)
        compact = self.frame_layout(controls.getContext())
        compact.setVisibility(8)
        for label, icon, action in compact_items:
            item = self.make_video_control(controls.getContext(), label, icon, action, viewer_ref, compact=True)
            compact.addView(item, self.frame_params(self.dp(VIDEO_TOOL_SIZE), -1, 83))
        controls.addView(compact, self.frame_params(-1, self.dp(VIDEO_TOOLS_ROW_HEIGHT), 80))
        self.compact_controls = [(v, b) for v, b in self.compact_controls if b.get() is not None]
        self.compact_controls.append((viewer_ref, self.weak_reference(compact)))
        button = self.make_video_control(controls.getContext(), "全屏", self.drawable.msg_maxvideo,
                                         "fullscreen", viewer_ref)
        button.setVisibility(8)
        controls.addView(button, self.frame_params(self.dp(VIDEO_TOOL_SIZE), self.dp(VIDEO_TOOL_SIZE), 85))
        play = self.make_video_control(controls.getContext(), "播放", self.drawable.baseline_play_arrow_36_white,
                                       "play", viewer_ref)
        play.setVisibility(8)
        controls.addView(play, self.frame_params(self.dp(VIDEO_TOOL_SIZE), self.dp(VIDEO_TOOL_SIZE), 83))
        self.fullscreen_controls.append((viewer_ref, self.weak_reference(button), self.weak_reference(play)))
        seekbar = self.video_seek.get(viewer)
        if seekbar is not None:
            self.seekbars = [(s, v) for s, v in self.seekbars if s.get() is not None]
            self.seekbars.append((self.weak_reference(seekbar), viewer_ref))

    def fullscreen_control(self, viewer):
        return next((b.get() for v, b, _ in self.fullscreen_controls if v.get() == viewer), None)

    def playback_control(self, viewer):
        return next((p.get() for v, _, p in self.fullscreen_controls if v.get() == viewer), None)

    def compact_control(self, viewer):
        return next((b.get() for v, b in self.compact_controls if v.get() == viewer), None)

    def refresh_fullscreen_button(self, viewer, progress=None):
        button = self.fullscreen_control(viewer)
        if button is None:
            return
        matches = self.fullscreen_target(viewer) is None
        button.setImageResource(self.drawable.msg_minvideo if matches else self.drawable.msg_maxvideo)
        button.setContentDescription("在聊天中查看" if matches else "按视频方向全屏")
        button.setEnabled(not matches or self.can_show_in_chat(viewer))
        if progress is not None:
            button.setAlpha(progress)
            play = self.playback_control(viewer)
            if play is not None:
                play.setAlpha(progress)
            compact = self.compact_control(viewer)
            if compact is not None:
                compact.setAlpha(progress)

    def reserve_fullscreen_slot(self, param):
        control = param.thisObject
        viewer = self.control_outer.get(control)
        button = self.fullscreen_control(viewer)
        seek_view = self.video_seek_view.get(viewer)
        if button is not None and seek_view is not None and self.option("video_toolbar") and self.video_surface(viewer):
            self.control_width.setInt(control, max(self.control_width.getInt(control),
                                                   self.control_height.getInt(control) + 1))
            button.setVisibility(0)
            play = self.playback_control(viewer)
            play.setVisibility(0)
            compact = self.compact_control(viewer)
            use_compact = compact is not None and compact.getVisibility() == 0
            width = self.measure_spec.getSize(int(param.args[0]))
            left, right = self.scrubber_margins(viewer, control, use_compact, width)
            seek_params = seek_view.getLayoutParams()
            seek_params.height = self.dp(SCRUBBER_HEIGHT)
            seek_params.leftMargin, seek_params.rightMargin = left, right
            button_params, play_params = button.getLayoutParams(), play.getLayoutParams()
            button_params.height = self.dp(VIDEO_TOOLS_ROW_HEIGHT if use_compact else VIDEO_TOOL_SIZE)
            if use_compact:
                size, right_gutter = self.layout_compact_controls(viewer, compact, width, left, right)
                button_params.width, button_params.rightMargin = size, right_gutter
                gap = self.dp(COMPACT_BOTTOM_GAP)
                button_params.bottomMargin = gap
                compact.getLayoutParams().bottomMargin = gap
                play_params.width = size
                play_params.leftMargin = max(0, left - self.dp(4))
                play_params.bottomMargin = gap + (button_params.height - play_params.height) // 2
            else:
                left, right = max(0, left - self.dp(4)), max(0, right - self.dp(4))
                button_params.width = play_params.width = self.dp(VIDEO_TOOL_SIZE)
                button_params.rightMargin, button_params.bottomMargin = right, 0
                play_params.leftMargin, play_params.bottomMargin = left, 0
                time_start = left + play_params.width + self.dp(4)
                time_width = max(1, width - right - button_params.width - time_start - self.dp(8))
                self.move_time_under_scrubber(viewer, time_start, time_width)
        elif button is not None:
            button.setVisibility(8)
            self.playback_control(viewer).setVisibility(8)
            self.restore_scrubber_view(seek_view)
            self.restore_time(self.video_time.get(viewer))

    def restore_scrubber_view(self, view):
        if view is not None:
            params = view.getLayoutParams()
            params.height, params.leftMargin, params.rightMargin = -1, 0, 0

    def layout_compact_controls(self, viewer, compact, width, left, right):
        time = self.video_time.get(viewer)
        time_width = 0
        if time is not None:
            time.setTextSize(12)
            time_width = int(time.getPaint().measureText(str(time.getText() or "00:00 / 00:00"))) + self.dp(4)
        slots = compact.getChildCount() + 2  # Include the play and fullscreen buttons.
        left, right = max(0, left - self.dp(4)), max(0, right - self.dp(4))
        available = max(0, width - left - right - self.dp(14))
        time_width = min(time_width, available // 3)
        size = max(1, min(self.dp(VIDEO_TOOL_SIZE), (available - time_width) // slots))
        start = left + size + self.dp(2)
        self.move_time_under_scrubber(viewer, start, time_width, compact=True)
        for index in range(compact.getChildCount()):
            x = right + (compact.getChildCount() - index) * size
            params = compact.getChildAt(index).getLayoutParams()
            params.gravity, params.rightMargin, params.width = 85, x, size
        return size, right

    def move_time_under_scrubber(self, viewer, left, width, compact=False):
        time = self.video_time.get(viewer)
        if time is None:
            return
        params = time.getLayoutParams()
        self.time_layouts = [entry for entry in self.time_layouts if entry[0].get() is not None]
        if not any(ref.get() == time for ref, *_ in self.time_layouts):
            self.time_layouts.append((self.weak_reference(time), params.gravity,
                                      params.leftMargin, params.topMargin, params.rightMargin,
                                      params.bottomMargin, params.width))
            time.setGravity(51)  # SimpleTextView aligns its text separately from the frame.
        params.gravity = 83  # LEFT | BOTTOM
        if not compact:
            time.setTextSize(14)
        params.leftMargin, params.width = left, width
        params.topMargin = 0
        params.rightMargin = 0
        compact_offset = COMPACT_BOTTOM_GAP + (VIDEO_TOOLS_ROW_HEIGHT - VIDEO_TOOL_SIZE) // 2
        params.bottomMargin = self.dp(14 + (compact_offset if compact else 0))

    def restore_time(self, time):
        for index, (ref, gravity, left, top, right, bottom, width) in enumerate(self.time_layouts):
            if ref.get() == time:
                self.time_layouts.pop(index)
                params = time.getLayoutParams()
                params.gravity, params.leftMargin, params.topMargin = gravity, left, top
                params.rightMargin, params.bottomMargin, params.width = right, bottom, width
                time.setGravity(53)  # NagramXF aligns the original time to TOP | RIGHT.
                time.setTextSize(14)
                time.requestLayout()
                return

    def active_seek_view(self, seekbar):
        for seekbar_ref, viewer_ref in self.seekbars:
            if seekbar_ref.get() != seekbar:
                continue
            viewer = viewer_ref.get()
            if viewer is not None:
                button = self.fullscreen_control(viewer)
                if button is not None and button.getVisibility() == 0:
                    return self.video_seek_view.get(viewer)
            break
        return None

    def size_scrubber(self, param):
        view = self.active_seek_view(param.thisObject)
        if view is not None and view.getMeasuredWidth() > 0:
            param.args[0] = self.integer(max(self.dp(25), view.getMeasuredWidth() - self.dp(4)))
            param.args[1] = self.integer(self.dp(SCRUBBER_HEIGHT))

    def offset_scrubber_touch(self, param):
        view = self.active_seek_view(param.thisObject)
        if view is not None:
            local_x = float(param.args[1]) - view.getLayoutParams().leftMargin
            width = view.getMeasuredWidth() - self.dp(4)
            thumb_radius = self.dp(12)
            if int(param.args[0]) == 0 and -self.dp(2) <= local_x <= width + self.dp(2) and width > 2 * thumb_radius:
                local_x = min(width - thumb_radius, max(thumb_radius, local_x))
            param.args[1] = self.float_value(local_x)

    def offset_preview_thumb(self, param):
        view = self.active_seek_view(param.thisObject)
        if view is not None:
            param.setResult(self.integer(int(param.getResult()) + view.getLayoutParams().leftMargin))

    def finish_fullscreen_slot(self, param):
        viewer = self.control_outer.get(param.thisObject)
        button = self.fullscreen_control(viewer)
        if button is not None and button.getVisibility() == 0:
            native = self.exit_fullscreen.get(viewer)
            if native is not None:
                native.setVisibility(4)
            time = self.video_time.get(viewer)
            if time is not None:
                time.getLayoutParams().rightMargin = 0
            self.refresh_fullscreen_button(viewer, float(param.thisObject.getProgress()))

    def hide_floating_fullscreen(self, viewer):
        if self.option("video_toolbar") and self.video_surface(viewer):
            for button in self.fullscreen.get(viewer):
                if button is not None:
                    button.setVisibility(4)

    def enabled(self, button, enabled):
        button.setEnabled(enabled)
        button.setAlpha(1.0 if enabled else 0.4)

    def call(self, viewer, name, *args):
        return self.native[name].invoke(viewer, self.arguments(args))

    def open_menu(self, viewer, menu, button):
        if not self.active or menu is None or button is None or not button.isAttachedToWindow():
            return
        self.hide_header(menu)
        menu.setAnchor(button)
        menu.setShowOnTop(True)
        menu.setSubMenuOpenSide(2)
        menu.setAdditionalYOffset(-self.dp(7))
        popup = self.popup_window.get(menu)
        was_showing = popup is not None and popup.isShowing()
        if not was_showing:
            try:
                self.prepare_gear_sliders(viewer)
            except Exception as error:
                self.log(f"Video slider setup failed: {type(error).__name__}: {error}")
                self.restore_gear_sliders(viewer)
        try:
            menu.toggleSubMenu()
        except Exception as error:
            self.log(f"Video menu failed: {type(error).__name__}: {error}")
        popup = self.popup_window.get(menu)
        if was_showing or (popup is not None and popup.isShowing()):
            return
        self.restore_gear_sliders(viewer)
        self.native_popup_menu = menu
        try:
            menu.toggleSubMenu()
        except Exception as error:
            self.log(f"Native video menu failed: {type(error).__name__}: {error}")
        finally:
            self.native_popup_menu = None

    def style_popup_rows(self, viewer, video, photo):
        self.replace_popup_row(self.gallery_gap.get(viewer), video or photo, divider=True)
        self.replace_popup_row(self.speed_presets.get(viewer), video)
        if not video:
            self.restore_gear_sliders(viewer)

    def restore_gear_sliders(self, viewer):
        self.replace_popup_row(self.video_quality.get(viewer), False)
        self.replace_popup_row(self.speed_gap.get(viewer), False)
        self.replace_popup_row(self.speed_slider.get(viewer), False)

    def replace_popup_row(self, original, enabled, *, divider=False, replacement=None):
        if original is None:
            return
        self.popup_rows = [entry for entry in self.popup_rows if entry[0].get() is not None and entry[1].get() is not None]
        saved = next((entry for entry in self.popup_rows if entry[0].get() == original), None)
        if not enabled:
            if saved is not None:
                self.restore_popup_row(saved)
                self.popup_rows.remove(saved)
            return
        if saved is None:
            parent = original.getParent()
            if parent is None:
                return
            index, params = parent.indexOfChild(original), original.getLayoutParams()
            line = replacement
            if replacement is not None:
                parent.addView(replacement, index, self.linear_params(-1, -2))
            if divider:
                # An ordinary child scrolls and animates with the rows without splitting the popup background.
                line = self.view_type(parent.getContext())
                line.setBackgroundColor(MENU_DIVIDER_COLOR)
                line.setImportantForAccessibility(2)
                line_params = self.linear_params(-1, params.height if params.height > 0 else self.dp(8))
                parent.addView(line, index, line_params)
            parent.removeView(original)
            saved = (self.weak_reference(original), self.weak_reference(parent),
                     self.weak_reference(line) if line is not None else None, index, params)
            self.popup_rows.append(saved)
        parent = saved[1].get()
        line = saved[2].get() if saved[2] is not None else None
        if divider and line is not None and line.getParent() == parent:
            visibility = 0 if original.getVisibility() == 0 else 8
            if line.getVisibility() != visibility:
                line.setVisibility(visibility)

    def restore_popup_row(self, saved):
        original, parent, line_ref, index, params = saved
        original, parent = original.get(), parent.get()
        if parent is None or original is None or original.getParent() is not None:
            return
        line = line_ref.get() if line_ref is not None else None
        if line is not None and line.getParent() == parent:
            index = parent.indexOfChild(line)
            parent.removeView(line)
        parent.addView(original, min(index, parent.getChildCount()), params)

    def prepare_gear_sliders(self, viewer):
        speed = self.speed_slider.get(viewer)
        speed_gap = self.speed_gap.get(viewer)
        self.replace_popup_row(self.speed_presets.get(viewer), True)
        self.replace_popup_row(speed_gap, False)
        self.replace_popup_row(speed, False)
        if speed is not None and speed.getVisibility() == 0:
            try:
                self.replace_popup_row(speed, True, replacement=self.make_gear_speed_slider(speed))
                if speed.getParent() is None:
                    self.replace_popup_row(speed_gap, True)
            except Exception as error:
                self.replace_popup_row(speed, False)
                self.replace_popup_row(speed_gap, False)
                self.log(f"Video speed slider failed: {type(error).__name__}: {error}")
        try:
            self.prepare_gear_quality(viewer)
        except Exception as error:
            self.replace_popup_row(self.video_quality.get(viewer), False)
            self.log(f"Video quality slider failed: {type(error).__name__}: {error}")

    def make_gear_speed_slider(self, native):
        stops = self.native_speed_stops.get(native) or ()
        positions = sorted({0.0, 1.0, *(float(stop) for stop in stops if 0 < stop < 1)})

        def speed_value(progress):
            return float(native.getSpeed(jfloat(progress)))

        low, high = speed_value(0.0), speed_value(1.0)

        def quantize(progress):
            speed = round(speed_value(progress) * 10) / 10
            return max(0.0, min(1.0, (speed - low) / max(0.01, high - low)))

        def speed_text(progress):
            return f"{speed_value(progress):.1f}".rstrip("0").rstrip(".") + "×"

        def apply(final, progress, _):
            self.native_speed_update.invoke(native, self.arguments([self.float_value(progress), self.boolean(final)]))

        return self.make_gear_capsule(native.getContext(), "速度", positions, list(map(speed_text, positions)),
                                      float(native.getValue()), speed_text, apply,
                                      tick=lambda progress: round(speed_value(progress) * 10), quantize=quantize,
                                      divider=True)

    def prepare_gear_quality(self, viewer):
        quality = self.video_quality.get(viewer)
        if quality is None:
            return False
        player = viewer.getVideoPlayer()
        qualities = []
        for index in range(player.getQualitiesCount() if player is not None else 0):
            item = player.getQuality(index)
            qualities.append((bool(item.original), item.p(), index))
        choices = [(index, f"原画 {resolution}p" if original else f"{resolution}p")
                   for original, resolution, index in sorted(qualities)]
        select = None
        selected = 0
        if len(choices) > 1:
            choices.insert(0, (-1, "自动"))
            current_quality = player.getSelectedQuality()
            selected = next((point for point, (index, _) in enumerate(choices) if index == current_quality), 0)
            def select(point):
                self.call(viewer, "chooseQuality", self.integer(choices[point][0]))
        elif not choices:
            width, height = self.viewer_video_dimensions(viewer)
            resolution = int(min(width, height))
            choices.append((None, f"原画 {resolution}p" if resolution > 0 else "原画"))
        signature = str((choices, selected))
        for original, _, slider, *_ in self.popup_rows:
            if original.get() == quality and slider is not None:
                row = slider.get()
                if row is not None and str(row.getTag()) == signature:
                    return False
                break
        self.replace_popup_row(quality, False)
        labels = [label for _, label in choices]
        rail = self.make_gear_quality_slider(quality.getContext(), labels, selected, select)
        rail.setTag(signature)
        self.replace_popup_row(quality, True, replacement=rail)
        return True

    def after_gear_quality_update(self, param):
        viewer = param.thisObject
        if not self.active or not self.option("video_toolbar") or not self.video_surface(viewer):
            return
        menu = self.video_menu.get(viewer)
        if menu is None or not any(ref.get() == menu for ref, *_ in self.gear_state):
            return
        popup = self.popup_window.get(menu)
        if popup is not None and popup.isShowing():
            try:
                self.replace_popup_row(self.speed_presets.get(viewer), True)
                if self.prepare_gear_quality(viewer):
                    menu.forceUpdatePopupPosition()
            except Exception as error:
                self.log(f"Video quality refresh failed: {type(error).__name__}: {error}")

    def make_gear_quality_slider(self, context, labels, selected, select):
        positions = [i / (len(labels) - 1) for i in range(len(labels))] if len(labels) > 1 else [0.5]

        def apply(final, _, point):
            if final and point != selected:
                select(point)

        if select is None and labels[selected].endswith("p"):
            labels = [labels[selected].split()[-1]]
        selectable = [int(label[:-1]) for label in labels if label.endswith("p") and label[:-1].isdigit()]
        repeated = f"原画 {max(selectable)}p" if selectable else None
        captions = ["原画" if label == repeated else label for label in labels]
        return self.make_gear_capsule(context, "画质", positions, captions, positions[selected], None,
                                      apply if select is not None else None, divider=True, value_labels=labels)

    def place_popup(self, param):
        menu = param.thisObject
        if not self.active or menu == self.native_popup_menu:
            return
        try:
            self.position_media_popup(param, menu)
        except Exception as error:
            popup = self.popup_window.get(menu)
            if popup is not None and not popup.isShowing():
                popup.setWidth(-2)
                popup.setHeight(-2)
            self.log(f"Video menu sizing failed: {type(error).__name__}: {error}")

    def position_media_popup(self, param, menu):
        gear = any(ref.get() == menu for ref, *_ in self.gear_state)
        landscape = self.landscape_header
        container = menu.getParent()
        bar = container.getParent() if container is not None else None
        container = bar.getParent() if bar is not None else None
        viewer = self.outer.get(container) if container is not None and self.drawer_type.isInstance(container) else None
        overflow = (viewer is not None and menu == self.gallery_menu.get(viewer)
                    and ((self.option("video_toolbar") and self.video_surface(viewer))
                         or (self.option("photo_shadows") and self.photo_surface(viewer))))
        if not gear and not overflow:
            return
        self.style_popup_color(menu.getPopupLayout())
        anchor = menu if overflow else menu.getAnchor()
        popup = self.popup_window.get(menu)
        if anchor is None or popup is None or not anchor.isAttachedToWindow():
            return
        content = popup.getContentView()
        if content is None:
            return
        showing, updating = map(bool, param.args)
        if not showing and (not updating or not popup.isShowing()):
            return
        visible = self.rect()
        anchor.getWindowVisibleDisplayFrame(visible)
        position = self.positions([0, 0])
        anchor.getLocationOnScreen(position)
        landscape_menu = landscape is not None and (container == landscape[1] or (gear and menu == self.video_menu.get(landscape[0])))
        if overflow or landscape_menu:
            container = landscape[1] if landscape_menu else container
            origin = self.positions([0, 0])
            container.getLocationOnScreen(origin)
            top_inset = container.getPaddingTop()
            insets = container.getRootWindowInsets()
            if insets is not None and viewer is not None and self.action_bar_visible.getBoolean(viewer):
                top_inset = max(top_inset, insets.getStableInsetTop())
            bounds = (max(visible.left, origin[0] + container.getPaddingLeft()),
                      max(visible.top, origin[1] + top_inset),
                      min(visible.right, origin[0] + container.getWidth() - container.getPaddingRight()
                          - self.thumbnail_right_reservation(viewer)),
                      min(visible.bottom, origin[1] + container.getHeight() - container.getPaddingBottom()))
            gap, edge, vertical_edge = self.dp(6), self.dp(8), self.dp(2)
            available_width = bounds[2] - bounds[0]
            space_left = position[0] - gap - bounds[0] - edge
            if space_left >= self.dp(128):
                available_width = min(available_width, space_left + 2 * edge)
            width = self.measure_popup_content(menu, content, available_width,
                                               bounds[3] - bounds[1] - 2 * vertical_edge, edge)
            offsets = side_popup_offsets(
                *bounds, position[0], position[1], anchor.getHeight(), width, content.getMeasuredHeight(),
                gap, edge, vertical_edge, self.dp(12))
            if offsets is not None:
                x, y, width, height = offsets
                if popup.isShowing():
                    popup.update(anchor, x, y, width, height)
                elif showing:
                    menu.getPopupLayout().scrollToTop()
                    popup.setWidth(width)
                    popup.setHeight(height)
                    popup.showAsDropDown(anchor, x, y, 3)
                param.setResult(None)
                return
        if not gear:
            return
        width = self.measure_popup_content(menu, content, visible.right - visible.left,
                                           visible.bottom - visible.top, self.dp(12))
        x, y, height = popup_offsets(
            visible.left, visible.top, visible.right, position[0], position[1],
            anchor.getWidth(), anchor.getHeight(), width,
            content.getMeasuredHeight(), self.dp(8), self.dp(12))
        if popup.isShowing():
            popup.update(anchor, x, y, width, height)
        elif showing:
            menu.getPopupLayout().scrollToTop()
            popup.setWidth(width)
            popup.setHeight(height)
            popup.showAsDropDown(anchor, x, y, 3)
        param.setResult(None)

    def style_popup_color(self, layout):
        self.popup_colors = [(ref, color) for ref, color in self.popup_colors if ref.get() is not None]
        if not any(ref.get() == layout for ref, color in self.popup_colors):
            self.popup_colors.append((self.weak_reference(layout), layout.getBackgroundColor()))
        layout.setBackgroundColor(MEDIA_POPUP_COLOR)

    def measure_popup_content(self, menu, content, available_width, available_height, edge):
        layout = menu.getPopupLayout()
        unspecified = self.measure_spec.makeMeasureSpec(0, self.measure_spec.UNSPECIFIED)
        widest = 0
        for index in range(layout.getItemsCount()):
            row = layout.getItemAt(index)
            if row.getVisibility() != 0:
                continue
            if self.popup_item_type.isInstance(row):
                text = row.getTextView()
                params = text.getLayoutParams()
                label_width = self.text_layout.getDesiredWidth(text.getText(), text.getPaint())
                row_width = (int(label_width + 0.999) + text.getCompoundPaddingLeft()
                             + text.getCompoundPaddingRight() + params.leftMargin + params.rightMargin
                             + row.getPaddingLeft() + row.getPaddingRight())
            else:
                row.measure(unspecified, unspecified)
                row_width = max(row.getMinimumWidth(), row.getMeasuredWidth())
            widest = max(widest, row_width)
        natural_width = widest + layout.getPaddingLeft() + layout.getPaddingRight()
        width = max(1, min(natural_width or content.getMeasuredWidth(), available_width - 2 * edge))
        content.measure(self.measure_spec.makeMeasureSpec(width, self.measure_spec.EXACTLY),
                        self.measure_spec.makeMeasureSpec(max(1, available_height), self.measure_spec.AT_MOST))
        return width

    def hide_header(self, menu):
        if menu is None:
            return
        self.gear_state = [entry for entry in self.gear_state if entry[0].get() is not None]
        for index, entry in enumerate(self.gear_state):
            if entry[0].get() == menu:
                if menu.getVisibility() != 8:
                    self.gear_state[index] = (entry[0], menu.getVisibility(), *entry[2:])
                break
        else:
            anchor = menu.getAnchor()
            self.gear_state.append((self.weak_reference(menu), menu.getVisibility(),
                                    self.weak_reference(anchor) if anchor is not None else None,
                                    menu.isShowOnTop(), self.menu_side.getInt(menu),
                                    self.menu_offset.getInt(menu)))
        menu.setVisibility(8)

    def restore_header(self, menu, show=True):
        for index, (ref, visibility, anchor, above, side, offset) in enumerate(self.gear_state):
            if ref.get() == menu:
                self.gear_state.pop(index)
                self.restore_menu(menu, visibility if show else 8, anchor, above, side, offset)
                return

    def restore_menu(self, menu, visibility, anchor, above, side, offset):
        menu.closeSubMenu()
        menu.setAnchor(anchor.get() if anchor is not None else None)
        menu.setShowOnTop(above)
        menu.setSubMenuOpenSide(side)
        menu.setAdditionalYOffset(offset)
        menu.setVisibility(visibility)

    def hide_timer_in_menu(self, param):
        menu = param.thisObject
        for background, row_ref in self.rows:
            row = row_ref.get()
            if row is None:
                continue
            container = background.get().getParent() if background.get() is not None else None
            if container is None:
                continue
            viewer = self.outer.get(container)
            if self.footer_active(viewer) and self.video_menu.get(viewer) == menu:
                timer = self.timer_action(viewer)
                if timer is not None:
                    timer.setVisibility(8)
                return

    def on_button(self, viewer_ref, action, button=None):
        viewer = viewer_ref.get()
        if not self.active or viewer is None:
            return
        if action == "settings":
            self.open_menu(viewer, self.video_menu.get(viewer), button)
            return
        if action == "media_library":
            self.open_media_library(viewer)
            return
        if action == "play":
            if self.has_player(viewer):
                self.manual_pause.setBoolean(viewer, True)
                self.call(viewer, "toggleVideoPlayer")
            else:
                self.call(viewer, "onActionClick", self.boolean(True))
            self.refresh_row(viewer)
            return
        if action == "fullscreen":
            self.toggle_fullscreen(viewer)
            return
        if action == "timer":
            item = self.timer_action(viewer)
            if item is not None and item.isEnabled():
                item.performClick()

    def has_player(self, viewer):
        web = self.web_player.get(viewer)
        return viewer.getVideoPlayer() is not None or (web is not None and web.isControllable())

    def can_show_in_chat(self, viewer):
        menu = self.gallery_menu.get(viewer)
        return menu is not None and self.header_menu.get(viewer) is not None and menu.isSubItemVisible(SHOW_IN_CHAT_MENU_ID)

    def can_show_media_library(self, viewer):
        message = viewer.getCurrentMessageObject()
        menu = self.gallery_menu.get(viewer)
        return (message is not None and message.getDialogId() != 0 and message.getId() != 0
                and menu is not None and (menu.isSubItemVisible(SHOW_ALL_MEDIA_MENU_ID)
                                          or menu.isSubItemVisible(SHOW_IN_CHAT_MENU_ID)))

    def open_media_library(self, viewer):
        if not self.can_show_media_library(viewer):
            return False
        closing = self.library_return
        if closing is not None and closing.viewer == viewer and closing.key == self.current_media_key(viewer):
            return True
        activity = viewer.getParentActivity()
        if activity is None or activity.isFinishing() or not self.launch_activity_type.isInstance(activity):
            return False
        message = viewer.getCurrentMessageObject()
        dialog, message_id = message.getDialogId(), message.getId()
        source = self.capture_library_video(viewer, message)
        self.stop_library_preview()
        args = self.bundle()
        args.putLong("dialog_id", dialog)
        fragment = self.media_library_type(args, None)
        origin = activity.getActionBarLayout().getLastFragment()
        chat = self.parent_chat.get(viewer)
        if self.chat_activity.isInstance(origin) and origin.getDialogId() == dialog:
            chat = origin
        if chat is not None and chat.getDialogId() == dialog:
            fragment.setChatInfo(chat.getCurrentChatInfo())
        images = self.album_messages.get(viewer)
        queue = self.library_array(images) if images is not None and images.indexOf(message) >= 0 else None
        dialogs = tuple(value.getLong(viewer) for value in self.viewer_dialogs)
        window = self.window.get(viewer)
        orientation = SENSOR_LANDSCAPE if window is not None and window.getWidth() > window.getHeight() else SENSOR_PORTRAIT
        player = viewer.getVideoPlayer()
        playback = ((max(0, player.getCurrentPosition()), player.getPlaybackSpeed(), player.isPlaying())
                    if player is not None else None)
        layout_state = self.capture_chat_layout_state(chat) if chat is not None and chat == origin else None
        viewer_parent = (self.viewer_parent_fragment.get(viewer), self.viewer_resources_provider.get(viewer))
        route = LibraryReturn(viewer, activity, fragment, origin, chat, self.viewer_provider.get(viewer),
                              viewer_parent, message, queue, dialogs, orientation, playback, layout_state)
        opening = self.opening_chat_viewport
        if opening is not None and opening[0].get() == viewer and opening[1].get() == chat:
            route.opening_chat_viewport = opening
        self.library_return = route
        if not activity.presentFragment(fragment, False, True):
            self.library_return = closing
            return False
        focus = route.focus = self.pending_media_library = (fragment, dialog, message_id, source)
        run_on_ui_thread(lambda: self.focus_media_library(focus, 120), 16)
        # Build and lay out the grid under the viewer before starting the native closing animation.
        run_on_ui_thread(lambda: self.reveal_media_library(route, monotonic() + 0.13), 48)
        return True

    def reveal_media_library(self, route, deadline):
        if (not self.active or self.library_return is not route or not self.library_is_front(route)
                or not route.viewer.isVisible()):
            return
        layout = self.library_layout.get(route.fragment)
        if (monotonic() < deadline and (layout is None or not layout.isAttachedToWindow()
                                         or layout.isLayoutRequested())):
            run_on_ui_thread(lambda: self.reveal_media_library(route, deadline), 16)
            return
        route.viewer.closePhoto(False, False)
        run_on_ui_thread(lambda: self.recenter_library_after_resize(route, 22), 64)

    def recenter_library_after_resize(self, route, remaining):
        if not self.active or self.library_return is not route:
            return
        geometry = route.focus_geometry
        if geometry is not None:
            listing, layout, width, bounds, _ = geometry
            if listing.getScrollState() != 0:
                return
            if (not route.viewer.isVisible() and not listing.isLayoutRequested()
                    and not listing.isComputingLayout() and not listing.hasPendingAdapterUpdates()
                    and self.pending_media_library is not route.focus
                    and (not route.focus_settled or listing.getWidth() != width
                         or self.media_library_vertical_bounds(listing, layout) != bounds)):
                self.pending_media_library = route.focus
                self.focus_media_library(route.focus, 16, True)
        if remaining:
            run_on_ui_thread(lambda: self.recenter_library_after_resize(route, remaining - 1), 56)

    def after_media_library_destroy(self, param):
        route = self.library_return
        if route is not None and route.fragment == param.thisObject:
            self.remove_library_selection(route)
            run_on_ui_thread(lambda: self.return_from_media_library(route, 40), 1)

    def capture_chat_layout_state(self, chat):
        listing = chat.getChatListView()
        manager = listing.getLayoutManager() if listing is not None else None
        state = manager.onSaveInstanceState() if manager is not None else None
        if state is None:
            return None
        position = self.chat_saved_position.getInt(state)
        if position < 0:
            return None
        adapter = listing.getAdapter()
        stable_id = (adapter.getItemId(position) if adapter is not None and adapter.hasStableIds()
                     and position < adapter.getItemCount() else None)
        return state, position, stable_id, self.chat_resume_scroll.getBoolean(chat)

    def restore_chat_layout_state(self, chat, listing, captured, message_key=None):
        state, position, stable_id, _ = captured
        manager = listing.getLayoutManager()
        if manager is None:
            return
        adapter = listing.getAdapter()
        if stable_id is not None and adapter is not None and adapter.hasStableIds():
            count = adapter.getItemCount()
            if position >= count or adapter.getItemId(position) != stable_id:
                position = next((index for index in range(count) if adapter.getItemId(index) == stable_id), -1)
                if position >= 0:
                    self.chat_saved_position.setInt(state, position)
        if position >= 0:
            manager.onRestoreInstanceState(state)
        elif message_key is not None:
            dialog, message_id = message_key
            load_index = self.chat_message_load_index(chat, dialog)
            if load_index is not None:
                chat.scrollToMessageId(message_id, 0, False, load_index, True, 0)

    def before_library_chat_resume(self, param):
        route = self.library_resume
        chat = param.thisObject
        if route is None or route.chat != chat or route.chat_layout_state is None or not route.viewer.isVisible():
            return
        _, position, _, already_pending = route.chat_layout_state
        if already_pending or self.chat_resume_unread.getBoolean(chat):
            route.chat_layout_state = None
            route.opening_chat_viewport = None
            return
        # Preserve deliberate jumps and the unread marker. A bottom-jump queued
        # only while the old chat was behind this gallery would replace its viewport.
        if position > 0 and self.chat_resume_scroll.getBoolean(chat):
            self.chat_resume_scroll.setBoolean(chat, False)

    def library_is_front(self, route):
        parent = route.fragment.getParentLayout()
        return parent is not None and parent.getLastFragment() == route.fragment

    def back_from_media_library(self, param):
        route = self.library_return
        if (route is None or param.thisObject != route.activity or not bool(param.getResult())
                or route.viewer.isVisible() or not self.library_is_front(route)):
            return
        if bool(param.args[0]) and route.fragment.onBackPressed(True):
            route.fragment.finishFragment(False)
        param.setResult(self.boolean(False))

    def before_media_library_finish(self, param):
        route = self.library_return
        if route is not None and param.thisObject == route.fragment and self.restore_from_front_library(route):
            param.setResult(self.boolean(True))

    def before_media_library_pop(self, param):
        route = self.library_return
        if (route is not None and param.thisObject == route.fragment.getParentLayout()
                and self.restore_from_front_library(route)):
            param.setResult(None)

    def restore_from_front_library(self, route):
        if route.viewer.isVisible() or route.activity.isFinishing() or not self.library_is_front(route):
            return False
        self.leave_media_library(route.fragment)
        if not self.reopen_library_viewer(route):
            return False
        self.remove_library_selection(route)
        self.library_return = None
        # Keep the gallery under PhotoViewer during its native 220 ms opening fade.
        deadline = monotonic() + 0.65
        run_on_ui_thread(lambda: self.finish_media_library_behind_viewer(route, deadline), 240)
        return True

    def finish_media_library_behind_viewer(self, route, deadline):
        if not self.library_is_front(route):
            return
        container = self.viewer_container.get(route.viewer)
        if (self.active and route.viewer.isVisible() and monotonic() < deadline
                and (container is None or not container.isShown() or container.getAlpha() < 0.995)):
            run_on_ui_thread(lambda: self.finish_media_library_behind_viewer(route, deadline), 16)
            return
        route.fragment.finishFragment(False)
        if route.viewer.isVisible() and self.current_media_key(route.viewer) == route.key:
            self.restore_library_context(route)
            self.resume_library_video(route, 80)

    def return_from_media_library(self, route, remaining):
        if not self.active or self.library_return is not route:
            return
        viewer, activity = route.viewer, route.activity
        if activity.isFinishing():
            self.library_return = None
            return
        if viewer.isVisible() or activity.getActionBarLayout().getLastFragment() != route.origin:
            if remaining:
                run_on_ui_thread(lambda: self.return_from_media_library(route, remaining - 1), 16)
            else:
                self.library_return = None
            return
        self.library_return = None
        opened = self.reopen_library_viewer(route)
        if opened:
            self.restore_library_context(route)
            self.resume_library_video(route, 80)
            return
        if opened is False and remaining:
            self.library_return = route
            run_on_ui_thread(lambda: self.return_from_media_library(route, remaining - 1), 16)

    def restore_library_context(self, route):
        activity = route.activity
        self.opening_chat_viewport = route.opening_chat_viewport
        # The gallery pauses and detaches the chat. Restore its native layout
        # state once it is back underneath PhotoViewer, before rotating playback.
        parent = route.chat.getParentLayout() if route.chat is not None else None
        if route.chat_layout_state is not None and parent is not None and parent.getLastFragment() == route.chat:
            listing = route.chat.getChatListView()
            if listing is not None:
                self.restore_chat_layout_state(route.chat, listing, route.chat_layout_state)
            route.chat_layout_state = None
        portrait = activity.getResources().getConfiguration().orientation == 1
        if route.orientation == SENSOR_LANDSCAPE or not portrait:
            self.lock_playback_axis(route.viewer, route.orientation)

    def reopen_library_viewer(self, route):
        viewer, activity = route.viewer, route.activity
        try:
            viewer.setParentActivity(activity, *route.viewer_parent)
            self.library_resume = route
            dialog, merged, topic = route.dialogs
            queue = route.queue
            index = queue.indexOf(route.message) if queue is not None else 0
            message = route.message
            if index < 0:
                queue, index = None, 0
            if queue is not None:
                # PhotoViewer enters the single-message loader when both arguments are set.
                message = None
            # No transition source on this re-entry. Keep the original provider for subsequent viewer actions.
            opened = viewer.openPhoto(message, None, None, None, queue, None, None, index, self.album_provider(),
                                      route.chat, dialog or route.key[0], merged, topic, True, None, None)
            if not opened:
                self.library_resume = None
                return False
            self.opening_chat_viewport = route.opening_chat_viewport
            preview = self.seek_preview.get(viewer)
            if preview is not None:
                self.seek_preview_pending.setBoolean(viewer, False)
                preview.setTag(None)
                preview.setVisibility(4)
                self.hidden_return_preview = preview
            if route.provider is not None:
                self.viewer_provider.set(viewer, route.provider)
            self.auto_processed = (self.weak_reference(viewer), route.key, True)
            if route.playback is not None and not route.playback[2]:
                self.manual_pause.setBoolean(viewer, True)
                player = viewer.getVideoPlayer()
                if player is not None:
                    player.setPlayWhenReady(False)
            return True
        except Exception as error:
            self.library_resume = None
            self.log(f"Could not return to video from media library: {type(error).__name__}: {error}")
            return True if viewer.isVisible() else None

    def show_return_seek_preview(self, param):
        viewer = param.thisObject
        if (bool(param.args[0]) and self.hidden_return_preview is not None
                and self.hidden_return_preview == self.seek_preview.get(viewer)):
            seekbar = self.video_seek.get(viewer)
            if seekbar is not None and seekbar.isDragging():
                self.restore_return_seek_preview()
            else:
                param.setResult(None)

    def restore_return_seek_preview(self):
        preview = self.hidden_return_preview
        if preview is not None:
            self.hidden_return_preview = None
            preview.setAlpha(0.0)
            preview.setVisibility(0)

    def resume_library_video(self, route, remaining):
        if not self.active or self.library_resume is not route:
            return
        viewer = route.viewer
        if self.current_media_key(viewer) != route.key or route.playback is None:
            self.library_resume = None
            return
        player = viewer.getVideoPlayer()
        container = self.viewer_container.get(viewer)
        oriented = (container is not None and container.getWidth() > 0
                    and (container.getWidth() > container.getHeight()) == (route.orientation == SENSOR_LANDSCAPE))
        if oriented and viewer.isVisible() and player is not None and player.isPlayerPrepared():
            self.library_resume = None
            position, speed, playing = route.playback
            self.manual_pause.setBoolean(viewer, not playing)
            self.viewer_pending_seek.setFloat(viewer, 0.0)
            player.seekTo(position)
            player.setPlaybackSpeed(speed)
            player.setPlayWhenReady(playing)
        elif remaining:
            run_on_ui_thread(lambda: self.resume_library_video(route, remaining - 1), 40)
        else:
            self.library_resume = None

    def focus_media_library(self, focus, remaining, requested=False, settle_attempts=0):
        if not self.active or self.pending_media_library is not focus:
            return
        fragment, dialog, message_id, source = focus
        layout = self.library_layout.get(fragment)
        if layout is not None and layout.isAttachedToWindow():
            if layout.getClosestTab() != 0:
                if requested:
                    self.pending_media_library = None
                    return
                layout.scrollToPage(0)
            page = self.library_page.invoke(layout, self.integer(0))
            listing = self.library_list.get(page) if page is not None else None
            adapter = self.library_adapter.get(layout)
            if (listing is not None and listing.getAdapter() == adapter and listing.getHeight() > 0
                    and not listing.isLayoutRequested() and not listing.isComputingLayout()
                    and not listing.hasPendingAdapterUpdates()):
                if listing.getScrollState() != 0:
                    self.pending_media_library = None
                    return
                data = self.library_data.get(layout)[0]
                messages = data.getMessages()
                index = media_grid_index(messages, dialog, message_id)
                if index >= 0:
                    position = adapter.getPositionForIndex(index)
                    jumped = self.center_media_library_row(listing, position, layout, settle_attempts == 0)
                    holder = listing.findViewHolderForAdapterPosition(position)
                    waiting_for_cell = 0 < settle_attempts < 4 and holder is None
                    if remaining and (jumped or waiting_for_cell):
                        run_on_ui_thread(lambda: self.focus_media_library(
                            focus, remaining - 1, requested, settle_attempts + 1), 32)
                        return
                    self.pending_media_library = None
                    route = self.library_return
                    if route is not None and route.focus is focus:
                        route.focus_geometry = (listing, layout, listing.getWidth(),
                                                self.media_library_vertical_bounds(listing, layout), position)
                        route.focus_settled = not route.viewer.isVisible()
                        self.install_library_selection(route)
                        listing.invalidate()
                    if source is not None:
                        preview = self.library_preview
                        if (preview is not None and preview.fragment == fragment and preview.listing == listing
                                and (preview.dialog, preview.message_id) == (dialog, message_id)
                                and (preview.cell is None or (holder is not None and holder.itemView == preview.cell))):
                            preview.position = position
                        else:
                            self.stop_library_preview()
                            preview = self.library_preview = LibraryVideoPreview(fragment, listing, dialog, message_id,
                                                                                  position, source)
                            run_on_ui_thread(lambda: self.update_library_preview(preview), 280)
                    return
                if not requested:
                    requested = True
                    self.request_media_library_anchor(focus, layout, data, page, listing)
        if remaining:
            run_on_ui_thread(lambda: self.focus_media_library(focus, remaining - 1, requested, settle_attempts), 50)
        else:
            self.pending_media_library = None

    def install_library_selection(self, route):
        host = route.fragment.getFragmentView()
        if host is None:
            return
        if route.selection is not None:
            if route.selection.host == host:
                return
            self.remove_library_selection(route)
        host = cast(self.frame_layout, host)
        marker = self.image_view(host.getContext())
        marker.setImageResource(self.drawable.msg_views)
        marker.setScaleType(self.fit_center)
        marker.setColorFilter(jint(0xFF34210E - (1 << 32)))
        marker.setBackground(self.round_background(jint(0xFFFFD28D - (1 << 32)), 24))
        marker.setVisibility(4)
        marker.setImportantForAccessibility(2)
        # This overlay is drawn above every child, including a video preview added later.
        host.getOverlay().add(marker)
        route.selection = LibrarySelection(host, marker)

    def remove_library_selection(self, route):
        selection = route.selection
        if selection is not None:
            selection.host.getOverlay().remove(selection.marker)
            route.selection = None
        route.selection_cell = None

    def library_cell_matches(self, cell, key):
        if cell is None or not self.library_cell_type.getClass().isInstance(cell):
            return False
        message = cast(self.library_cell_type, cell).getMessageObject()
        return message is not None and (message.getDialogId(), message.getId()) == key

    def track_library_selection_cell(self, param):
        route = self.library_return
        if route is None:
            return
        layout = self.library_layout.get(route.fragment)
        if layout is not None and self.library_adapter.get(layout) == param.thisObject:
            cell = param.args[0].itemView
            if self.library_cell_matches(cell, route.key):
                route.selection_cell = self.weak_reference(cell)

    def update_library_selection(self, param):
        route = self.library_return
        if route is None or route.focus_geometry is None or route.selection is None:
            return
        selection = route.selection
        listing, _, width, (view_top, view_bottom), position = route.focus_geometry
        if listing != param.thisObject:
            return
        if (view_bottom <= view_top or listing.getWidth() != width or listing.isChangeColumnsAnimation()
                or not self.position_library_selection(route, listing, position, view_top, view_bottom)):
            if selection.marker.getVisibility() != 4:
                selection.marker.setVisibility(4)

    def position_library_selection(self, route, listing, position, view_top, view_bottom):
        selection = route.selection
        cell = route.selection_cell.get() if route.selection_cell is not None else None
        if not self.library_cell_matches(cell, route.key) or cell.getParent() != listing:
            holder = listing.findViewHolderForAdapterPosition(position)
            cell = holder.itemView if holder is not None else None
            if not self.library_cell_matches(cell, route.key):
                return False
            route.selection_cell = self.weak_reference(cell)
        image, (left, top, right, bottom) = self.library_thumbnail_bounds(cell)
        if image is None or right <= left or bottom <= top:
            return False

        size = min(self.dp(24), round(min(right - left, bottom - top) * 0.36))
        if size < self.dp(10):
            return False
        margin = max(1, size // 6)
        x = round(cell.getX() + right) - size - margin
        y = round(cell.getY() + top) + margin
        if x < 0 or x + size > listing.getWidth() or y < view_top or y + size > view_bottom:
            return False
        origin_x, origin_y = self.view_origin(listing, selection.host)
        x, y = x + origin_x, y + origin_y
        geometry = (x, y, size)
        marker = selection.marker
        if geometry != selection.geometry:
            if selection.geometry is None or selection.geometry[2] != size:
                inset = max(1, round(size * 0.21))
                marker.setPadding(inset, inset, inset, inset)
                spec = self.measure_spec.makeMeasureSpec(size, self.measure_spec.EXACTLY)
                marker.measure(spec, spec)
            marker.layout(x, y, x + size, y + size)
            selection.geometry = geometry
        if marker.getVisibility() != 0:
            marker.setVisibility(0)
        return True

    def library_thumbnail_bounds(self, cell):
        width, height = float(cell.getWidth()), float(cell.getHeight())
        image = self.library_cell_image.get(cell)
        if image is None or image.getImageWidth() <= 0 or image.getImageHeight() <= 0:
            return None, (0.0, 0.0, width, height)
        x, y = float(image.getImageX()), float(image.getImageY())
        return image, (max(0.0, x), max(0.0, y), min(width, x + image.getImageWidth()),
                       min(height, y + image.getImageHeight()))

    def library_corner_radii(self, image, inset):
        return tuple(max(0.0, float(radius) - inset) for radius in image.getRoundRadius(True) for _ in range(2))

    def media_library_vertical_bounds(self, listing, layout):
        top, bottom = listing.getPaddingTop(), listing.getHeight() - listing.getPaddingBottom()
        visible = self.library_visible_rect
        if listing.getLocalVisibleRect(visible):
            top, bottom = max(top, visible.top), min(bottom, visible.bottom)
        tabs = self.library_tabs.get(layout)
        if tabs is not None and tabs.isShown() and tabs.getHeight() > 0:
            _, tabs_top = self.view_origin(tabs, listing)
            top = max(top, tabs_top + tabs.getHeight())
        return top, bottom

    def center_media_library_row(self, listing, position, layout, allow_jump=True):
        top, bottom = self.media_library_vertical_bounds(listing, layout)
        if bottom <= top:
            return False
        manager = listing.getLayoutManager()
        holder = listing.findViewHolderForAdapterPosition(position)
        cell = holder.itemView if holder is not None else None
        if cell is not None:
            current = (manager.getDecoratedTop(cell) + manager.getDecoratedBottom(cell)) / 2.0
            if self.library_cell_type.getClass().isInstance(cell):
                image, (_, image_top, _, image_bottom) = self.library_thumbnail_bounds(cell)
                if image is not None:
                    current = cell.getY() + (image_top + image_bottom) / 2.0
            delta = round(current - (top + bottom) / 2.0)
            if delta and listing.canScrollVertically(1 if delta > 0 else -1):
                listing.scrollBy(0, delta)
            return False
        if not allow_jump:
            return False
        columns = max(1, cast(self.library_list_type, listing).getColumnsCount())
        tile = max(1, (listing.getWidth() - listing.getPaddingLeft() - listing.getPaddingRight()) // columns)
        padding_top = listing.getPaddingTop()
        padded_bottom = listing.getHeight() - listing.getPaddingBottom()
        target = media_grid_scroll_target(position, listing.getAdapter().getItemCount(), columns,
                                          padded_bottom - padding_top, tile, top - padding_top, padded_bottom - bottom)
        if target is not None:
            manager.scrollToPositionWithOffset(*target)
            return True
        return False

    def request_media_library_anchor(self, focus, layout, data, page, listing):
        fragment, dialog, message_id, _ = focus
        if message_id <= 0 or self.dialog_object.isEncryptedDialog(dialog):
            return
        peer = fragment.getMessagesController().getInputPeer(dialog)
        if peer is None:
            return
        request = self.media_search_request()
        request.peer, request.filter, request.q = peer, self.photo_video_filter(), ""
        request.offset_id, request.add_offset, request.limit = message_id, -10, 21

        def anchor_ready(result, error):
            if (not self.active or self.pending_media_library is not focus or error is not None
                    or not layout.isAttachedToWindow() or layout.getClosestTab() != 0
                    or listing.getScrollState() != 0):
                return
            messages = data.getMessages()
            if media_grid_index(messages, dialog, message_id) >= 0:
                return  # The first native page resolved the target while the search was in flight.
            anchor = media_grid_anchor(result, message_id)
            if anchor is None:
                return
            max_id, start, count = anchor
            data.setTotalCount(count)
            self.library_jump.invoke(layout, self.integer(0), self.integer(max_id), self.integer(start), self.boolean(False))
            self.library_load.invoke(layout, page, listing, listing.getLayoutManager())

        callback = RequestCallback(lambda result, error: run_on_ui_thread(lambda: anchor_ready(result, error)),
                                   fragment.getCurrentAccount())
        connection = fragment.getConnectionsManager()
        token = connection.sendRequest(request, callback)
        if token:
            connection.bindRequestToGuid(token, fragment.getClassGuid())

    def capture_library_video(self, viewer, message):
        player = viewer.getVideoPlayer()
        try:
            raw = message.messageOwner
            if (player is None or not player.isPlaying() or not message.isVideo() or raw is None
                    or 0 < raw.ttl < 3600 or message.isRestrictedMessage
                    or message.hasMediaSpoilers() or message.isHiddenSensitive()):
                return None
            uri, byte_offset = player.getCurrentUri(), 0
            if uri is None:
                qualities = self.library_array()
                for index in range(player.getQualitiesCount()):
                    qualities.add(player.getQuality(index))
                variant = self.library_player_type.getQualityForThumb(qualities)
                if variant is None or variant.uri is None:
                    return None
                uri, byte_offset = variant.uri, variant.fileVideoOffset
            return uri, byte_offset, max(0, player.getCurrentPosition()), player.getPlaybackSpeed()
        except Exception as error:
            self.log(f"Could not capture media library video: {type(error).__name__}: {error}")
            return None

    def make_library_preview_delegate(self):
        plugin = self
        delegate_type = jclass("org.telegram.ui.Components.VideoPlayer$VideoPlayerDelegate")

        class Delegate(dynamic_proxy(delegate_type)):
            def __init__(self, preview):
                super().__init__()
                self.preview = preview

            def onStateChanged(self, play_when_ready, state):
                if state == 4:  # Player.STATE_ENDED
                    run_on_ui_thread(lambda: plugin.stop_library_preview(self.preview), 1)

            def onError(self, player, error):
                run_on_ui_thread(lambda: plugin.stop_library_preview(self.preview), 1)

            def onVideoSizeChanged(self, width, height, rotation, ratio):
                if width > 0 and height > 0:
                    self.preview.aspect.setAspectRatio(jfloat(width * ratio / height), rotation)
                    self.preview.geometry = None

            def onRenderedFirstFrame(self, *_):
                self.preview.first_frame = True

            def onSurfaceTextureUpdated(self, surface):
                pass

            def onSurfaceDestroyed(self, surface):
                return False

            def onSeekStarted(self, event):
                pass

            def onSeekFinished(self, event):
                pass

        return Delegate

    def start_library_preview(self, preview, cell):
        context = cell.getContext()
        preview.host = cast(self.frame_layout, preview.fragment.getFragmentView())
        preview.frame = self.frame_layout(context)
        preview.aspect = self.library_aspect(context)
        preview.aspect.setResizeMode(4)  # AspectRatioFrameLayout.RESIZE_MODE_ZOOM
        texture = self.library_texture(context)
        # TextureView creates its SurfaceTexture when drawn. Keep it drawable before the first frame.
        texture.setOpaque(False)
        preview.aspect.addView(texture, self.frame_params(-1, -1))
        preview.frame.addView(preview.aspect, self.frame_params(-1, -1, 17))
        preview.host.addView(preview.frame, self.frame_params(0, 0, 51))
        preview.cell = cell
        preview.deadline = monotonic() + 12
        self.position_library_preview(preview, cell)
        player = preview.player = self.library_player_type(False, True)
        player.setDelegate(self.library_delegate(preview))
        player.setTextureView(texture)
        uri, byte_offset, position, speed = preview.source
        player.preparePlayer(uri, "other", 0, byte_offset)
        player.seekTo(position)
        player.setPlaybackSpeed(speed)
        player.setPlayWhenReady(True)

    def position_library_preview(self, preview, cell):
        listing = preview.listing
        image, bounds = self.library_thumbnail_bounds(cell)
        left, top, right, bottom = map(round, bounds)
        inset = self.dp(3)
        x, y = round(cell.getX()) + left + inset, round(cell.getY()) + top + inset
        w, h = right - left - 2 * inset, bottom - top - 2 * inset
        top = max(0, listing.getPaddingTop() - y)
        bottom = min(h, listing.getHeight() - listing.getPaddingBottom() - y)
        if w <= 0 or bottom <= top:
            return False
        if self.sdk >= 33 and image is not None:
            corners = self.library_corner_radii(image, inset)
            if corners != preview.corner_radii:
                if preview.outline_mask is None:
                    preview.outline_mask = self.pill_background()
                    preview.outline_mask.setColor(jint(0))
                    preview.frame.setBackground(preview.outline_mask)
                    preview.frame.setClipToOutline(True)
                preview.outline_mask.setCornerRadii(self.thumbnail_fade_positions(corners))
                preview.corner_radii = corners
        list_x, list_y = self.view_origin(listing, preview.host)
        x, y = x + list_x, y + list_y
        geometry = x, y, w, h, top, bottom
        if geometry != preview.geometry:
            frame = preview.frame
            if preview.geometry is None or preview.geometry[2:4] != (w, h):
                exact = self.measure_spec.EXACTLY
                params = frame.getLayoutParams()
                params.width, params.height = w, h
                frame.measure(self.measure_spec.makeMeasureSpec(w, exact), self.measure_spec.makeMeasureSpec(h, exact))
                frame.layout(0, 0, w, h)
            frame.setTranslationX(jfloat(x))
            frame.setTranslationY(jfloat(y))
            frame.setClipBounds(self.rect(0, top, w, bottom))
            preview.geometry = geometry
        return True

    def update_library_preview(self, preview):
        if not self.active or self.library_preview is not preview:
            return
        try:
            listing = preview.listing
            parent = preview.fragment.getParentLayout()
            layout = self.library_layout.get(preview.fragment)
            if (parent is None or parent.getLastFragment() != preview.fragment or not listing.isShown()
                    or layout is None or layout.getClosestTab() != 0
                    or (not preview.first_frame and monotonic() >= preview.deadline)):
                self.stop_library_preview(preview)
                return
            route = self.library_return
            if route is not None and route.fragment == preview.fragment and route.viewer.isVisible():
                run_on_ui_thread(lambda: self.update_library_preview(preview), 32)
                return
            if listing.getScrollState() != 0:
                if preview.player is not None and not preview.scrolling:
                    preview.scrolling = True
                    preview.frame.setVisibility(4)
                    preview.player.setPlayWhenReady(False)
                run_on_ui_thread(lambda: self.update_library_preview(preview), 100)
                return
            if preview.player is None and (listing.isLayoutRequested() or listing.hasPendingAdapterUpdates()):
                run_on_ui_thread(lambda: self.update_library_preview(preview), 32)
                return
            cell = preview.cell
            if cell is None:
                holder = listing.findViewHolderForAdapterPosition(preview.position)
                candidate = holder.itemView if holder is not None else None
                if candidate is not None and self.library_cell_type.getClass().isInstance(candidate):
                    cell = cast(self.library_cell_type, candidate)
            if cell is not None:
                message = cell.getMessageObject()
                matches = (cell.getParent() == listing and message is not None
                           and message.getId() == preview.message_id and message.getDialogId() == preview.dialog)
                if preview.player is None:
                    if matches and cell.getWidth() > 0 and cell.getHeight() > 0:
                        self.start_library_preview(preview, cell)
                elif not matches or not self.position_library_preview(preview, cell):
                    self.stop_library_preview(preview)
                    return
                elif preview.scrolling:
                    preview.scrolling = False
                    preview.frame.setVisibility(0)
                    preview.player.setPlayWhenReady(True)
            run_on_ui_thread(lambda: self.update_library_preview(preview), 60)
        except Exception as error:
            self.log(f"Media library video preview failed: {type(error).__name__}: {error}")
            self.stop_library_preview(preview)

    def stop_library_preview(self, expected=None):
        preview = getattr(self, "library_preview", None)
        if preview is None or (expected is not None and preview is not expected):
            return
        self.library_preview = None
        try:
            if preview.player is not None:
                preview.player.releasePlayer(False)
        finally:
            if preview.frame is not None:
                parent = preview.frame.getParent()
                if parent is not None:
                    parent.removeView(preview.frame)

    def leave_media_library(self, fragment):
        if self.pending_media_library is not None and self.pending_media_library[0] == fragment:
            self.pending_media_library = None
        preview = self.library_preview
        if preview is not None and preview.fragment == fragment:
            self.stop_library_preview(preview)

    def pause_media_library(self, activity):
        for fragment in (self.pending_media_library[0] if self.pending_media_library is not None else None,
                         self.library_preview.fragment if self.library_preview is not None else None):
            if fragment is not None and fragment.getParentActivity() == activity:
                self.leave_media_library(fragment)

    def before_gallery_menu_click(self, param):
        action = int(param.args[0])
        if not self.active or action not in (SHOW_ALL_MEDIA_MENU_ID, SHOW_IN_CHAT_MENU_ID):
            return
        menu = param.thisObject
        bar = menu.getParent()
        container = bar.getParent() if bar is not None else None
        if container is None or not self.drawer_type.isInstance(container):
            return
        viewer = self.outer.get(container)
        if menu != self.header_menu.get(viewer):
            return
        if action == SHOW_ALL_MEDIA_MENU_ID:
            enabled = ((self.option("video_toolbar") and self.video_surface(viewer))
                       or (self.option("photo_shadows") and self.photo_surface(viewer)))
            if enabled and self.open_media_library(viewer):
                param.setResult(None)
            return
        opening = self.opening_chat_viewport
        if opening is not None and opening[0].get() == viewer:
            self.opening_chat_viewport = None
        if container.getWidth() <= container.getHeight() or not self.can_show_in_chat(viewer):
            return
        activity = viewer.getParentActivity()
        if activity is None or activity.isFinishing():
            return
        if self.pending_chat_jump is not None and self.pending_chat_jump[0].get() == viewer:
            param.setResult(None)
            return
        native = self.native_fullscreen_mode.getInt(viewer) != 0
        owned = any(state is not None and state[0].get() == viewer
                    for state in (self.fullscreen_session, self.axis_lock))
        if not native and not owned:
            return
        pending = (self.weak_reference(viewer), self.current_media_key(viewer))
        self.pending_chat_jump = pending
        param.setResult(None)
        self.release_video_orientation(viewer)
        if native:
            activity.setRequestedOrientation(self.previous_native_orientation.getInt(viewer))

        def navigate(remaining):
            if self.pending_chat_jump is not pending:
                return
            if (not self.active or not viewer.isVisible() or activity.isFinishing()
                    or self.current_media_key(viewer) != pending[1]):
                self.pending_chat_jump = None
                return
            if container.getWidth() > container.getHeight() and remaining:
                run_on_ui_thread(lambda: navigate(remaining - 1), 32)
                return
            self.pending_chat_jump = None
            callback = bar.getActionBarMenuOnItemClick()
            if callback is not None:
                callback.onItemClick(SHOW_IN_CHAT_MENU_ID)

        run_on_ui_thread(lambda: navigate(25), 32)

    def before_viewer_close(self, param):
        viewer = param.thisObject
        if self.active and self.library_return is None and viewer.isVisible() and not bool(param.args[1]):
            jump = self.pending_sidebar_chat
            if jump is not None and jump[0].get() == viewer:
                self.position_sidebar_chat(jump)
            window, chat = self.window.get(viewer), self.parent_chat.get(viewer)
            if chat is not None and window is not None and window.getWidth() > window.getHeight():
                opening = self.opening_chat_viewport
                key = self.current_media_key(viewer)
                same_message = (opening is not None and opening[0].get() == viewer
                                and opening[1].get() == chat and opening[2] == key)
                self.pending_chat_reflow = ChatReturnReflow(
                    self.weak_reference(viewer), self.weak_reference(chat), opening[3] if same_message else None, key)
        self.release_video_orientation(viewer)

    def after_chat_rotation(self, param):
        reflow = self.pending_chat_reflow
        chat = param.thisObject
        if (reflow is None or reflow.chat_ref.get() != chat or reflow.layout_requested
                or int(param.args[0].orientation) != 1):
            return
        parent = chat.getParentLayout()
        listing = chat.getChatListView()
        if (parent is None or parent.getLastFragment() != chat
                or listing is None or not listing.isAttachedToWindow()):
            self.pending_chat_reflow = None
            return
        animator = listing.getItemAnimator()
        if animator is not None and animator.isRunning():
            animator.endAnimations()
        for index in range(listing.getChildCount()):
            child = listing.getChildAt(index)
            if self.chat_cell.getClass().isInstance(child):
                # The native onMeasure uses this cache to decide whether to rebind the message.
                self.chat_cell_height_cache.setInt(child, -1)
                cast(self.chat_cell, child).relayout()
        if reflow.viewport is not None:
            self.restore_chat_layout_state(chat, listing, reflow.viewport, reflow.message_key)
        listing.requestLayout()
        reflow.layout_requested = True
        self.finish_chat_return_reflow(reflow)

    def after_viewer_closed(self, param):
        reflow = self.pending_chat_reflow
        if reflow is not None and reflow.viewer_ref.get() == param.thisObject:
            reflow.viewer_closed = True
            self.finish_chat_return_reflow(reflow)

    def finish_chat_return_reflow(self, reflow):
        if not (reflow.viewer_closed and reflow.layout_requested):
            return
        self.pending_chat_reflow = None
        chat = reflow.chat_ref.get()
        listing = chat.getChatListView() if chat is not None else None
        if listing is not None and listing.isAttachedToWindow():
            # A draw while PhotoViewer owned the image could have cached an empty media layer.
            for index in range(listing.getChildCount()):
                listing.getChildAt(index).invalidate()
            listing.invalidate()

    def remember_opening_chat_viewport(self, viewer, message):
        if self.library_resume is not None and self.library_resume.viewer == viewer:
            return
        self.opening_chat_viewport = None
        self.pending_chat_reflow = None
        activity, chat = viewer.getParentActivity(), self.parent_chat.get(viewer)
        if (message is None or not message.isVideo() or activity is None or chat is None
                or activity.getResources().getConfiguration().orientation != 1):
            return
        parent = chat.getParentLayout()
        listing = chat.getChatListView()
        if (parent is not None and parent.getLastFragment() == chat and listing is not None
                and listing.isAttachedToWindow() and 0 < listing.getWidth() < listing.getHeight()):
            viewport = self.capture_chat_layout_state(chat)
            if viewport is not None:
                key = message.getDialogId(), message.getId()
                self.opening_chat_viewport = (self.weak_reference(viewer), self.weak_reference(chat), key, viewport)

    def footer_active(self, viewer):
        row = self.lookup_row(self.background.get(viewer)) if self.active else None
        if row is None:
            return False
        compact = self.compact_control(viewer)
        return row.getVisibility() == 0 or (compact is not None and compact.getVisibility() == 0)

    def video_surface(self, viewer):
        if not self.active or self.edit_mode.getInt(viewer) or not viewer.isVisible():
            return False
        message = viewer.getCurrentMessageObject()
        if message is not None and message.isPhoto() and not message.isVideo():
            return False
        return self.has_player(viewer) or (message is not None and message.isVideo())

    def photo_surface(self, viewer):
        if not self.active or self.edit_mode.getInt(viewer) or not viewer.isVisible():
            return False
        message = viewer.getCurrentMessageObject()
        return message is not None and message.isPhoto() and not message.isVideo() and not message.isSponsored()

    def fullscreen_target(self, viewer):
        direction = auto_video_orientation(*self.viewer_video_dimensions(viewer))
        window = self.window.get(viewer)
        if direction is not None and window is not None and window.getWidth() > 0 and window.getHeight() > 0:
            horizontal = window.getWidth() > window.getHeight()
            if horizontal != (direction == SENSOR_LANDSCAPE):
                return direction
        return None

    def toggle_fullscreen(self, viewer):
        direction = self.fullscreen_target(viewer)
        if direction is None:
            if self.can_show_in_chat(viewer):
                self.header_menu.get(viewer).onItemClick(SHOW_IN_CHAT_MENU_ID)
            return
        activity = viewer.getParentActivity()
        if activity is None:
            return
        self.auto_processed = (self.weak_reference(viewer), self.current_media_key(viewer), True)
        self.axis_suspended = None
        self.lock_playback_axis(viewer, direction)
        self.call(viewer, "toggleActionBar", self.boolean(True), self.boolean(True))
        self.android.cancelRunOnUIThread(self.auto_hide_controls.get(viewer))
        window = self.window.get(viewer)
        if window is not None:
            window.requestLayout()

    def swipe_fullscreen(self, viewer, exiting):
        activity = viewer.getParentActivity()
        if activity is None:
            return
        self.auto_processed = (self.weak_reference(viewer), self.current_media_key(viewer), True)
        if exiting:
            self.axis_suspended = self.auto_processed[:2]
            lock = self.axis_lock
            if lock is not None and lock[0].get() == viewer:
                self.previous_native_orientation.setInt(viewer, lock[2])
                self.clear_playback_axis(viewer, restore_orientation=False)
            session = self.fullscreen_session
            if session is not None and session[0].get() == viewer:
                self.previous_native_orientation.setInt(viewer, session[2])
                self.close_fullscreen(viewer, restore_orientation=False)
            button = self.exit_fullscreen.get(viewer)
        else:
            self.axis_suspended = None
            self.clear_playback_axis(viewer)
            buttons = self.fullscreen.get(viewer)
            button = buttons[0] if buttons is not None and len(buttons) else None
        if button is not None and button.performClick() and not exiting and self.option("orientation"):
            activity.setRequestedOrientation(SENSOR_LANDSCAPE)

    def enter_fullscreen(self, viewer, activity, orientation, automatic=False):
        self.fullscreen_session = (self.weak_reference(viewer), self.weak_reference(activity),
                                   activity.getRequestedOrientation())
        self.automatic_fullscreen = automatic
        if orientation is not None:
            activity.setRequestedOrientation(orientation)
        self.call(viewer, "toggleActionBar", self.boolean(True), self.boolean(True))
        self.android.cancelRunOnUIThread(self.auto_hide_controls.get(viewer))
        window = self.window.get(viewer)
        if window is not None:
            window.requestLayout()

    def close_fullscreen(self, viewer, restore_orientation=True):
        session = self.fullscreen_session
        if session is None or session[0].get() != viewer:
            return False
        self.fullscreen_session = None
        self.automatic_fullscreen = False
        activity = session[1].get()
        if restore_orientation and activity is not None and activity.getRequestedOrientation() != session[2]:
            activity.setRequestedOrientation(session[2])
        return True

    def clear_playback_axis(self, viewer, restore_orientation=True):
        session = self.axis_lock
        if session is not None and session[0].get() == viewer:
            self.axis_lock = None
            activity = session[1].get()
            if restore_orientation and activity is not None and activity.getRequestedOrientation() == session[3]:
                activity.setRequestedOrientation(session[2])

    def release_video_orientation(self, viewer, keep_entry=False):
        self.stop_media_rotation(viewer)
        self.close_fullscreen(viewer)
        self.clear_playback_axis(viewer)
        if self.axis_target is not None and self.axis_target[0].get() == viewer:
            self.axis_target = None
            self.sensed_device_axis = None
        if self.axis_suspended is not None and self.axis_suspended[0].get() == viewer:
            self.axis_suspended = None
        if self.auto_processed is not None and self.auto_processed[0].get() == viewer:
            self.auto_processed = None
        if not keep_entry and self.auto_entry is not None and self.auto_entry[0].get() == viewer:
            self.auto_entry = None

    def after_video_size(self, param):
        ref = self.auto_viewer
        viewer = ref.get() if ref is not None else None
        if viewer is not None and viewer.getVideoPlayer() == param.thisObject:
            player, size = param.thisObject, param.args[0]
            if self.looper.myLooper() == self.ui_looper:
                self.check_auto_fullscreen(viewer, size)
            else:
                run_on_ui_thread(lambda: self.check_auto_fullscreen(viewer, size)
                                 if viewer.getVideoPlayer() == player else None)

    def after_prepare_video(self, param):
        viewer = param.thisObject
        self.hook_orientation_listener(viewer)
        player = viewer.getVideoPlayer()
        size = player.player.getVideoSize() if player is not None and player.player is not None else None
        self.check_auto_fullscreen(viewer, size)

    def hook_orientation_listener(self, viewer):
        if not self.option("orientation") or self.orientation_hooked:
            return
        listener = self.orientation_listener.get(viewer)
        if listener is not None:
            callback = method(listener.getClass(), "onOrientationChanged", 1)
            self.hooks.append(self.hook_method(callback, before=self.follow_device_orientation))
            self.orientation_hooked = True

    def follow_device_orientation(self, param):
        target = self.axis_target
        if not self.active or not self.option("orientation") or target is None:
            return
        ref, key, direction = target
        viewer = ref.get()
        if viewer is None or not viewer.isVisible() or self.orientation_listener.get(viewer) != param.thisObject:
            return
        param.setResult(None)
        if self.media_sensor is None:
            self.sensed_device_axis = device_orientation_axis(int(param.args[0]))
            self.apply_sensed_axis(viewer, self.sensed_device_axis)

    def start_media_rotation(self, viewer):
        if not self.option("orientation"):
            return
        session = self.media_sensor
        if session is not None and session[0].get() == viewer:
            return
        self.stop_media_rotation()
        activity = viewer.getParentActivity()
        if activity is None:
            return
        service = activity.getSystemService("sensor")
        if service is None:
            return
        manager = cast(self.sensor_manager, service)
        sensor = manager.getDefaultSensor(self.gravity_sensor) or manager.getDefaultSensor(self.accelerometer)
        if sensor is None:
            return
        viewer_ref = self.weak_reference(viewer)
        plugin = self

        class Listener(dynamic_proxy(plugin.sensor_listener)):
            def onSensorChanged(self, event):
                current = viewer_ref.get()
                if current is None or not current.isVisible():
                    plugin.stop_media_rotation(current)
                    return
                values = event.values
                plugin.sensed_device_axis = gravity_axis(values[0], values[1], values[2])
                plugin.apply_sensed_axis(current, plugin.sensed_device_axis)

            def onAccuracyChanged(self, sensor, accuracy):
                pass

        listener = Listener()
        if manager.registerListener(listener, sensor, self.sensor_manager.SENSOR_DELAY_NORMAL):
            self.media_sensor = (viewer_ref, manager, listener)

    def stop_media_rotation(self, viewer=None):
        session = getattr(self, "media_sensor", None)
        if session is not None and (viewer is None or session[0].get() == viewer):
            self.media_sensor = None
            self.sensed_device_axis = None
            session[1].unregisterListener(session[2])

    def apply_sensed_axis(self, viewer, actual):
        target = self.axis_target
        if target is None or target[0].get() != viewer or target[1] != self.current_media_key(viewer):
            return
        _, key, direction = target
        paused = self.axis_suspended
        if paused is not None and paused[0].get() == viewer and paused[1] == key:
            if actual is not None and actual != direction:
                self.axis_suspended = None
            return
        if actual == direction:
            self.lock_playback_axis(viewer, direction)

    def lock_playback_axis(self, viewer, direction):
        activity = viewer.getParentActivity()
        if (activity is None or activity.isFinishing()
                or (self.sdk >= 24 and activity.isInPictureInPictureMode())):
            return
        requested = activity.getRequestedOrientation()
        if requested == direction:
            return
        lock = self.axis_lock
        session = self.fullscreen_session
        if lock is not None and lock[0].get() == viewer:
            previous = lock[2]
        elif session is not None and session[0].get() == viewer:
            previous = session[2]
        elif self.native_fullscreen_mode.getInt(viewer) != 0:
            previous = self.previous_native_orientation.getInt(viewer)
        else:
            previous = requested
        if session is not None and session[0].get() == viewer:
            self.close_fullscreen(viewer, restore_orientation=False)
        self.axis_lock = (self.weak_reference(viewer), self.weak_reference(activity), previous, direction)
        activity.setRequestedOrientation(direction)

    def check_auto_fullscreen(self, viewer, size=None):
        if (not self.active or not viewer.isVisible()
                or (self.pending_chat_jump is not None and self.pending_chat_jump[0].get() == viewer)
                or (getattr(self, "library_resume", None) is not None and self.library_resume.viewer == viewer)
                or not (self.option("auto_fullscreen") or self.option("orientation"))):
            return
        message = viewer.getCurrentMessageObject()
        photo = self.photo_surface(viewer)
        key = self.current_media_key(viewer)
        entry = self.auto_entry
        if entry is None or entry[0].get() != viewer:
            if message is None:
                return
            entry = self.auto_entry = (self.weak_reference(viewer), key, False)
        if not entry[2] and entry[1] != key:
            entry = self.auto_entry = (entry[0], entry[1], True)
        apply_immediately = self.option("auto_fullscreen") and (
            self.option("auto_fullscreen_on_switch") if entry[2] else not photo)
        activity = viewer.getParentActivity()
        if (message is None or (not photo and not message.isVideo()) or message.isSponsored() or activity is None
                or self.edit_mode.getInt(viewer)
                or (self.sdk >= 24 and activity.isInPictureInPictureMode()) or activity.isFinishing()):
            if self.automatic_fullscreen and apply_immediately:
                self.release_video_orientation(viewer, keep_entry=True)
            else:
                self.stop_media_rotation(viewer)
                self.axis_target = None
                if self.auto_processed is not None and self.auto_processed[0].get() == viewer:
                    self.auto_processed = None
            return
        self.start_media_rotation(viewer)
        self.auto_viewer = self.weak_reference(viewer)
        previous = self.auto_processed
        same_video = previous is not None and previous[0].get() == viewer and previous[1] == key
        if same_video and (size is None or previous[2]):
            return
        width, height, from_player = self.photo_dimensions(viewer, message) if photo else self.video_dimensions(message, size)
        if width <= 0 or height <= 0:
            self.axis_target = None
            return
        session = self.fullscreen_session
        self.auto_processed = (self.auto_viewer, key, from_player)
        direction = auto_video_orientation(width, height)
        self.axis_target = (self.auto_viewer, key, direction) if direction is not None else None
        if direction is None:
            if apply_immediately and same_video and self.automatic_fullscreen:
                self.close_fullscreen(viewer)
            return
        window = self.window.get(viewer)
        horizontal = window is not None and window.getWidth() > window.getHeight()
        if not apply_immediately or (session is not None and session[0].get() == viewer and not self.automatic_fullscreen):
            if self.option("orientation"):
                actual = getattr(self, "sensed_device_axis", None)
                if actual == direction:
                    self.apply_sensed_axis(viewer, actual)
                elif horizontal == (direction == SENSOR_LANDSCAPE):
                    self.lock_playback_axis(viewer, direction)
            return
        if direction == SENSOR_LANDSCAPE:
            if not horizontal and (session is None or session[0].get() != viewer):
                self.clear_playback_axis(viewer)
                self.enter_fullscreen(viewer, activity, SENSOR_LANDSCAPE, automatic=True)
            elif self.option("orientation"):
                self.lock_playback_axis(viewer, direction)
        elif self.option("orientation") or horizontal:
            self.lock_playback_axis(viewer, direction)

    def video_dimensions(self, message, size):
        if size is not None and size.width > 0 and size.height > 0:
            width, height = size.width * float(size.pixelWidthHeightRatio), size.height
            if size.unappliedRotationDegrees in (90, 270):
                width, height = height, width
            return width, height, True
        document = message.getDocument() if message is not None else None
        attributes = document.attributes if document is not None else None
        if attributes is not None:
            for index in range(attributes.size()):
                attribute = attributes.get(index)
                if self.video_attribute.isInstance(attribute):
                    return attribute.w, attribute.h, False
        return 0, 0, False

    def photo_dimensions(self, viewer, message):
        photo = message.getPhoto()
        if photo is not None:
            size = self.file_loader.getClosestPhotoSizeWithSize(photo.sizes, self.android.getPhotoSize())
            if size is not None and size.w > 0 and size.h > 0:
                return size.w, size.h, True
        receiver = self.center_image.get(viewer)
        if receiver is not None and receiver.hasBitmapImage():
            return receiver.getBitmapWidth(), receiver.getBitmapHeight(), True
        return 0, 0, False

    def wide_video(self, viewer):
        width, height = self.viewer_video_dimensions(viewer)
        return auto_video_orientation(width, height) == SENSOR_LANDSCAPE

    def viewer_video_dimensions(self, viewer):
        if self.video_size_set.getBoolean(viewer):
            width, height = self.video_width.getInt(viewer), self.video_height.getInt(viewer)
            if width > 0 and height > 0:
                return width, height
        width, height, _ = self.video_dimensions(viewer.getCurrentMessageObject(), None)
        if width > 0 and height > 0:
            return width, height
        image = self.center_image.get(viewer)
        return (image.getImageWidth(), image.getImageHeight()) if image is not None else (0, 0)

    def hide_center_draw(self, param):
        state = self.progress_state.getInt(param.thisObject)
        if state not in PLAY_STATES:
            return
        viewer = self.progress_outer.get(param.thisObject)
        if self.center_progress.get(viewer)[0] == param.thisObject and self.footer_active(viewer):
            param.setResult(None)

    def hide_center_accessibility(self, viewer):
        if self.footer_active(viewer):
            overlay = self.accessibility.get(viewer)
            if overlay is not None:
                overlay.setVisibility(4)

    def center_tap(self, param):
        viewer, event = param.thisObject, param.args[0]
        if not self.footer_active(viewer) or self.discard_tap.getBoolean(viewer):
            return
        message = viewer.getCurrentMessageObject()
        if message is not None and message.isSponsored():
            return
        radius = self.dp(50)
        if (abs(event.getX() - int(self.call(viewer, "getContainerViewWidth")) / 2) <= radius
                and abs(event.getY() - int(self.call(viewer, "getContainerViewHeight")) / 2) <= radius):
            self.call(viewer, "toggleActionBar", self.boolean(not self.action_bar_visible.getBoolean(viewer)),
                      self.boolean(True))
            param.setResult(self.boolean(True))

    def defer_video_single_tap(self, param):
        if self.video_surface(param.thisObject):
            param.setResult(self.boolean(False))

    def before_native_double_tap(self, param):
        viewer, event = param.thisObject, param.args[0]
        if not self.video_surface(viewer):
            return
        action = double_tap_action(event.getX(), int(self.call(viewer, "getContainerViewWidth")))
        if action == "play":
            if self.option("double_tap"):
                self.on_button(self.weak_reference(viewer), "play")
                container = self.viewer_container.get(viewer)
                if container is not None and self.has_player(viewer):
                    container.performHapticFeedback(self.haptic.CLOCK_TICK)
                param.setResult(self.boolean(True))
        elif self.option("double_tap_seek") and self.has_player(viewer):
            target = self.double_tap_target(viewer, action)
            if target is not None:
                position, duration, delta = target
                container = self.viewer_container.get(viewer)
                drawable = self.seek_animation.get(viewer)
                if drawable is not None:
                    self.seek_visual = (self.weak_reference(drawable), self.weak_reference(container))
                    drawable.setOneShootAnimation(True)
                    drawable.setLeftSide(action == "back")
                    drawable.addTime(delta)
                self.call(viewer, "seekVideoOrWebTo", self.long(position))
                container.performHapticFeedback(self.haptic.CLOCK_TICK)
                container.invalidate()
                seek, seek_view = self.video_seek.get(viewer), self.video_seek_view.get(viewer)
                if seek is not None and seek_view is not None:
                    seek.setProgress(jfloat(position / duration), True)
                    seek_view.invalidate()
            param.setResult(self.boolean(True))

    def before_seek_visual_draw(self, param):
        self.seek_visual_stack.append(None)
        drawable = param.thisObject
        if (self.seek_visual is None or self.seek_visual[0].get() != drawable
                or not self.seek_visual_one_shot.getBoolean(drawable)):
            return
        container = self.seek_visual[1].get()
        if container is None:
            return
        width, height = container.getWidth(), container.getHeight()
        if width <= 0 or height <= 0:
            return
        canvas = param.args[0]
        self.seek_visual_stack[-1] = (canvas, canvas.save())
        seconds = self.seek_visual_time.getLong(drawable) // 1000
        progress = self.seek_visual_progress.getFloat(drawable)
        opacity = max(0.0, min(1.0, progress / 0.22, (1.0 - progress) / 0.27))
        if opacity > 0 and seconds > 0:
            left = self.seek_visual_left.getBoolean(drawable)
            oval, text_x, y, depth = seek_edge_geometry(width, height, self.dp, left)
            canvas.clipRect(0, 0, width, height)
            self.seek_visual_rect.set(*oval)
            self.seek_visual_bg.setAlpha(round(60 * opacity))
            canvas.drawOval(self.seek_visual_rect, self.seek_visual_bg)
            label = f"{seconds}S"
            text = self.seek_visual_text
            size = float(self.dp(13))
            text.setTextSize(size)
            label_width = text.measureText(label)
            if label_width > depth - self.dp(8):
                text.setTextSize(size * max(1.0, depth - self.dp(8)) / label_width)
            text.setAlpha(round(255 * opacity))
            canvas.drawText(label, text_x, y - (text.ascent() + text.descent()) / 2, text)
        # The drawable still advances its native timing and handles repeated taps.
        canvas.clipRect(0, 0, 0, 0)

    def after_seek_visual_draw(self, param):
        saved = self.seek_visual_stack.pop()
        if saved is not None:
            canvas, depth = saved
            canvas.restoreToCount(depth)

    def before_can_double_tap_seek(self, param):
        viewer, event = param.thisObject, param.args[0]
        if self.option("double_tap_seek") and self.video_surface(viewer) and self.has_player(viewer):
            action = double_tap_action(event.getX(), int(self.call(viewer, "getContainerViewWidth")))
            if action != "play":
                param.setResult(self.boolean(self.double_tap_target(viewer, action) is not None))

    def double_tap_target(self, viewer, action):
        current = int(self.call(viewer, "getCurrentVideoPosition"))
        duration = int(self.call(viewer, "getVideoDuration"))
        if current < 0 or duration <= 0:
            return None
        seconds = getattr(self, "double_tap_seconds", DEFAULT_DOUBLE_TAP_SECONDS)
        delta = seconds * 1000
        target = max(0, min(duration, current + (delta if action == "forward" else -delta)))
        return (target, duration, delta) if target != current else None

    def before_touch(self, param):
        viewer = param.thisObject
        override = (self.option("pinch") and param.args[0].getPointerCount() > 1
                    and self.video_surface(viewer) and not self.can_zoom.getBoolean(viewer))
        self.touch_stack.append(override)
        if override:
            self.can_zoom.setBoolean(viewer, True)

    def after_touch(self, param):
        if self.touch_stack.pop():
            self.can_zoom.setBoolean(param.thisObject, False)
        if param.args[0].getPointerCount() > 1 or param.args[0].getActionMasked() in (1, 3):
            self.refresh_zoom(param.thisObject)

    def route_video_touch(self, param):
        window, event = param.thisObject, param.args[0]
        viewer = self.window_outer.get(window)
        action = event.getActionMasked()
        if action in (0, 1, 3, 5):
            self.swipe_tick_pending = None
        if self.route_thumbnail_touch(viewer, window, event, action):
            param.setResult(self.boolean(True))
            return
        if self.route_speed_touch(param, window, viewer, event, action):
            return
        if self.route_swipe(param, window, viewer, event, action):
            caption = self.top_caption(viewer)
            if caption is not None:
                caption.touch = None
            return
        if self.route_caption_touch(param, window, viewer, event, action):
            self.swipe = None
            return
        if action == 0:
            self.pinch_window = None
        if self.pinch_window is None:
            if (action != 5 or event.getPointerCount() != 2 or not self.option("pinch")
                    or not self.video_surface(viewer)):
                return
            self.cancel_child_touch(param, window, event)
            self.pinch_window = self.weak_reference(window)
        if self.pinch_window.get() != window:
            return
        self.touch_method.invoke(viewer, self.arguments([event]))
        if action in (1, 3):
            self.pinch_window = None
        param.setResult(self.boolean(True))

    def route_speed_touch(self, param, window, viewer, event, action):
        if action == 0:
            self.restore_held_speed()
            self.speed_press = None
            if self.option("hold_speed") and self.video_surface(viewer):
                x, y = event.getX(), event.getY()
                if self.hits_playback_area(viewer, window, x, y):
                    self.speed_press = (viewer, x, y)
            return False
        hold = self.speed_hold
        if hold is not None and hold[0] == viewer:
            param.setResult(self.boolean(True))
            if not hold[3]:
                self.speed_hold = (*hold[:3], True)
                self.cancel_child_touch(param, window, event)
            if action != 2 or event.getPointerCount() != 1:
                self.restore_held_speed(viewer)
            return True
        press = self.speed_press
        if press is not None and (action != 2
                or max(abs(event.getX() - press[1]), abs(event.getY() - press[2])) > self.dp(8)):
            self.speed_press = None
        return False

    def hits_playback_area(self, viewer, window, x, y):
        top, bottom = self.video_swipe_bounds(viewer, window)
        caption = self.top_caption(viewer)
        return (0 <= x < window.getWidth() and top <= y < bottom
                and not self.hits_caption(viewer, window, x, y)
                and not self.hits_caption_button(caption, window, x, y))

    def start_held_speed(self, param):
        viewer, press = param.thisObject, self.speed_press
        if not self.option("hold_speed") or not self.video_surface(viewer):
            return
        # This native callback only starts the old rewinder.
        param.setResult(None)
        if press is None or press[0] != viewer:
            return
        self.speed_press = None
        player = viewer.getVideoPlayer()
        engine = player.player if player is not None else None
        if engine is None:
            return
        original = engine.getPlaybackParameters()
        speed = getattr(self, "hold_speed", DEFAULT_HOLD_SPEED)
        engine.setPlaybackParameters(self.playback_parameters(jfloat(speed), original.pitch))
        self.speed_hold = (viewer, engine, original, False)
        self.swipe = None
        self.swipe_tick_pending = None
        self.viewer_container.get(viewer).performHapticFeedback(self.haptic.LONG_PRESS)
        self.show_level_hud(viewer, "speed", speed)

    def restore_held_speed(self, viewer=None):
        hold = self.speed_hold
        if hold is not None and (viewer is None or hold[0] == viewer):
            self.speed_hold = None
            hold[1].setPlaybackParameters(hold[2])
            if self.level_hud is not None and self.level_hud[1] == "speed":
                self.hide_level_hud()

    def cancel_child_touch(self, param, window, event):
        cancel = self.motion.obtain(event)
        try:
            cancel.setAction(3)
            self.bridge.invokeOriginalMethod(param.method, window, self.arguments([cancel]))
        finally:
            cancel.recycle()

    def route_swipe(self, param, window, viewer, event, action):
        if action == 0:
            self.swipe = None
            self.swipe_haptic_step = None
            if not self.video_surface(viewer):
                return False
            x, y = event.getX(), event.getY()
            zone = {"back": "brightness", "play": "fullscreen", "forward": "volume"}[
                double_tap_action(x, window.getWidth())]
            top, bottom = self.video_swipe_bounds(viewer, window)
            if not top <= y < bottom or (zone == "fullscreen" and self.hits_caption(viewer, window, x, y)):
                return False
            if self.hits_caption_button(self.top_caption(viewer), window, x, y):
                return False
            if self.option(zone + "_swipe"):
                horizontal = window.getWidth() > window.getHeight()
                self.swipe = (x, y, zone, horizontal, False, None)
            return False
        if self.swipe is None:
            return False
        x, y, zone, full, captured, initial = self.swipe
        if event.getPointerCount() != 1:
            self.swipe = None
            self.swipe_tick_pending = None
            self.hide_level_hud()
            return False
        dx, dy = event.getX() - x, event.getY() - y
        volume_anchor = False
        if action == 2 and not captured:
            threshold = self.dp(12 if zone == "fullscreen" else 9)
            if vertical_swipe(dx, dy, threshold):
                self.swipe = (x, y, zone, full, True, None)
                captured = True
                param.setResult(self.boolean(True))
                self.cancel_child_touch(param, window, event)
                if zone != "fullscreen":
                    initial = self.get_adjustment(viewer, window, zone)
                    if initial is not None:
                        self.swipe_haptic_step = self.adjustment_step(initial)
                if zone == "volume":
                    y = event.getY()
                    dy = 0.0
                    volume_anchor = True
                self.swipe = (x, y, zone, full, True, initial)
            elif abs(dx) >= threshold and abs(dx) >= abs(dy):
                self.swipe = None
        elif captured:
            param.setResult(self.boolean(True))
        if captured and zone != "fullscreen" and action in (1, 2) and initial is None:
            initial = self.get_adjustment(viewer, window, zone)
            if initial is not None:
                self.swipe_haptic_step = self.adjustment_step(initial)
                if zone == "volume":
                    y = event.getY()
                    dy = 0.0
                    volume_anchor = True
                self.swipe = (x, y, zone, full, True, initial)
        if captured and zone != "fullscreen" and action in (1, 2) and initial is not None:
            height = window.getHeight()
            if zone == "volume":
                height = min(height, self.dp(400))
            level = swipe_level(initial, dy, height, 0.0)
            applied = initial if volume_anchor else self.set_adjustment(viewer, window, zone, level)
            if applied is not None:
                step = self.adjustment_step(level if zone == "volume" else applied)
                if step != self.swipe_haptic_step:
                    self.swipe_haptic_step = step
                    if action == 2:
                        self.request_adjustment_tick(window)
                self.show_level_hud(viewer, zone, applied)
        if action in (1, 3):
            self.swipe = None
            if (captured and zone == "fullscreen" and action == 1
                    and fullscreen_swipe(dx, dy, full, self.dp(34)) and (full or self.wide_video(viewer))):
                self.swipe_fullscreen(viewer, full)
            if zone != "fullscreen":
                self.hide_level_hud(delay=650 if captured and action == 1 else 0)
        return captured

    def configure_adjustment_ticks(self, rate, percent, strength=DEFAULT_ADJUSTMENT_TICK_STRENGTH):
        rate = adjustment_tick_value(rate, DEFAULT_ADJUSTMENT_TICK_RATE, 0, 30)
        strength = adjustment_tick_value(strength, DEFAULT_ADJUSTMENT_TICK_STRENGTH, 0, 100)
        previous_strength = getattr(self, "adjustment_tick_strength", None)
        self.adjustment_tick_interval_ms = (1000 + rate - 1) // rate if rate else 0
        self.adjustment_tick_percent = adjustment_tick_value(percent, DEFAULT_ADJUSTMENT_TICK_PERCENT, 1, 100)
        self.adjustment_tick_strength = strength
        if not rate or not strength:
            self.swipe_tick_pending = None
        if previous_strength != strength and hasattr(self, "soft_adjustment_tick"):
            self.soft_adjustment_tick = self.create_soft_adjustment_tick()

    def adjustment_step(self, level):
        return int(level * 100 / self.adjustment_tick_percent + 0.5)

    def request_adjustment_tick(self, window):
        if self.adjustment_tick_interval_ms and self.adjustment_tick_strength and self.swipe_tick_pending is None:
            token = self.swipe_tick_pending = object()
            self.emit_adjustment_tick(window, token)

    def emit_adjustment_tick(self, window, token):
        if self.swipe_tick_pending is not token:
            return
        if not self.active or self.swipe is None or not self.adjustment_tick_interval_ms or not self.adjustment_tick_strength:
            self.swipe_tick_pending = None
            return
        now = self.adjustment_clock.uptimeMillis()
        last = self.last_swipe_haptic_ms
        wait = last + self.adjustment_tick_interval_ms - now if last is not None else 0
        if wait > 0:
            run_on_ui_thread(lambda: self.emit_adjustment_tick(window, token), wait)
            return
        self.swipe_tick_pending = None
        self.last_swipe_haptic_ms = now
        self.play_adjustment_tick(window)

    def create_soft_adjustment_tick(self):
        if self.sdk < 26 or not self.adjustment_tick_strength:
            return None
        try:
            context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            if context is None or context.checkSelfPermission("android.permission.VIBRATE") != 0:
                return None
            vibrator = cast(jclass("android.os.Vibrator"), context.getSystemService("vibrator"))
            if vibrator is None:
                return None
            effects = jclass("android.os.VibrationEffect")
            strength = self.adjustment_tick_strength / 100.0
            effect = None
            if self.sdk >= 31:
                primitive = jclass("android.os.VibrationEffect$Composition").PRIMITIVE_LOW_TICK
                if vibrator.areAllPrimitivesSupported(self.positions([primitive])):
                    effect = effects.startComposition().addPrimitive(primitive, jfloat(strength)).compose()
            if effect is None:
                if not vibrator.hasAmplitudeControl():
                    return None
                amplitude = max(1, round(strength ** 2 * 255))
                effect = effects.createOneShot(12, amplitude)
            if self.sdk >= 33:
                attributes = jclass("android.os.VibrationAttributes")
                usage = attributes.createForUsage(attributes.USAGE_TOUCH)
            else:
                attributes = jclass("android.media.AudioAttributes")
                builder = jclass("android.media.AudioAttributes$Builder")()
                usage = builder.setUsage(attributes.USAGE_ASSISTANCE_SONIFICATION).build()
            return vibrator, effect, usage
        except Exception:
            return None

    def play_adjustment_tick(self, window):
        if self.soft_adjustment_tick is None:
            window.performHapticFeedback(self.slider_tick())
            return
        if (window.isHapticFeedbackEnabled()
                and self.setting_system.getInt(window.getContext().getContentResolver(), "haptic_feedback_enabled", 1)):
            vibrator, effect, attributes = self.soft_adjustment_tick
            vibrator.vibrate(effect, attributes)

    def video_swipe_bounds(self, viewer, window):
        top, bottom = self.dp(12), window.getHeight() - self.dp(12)
        if self.action_bar_visible.getBoolean(viewer):
            bar, controls = self.action_bar.get(viewer), self.controls.get(viewer)
            if bar is not None and bar.getHeight() > 0 and bar.getParent() is not None:
                top = max(top, self.view_origin(bar, window)[1] + bar.getHeight())
            if (controls is not None and controls.getVisibility() == 0 and controls.getHeight() > 0
                    and controls.getParent() is not None):
                controls_top = self.view_origin(controls, window)[1]
                if controls_top > top:
                    bottom = min(bottom, controls_top)
        return top, bottom

    def view_origin(self, view, window):
        origin, window_origin = self.positions([0, 0]), self.positions([0, 0])
        view.getLocationInWindow(origin)
        window.getLocationInWindow(window_origin)
        return origin[0] - window_origin[0], origin[1] - window_origin[1]

    def hits_view(self, view, window, x, y):
        if view.getVisibility() != 0 or view.getAlpha() <= 0.1 or view.getParent() is None:
            return False
        left, top = self.view_origin(view, window)
        return left <= x < left + view.getWidth() and top <= y < top + view.getHeight()

    def hits_caption(self, viewer, window, x, y):
        entry = self.top_caption(viewer)
        return (entry is not None and entry.scroll is not None
                and self.hits_view(entry.scroll, window, x, y)
                and self.caption_text_at(entry, window, x, y))

    def hits_caption_button(self, entry, window, x, y):
        button = entry.button if entry is not None else None
        if button is None or button.getVisibility() != 0 or button.getAlpha() <= 0.1 or button.getParent() is None:
            return False
        left, top = self.view_origin(button.getParent(), window)
        left, top = left + button.getX(), top + button.getY()
        return left <= x < left + button.getWidth() and top <= y < top + button.getHeight()

    def blank_caption_at(self, viewer, entry, window, x, y):
        bar = self.action_bar.get(viewer)
        if (y < self.view_origin(bar, window)[1] + bar.getHeight()
                or not self.hits_view(entry.shade, window, x, y)
                or self.hits_caption_button(entry, window, x, y)):
            return False
        return (entry.scroll is None or not self.hits_view(entry.scroll, window, x, y)
                or not self.caption_text_at(entry, window, x, y))

    def route_caption_touch(self, param, window, viewer, event, action):
        entry = self.top_caption(viewer)
        if entry is None:
            return False
        if action == 0:
            entry.touch = None
            entry.arrow_pressed = False
            if self.action_bar_visible.getBoolean(viewer):
                x, y = event.getX(), event.getY()
                if self.hits_caption_button(entry, window, x, y):
                    entry.arrow_pressed = True
                    param.setResult(self.boolean(True))
                    return True
                blank = self.blank_caption_at(viewer, entry, window, x, y)
                collapsed = entry.has_more and not entry.expanded and self.hits_caption(viewer, window, x, y)
                if blank or collapsed:
                    entry.touch = (x, y, blank, collapsed, False)
            return False
        if entry.arrow_pressed:
            if action in (1, 3):
                entry.arrow_pressed = False
                if action == 1 and self.hits_caption_button(entry, window, event.getX(), event.getY()):
                    entry.button.performClick()
            param.setResult(self.boolean(True))
            return True
        if entry.touch is None:
            return False
        if event.getPointerCount() != 1:
            entry.touch = None
            return False
        x, y, blank, collapsed, captured = entry.touch
        dx, dy = event.getX() - x, event.getY() - y
        if action == 2 and not captured:
            if collapsed and vertical_swipe(dx, dy, self.dp(10)):
                self.cancel_child_touch(param, window, event)
                captured = True
                entry.touch = (x, y, blank, collapsed, True)
            elif max(abs(dx), abs(dy)) > self.dp(10):
                entry.touch = None
        if (action == 1 and not captured and blank and max(abs(dx), abs(dy)) <= self.dp(8)
                and event.getEventTime() - event.getDownTime() < self.tap_timeout
                and self.action_bar_visible.getBoolean(viewer)
                and self.blank_caption_at(viewer, entry, window, event.getX(), event.getY())):
            self.cancel_child_touch(param, window, event)
            self.call(viewer, "toggleActionBar", self.boolean(False), self.boolean(True))
            captured = True
        if action in (1, 3):
            entry.touch = None
        if captured:
            param.setResult(self.boolean(True))
        return captured

    def toggle_caption(self, viewer):
        entry = self.top_caption(viewer)
        if entry is None or not entry.has_more or not self.action_bar_visible.getBoolean(viewer):
            return
        entry.expanded = not entry.expanded
        entry.scroll.stopScrolling()
        entry.reset_scroll_on_measure = True
        self.update_caption_button(entry)
        entry.scroll.requestLayout()
        if entry.expanded:
            self.android.cancelRunOnUIThread(self.auto_hide_controls.get(viewer))
        else:
            self.call(viewer, "scheduleActionBarHide")

    def caption_text_at(self, entry, window, x, y):
        text = entry.switcher.getCurrentView()
        layout = text.getLayout() if text is not None else None
        if layout is None or not layout.getLineCount():
            return False
        left, top = self.view_origin(text, window)
        tx = x - left + text.getScrollX() - text.getTotalPaddingLeft()
        ty = y - top + text.getScrollY() - text.getTotalPaddingTop()
        if not 0 <= ty < layout.getHeight():
            return False
        line = layout.getLineForVertical(int(ty))
        return layout.getLineLeft(line) <= tx < layout.getLineRight(line)

    def get_adjustment(self, viewer, window, zone):
        if zone == "volume":
            manager = self.media_audio_manager(window)
            if manager is None:
                return None
            low, high = self.media_volume_limits(manager)
            return (manager.getStreamVolume(self.music_stream) - low) / (high - low) if high > low else None
        params = self.window_params.get(viewer)
        if params is None or window.getParent() is None:
            return None
        if params.screenBrightness >= 0:
            return float(params.screenBrightness)
        settings = self.setting_system
        value = settings.getInt(window.getContext().getContentResolver(), settings.SCREEN_BRIGHTNESS, 128)
        return max(0, min(255, value)) / 255

    def set_adjustment(self, viewer, window, zone, level):
        if zone == "volume":
            return self.set_media_volume(viewer, window, level)
        params = self.window_params.get(viewer)
        activity = viewer.getParentActivity()
        if params is None or activity is None or window.getParent() is None:
            return None
        original = params.screenBrightness
        if original == level:
            return level
        session = self.brightness_session
        if session is not None and session[1].get() != window:
            self.restore_brightness()
            session = None
        params.screenBrightness = jfloat(level)
        try:
            activity.getWindowManager().updateViewLayout(window, params)
        except Exception:
            params.screenBrightness = original
            return None
        if session is None:
            self.brightness_session = (self.weak_reference(viewer), self.weak_reference(window), original)
        return level

    def before_image_index(self, param):
        viewer = param.thisObject
        if int(param.args[0]) != viewer.getCurrentIndex():
            self.speed_press = None
            self.restore_held_speed(viewer)
            self.hide_level_hud()
            self.swipe = None

    def after_image_index(self, param):
        viewer = param.thisObject
        if getattr(self, "library_preview", None) is not None and viewer.isVisible():
            self.stop_library_preview()
        if self.option("video_toolbar") and self.photo_surface(viewer):
            self.clear_video_controls_on_photo(viewer)
        self.refresh_zoom(viewer)
        self.check_auto_fullscreen(viewer)
        container = self.viewer_container.get(viewer)
        if self.option("album_thumbnails") and container is not None:
            rail = getattr(self, "thumbnail_rail", None)
            if rail is not None and rail.viewer == viewer and bool(param.args[3]):
                rail.dirty = True
            container.requestLayout()

    def clear_video_controls_on_photo(self, viewer):
        controls = self.controls.get(viewer)
        if controls is None or controls.getVisibility() == 8:
            return
        animator = self.video_controls_animator.get(viewer)
        if animator is not None:
            animator.cancel()
        self.call(viewer, "setVideoPlayerControlVisible", self.boolean(False), self.boolean(False))
        controls.setAlpha(0.0)
        controls.setVisibility(8)

    def current_media_key(self, viewer):
        message = viewer.getCurrentMessageObject()
        if message is not None:
            return message.getDialogId(), message.getId()
        return (viewer.getCurrentIndex(),)

    def before_player_release(self, param):
        self.speed_press = None
        self.restore_held_speed(param.thisObject)

    def media_audio_manager(self, window):
        service = window.getContext().getSystemService("audio")
        return cast(self.audio_manager_type, service) if service is not None else None

    def media_volume_limits(self, manager):
        stream = self.music_stream
        minimum = manager.getStreamMinVolume(stream) if self.sdk >= 28 else 0
        return minimum, manager.getStreamMaxVolume(stream)

    def set_media_volume(self, viewer, window, level):
        manager = self.media_audio_manager(window)
        if manager is None:
            return None
        low, high = self.media_volume_limits(manager)
        if high <= low:
            return None
        session = self.volume_session
        if session is not None and session[0].get() != viewer:
            self.restore_volume()
        stream = self.music_stream
        old = manager.getStreamVolume(stream)
        target = low + int(level * (high - low) + 0.5)
        if target != old and not manager.isVolumeFixed():
            try:
                manager.setStreamVolume(stream, target, 0)
            except Exception as error:
                self.log(f"Media volume: {type(error).__name__}")
                return None
            applied = manager.getStreamVolume(stream)
            if applied != old and self.volume_session is None:
                self.volume_session = (self.weak_reference(viewer), manager, old)
        else:
            applied = old
        return (applied - low) / (high - low)

    def restore_volume(self, viewer=None):
        session = self.volume_session
        if session is None or (viewer is not None and session[0].get() != viewer):
            return
        self.volume_session = None
        _, manager, original = session
        if manager.getStreamVolume(self.music_stream) != original:
            try:
                manager.setStreamVolume(self.music_stream, original, 0)
            except Exception as error:
                self.log(f"Restore media volume: {type(error).__name__}")

    def restore_brightness(self, viewer=None):
        session = self.brightness_session
        if session is None or (viewer is not None and session[0].get() != viewer):
            return
        self.brightness_session = None
        owner, window = session[0].get(), session[1].get()
        if owner is None:
            return
        params = self.window_params.get(owner)
        if params is None:
            return
        params.screenBrightness = jfloat(session[2])
        activity = owner.getParentActivity()
        if activity is not None and window is not None and window.getParent() is not None:
            try:
                activity.getWindowManager().updateViewLayout(window, params)
            except Exception:
                pass

    def leave_adjustments(self, viewer):
        self.finish_status_slide(viewer, True)
        self.speed_press = None
        self.restore_held_speed(viewer)
        self.restore_volume(viewer)
        self.restore_brightness(viewer)
        self.swipe = None
        self.swipe_tick_pending = None
        if self.level_hud is not None and self.level_hud[0].get() == viewer:
            self.remove_level_hud()

    def leave_viewer(self, viewer):
        if self.hidden_return_preview is not None and self.hidden_return_preview == self.seek_preview.get(viewer):
            self.restore_return_seek_preview()
        if self.pending_chat_jump is not None and self.pending_chat_jump[0].get() == viewer:
            self.pending_chat_jump = None
        if self.pending_sidebar_chat is not None and self.pending_sidebar_chat[0].get() == viewer:
            self.pending_sidebar_chat = None
        opening = self.opening_chat_viewport
        if opening is not None and opening[0].get() == viewer:
            self.opening_chat_viewport = None
        self.clear_caption_exit(viewer)
        caption = self.inherited_caption
        if caption is not None and caption[0] == viewer:
            self.inherited_caption = None
        self.leave_adjustments(viewer)
        self.clear_thumbnail_preload(viewer)
        self.remove_thumbnail_rail(viewer)
        self.thumbnail_failure = None
        self.release_video_orientation(viewer)
        self.restore_landscape_header(viewer)
        self.restore_header_buttons(viewer)
        self.restore_top_caption(viewer)
        self.prepare_photo_header(viewer, self.viewer_container.get(viewer), False)

    def show_level_hud(self, viewer, zone, level):
        container = self.viewer_container.get(viewer)
        if container is None or container.getHeight() <= 0:
            return
        speed = zone == "speed"
        hud = self.level_hud
        if hud is None or hud[0].get() != viewer or hud[1] != zone or hud[5] != container:
            self.remove_level_hud()
            context = container.getContext()
            card = self.frame_layout(context)
            card.setImportantForAccessibility(2)
            card.setBackground(self.round_background(0xA3212429 - (1 << 32), 18))
            icon = self.image_view(context)
            glyph = {"brightness": self.drawable.msg_brightness_high, "volume": self.drawable.baseline_volume_up_24,
                     "speed": self.drawable.msg_speed}[zone]
            icon.setImageResource(glyph)
            icon.setColorFilter(jint(0xE6FFFFFF - (1 << 32)))
            icon.setScaleType(self.fit_center)
            params = self.frame_params(self.dp(19), self.dp(19), 19)
            params.leftMargin = self.dp(11)
            card.addView(icon, params)
            fill = None
            if not speed:
                track = self.frame_layout(context)
                track.setBackground(self.round_background(0x35FFFFFF, 4))
                params = self.frame_params(self.dp(86), self.dp(5), 19)
                params.leftMargin = self.dp(41)
                card.addView(track, params)
                fill = self.view_type(context)
                fill.setBackground(self.round_background(0xC7FFFFFF - (1 << 32), 4))
                fill.setPivotX(0.0)
                track.addView(fill, self.frame_params(-1, -1, 3))
            value = self.text_view(context)
            value.setTextSize(12)
            value.setGravity(17)
            value.setTextColor(WHITE)
            params = self.frame_params(self.dp(56 if speed else 39), -1, 21)
            params.rightMargin = self.dp(5)
            card.addView(value, params)
            container.getOverlay().add(card)
            hud = self.level_hud = (self.weak_reference(viewer), zone, card, fill, value, container)
        self.hud_generation += 1
        _, _, card, fill, value, _ = hud
        width, height = self.dp(98 if speed else 174), self.dp(36)
        x = (container.getWidth() - width) // 2
        insets = container.getRootWindowInsets()
        top = (insets.getStableInsetTop() if insets is not None else 0) + self.dp(12)
        card.animate().cancel()
        card.setAlpha(1.0)
        card.setVisibility(0)
        exact = self.measure_spec.EXACTLY
        card.measure(self.measure_spec.makeMeasureSpec(width, exact), self.measure_spec.makeMeasureSpec(height, exact))
        card.layout(x, top, x + width, top + height)
        if fill is not None:
            fill.setScaleX(float(level))
        value.setText(f"{level:g}×" if speed else f"{round(level * 100)}%")

    def hide_level_hud(self, delay=0):
        self.hud_generation += 1
        generation = self.hud_generation
        if self.level_hud is None:
            return
        card = self.level_hud[2]
        if not delay:
            card.animate().cancel()
            card.setVisibility(8)
            return

        def fade():
            if generation == self.hud_generation:
                card.animate().alpha(0.0).setDuration(150).start()

        run_on_ui_thread(fade, delay)

    def remove_level_hud(self):
        self.hide_level_hud()
        if self.level_hud is not None:
            _, _, card, _, _, container = self.level_hud
            container.getOverlay().remove(card)
            self.level_hud = None

    def refresh_zoom(self, viewer):
        self.zoom_buttons = [(v, b) for v, b in self.zoom_buttons if v.get() is not None and b.get() is not None]
        button = next((b.get() for v, b in self.zoom_buttons if v.get() == viewer), None)
        show = self.option("pinch") and self.video_surface(viewer) and self.scale.getFloat(viewer) > 1.015
        if show and self.scale_animation_time.getLong(viewer) != 0:
            show = self.scale_animation_target.getFloat(viewer) > 1.015
        if not show:
            if button is not None:
                button.setVisibility(8)
            return
        background = self.background.get(viewer)
        container = background.getParent() if background is not None else None
        if container is None:
            return
        if button is None:
            button = self.make_button(container.getContext(), "还原大小", "还原")
            button.setPadding(self.dp(12), 0, self.dp(12), 0)
            pill = self.pill_background()
            pill.setColor(0x60000000)
            pill.setCornerRadius(float(self.dp(19)))
            button.setBackground(pill)
            viewer_ref = self.weak_reference(viewer)

            def reset(view):
                current = viewer_ref.get()
                if current is not None:
                    view.setVisibility(8)
                    current.zoomOut()

            button.setOnClickListener(OnClickListener(reset))
            params = self.frame_params(-2, self.dp(38), 49)
            container.addView(button, params)
            self.zoom_buttons.append((viewer_ref, self.weak_reference(button)))
        button.setVisibility(0)
        self.position_zoom_reset(viewer, button)

    def position_zoom_reset(self, viewer, button):
        container = button.getParent()
        if container is None or container.getHeight() <= 0:
            return
        bottom = container.getHeight() * 0.79
        controls, seek = self.controls.get(viewer), self.video_seek_view.get(viewer)
        if controls is not None and seek is not None and seek.getParent() == controls and seek.getHeight() > 0:
            bottom = min(bottom, controls.getY() + seek.getY() - self.dp(12))
        top = max(0, bottom - self.dp(38))
        if button.getTranslationY() != top:
            button.setTranslationY(float(top))

    def before_container_measure(self, param):
        self.header_height_stack.append(False)
        viewer = self.outer.get(param.thisObject)
        background = self.background.get(viewer)
        video = self.video_surface(viewer)
        photo = self.photo_surface(viewer)
        show = self.option("video_toolbar") and video
        photo_style = self.option("photo_shadows") and photo
        controls = self.controls.get(viewer)
        compact = self.compact_control(viewer)
        width, height = (self.measure_spec.getSize(int(arg)) for arg in param.args)
        self.set_landscape_header(viewer, param.thisObject, width > height and (show or photo_style))
        if not (show or photo_style):
            self.restore_header_buttons(viewer)
        use_compact = show and compact is not None and width > height
        self.header_height_stack[-1] = use_compact
        if compact is not None:
            compact.setVisibility(0 if use_compact else 8)
        if controls is not None and self.fullscreen_control(viewer) is not None:
            control_height = (SCRUBBER_HEIGHT + VIDEO_TOOLS_ROW_HEIGHT + COMPACT_BOTTOM_GAP
                              if use_compact else VIDEO_CONTROLS_HEIGHT)
            controls.getLayoutParams().height = self.dp(control_height if show else 48)
        self.style_album_strip(viewer, self.option("album_thumbnails") and (video or photo), show or photo_style)
        self.prepare_thumbnail_rail(viewer, param.thisObject, width, height,
                                    self.option("album_thumbnails") and (video or photo))
        self.prepare_top_caption(viewer, param.thisObject, show or photo_style)
        self.prepare_photo_header(viewer, param.thisObject, photo_style and self.top_caption(viewer) is None)
        self.style_popup_rows(viewer, show, photo_style)
        self.style_video_shadows(viewer, show or photo_style)
        self.style_header_icons(viewer, show or photo_style)
        if show and background is not None and self.lookup_row(background) is not None:
            self.hide_header(self.video_menu.get(viewer))

    def set_landscape_header(self, viewer, container, enabled):
        active = self.landscape_header
        if not enabled:
            self.restore_landscape_header(viewer)
            return
        bar = self.action_bar.get(viewer)
        if bar is None or (active is not None and active[1] == container):
            return
        self.restore_landscape_header()
        paint = self.drawer_edge_paint.get(container)
        self.landscape_header = (viewer, container, bar, paint, paint.getColorFilter(), container.getClipToPadding())
        paint.setColorFilter(self.clear_edge_paint)
        container.setClipToPadding(False)
        container.invalidate()
        if self.status_slide is None:
            self.sync_media_status_bar(viewer)

    def restore_landscape_header(self, viewer=None):
        saved = self.landscape_header
        if saved is not None and (viewer is None or saved[0] == viewer):
            _, container, _, paint, color_filter, clip_to_padding = saved
            self.landscape_header = None
            paint.setColorFilter(color_filter)
            container.setClipToPadding(clip_to_padding)
            container.invalidate()
            container.requestLayout()

    def status_bar_container(self, viewer):
        if not ((self.option("video_toolbar") and self.video_surface(viewer))
                or (self.option("photo_shadows") and self.photo_surface(viewer))):
            return None
        container = self.viewer_container.get(viewer)
        activity = viewer.getParentActivity()
        if (container is None or not container.isAttachedToWindow() or not self.call(viewer, "isStatusBarVisible")
                or (self.sdk >= 24 and activity is not None and activity.isInPictureInPictureMode())):
            return None
        return container

    def sync_media_status_bar(self, viewer, shown=None):
        container = self.status_bar_container(viewer)
        if container is None:
            return False
        if shown is None:
            shown = self.action_bar_visible.getBoolean(viewer)
        if self.sdk >= 30:
            controller = container.getWindowInsetsController()
            if controller is not None:
                insets = container.getRootWindowInsets()
                if insets is None or bool(insets.isVisible(self.status_type)) != shown:
                    action = controller.show if shown else controller.hide
                    action(self.status_type)
                return True
        flags = container.getSystemUiVisibility()
        target = flags & ~HIDE_STATUS_BAR if shown else flags | HIDE_STATUS_BAR
        if target != flags:
            container.setSystemUiVisibility(target)
        return False

    def before_status_toggle(self, param):
        if self.sdk < 30:
            return
        viewer = param.thisObject
        shown = bool(param.args[0])
        if not bool(param.args[1]):
            self.finish_status_slide(viewer, shown, update_flags=False)
            return
        container = self.status_bar_container(viewer)
        if container is None:
            return
        slide = self.status_slide
        if slide is not None and slide.viewer == viewer:
            slide.shown = shown
            slide.animator = None
            return
        system = container.getWindowInsetsController()
        insets = container.getRootWindowInsets()
        if system is None or insets is None or bool(insets.isVisible(self.status_type)) == shown:
            return
        self.finish_status_slide()
        self.status_slide = StatusBarSlide(viewer, container, system, shown)

    def hold_status_flags(self, param):
        viewer = param.thisObject
        slide = self.status_slide
        if ((slide is not None and slide.viewer == viewer)
                or (self.sdk >= 30 and self.sync_media_status_bar(viewer, bool(param.args[0])))):
            param.setResult(None)

    def after_status_toggle(self, param):
        viewer = param.thisObject
        slide = self.status_slide
        if slide is None or slide.viewer != viewer:
            self.sync_media_status_bar(viewer)
            return
        shown = bool(self.action_bar_visible.getBoolean(viewer))
        animator = self.action_bar_animator.get(viewer)
        if animator is None or shown != slide.shown:
            self.finish_status_slide(viewer, shown)
            return
        slide.animator = animator
        animator.addListener(self.status_end_listener(slide))
        if slide.control is not None:
            self.resume_status_slide(slide)
            return
        animator.pause()
        if slide.signal is not None:
            return
        slide.signal = self.status_cancel_signal()
        listener = self.status_animation_listener(slide)
        try:
            slide.system.controlWindowInsetsAnimation(
                self.status_type, animator.getTotalDuration(), None, slide.signal, listener)
        except Exception:
            self.finish_status_slide(viewer, shown)
            return

        def control_timeout():
            if self.status_slide is slide and slide.control is None:
                self.finish_status_slide(viewer, slide.shown)

        run_on_ui_thread(control_timeout, 120)

    def make_status_animation_listener(self):
        plugin = self
        interface = jclass("android.view.WindowInsetsAnimationControlListener")

        class Listener(dynamic_proxy(interface)):
            def __init__(self, slide):
                super().__init__()
                self.slide = slide

            def onReady(self, controller, types):
                slide = self.slide
                if plugin.status_slide is slide:
                    slide.control = controller
                    plugin.resume_status_slide(slide)

            def onCancelled(self, controller):
                slide = self.slide
                if plugin.status_slide is slide:
                    plugin.finish_status_slide(slide.viewer, slide.shown)

            def onFinished(self, controller):
                pass

        return Listener

    def make_status_end_listener(self):
        plugin = self
        interface = jclass("android.animation.Animator$AnimatorListener")

        class Listener(dynamic_proxy(interface)):
            def __init__(self, slide):
                super().__init__()
                self.slide = slide

            def onAnimationEnd(self, animator, *_):
                animator.removeListener(self)
                slide = self.slide
                if plugin.status_slide is slide and slide.animator == animator:
                    plugin.finish_status_slide(slide.viewer, slide.shown)

            def onAnimationStart(self, animator, *_):
                pass

            def onAnimationCancel(self, animator):
                pass

            def onAnimationRepeat(self, animator):
                pass

        return Listener

    def resume_status_slide(self, slide):
        animator = slide.animator
        if animator is None:
            return
        self.step_status_slide(slide.container)
        if animator.isPaused():
            animator.resume()

    def step_status_slide(self, container):
        slide = self.status_slide
        if slide is None or slide.container != container or slide.control is None or slide.animator is None:
            return
        if not slide.animator.isStarted():
            self.finish_status_slide(slide.viewer, slide.shown)
            return
        control = slide.control
        if not control.isReady():
            return
        progress = max(0.0, min(1.0, float(self.action_bar.get(slide.viewer).getAlpha())))
        if progress != slide.progress:
            hidden, visible = control.getHiddenStateInsets(), control.getShownStateInsets()
            edges = [round(start + (end - start) * progress) for start, end in zip(
                (hidden.left, hidden.top, hidden.right, hidden.bottom),
                (visible.left, visible.top, visible.right, visible.bottom))]
            control.setInsetsAndAlpha(self.status_insets.of(*edges), progress, progress)
            slide.progress = progress

    def finish_status_slide(self, viewer=None, shown=None, *, update_flags=True):
        slide = self.status_slide
        if slide is None or (viewer is not None and slide.viewer != viewer):
            return
        self.status_slide = None
        shown = slide.shown if shown is None else shown
        control, signal, animator = slide.control, slide.signal, slide.animator
        slide.control = slide.signal = slide.animator = None
        ready = control is not None and control.isReady()
        if ready:
            control.finish(shown)
        elif signal is not None:
            signal.cancel()
        if animator is not None and animator.isPaused():
            animator.resume()
        if update_flags and not ready and slide.container.isAttachedToWindow():
            self.sync_media_status_bar(slide.viewer, shown)

    def finish_container_measure(self, param):
        try:
            self.after_container_measure(param)
        finally:
            self.header_height_stack.pop()

    def before_container_layout(self, param):
        self.header_height_stack.append(False)
        viewer = self.outer.get(param.thisObject)
        compact = self.compact_control(viewer)
        self.header_height_stack[-1] = compact is not None and compact.getVisibility() == 0

    def landscape_media_viewport(self, container):
        if container is None:
            return None
        width, height = container.getMeasuredWidth(), container.getMeasuredHeight()
        return (width, height) if width > height > 0 else None

    def measure_landscape_video(self, param):
        aspect = param.thisObject
        container = aspect.getParent()
        if container is None or not self.drawer_type.isInstance(container):
            return
        viewer = self.outer.get(container)
        if self.aspect_frame.get(viewer) == aspect and self.option("video_toolbar") and self.video_surface(viewer):
            viewport = self.landscape_media_viewport(container)
            if viewport is not None:
                for index, size in enumerate(viewport):
                    param.args[index] = self.integer(self.measure_spec.makeMeasureSpec(size, self.measure_spec.EXACTLY))

    def landscape_media_height(self, param):
        if int(param.args[1]) != 0:
            return
        viewer = param.thisObject
        viewport = self.landscape_media_viewport(self.viewer_container.get(viewer))
        if viewport is None:
            return
        if not ((self.option("video_toolbar") and self.video_surface(viewer))
                or (self.option("photo_shadows") and self.photo_surface(viewer))):
            return
        param.setResult(self.integer(viewport[1]))

    def finish_container_layout(self, param):
        try:
            viewer = self.outer.get(param.thisObject)
            self.layout_thumbnail_rail(viewer, param.thisObject)
            self.position_collapsed_scrubber(viewer, self.controls.get(viewer))
            for owner, view in self.zoom_buttons:
                button = view.get()
                if owner.get() == viewer and button is not None and button.getVisibility() == 0:
                    self.position_zoom_reset(viewer, button)
            if ((self.option("video_toolbar") and self.video_surface(viewer))
                    or (self.option("photo_shadows") and self.photo_surface(viewer))):
                self.align_header_buttons(viewer)
            date_shifted = self.align_caption_date(viewer)
            self.fit_header(viewer, date_shifted)
        finally:
            self.header_height_stack.pop()

    def compact_header_height(self, param):
        if (self.header_height_stack and self.header_height_stack[-1]
                and self.looper.myLooper() == self.ui_looper):
            height = min(int(param.getResult()), self.dp(COMPACT_HEADER_HEIGHT))
            param.setResult(self.integer(height))

    def align_header_buttons(self, viewer):
        bar = self.action_bar.get(viewer)
        menu, back = self.header_menu.get(viewer), self.header_back.get(viewer)
        if bar is None or menu is None or back is None or back.getWidth() <= 0 or back.getVisibility() != 0:
            return
        rightmost = None
        for index in range(menu.getChildCount()):
            item = menu.getChildAt(index)
            if (item.getVisibility() != 0 or item.getWidth() <= 0
                    or not self.menu_item_type.isInstance(item)):
                continue
            icon = item.getIconView()
            center = item.getX() + (icon.getX() + icon.getWidth() / 2 if icon is not None and icon.getWidth() > 0
                                     else item.getWidth() / 2)
            rightmost = center if rightmost is None else max(rightmost, center)
        if rightmost is None:
            return
        saved = self.header_buttons
        if saved is None or saved[1] != menu or saved[3] != back:
            self.restore_header_buttons()
            self.header_buttons = (viewer, menu, menu.getTranslationX(), back, back.getTranslationX())
        _, _, menu_x, _, back_x = self.header_buttons
        left = bar.getLeft() + back.getLeft() + back_x + back.getWidth() / 2
        right = bar.getLeft() + menu.getLeft() + menu_x + rightmost
        landscape = self.landscape_header is not None and self.landscape_header[0] == viewer
        gutter = (landscape_gutter(self.dp, bar.getWidth()) + self.dp(18)
                  if landscape else self.dp(VIDEO_TOOL_SIZE // 2))
        target_left, target_right = bar.getLeft() + gutter, bar.getRight() - gutter
        controls = self.controls.get(viewer)
        compact = self.compact_control(viewer)
        if (landscape and controls is not None and controls.getVisibility() == 0
                and compact is not None and compact.getVisibility() == 0):
            play, fullscreen = self.playback_control(viewer), self.fullscreen_control(viewer)
            if play is not None and fullscreen is not None and play.getWidth() > 0 and fullscreen.getWidth() > 0:
                target_left = controls.getLeft() + play.getLeft() + play.getWidth() / 2
                target_right = controls.getLeft() + fullscreen.getLeft() + fullscreen.getWidth() / 2
        if target_left >= target_right:
            return
        back.setTranslationX(float(back_x + target_left - left))
        menu.setTranslationX(float(menu_x + target_right - right))

    def restore_header_buttons(self, viewer=None):
        saved = self.header_buttons
        if saved is not None and (viewer is None or saved[0] == viewer):
            _, menu, menu_x, back, back_x = saved
            self.header_buttons = None
            menu.setTranslationX(menu_x)
            back.setTranslationX(back_x)

    def style_header_icons(self, viewer, enabled):
        icons = [self.header_back.get(viewer)]
        menu = self.header_menu.get(viewer)
        if menu is not None:
            for index in range(menu.getChildCount()):
                item = menu.getChildAt(index)
                if self.menu_item_type.isInstance(item):
                    icons.append(item.getIconView())
        self.header_icons = [entry for entry in self.header_icons if entry[0].get() is not None]
        for icon in icons:
            if icon is None:
                continue
            index = next((i for i, (ref, _, _) in enumerate(self.header_icons) if ref.get() == icon), None)
            if enabled and index is None:
                scale_x, scale_y = icon.getScaleX(), icon.getScaleY()
                drawable = icon.getDrawable()
                if drawable is None:
                    continue
                intrinsic = max(drawable.getIntrinsicWidth(), drawable.getIntrinsicHeight())
                if intrinsic <= 0:
                    continue
                scale = self.dp(VIDEO_ICON_SIZE) / intrinsic
                self.header_icons.append((self.weak_reference(icon), scale_x, scale_y))
                icon.setScaleX(float(scale_x * scale))
                icon.setScaleY(float(scale_y * scale))
            elif not enabled and index is not None:
                _, scale_x, scale_y = self.header_icons.pop(index)
                icon.setScaleX(scale_x)
                icon.setScaleY(scale_y)

    def style_video_shadows(self, viewer, enabled):
        top = self.action_bar.get(viewer)
        has_header_shade = self.top_caption(viewer) is not None or self.photo_header(viewer) is not None
        if has_header_shade:
            self.manage_shadow_background(top, enabled)
        else:
            self.manage_shadow_background(top, enabled, lambda: self.shadow_profile_drawable(self.header_shadow_stops))
        footer = self.background.get(viewer)
        enabled = enabled and self.footer_shade(footer) is not None
        self.manage_shadow_background(footer, enabled)
        self.manage_shadow_background(self.navigation_bar.get(viewer), enabled)

    def after_album_fill(self, param):
        container = param.thisObject.getParent()
        if self.active and self.option("album_thumbnails") and container is not None:
            container.requestLayout()

    def preload_opening_thumbnail(self, param):
        if not self.active:
            return
        viewer = param.thisObject
        message, items, index = param.args[0], param.args[4], int(param.args[7])
        if message is None and items is not None and 0 <= index < items.size():
            message = items.get(index)
        self.remember_opening_chat_viewport(viewer, message)
        if message is None or not (message.isPhoto() or message.isVideo()):
            return
        if not self.option("album_thumbnails"):
            return
        self.clear_thumbnail_preload()
        container = self.viewer_container.get(viewer)
        if container is None:
            return
        pending = self.thumbnail_preload = (viewer, [])

        def prime():
            if self.active and self.thumbnail_preload is pending:
                known = [message]
                if items is not None and 0 <= index < items.size() and same_thumbnail_item(items.get(index), message):
                    known.extend(items.get(i) for i in (index - 1, index + 1) if 0 <= i < items.size())
                for item in known:
                    if (item is not None and item.currentAccount == message.currentAccount
                            and item.getDialogId() == message.getDialogId() and (item.isPhoto() or item.isVideo())):
                        pending[1].append((item, self.create_thumbnail_receiver(container, None, item)))

        def expire():
            if self.thumbnail_preload is pending:
                self.clear_thumbnail_preload(viewer)

        run_on_ui_thread(prime, 1)
        run_on_ui_thread(expire, 750)

    def clear_thumbnail_preload(self, viewer=None):
        pending = getattr(self, "thumbnail_preload", None)
        if pending is not None and (viewer is None or pending[0] == viewer):
            self.thumbnail_preload = None
            for _, receiver in pending[1]:
                if receiver is not None:
                    receiver.onDetachedFromWindow()

    def reveal_thumbnail_window(self, rail, on_screen):
        if rail.revealed:
            return True
        now = monotonic()
        waiting_for_list = (rail.source is not None and rail.source[1] <= 1
                            and self.searching_album.getBoolean(rail.viewer))
        ready = all(index in rail.cells and (rail.cells[index] is None or rail.cells[index].hasBitmapImage())
                    for index in on_screen)
        deadline = rail.opened_at + (THUMBNAIL_FIRST_LIST_SECONDS if waiting_for_list else THUMBNAIL_FIRST_PAINT_SECONDS)
        if (not waiting_for_list and ready) or now >= deadline:
            rail.revealed = True
            return True
        if rail.reveal_check is None or deadline < rail.reveal_check:
            rail.reveal_check = deadline

            def invalidate():
                if getattr(self, "thumbnail_rail", None) is rail and rail.reveal_check == deadline:
                    rail.reveal_check = None
                    rail.container.invalidate()

            run_on_ui_thread(invalidate, max(1, int((deadline - now) * 1000) + 1))
        return False

    def schedule_thumbnail_window(self, rail, delay=1):
        if rail.handle is not None and rail.collapsed and rail.slide >= 1 and rail.handle_touch is None:
            return
        pending = rail.refresh_pending
        if pending is not None and pending[1] <= delay:
            return
        mode = (object(), delay)
        rail.refresh_pending = mode

        def render():
            if rail.refresh_pending is not mode:
                return
            rail.refresh_pending = None
            if self.active and self.thumbnail_rail is rail:
                try:
                    if rail.handle is None:
                        self.install_thumbnail_handle(rail)
                    if not rail.collapsed or rail.slide < 1 or rail.handle_touch is not None:
                        next_delay = self.render_thumbnail_window(rail)
                        if next_delay is not None:
                            self.schedule_thumbnail_window(rail, next_delay)
                    self.thumbnail_failure = None
                    rail.container.invalidate()
                except Exception as error:
                    self.fail_thumbnail_rail(rail.viewer, rail.container, error)

        run_on_ui_thread(render, delay)

    def fail_thumbnail_rail(self, viewer, container, error):
        self.thumbnail_log.w("NagramMediaRail", f"Media thumbnail rail failed: {type(error).__name__}: {error}")
        key = self.current_media_key(viewer)
        previous = getattr(self, "thumbnail_failure", None)
        attempts = previous[2] + 1 if previous is not None and previous[:2] == (viewer, key) else 1
        delay = (80, 250, 750)[min(attempts, 3) - 1]
        failure = self.thumbnail_failure = (viewer, key, attempts, monotonic() + delay / 1000.0)
        self.remove_thumbnail_rail(viewer)
        if container is not None and attempts <= 3:
            def retry():
                if self.active and self.thumbnail_failure is failure and container.isAttachedToWindow():
                    container.requestLayout()

            run_on_ui_thread(retry, delay + 16)

    def thumbnail_scroll_offset(self, rail, viewport):
        offset = rail.pending_offset
        if offset is None:
            offset = rail.position
        elif rail.center_pending:
            offset += rail.tile_height // 2 - rail.center
        minimum, maximum = self.thumbnail_scroll_limits(rail, viewport)
        return max(minimum, min(offset, maximum))

    def thumbnail_scroll_limits(self, rail, viewport):
        center_offset = rail.tile_height // 2 - rail.center
        if not rail.offsets:
            return 0, 0
        return (min(0, rail.offsets[0] + center_offset),
                max(0, rail.extent - viewport, rail.offsets[-1] + center_offset))

    def prefetch_thumbnail_edge(self, rail, delta):
        request = getattr(self, "on_thumbnail_edge", None)
        if request is None or rail.source is None or rail.dirty or not rail.source[1]:
            return
        lookahead = max(self.dp(100), min(self.dp(320), rail.height))
        if delta < 0 and rail.position <= lookahead:
            request(rail.viewer, 0, "older")
        elif delta > 0 and rail.position + rail.height >= rail.extent - lookahead:
            request(rail.viewer, rail.source[1] - 1, "newer")

    def move_thumbnail_rail(self, rail, position):
        minimum, maximum = self.thumbnail_scroll_limits(rail, rail.height)
        position = max(minimum, min(round(position), maximum))
        delta = position - rail.position
        if delta:
            rail.follow_selection = False
            rail.position = position
            rail.scroll_direction = 1 if delta > 0 else -1
            self.prefetch_thumbnail_edge(rail, delta)
            self.schedule_thumbnail_window(rail)
            rail.container.invalidate()

    def hold_thumbnail_controls(self, param):
        rail = getattr(self, "thumbnail_rail", None)
        if (rail is not None and rail.viewer == param.thisObject
                and (rail.touch is not None or rail.flinging or rail.handle_touch is not None)):
            param.setResult(None)

    def install_thumbnail_handle(self, rail):
        context = rail.container.getContext()
        handle = self.frame_layout(context)
        handle.setContentDescription("展开缩略图" if rail.collapsed else "收起缩略图")
        icon = self.image_view(context)
        icon_size = self.dp(THUMBNAIL_HANDLE_ICON_SIZE)
        chevron = getattr(self, "thumbnail_handle_chevron", None)
        if chevron is None or chevron.getWidth() != icon_size:
            chevron = self.bitmap.createBitmap(icon_size, icon_size, self.bitmap_config)
            paint = jclass("android.graphics.Paint")(1)
            paint.setColor(jint(WHITE))
            paint.setStyle(jclass("android.graphics.Paint$Style").STROKE)
            paint.setStrokeCap(jclass("android.graphics.Paint$Cap").ROUND)
            paint.setStrokeJoin(jclass("android.graphics.Paint$Join").ROUND)
            paint.setStrokeWidth(float(self.dp(3)))
            path = jclass("android.graphics.Path")()
            path.moveTo(float(self.dp(3)), float(self.dp(10)))
            path.lineTo(float(self.dp(12)), float(self.dp(15)))
            path.lineTo(float(self.dp(21)), float(self.dp(10)))
            self.canvas(chevron).drawPath(path, paint)
            self.thumbnail_handle_chevron = chevron
        icon.setImageBitmap(chevron)
        icon.setColorFilter(WHITE)
        icon.setAlpha(0.82)
        icon.setScaleType(self.fit_center)
        icon.setImportantForAccessibility(2)
        handle.addView(icon, self.frame_params(icon_size, icon_size, 21))
        handle.setOnClickListener(OnClickListener(lambda _: self.set_thumbnail_collapsed(rail, not rail.collapsed)))
        rail.handle, rail.handle_icon = handle, icon
        rail.container.addView(handle, self.frame_params(self.dp(44), self.dp(44), 51))

    def set_thumbnail_collapsed(self, rail, collapsed):
        changed = collapsed != rail.collapsed
        rail.collapsed = collapsed
        rail.slide_motion = (rail.slide, float(collapsed), monotonic())
        if changed:
            if rail.collapse_key is not None:
                self.set_setting(rail.collapse_key, collapsed)
            rail.handle.setContentDescription("展开缩略图" if collapsed else "收起缩略图")
            if rail.landscape:
                rail.container.requestLayout()
        if not collapsed:
            self.schedule_thumbnail_window(rail)
        rail.container.invalidate()

    def sync_thumbnail_handle(self, rail):
        if rail.slide_motion is not None:
            start, end, began = rail.slide_motion
            fraction = min(1.0, (monotonic() - began) / 0.2)
            rail.slide = end + (start - end) * (1.0 - fraction) ** 3
            if fraction == 1:
                rail.slide_motion = None
                if rail.collapsed:
                    self.drop_thumbnail_cells(rail, ())
            else:
                rail.container.postInvalidateOnAnimation()
        handle = rail.handle
        if handle is None:
            return
        free_height = rail.height - rail.mask_top
        visible = rail.ready and rail.alpha > 0.01 and free_height >= self.dp(32)
        visibility = 0 if visible else 4
        if handle.getVisibility() != visibility:
            handle.setVisibility(visibility)
        if not visible:
            return
        edge = rail.left + rail.tile_width - self.visible_thumbnail_width(rail) + rail.ui_shift
        width, height = handle.getMeasuredWidth(), handle.getMeasuredHeight()
        handle.setX(float(max(0, edge - width + self.dp(4))))
        top = max(rail.top + rail.mask_top, min(rail.top + rail.center - height / 2, rail.top + rail.height - height))
        handle.setY(float(top))
        handle.setAlpha(rail.alpha)
        rail.handle_icon.setRotation(90.0 if rail.slide >= 0.5 else -90.0)
        now = monotonic()
        if width > 0 and height > 0 and now >= rail.next_handle_sample:
            rail.next_handle_sample = now + 0.45
            x = handle.getX() + width - self.dp(THUMBNAIL_HANDLE_ICON_SIZE) / 2
            y = top + height / 2
            run_on_ui_thread(lambda: self.sample_thumbnail_handle(rail, x, y), 1)

    def make_thumbnail_pixel_callback(self):
        listener = jclass("android.view.PixelCopy$OnPixelCopyFinishedListener")

        class Callback(dynamic_proxy(listener)):
            def __init__(self, finish):
                super().__init__()
                self.finish = finish

            def onPixelCopyFinished(self, result):
                self.finish(result)

        return Callback

    def tint_thumbnail_handle(self, rail, color):
        if self.thumbnail_rail is not rail or rail.handle_icon is None:
            return
        shade = (0.2126 * ((color >> 16) & 255) + 0.7152 * ((color >> 8) & 255) + 0.0722 * (color & 255))
        tint = THUMBNAIL_HANDLE_DARK if shade >= (154 if rail.handle_tint == WHITE else 138) else WHITE
        if rail.handle_tint != tint:
            rail.handle_tint = tint
            rail.handle_icon.setColorFilter(jint(tint))

    def sample_thumbnail_handle(self, rail, x, y):
        if self.thumbnail_rail is not rail or rail.alpha < 0.1:
            return
        image = self.center_image.get(rail.viewer)
        if image is None:
            return
        width, height = rail.container.getWidth(), rail.container.getHeight()
        media_width, media_height = image.getBitmapWidth(), image.getBitmapHeight()
        if min(width, height, media_width, media_height) <= 0:
            self.tint_thumbnail_handle(rail, 0)
            return
        fit = min(width / media_width, height / media_height)
        u = 0.5 + (x - width / 2) / (media_width * fit)
        v = 0.5 + (y - height / 2) / (media_height * fit)
        if not 0 <= u < 1 or not 0 <= v < 1:
            self.tint_thumbnail_handle(rail, 0)
            return
        try:
            surface = self.handle_video_surface.get(rail.viewer)
            if (self.handle_pixel_copy is not None and surface is not None and surface.getVisibility() == 0
                    and surface.getWidth() > 0 and surface.getHeight() > 0 and surface.getHolder().getSurface().isValid()):
                px, py = int(u * surface.getWidth()), int(v * surface.getHeight())
                sample = self.bitmap.createBitmap(1, 1, self.bitmap_config)

                def finish(result):
                    try:
                        if result == 0:
                            self.tint_thumbnail_handle(rail, sample.getPixel(0, 0))
                    finally:
                        sample.recycle()

                try:
                    self.handle_pixel_copy.request(surface, self.rect(px, py, px + 1, py + 1), sample,
                                                   self.handle_pixel_callback(finish), self.handle_pixel_handler)
                    return
                except Exception:
                    sample.recycle()
            texture = self.handle_video_texture.get(rail.viewer)
            frame = texture.getBitmap(12, 12) if texture is not None and texture.isAvailable() else None
            try:
                bitmap = frame if frame is not None else image.getBitmap()
                if bitmap is not None:
                    self.tint_thumbnail_handle(rail, bitmap.getPixel(int(u * bitmap.getWidth()),
                                                                    int(v * bitmap.getHeight())))
            finally:
                if frame is not None:
                    frame.recycle()
        except Exception:
            pass

    def visible_thumbnail_width(self, rail):
        return rail.drag_width if rail.drag_width is not None else round((1.0 - rail.slide) * rail.tile_width)

    def thumbnail_draw_scale(self, rail):
        if rail.drag_width is None:
            return 1.0
        return max(rail.handle_touch[3][0], rail.drag_width) / rail.tile_width

    def thumbnail_draw_viewport(self, rail, scale):
        start = rail.position + rail.center + (rail.mask_top - rail.center) / scale
        return start, (rail.height - rail.mask_top) / scale

    def thumbnail_visible_range(self, rail):
        position, height = self.thumbnail_draw_viewport(rail, self.thumbnail_draw_scale(rail))
        return thumbnail_range(rail.offsets, position, height, 0)

    def thumbnail_prefetch_range(self, rail, on_screen, before=THUMBNAIL_PREFETCH_COUNT,
                                 after=THUMBNAIL_PREFETCH_COUNT):
        start, end = on_screen.start, on_screen.stop
        while start > 0 and before:
            start -= 1
            before -= not thumbnail_divider(rail.entries[start][1])
        while end < len(rail.entries) and after:
            after -= not thumbnail_divider(rail.entries[end][1])
            end += 1
        return range(start, end)

    def thumbnail_width_stops(self, rail):
        container = rail.container
        width = container.getWidth() - container.getPaddingLeft() - container.getPaddingRight()
        return [thumbnail_dimensions(self.dp, preset, rail.landscape, width)[0] for preset in range(len(THUMBNAIL_WIDTHS))]

    def route_thumbnail_handle(self, rail, action, x, y):
        handle = rail.handle
        if handle is None:
            return False
        if action == 0:
            if (handle.getVisibility() != 0 or rail.alpha <= 0.1
                    or not (handle.getX() <= x < handle.getX() + handle.getWidth()
                            and handle.getY() <= y < handle.getY() + handle.getHeight())):
                return False
            rail.slide_motion = None
            rail.scroller.forceFinished(True)
            rail.flinging = False
            rail.handle_touch = (x, self.visible_thumbnail_width(rail), False, self.thumbnail_width_stops(rail))
            handle.setPressed(True)
            self.android.cancelRunOnUIThread(self.auto_hide_controls.get(rail.viewer))
            return True
        if rail.handle_touch is None:
            return False
        down, start, dragged, stops = rail.handle_touch
        if action == 2:
            dragged = dragged or abs(x - down) >= self.dp(6)
            if dragged:
                rail.drag_width = min(stops[-1], max(0, round(start + down - x)))
                self.schedule_thumbnail_window(rail)
                rail.container.invalidate()
            rail.handle_touch = (down, start, dragged, stops)
        elif action in (1, 3):
            rail.handle_touch = None
            handle.setPressed(False)
            preview, rail.drag_width = rail.drag_width, None
            if action == 1 and not dragged:
                handle.performClick()
            else:
                collapsed = rail.collapsed
                if action == 1 and preview is not None:
                    collapsed = preview < stops[0] * 0.6
                    if not collapsed:
                        current = self.thumbnail_size
                        preset = min(range(len(stops)), key=lambda i: (abs(stops[i] - preview), abs(i - current)))
                        if preset != current:
                            self.set_setting("thumbnail_size", preset)
                            self.thumbnail_size_changed(preset)
                if preview is not None:
                    rail.slide = 1.0 - min(1.0, preview / rail.tile_width)
                self.set_thumbnail_collapsed(rail, collapsed)
            self.call(rail.viewer, "scheduleActionBarHide")
        return True

    def route_thumbnail_touch(self, viewer, window, event, action):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is None or rail.viewer != viewer:
            return False
        origin_x, origin_y = self.view_origin(rail.container, window)
        x, y = event.getX() - origin_x, event.getY() - origin_y
        if self.route_thumbnail_handle(rail, action, x, y):
            return True
        if rail.touch is None and (rail.alpha <= 0.1 or not rail.cells or rail.slide > 0.01):
            return False
        inside = (rail.left + rail.ui_shift <= x < rail.left + rail.tile_width
                  and rail.top + rail.mask_top <= y < rail.top + rail.height)
        now = event.getEventTime()
        if action == 0:
            if not inside:
                return False
            rail.scroller.forceFinished(True)
            rail.flinging = False
            rail.touch = (y, rail.position, y, now, 0.0, False)
            self.android.cancelRunOnUIThread(self.auto_hide_controls.get(viewer))
            return True
        if rail.touch is None:
            return False
        down, start, last_y, last_time, velocity, dragging = rail.touch
        if action == 2 and event.getPointerCount() == 1:
            dragging = dragging or abs(y - down) >= self.dp(6)
            if dragging:
                self.move_thumbnail_rail(rail, start + down - y)
                if now > last_time:
                    velocity = (last_y - y) * 1000 / (now - last_time)
            rail.touch = (down, start, y, now, velocity, dragging)
        elif action == 5:
            rail.touch = (down, start, last_y, -1, 0.0, True)
        elif action in (1, 3):
            rail.touch = None
            if action == 1 and dragging and now - last_time < 120:
                limit = self.dp(3600)
                speed = round(max(-limit, min(limit, velocity)))
                start, end = self.thumbnail_scroll_limits(rail, rail.height)
                if (speed > self.dp(50) and rail.position < end) or (speed < -self.dp(50) and rail.position > start):
                    rail.flinging = True
                    rail.scroller.fling(0, rail.position, 0, speed, 0, 0, start, end)
                    rail.container.postInvalidateOnAnimation()
            elif action == 1 and not dragging and inside:
                local = y - rail.top + rail.position
                index = bisect_right(rail.offsets, local) - 1
                if index >= 0:
                    offset, item = rail.entries[index]
                    if local < offset + rail.tile_height and not thumbnail_divider(item):
                        self.open_thumbnail(rail, item)
            if not rail.flinging and getattr(self, "thumbnail_rail", None) is rail:
                self.call(viewer, "scheduleActionBarHide")
        return True

    def remove_thumbnail_rail(self, viewer=None):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is None or (viewer is not None and viewer != rail.viewer):
            return
        self.thumbnail_rail = None
        rail.set_right_reservation((), 0)
        self.drop_thumbnail_cells(rail, ())
        if rail.handle is not None:
            rail.container.removeView(rail.handle)
        if rail.strip is not None and rail.ready:
            rail.strip.setVisibility(rail.native_visibility)
        rail.container.invalidate()

    def sync_thumbnail_visibility(self, viewer):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is None or rail.viewer != viewer:
            return
        bar = self.action_bar.get(viewer)
        shown = self.action_bar_visible.getBoolean(viewer)
        rail.alpha = float(bar.getAlpha()) if bar is not None else float(shown)
        rail.ui_shift = round(self.dp(16) * (1.0 - rail.alpha))

    def prepare_thumbnail_rail(self, viewer, container, width, height, enabled):
        if not enabled or width <= 0 or height <= 0:
            self.remove_thumbnail_rail(viewer)
            return
        failure = getattr(self, "thumbnail_failure", None)
        if (failure is not None and failure[:2] == (viewer, self.current_media_key(viewer))
                and monotonic() < failure[3]):
            return
        try:
            self.update_thumbnail_rail(viewer, container, width, height)
        except Exception as error:
            self.fail_thumbnail_rail(viewer, container, error)

    def thumbnail_size_changed(self, value):
        size = selected_thumbnail_size(value)
        previous = getattr(self, "thumbnail_size", DEFAULT_THUMBNAIL_SIZE)
        self.thumbnail_size = size
        rail = getattr(self, "thumbnail_rail", None)
        if rail is not None and size != previous:
            rail.container.requestLayout()

    def configure_thumbnail_state(self):
        scope = adjustment_tick_value(self.get_setting("thumbnail_state_scope", THUMBNAIL_STATE_CHAT),
                                      THUMBNAIL_STATE_CHAT, THUMBNAIL_STATE_GLOBAL, THUMBNAIL_STATE_CHAT)
        start = adjustment_tick_value(self.get_setting("thumbnail_default_state", THUMBNAIL_START_COLLAPSED),
                                       THUMBNAIL_START_COLLAPSED, THUMBNAIL_START_COLLAPSED, THUMBNAIL_START_EXPANDED)
        config = (scope, start == THUMBNAIL_START_COLLAPSED)
        previous = getattr(self, "thumbnail_state_config", None)
        self.thumbnail_state_config = config
        rail = getattr(self, "thumbnail_rail", None)
        if rail is not None and config != previous:
            message = rail.viewer.getCurrentMessageObject()
            if message is not None:
                self.restore_thumbnail_collapse(rail, message, refresh=True)
                rail.container.requestLayout()

    def restore_thumbnail_collapse(self, rail, message, refresh=False):
        scope, default_collapsed = self.thumbnail_state_config
        key = "thumbnail_rail_collapsed"
        if scope == THUMBNAIL_STATE_CHAT:
            dialog = message.getDialogId()
            if dialog:
                key = f"{key}_{message.currentAccount}_{dialog}"
        same_key = key == rail.collapse_key
        if same_key and not refresh:
            return
        collapsed = bool(self.get_setting(key, default_collapsed))
        if same_key and collapsed == rail.collapsed:
            return
        rail.collapse_key = key
        rail.collapsed = collapsed
        rail.slide, rail.slide_motion = float(collapsed), None
        if collapsed:
            self.drop_thumbnail_cells(rail, ())
        if rail.handle is not None:
            rail.handle.setContentDescription("展开缩略图" if collapsed else "收起缩略图")

    def thumbnail_right_reservation(self, viewer):
        rail = getattr(self, "thumbnail_rail", None)
        return rail.right_reservation if rail is not None and rail.viewer == viewer else 0

    def measure_thumbnail_side_insets(self, viewer, container, rail, width, height):
        insets = container.getRootWindowInsets()
        window = self.window.get(viewer)
        consumed_right = container.getPaddingRight() + (window.getPaddingRight() if window is not None else 0)
        consumed_top = window.getPaddingTop() if window is not None else 0
        consumed_bottom = container.getPaddingBottom() + (window.getPaddingBottom() if window is not None else 0)
        right = top = bottom = 0
        if insets is not None:
            right = max(0, insets.getStableInsetRight() - consumed_right)
            top = max(0, insets.getStableInsetTop() - consumed_top)
            bottom = max(0, insets.getStableInsetBottom() - consumed_bottom)
        rail.safe_top, rail.safe_bottom = top, bottom
        rail.left = max(0, width - container.getPaddingRight() - right - self.dp(THUMBNAIL_EDGE_PADDING) - rail.tile_width)
        if rail.landscape:
            rail.top = top
            rail.height = max(0, height - container.getPaddingBottom() - top - bottom)
        controls = self.controls.get(viewer)
        views = tuple(view for view in (self.action_bar.get(viewer), controls)
                      if view is not None and view.getParent() == container) if rail.landscape else ()
        rail_width = self.dp(24) if rail.collapsed else rail.tile_width + self.dp(2 * THUMBNAIL_EDGE_PADDING + THUMBNAIL_PANEL_GAP)
        reservation = rail_width + right
        rail.set_right_reservation(views, reservation if rail.landscape else 0)

    def update_thumbnail_rail(self, viewer, container, width, height):
        strip = self.album_strip.get(viewer)
        current = viewer.getCurrentMessageObject()
        images = self.album_messages.get(viewer)
        if current is None or not (current.isPhoto() or current.isVideo()):
            self.remove_thumbnail_rail(viewer)
            return
        rail = getattr(self, "thumbnail_rail", None)
        landscape = width > height
        dimensions = thumbnail_dimensions(self.dp, getattr(self, "thumbnail_size", DEFAULT_THUMBNAIL_SIZE),
                                          landscape, width - container.getPaddingLeft() - container.getPaddingRight())
        if rail is None or rail.viewer != viewer or rail.container != container:
            self.remove_thumbnail_rail()
            rail = self.thumbnail_rail = ThumbnailRail(viewer, strip, container, dimensions)
            rail.scroller = self.thumbnail_scroller(container.getContext())
        elif dimensions != (rail.tile_width, rail.tile_height) or rail.landscape != landscape:
            rail.tile_width, rail.tile_height = dimensions
            rail.dirty = True
            if rail.touch is not None or rail.flinging or rail.handle_touch is not None:
                rail.touch = rail.handle_touch = rail.drag_width = None
                rail.flinging = False
                rail.scroller.forceFinished(True)
                if rail.handle is not None:
                    rail.handle.setPressed(False)
                self.call(viewer, "scheduleActionBarHide")
        rail.landscape = landscape
        self.restore_thumbnail_collapse(rail, current)
        self.measure_thumbnail_side_insets(viewer, container, rail, width, height)
        count = images.size() if images is not None else 0
        account, dialog = current.currentAccount, current.getDialogId()
        primary, merged = (part.getLong(viewer) for part in self.viewer_dialogs[:2])
        dialogs = (primary, merged) if primary and merged and dialog in (primary, merged) else (dialog,)
        index = viewer.getCurrentIndex()
        listed = images.get(index) if 0 <= index < count else None
        if not same_thumbnail_item(listed, current) or listed.currentAccount != account:
            # The singleton viewer can still hold the outgoing list during a new open.
            count = 0
        source = (images, count, images.get(0) if count else current, images.get(count - 1) if count else current,
                  account, dialogs)
        changed = rail.dirty or source != rail.source
        if changed:
            tile = rail.tile_height + self.dp(THUMBNAIL_SPACING)
            messages = (images.get(i) for i in range(count)) if count else (current,)
            entries, extent = thumbnail_entries(messages,
                tile, self.dp(THUMBNAIL_MESSAGE_GAP), self.dp(THUMBNAIL_CHAT_GAP), self.dp(THUMBNAIL_EDGE_PADDING),
                (account, dialogs))
            if not entries:
                self.remove_thumbnail_rail(viewer)
                return
            changed = extent != rail.extent or len(entries) != len(rail.entries) or any(
                offset != old_offset or item is not old_item
                for (offset, item), (old_offset, old_item) in zip(entries, rail.entries))
            anchor = None
            if changed and rail.offsets and not rail.follow_selection and source[4:] == rail.source[4:]:
                position = self.thumbnail_scroll_offset(rail, rail.height)
                index = max(0, bisect_right(rail.offsets, position) - 1)
                if thumbnail_divider(rail.entries[index][1]):
                    index += 1
                anchor = rail.entries[index][1], position - rail.offsets[index]
            previous = rail.source
            rail.source, rail.dirty = source, False
            if changed:
                if previous is None or source[4:] != previous[4:]:
                    rail.scroll_direction = 0
                rail.priority_window = range(0)
                self.keep_thumbnail_cells(rail, entries)
                rail.entries, rail.extent = entries, extent
                rail.offsets = [offset for offset, _ in entries]
                rail.pending_offset = None
                rail.center_pending = False
                if anchor is not None and same_thumbnail_item(rail.selected, current):
                    rail.pending_offset = next((start + anchor[1] for start, item in entries
                                                if same_thumbnail_item(item, anchor[0])), None)
        if not same_thumbnail_item(rail.selected, current) or (changed and rail.pending_offset is None):
            if not same_thumbnail_item(rail.selected, current):
                rail.next_handle_sample = 0.0
            rail.follow_selection = True
            rail.selected = current
            rail.pending_offset = next((start for start, item in rail.entries if same_thumbnail_item(item, current)), 0)
            rail.center_pending = True
        rail.ready = True
        if strip is not None and strip.getVisibility() != 8:
            strip.setVisibility(8)
        self.sync_thumbnail_visibility(viewer)

    def open_thumbnail(self, rail, item):
        viewer = rail.viewer
        images = self.album_messages.get(viewer)
        index = images.indexOf(item) if images is not None else -1
        if index < 0:
            return
        switching = index != viewer.getCurrentIndex()
        if switching:
            delegate = self.album_delegate.get(rail.strip) if rail.strip is not None else None
            if delegate is not None:
                delegate.setCurrentIndex(index)
            else:
                self.call(viewer, "setImageIndex", self.integer(index), self.boolean(False),
                          self.boolean(True), self.boolean(False))
        if item.isVideo() and same_thumbnail_item(viewer.getCurrentMessageObject(), item):
            if switching:
                self.queue_sidebar_chat_position(viewer, item)
            self.manual_pause.setBoolean(viewer, False)
            player = viewer.getVideoPlayer()
            if player is not None:
                player.setPlayWhenReady(True)
            else:
                filename = self.video_file_names.get(viewer)[0]
                loading = filename is not None and self.file_loader.getInstance(item.currentAccount).isLoadingFile(filename)
                self.call(viewer, "onActionClick", self.boolean(not loading))

    def chat_message_load_index(self, chat, dialog):
        if dialog == chat.getDialogId():
            return 0
        if dialog != 0 and dialog == self.chat_merged_dialog.getLong(chat):
            return 1
        return None

    def queue_sidebar_chat_position(self, viewer, message):
        chat = self.parent_chat.get(viewer)
        if chat is None or chat.getCurrentAccount() != message.currentAccount:
            return
        dialog, message_id = message.getDialogId(), message.getId()
        load_index = self.chat_message_load_index(chat, dialog)
        if load_index is None:
            return
        pending = self.pending_sidebar_chat = (self.weak_reference(viewer), self.weak_reference(chat),
                                               (dialog, message_id), load_index)
        run_on_ui_thread(lambda: self.position_sidebar_chat(pending), 120)

    def position_sidebar_chat(self, pending):
        if self.pending_sidebar_chat is not pending:
            return
        self.pending_sidebar_chat = None
        viewer, chat = pending[0].get(), pending[1].get()
        if (not self.active or viewer is None or chat is None or not viewer.isVisible()
                or self.library_return is not None or self.current_media_key(viewer) != pending[2]):
            return
        parent = chat.getParentLayout()
        if parent is not None and parent.getLastFragment() == chat:
            chat.scrollToMessageId(pending[2][1], 0, False, pending[3], True, 0)

    def layout_thumbnail_rail(self, viewer, container):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is None or rail.viewer != viewer or rail.container != container or rail.height <= 0:
            return
        inset = min(rail.tile_height, rail.height) // 2
        center = max(inset, min(container.getHeight() // 2 - rail.top, rail.height - inset))
        if rail.follow_selection and rail.pending_offset is None and rail.center != center:
            rail.pending_offset = next((offset for offset, item in rail.entries
                                        if same_thumbnail_item(item, rail.selected)), 0)
            rail.center_pending = True
        rail.center = center
        rail.position = self.thumbnail_scroll_offset(rail, rail.height)
        rail.pending_offset = None
        self.schedule_thumbnail_window(rail)

    def measure_portrait_thumbnail_rail(self, viewer, container):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is None or rail.viewer != viewer or rail.landscape:
            return
        bar = self.action_bar.get(viewer)
        entry = self.top_caption(viewer)
        top = max(rail.safe_top, bar.getMeasuredHeight() if bar is not None else 0)
        if entry is not None and entry.scroll is not None:
            top = max(top, entry.scroll.getLayoutParams().topMargin + entry.collapsed_height)
        top += self.dp(8)
        drawer_bottom = container.getMeasuredHeight() - container.getPaddingBottom()
        bottom = drawer_bottom - rail.safe_bottom
        footer = self.background.get(viewer)
        for view in (self.controls.get(viewer), footer):
            if view is None or view.getVisibility() != 0 or view.getParent() != container:
                continue
            edge = drawer_bottom - view.getLayoutParams().bottomMargin
            row = self.lookup_row(view) if view == footer else None
            if row is not None and row.getVisibility() == 0:
                edge -= row.getMeasuredHeight() + row.getLayoutParams().bottomMargin
            else:
                edge -= view.getMeasuredHeight()
            bottom = min(bottom, edge)
        rail.top, rail.height = top, max(0, bottom - top - self.dp(8))

    def sync_thumbnail_caption_mask(self, viewer):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is None or rail.viewer != viewer:
            return
        entry = self.top_caption(viewer) if not rail.landscape else None
        cover = 0
        if entry is not None and entry.expanded and entry.scroll is not None and entry.scroll.getVisibility() == 0:
            text_bottom = entry.scroll.getBottom() + entry.scroll.getTranslationY()
            cover = max(0, min(rail.height, round(text_bottom - rail.top)))
        rail.mask_top = cover

    def draw_thumbnail_rail(self, param):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is None or rail.container != param.thisObject:
            return
        if rail.flinging:
            if rail.scroller.computeScrollOffset():
                self.move_thumbnail_rail(rail, rail.scroller.getCurrY())
                rail.container.postInvalidateOnAnimation()
            if rail.scroller.isFinished():
                rail.flinging = False
                self.call(rail.viewer, "scheduleActionBarHide")
        visible_width = self.visible_thumbnail_width(rail)
        if rail.alpha <= 0.01 or rail.height <= rail.mask_top or visible_width <= 0:
            return
        canvas = param.args[0]
        right = float(rail.left + rail.tile_width)
        x, y = right - visible_width + rail.ui_shift, float(rail.top)
        if x >= right:
            return
        bottom = y + rail.height
        scale = self.thumbnail_draw_scale(rail)
        on_screen = self.thumbnail_visible_range(rail)
        show_images = self.reveal_thumbnail_window(rail, on_screen)
        if not show_images:
            if any(index not in rail.cells for index in on_screen):
                self.schedule_thumbnail_window(rail)
            if rail.source is None or rail.source[1] <= 1:
                return
        top = y + rail.mask_top
        height = bottom - top
        top_fade = min(height / 3.0, self.dp(18 if rail.position + rail.mask_top > 0 else 12))
        bottom_fade = min(height / 3.0, self.dp(18 if rail.position + rail.height < rail.extent else 12))
        alpha = round(rail.alpha * 255)
        saved = canvas.save()
        try:
            canvas.clipRect(x, top, right, bottom)
            canvas.saveLayerAlpha(x, top, right, bottom, alpha)
            tiles = canvas.save()
            if scale != 1.0:
                canvas.scale(float(scale), float(scale), x, y + rail.center)
            for index in on_screen:
                offset, item = rail.entries[index]
                cell_top = y + offset - rail.position
                if thumbnail_divider(item):
                    chat = item is THUMBNAIL_CHAT_DIVIDER
                    gap = self.dp(THUMBNAIL_CHAT_GAP if chat else THUMBNAIL_MESSAGE_GAP)
                    bar_width = rail.tile_width * (0.70 if chat else 0.42)
                    bar_height = self.dp(3 if chat else 2)
                    bar_x = x + (rail.tile_width - bar_width) / 2
                    # Each tile already contributes spacing before the divider.
                    bar_y = cell_top + (gap - self.dp(THUMBNAIL_SPACING) - bar_height) / 2
                    self.thumbnail_paint.setColor(jint((0xE0FFFFFF if chat else 0x99FFFFFF) - (1 << 32)))
                    canvas.drawRoundRect(bar_x, bar_y, bar_x + bar_width, bar_y + bar_height,
                                         float(bar_height), float(bar_height), self.thumbnail_paint)
                else:
                    radius = float(self.dp(7))
                    self.thumbnail_paint.setColor(jint(0x283C4048))
                    canvas.drawRoundRect(x, cell_top, x + rail.tile_width, cell_top + rail.tile_height,
                                         radius, radius, self.thumbnail_paint)
                    receiver = rail.cells.get(index) if show_images else None
                    if receiver is not None:
                        inset = self.dp(2)
                        receiver.setImageCoords(x + inset, cell_top + inset,
                                                float(max(1, rail.tile_width - 2 * inset)),
                                                float(max(1, rail.tile_height - 2 * inset)))
                        receiver.draw(canvas)
                        if same_thumbnail_item(item, rail.selected) and receiver.hasBitmapImage():
                            inset = self.dp(1)
                            self.thumbnail_outline.setStrokeWidth(float(self.dp(2)))
                            canvas.drawRoundRect(x + inset, cell_top + inset, x + rail.tile_width - inset,
                                                 cell_top + rail.tile_height - inset, radius, radius,
                                                 self.thumbnail_outline)
            canvas.restoreToCount(tiles)
            mask = (height, top_fade, bottom_fade)
            if mask != self.thumbnail_fade:
                self.thumbnail_mask.setShader(self.thumbnail_gradient(
                    0.0, 0.0, 0.0, height, self.positions((0, WHITE, WHITE, 0)),
                    self.thumbnail_fade_positions((0.0, top_fade / height, 1.0 - bottom_fade / height, 1.0)),
                    self.thumbnail_clamp))
                self.thumbnail_fade = mask
            canvas.translate(0.0, top)
            canvas.drawRect(x, 0.0, right, height, self.thumbnail_mask)
        finally:
            canvas.restoreToCount(saved)

    def keep_thumbnail_cells(self, rail, entries):
        def key(item):
            return item.currentAccount, item.getDialogId(), item.getId()

        receivers = {key(rail.entries[index][1]): receiver for index, receiver in rail.cells.items()
                     if receiver is not None and not thumbnail_divider(rail.entries[index][1])}
        rail.cells = {}
        for index, (_, item) in enumerate(entries):
            if not receivers:
                break
            if thumbnail_divider(item):
                continue
            receiver = receivers.pop(key(item), None)
            if receiver is not None:
                rail.cells[index] = receiver
        for receiver in receivers.values():
            receiver.onDetachedFromWindow()

    def drop_thumbnail_cells(self, rail, visible):
        for index in tuple(rail.cells):
            if index not in visible:
                receiver = rail.cells.pop(index)
                if receiver is not None:
                    receiver.onDetachedFromWindow()

    def render_thumbnail_window(self, rail):
        if rail.dirty or not rail.offsets or rail.height <= 0:
            return None
        on_screen = self.thumbnail_visible_range(rail)
        direction = rail.scroll_direction
        before = THUMBNAIL_SCROLL_AHEAD if direction < 0 else THUMBNAIL_PREFETCH_COUNT
        after = THUMBNAIL_SCROLL_AHEAD if direction > 0 else THUMBNAIL_PREFETCH_COUNT
        prefetch = self.thumbnail_prefetch_range(rail, on_screen, before, after)
        retained = 2 * THUMBNAIL_PREFETCH_COUNT
        self.drop_thumbnail_cells(rail, self.thumbnail_prefetch_range(
            rail, on_screen, max(before, retained), max(after, retained)))
        if direction:
            visible = list(reversed(on_screen)) if direction > 0 else list(on_screen)
        else:
            focus = rail.position + rail.center - rail.tile_height // 2
            visible = sorted(on_screen, key=lambda index: abs(rail.offsets[index] - focus))
        if rail.priority_window != on_screen:
            for index in reversed(visible):
                receiver = rail.cells.get(index)
                if index not in rail.priority_window and receiver is not None and not receiver.hasBitmapImage():
                    receiver.moveImageToFront()
            rail.priority_window = on_screen
        pending = [index for index in visible if index not in rail.cells]
        offscreen = [index for index in prefetch if index not in rail.cells and index not in on_screen]
        offscreen.sort(key=lambda index: (
            (index < on_screen.start if direction > 0 else index >= on_screen.stop) if direction else False,
            max(on_screen.start - index, index - on_screen.stop + 1)))
        pending.extend(offscreen)
        self.load_thumbnail_cells(rail, pending[:THUMBNAILS_PER_FRAME])
        return 16 if len(pending) > THUMBNAILS_PER_FRAME else None

    def load_thumbnail_cells(self, rail, indices):
        for index in indices:
            rail.cells[index] = self.create_thumbnail_cell(rail, rail.entries[index][1])

    def create_thumbnail_cell(self, rail, item):
        if thumbnail_divider(item):
            return None
        pending = self.thumbnail_preload
        if pending is not None and pending[0] == rail.viewer:
            for index, (known, receiver) in enumerate(pending[1]):
                if known.currentAccount == item.currentAccount and same_thumbnail_item(known, item):
                    pending[1].pop(index)
                    if receiver is not None:
                        return receiver
                    break
        return self.create_thumbnail_receiver(rail.container, rail.strip, item)

    def create_thumbnail_receiver(self, container, strip, item):
        receiver = None
        try:
            location = self.thumbnail_location(item, strip)
            if location is None:
                return None
            receiver = self.thumbnail_receiver(container)
            receiver.setRoundRadius(self.dp(5))
            receiver.setCurrentAccount(item.currentAccount)
            receiver.setCrossfadeAlpha(jbyte(2))  # Finished offscreen thumbnails are fully opaque on their first draw.
            receiver.onAttachedToWindow()
            size = round(THUMBNAIL_WIDTHS[getattr(self, "thumbnail_size", DEFAULT_THUMBNAIL_SIZE)] * 1.2)
            receiver.setImage(None, None, location, f"{size}_{size}", 0, None, item, 1)
        except Exception as error:
            if receiver is not None:
                receiver.onDetachedFromWindow()
            self.log(f"Could not load media thumbnail: {type(error).__name__}: {error}")
            return None
        return receiver

    def thumbnail_location(self, item, strip=None):
        if strip is not None:
            items, locations = self.album_native_items.get(strip), self.album_native_locations.get(strip)
            if items is not None and locations is not None:
                index = items.indexOf(item)
                if 0 <= index < locations.size() and locations.get(index) is not None:
                    return locations.get(index)
        thumbs, owner = item.photoThumbs, item.photoThumbsObject
        if thumbs is None or thumbs.isEmpty() or owner is None:
            owner = item.getDocument() if item.isVideo() else item.getPhoto()
            if owner is None:
                return None
            thumbs = owner.thumbs if item.isVideo() else owner.sizes
        size = self.file_loader.getClosestPhotoSizeWithSize(thumbs, 80, True) if thumbs is not None else None
        return self.album_location.getForObject(size, owner) if size is not None else None

    def style_album_strip(self, viewer, enlarge, blend):
        strip = self.album_strip.get(viewer)
        if strip is None:
            return
        self.album_styles = [entry for entry in self.album_styles if entry[0].get() is not None]
        saved = next((entry for entry in self.album_styles if entry[0].get() == strip), None)
        if saved is None:
            if not enlarge and not blend:
                return
            paint = self.album_paint.get(strip)
            geometry = tuple(part.getInt(strip) for part in self.album_geometry)
            saved = (self.weak_reference(strip), geometry, strip.getLayoutParams().height, paint.getXfermode())
            self.album_styles.append(saved)
        self.apply_album_style(strip, saved, enlarge, blend)
        if not enlarge and not blend:
            self.album_styles.remove(saved)

    def apply_album_style(self, strip, saved, enlarge, blend):
        _, original, height, mode = saved
        if enlarge:
            width, tile_height = thumbnail_dimensions(
                self.dp, getattr(self, "thumbnail_size", DEFAULT_THUMBNAIL_SIZE), False, 0)
            padding = self.dp(THUMBNAIL_EDGE_PADDING)
            original = width, tile_height, padding, self.dp(THUMBNAIL_SPACING)
            height = tile_height + 2 * padding
        for part, size in zip(self.album_geometry, original):
            if part.getInt(strip) != size:
                part.setInt(strip, size)
        strip.getLayoutParams().height = height
        paint = self.album_paint.get(strip)
        mode = self.transparent_paint_mode if blend else mode
        if paint.getXfermode() != mode:
            paint.setXfermode(mode)
            strip.invalidate()

    def manage_shadow_background(self, panel, enabled, create=None):
        if panel is None:
            return None
        self.shadows = [entry for entry in self.shadows if entry[0].get() is not None]
        current = panel.getBackground()
        for index, (ref, original, gradient) in enumerate(self.shadows):
            if ref.get() != panel:
                continue
            if not enabled:
                self.shadows.pop(index)
                if current == gradient:
                    panel.setBackground(original)
            else:
                if current != gradient:
                    original = current
                if (gradient is None) != (create is None):
                    gradient = create() if create is not None else None
                self.shadows[index] = (ref, original, gradient)
                if current != gradient:
                    panel.setBackground(gradient)
            return gradient if enabled else None
        if enabled:
            gradient = create() if create is not None else None
            self.shadows.append((self.weak_reference(panel), current, gradient))
            panel.setBackground(gradient)
            return gradient
        return None

    def install_footer_shade(self, footer):
        container = footer.getParent()
        if container is None:
            return
        shade = self.view_type(container.getContext())
        shade.setVisibility(8)
        shade.setImportantForAccessibility(2)
        container.addView(shade, container.indexOfChild(footer), self.frame_params(-1, 0, 83))
        self.footer_shades = [(f, s) for f, s in self.footer_shades if s.get() is not None]
        self.footer_shades.append((self.weak_reference(footer), self.weak_reference(shade)))

    def footer_shade(self, footer):
        if footer is not None:
            return next((s.get() for f, s in self.footer_shades if f.get() == footer), None)
        return None

    def layout_footer_shade(self, viewer, container, footer, enabled, photo=False):
        shade = self.footer_shade(footer)
        if shade is None:
            return
        if photo:
            shade.setVisibility(0)
            self.measure_panel_shadow(shade, container, self.dp(48))
            shade.setAlpha(0.0)
            return
        shade.setVisibility(0 if enabled else 8)
        if not enabled:
            return
        # Reserve caption space only when the caption is in the native bottom position.
        caption = self.caption_text.get(viewer)
        caption_at_top = self.top_caption(viewer) is not None
        caption_height = (min(self.dp(108 if container.getMeasuredWidth() > container.getMeasuredHeight() else 56),
                              caption.getMeasuredHeight())
                          if not caption_at_top and caption is not None and caption.getTag() is not None else 0)
        extension = min(self.dp(58), max(self.dp(28), container.getMeasuredHeight() // 10))
        extension = max(extension, caption_height + self.dp(12))
        height = min(container.getMeasuredHeight(), footer.getMeasuredHeight() + extension)
        if height <= 0:
            return
        if shade.getScaleY() != 1.0:
            shade.setScaleY(1.0)
        shade.setAlpha(float(self.action_bar.get(viewer).getAlpha()))
        self.measure_panel_shadow(shade, container, height)

    def measure_panel_shadow(self, shade, container, height):
        params = shade.getLayoutParams()
        params.height = height
        full_width = self.landscape_header is not None and self.landscape_header[1] == container
        left, right = container.getPaddingLeft(), container.getPaddingRight()
        params.leftMargin = -left if full_width else 0
        exact = self.measure_spec.EXACTLY
        width = container.getMeasuredWidth() - (0 if full_width else left + right)
        shade.measure(self.measure_spec.makeMeasureSpec(width, exact),
                      self.measure_spec.makeMeasureSpec(height, exact))

    def sync_footer_shadow(self, viewer, container):
        footer = self.background.get(viewer)
        shade = self.footer_shade(footer)
        if shade is None or shade.getVisibility() != 0 or shade.getHeight() <= 0:
            return
        navigation = self.navigation_bar.get(viewer)
        for panel in (footer, navigation):
            if panel is not None and panel.getBackground() is not None:
                self.manage_shadow_background(panel, True)
        strip = self.album_strip.get(viewer)
        bottom, base = shade.getBottom(), shade.getHeight()
        top = bottom - base
        strip_top = None
        if strip is not None and strip.getVisibility() == 0 and strip.hasPhotos() and strip.getAlpha() > 0.01:
            strip_top = strip.getY() - self.dp(20)
            top = min(top, strip_top)
        photo = self.option("photo_shadows") and self.photo_surface(viewer)
        alpha = float(self.action_bar.get(viewer).getAlpha())
        if photo:
            caption_top = self.visible_photo_caption_top(viewer)
            tops = [value for value in (strip_top, caption_top) if value is not None and value < bottom]
            alpha = alpha if tops else 0.0
            if tops:
                top = min(tops)
        if shade.getAlpha() != alpha:
            shade.setAlpha(alpha)
        if alpha <= 0:
            return
        height = min(bottom - container.getPaddingTop(), bottom - round(top))
        if height <= 0:
            return
        scale = height / base
        if abs(shade.getScaleY() - scale) > 0.0001 or shade.getPivotY() != base:
            shade.setPivotY(float(base))
            shade.setScaleY(float(scale))

    def visible_photo_caption_top(self, viewer):
        entry = self.top_caption(viewer)
        if entry is not None and entry.scroll is not None:
            return None
        scroll, text = self.caption.get(viewer), self.caption_text.get(viewer)
        if (scroll is None or text is None or text.getTag() is None or text.getVisibility() != 0
                or scroll.getVisibility() != 0 or scroll.getAlpha() <= 0.01):
            return None
        content = self.caption_content.get(viewer)
        if content is None:
            return None
        text_offset = max(0, content.getTop() - scroll.getScrollY() + text.getTranslationY())
        if text_offset >= scroll.getHeight():
            return None
        return scroll.getY() + text_offset - self.dp(26)

    def set_shadow_colors(self, drawable, stops):
        cached = getattr(self, "caption_shadow_stops", None)
        if cached != (drawable, stops):
            drawable.setColors(self.positions(stops))
            self.caption_shadow_stops = drawable, stops

    def shadow_profile_drawable(self, stops):
        drawable = self.pill_background(self.shadow_orientation, self.positions(stops))
        drawable.setAlpha(0)  # Retain the profile while the combined shadow does the drawing.
        return drawable

    def top_caption(self, viewer):
        return next((entry for entry in self.top_captions if entry.viewer_ref.get() == viewer), None)

    def make_header_shade(self, container, bar):
        shade = self.view_type(container.getContext())
        shade.setImportantForAccessibility(2)
        shade.setBackground(self.shadow_profile_drawable((CAPTION_SHADE_COLOR, SHADOW_GRAY)))
        container.addView(shade, max(0, container.indexOfChild(bar)), self.frame_params(-1, 0, 51))
        return shade

    def photo_header(self, viewer):
        return next((shade for ref, shade in self.photo_headers if ref.get() == viewer), None)

    def prepare_photo_header(self, viewer, container, enabled):
        shade = self.photo_header(viewer)
        bar = self.action_bar.get(viewer)
        if not enabled or bar is None:
            if shade is not None:
                self.photo_headers = [(ref, child) for ref, child in self.photo_headers if child != shade]
                if shade.getParent() == container:
                    container.removeView(shade)
            return
        if shade is None:
            shade = self.make_header_shade(container, bar)
            self.photo_headers.append((self.weak_reference(viewer), shade))

    def prepare_top_caption(self, viewer, container, enabled):
        entry = self.top_caption(viewer)
        scroll, switcher = self.caption.get(viewer), self.caption_text.get(viewer)
        header, bar = self.header_title.get(viewer), self.action_bar.get(viewer)
        message = viewer.getCurrentMessageObject() if enabled else None
        tag = switcher.getTag() if switcher is not None else None
        if message is None or message.isSponsored() or header is None or bar is None:
            self.restore_top_caption(viewer)
            return
        if (tag is None or scroll is None or scroll.getParent() != container
                or switcher.getParent() != self.caption_content.get(viewer)):
            scroll = None
        if not (message.isVideo() or message.isPhoto()):
            self.restore_top_caption(viewer)
            return
        if entry is None or entry.scroll != scroll:
            self.restore_top_caption(viewer)
            shade = self.make_header_shade(container, bar)
            viewer_ref = self.weak_reference(viewer)
            button = None
            if scroll is not None:
                button = self.make_button(container.getContext(), "展开说明", self.drawable.arrow_more)
                self.shrink_icon(button, (VIDEO_TOOL_SIZE - VIDEO_ICON_SIZE) // 2)
                button.setOnClickListener(OnClickListener(lambda _: self.toggle_caption(viewer_ref.get())))
                button.setVisibility(4)
                frame = self.frame_params(self.dp(VIDEO_TOOL_SIZE), self.dp(VIDEO_TOOL_SIZE), 53)
                frame.rightMargin = self.dp(8)
                container.addView(button, frame)
            entry = TopMediaCaption(viewer_ref, scroll, self.header_name.get(header),
                                    self.header_date.get(header), switcher, shade, button)
            self.top_captions.append(entry)
        self.update_caption_state(entry, self.caption_state_key(viewer, message))
        entry.title.setVisibility(4)
        if scroll is None:
            return
        if self.action_bar_visible.getBoolean(viewer):
            switcher.setVisibility(0)
        for text in (switcher.getCurrentView(), switcher.getNextView()):
            if text is None:
                continue
            if not any(saved == text for saved, *_ in entry.text_layouts):
                padding = (text.getPaddingLeft(), text.getPaddingTop(), text.getPaddingRight(), text.getPaddingBottom())
                original_spacing = text.isFallbackLineSpacing() if self.sdk >= 28 else None
                entry.text_layouts.append((text, text.getMaxLines(), text.getEllipsize(), padding, original_spacing))
            if text.getMaxLines() != 2147483647 or text.getEllipsize() is not None:
                text.setSingleLine(False)
                text.setMaxLines(2147483647)
                text.setEllipsize(None)
            self.style_caption_padding(text)

    def style_caption_padding(self, text):
        content = text.getText()
        quoted = False
        if self.spanned_class.isInstance(content):
            content = cast(self.spanned, content)
            quoted = len(content.getSpans(0, content.length(), self.quote_style)) > 0
        top, right = self.dp(8 if quoted else 2), self.dp(48 if quoted else 16)
        if text.getPaddingTop() != top or text.getPaddingRight() != right:
            text.setPadding(text.getPaddingLeft(), top, right, text.getPaddingBottom())
        if quoted and self.sdk >= 28 and not text.isFallbackLineSpacing():
            text.setFallbackLineSpacing(True)

    def find_group_caption(self, viewer, message):
        chat = self.parent_chat.get(viewer)
        caption_hidden = getattr(self, "caption_source_hidden", None)
        group = (chat.getGroup(message.getGroupId())
                 if chat is not None and chat.getDialogId() == message.getDialogId() else None)

        def allowed(item):
            return (not item.isRestrictedMessage and not item.isHiddenSensitive()
                    and (caption_hidden is None or not caption_hidden(item, chat, group)))

        source = album_caption_source(message, group.messages if group is not None else None,
                                      self.text_utils.isEmpty, allowed)
        if source is None:
            source = album_caption_source(message, self.album_messages.get(viewer), self.text_utils.isEmpty, allowed)
        return source

    def caption_state_key(self, viewer, message):
        inherited = getattr(self, "inherited_caption", None)
        if (inherited is not None and inherited[0] == viewer and inherited[2] is not None
                and same_thumbnail_item(inherited[1], message)):
            message = inherited[2]
        return message.getDialogId(), message.getId()

    def before_caption_change(self, param):
        viewer = param.thisObject
        self.clear_caption_exit(viewer)
        self.inherited_caption = None
        if self.caption_in_picker.getBoolean(viewer):
            return
        message = param.args[0]
        if (message is not None and (message.isPhoto() or message.isVideo()) and message.getGroupId()
                and self.text_utils.isEmpty(param.args[1])
                and ((message.isPhoto() and self.option("photo_shadows")) or (message.isVideo() and self.option("video_toolbar"))
                     or self.option("album_thumbnails"))):
            source = self.find_group_caption(viewer, message)
            caption = source.caption if source is not None else None
            self.inherited_caption = (viewer, message, source, caption)
            if source is not None:
                # The viewer formats rich text using the supplied message's native entities.
                param.args[0] = source
                param.args[1] = caption
                param.args[2] = self.boolean(False)
                param.args[3] = self.boolean(False)
        entry = self.top_caption(viewer)
        if entry is None:
            return
        # Lay out managed top captions before they are shown, without the native bottom transition.
        param.args[3] = self.boolean(False)
        scroll = entry.scroll
        if scroll is None:
            return
        if self.sdk >= 23:
            self.transition_manager.endTransitions(scroll)
        if not self.text_utils.isEmpty(param.args[1]):
            return
        container = scroll.getParent()
        width, height, alpha = scroll.getWidth(), scroll.getHeight(), float(scroll.getAlpha())
        if (container is None or width <= 0 or height <= 0 or alpha <= 0.01
                or scroll.getVisibility() != 0 or entry.switcher.getVisibility() != 0):
            return
        try:
            bitmap = self.bitmap.createBitmap(width, height, self.bitmap_config)
            canvas = self.canvas(bitmap)
            canvas.translate(0.0, float(-scroll.getScrollY()))
            scroll.draw(canvas)
        except Exception as error:
            self.log(f"Caption exit snapshot unavailable: {type(error).__name__}")
            return
        overlay = self.image_view(container.getContext())
        overlay.setImportantForAccessibility(2)
        overlay.setImageBitmap(bitmap)
        overlay.setScaleType(self.fit_center)
        overlay.setTranslationX(scroll.getTranslationX())
        overlay.setTranslationY(scroll.getTranslationY())
        overlay.setAlpha(alpha)
        frame = self.frame_params(width, height, 51)
        frame.leftMargin = scroll.getLeft() - container.getPaddingLeft()
        frame.topMargin = scroll.getTop()
        container.addView(overlay, frame)
        shade_height = entry.shade.getHeight()
        shade_colors = tuple(entry.shade.getBackground().getColors()) if shade_height > 0 else ()
        self.caption_exit = (entry.viewer_ref, overlay, alpha, shade_height, shade_colors)
        overlay.animate().alpha(0.0).translationY(float(scroll.getTranslationY() - self.dp(8))).setDuration(150).start()
        run_on_ui_thread(lambda: self.clear_caption_exit(viewer, overlay), 170)

    def after_caption_change(self, param):
        viewer = param.thisObject
        if self.caption_in_picker.getBoolean(viewer):
            return
        enabled = ((self.option("video_toolbar") and self.video_surface(viewer))
                   or (self.option("photo_shadows") and self.photo_surface(viewer)))
        if not enabled and self.top_caption(viewer) is None:
            return
        container = self.viewer_container.get(viewer)
        if container is not None:
            container.requestLayout()

    def refresh_inherited_caption(self, param):
        state = self.inherited_caption
        if (state is None or state[0] != param.thisObject or int(param.args[0]) != self.media_loaded_event):
            return
        viewer, message, previous_source, previous = state
        if not viewer.isVisible() or not same_thumbnail_item(viewer.getCurrentMessageObject(), message):
            return
        source = self.find_group_caption(viewer, message)
        caption = source.caption if source is not None else None
        if not same_thumbnail_item(previous_source, source) or not self.text_utils.equals(previous, caption):
            self.call(viewer, "setCurrentCaption", message, None, self.boolean(False), self.boolean(False))

    def clear_caption_exit(self, viewer=None, overlay=None):
        exit_state = self.caption_exit
        if (exit_state is None or (viewer is not None and exit_state[0].get() != viewer)
                or (overlay is not None and exit_state[1] != overlay)):
            return
        self.caption_exit = None
        child = exit_state[1]
        child.animate().cancel()
        parent = child.getParent()
        if parent is not None:
            parent.removeView(child)
            parent.requestLayout()

    def update_caption_state(self, entry, key):
        if entry.caption_key == key:
            return
        entry.caption_key = key
        entry.expanded = entry.has_more = False
        entry.touch = None
        entry.arrow_pressed = False
        entry.reset_scroll_on_measure = False
        self.update_caption_button(entry)
        if entry.scroll is not None:
            entry.scroll.stopScrolling()
            entry.scroll.scrollTo(0, 0)

    def update_caption_button(self, entry):
        button = entry.button
        if button is None:
            return
        self.sync_caption_button(entry)
        rotation = 180.0 if entry.expanded else 0.0
        if button.getRotation() != rotation:
            button.setRotation(rotation)
            label = "收起说明" if entry.expanded else "展开说明"
            button.setContentDescription(label)
            if self.sdk >= 26:
                button.setTooltipText(label)

    def sync_caption_button(self, entry):
        if entry.button is None:
            return
        button, scroll = entry.button, entry.scroll
        alpha = float(scroll.getAlpha())
        visibility = 0 if entry.has_more and scroll.getVisibility() == 0 and alpha > 0.01 else 4
        if button.getVisibility() != visibility:
            button.setVisibility(visibility)
        if visibility == 0:
            button.setAlpha(alpha)
            button.setTranslationY(scroll.getTranslationY())

    def restore_top_caption(self, viewer):
        entry = self.top_caption(viewer)
        if entry is None:
            return
        self.top_captions.remove(entry)
        if entry.scroll is not None:
            params = entry.scroll.getLayoutParams()
            params.gravity, params.leftMargin, params.topMargin, params.rightMargin = entry.original_frame
            entry.scroll.setFadingEdgeLength(entry.original_fade)
        entry.title.setVisibility(entry.title_visibility)
        entry.subtitle.setTranslationX(entry.subtitle_translation_x)
        entry.subtitle.setTranslationY(entry.subtitle_translation)
        message = viewer.getCurrentMessageObject()
        if (entry.scroll is not None and message is not None
                and entry.caption_key == self.caption_state_key(viewer, message)):
            entry.switcher.setVisibility(entry.caption_visibility)
        for text, lines, ellipsize, padding, original_spacing in entry.text_layouts:
            text.setSingleLine(lines == 1)
            text.setMaxLines(lines)
            text.setEllipsize(ellipsize)
            text.setPadding(*padding)
            if original_spacing is not None and text.isFallbackLineSpacing() != original_spacing:
                text.setFallbackLineSpacing(original_spacing)
        parent = entry.shade.getParent()
        if parent is not None:
            parent.removeView(entry.shade)
        if entry.button is not None and entry.button.getParent() is not None:
            entry.button.getParent().removeView(entry.button)
        if entry.scroll is not None:
            self.caption_previous_height.setInt(entry.scroll, -1)
            entry.scroll.requestLayout()

    def pin_caption_top(self, param):
        if self.managed_caption_scroll(param.thisObject) is not None:
            param.setResult(self.integer(0))

    def managed_caption_scroll(self, scroll):
        container = scroll.getParent()
        if container is not None and self.drawer_type.isInstance(container):
            entry = self.top_caption(self.outer.get(container))
            if entry is not None and entry.scroll == scroll:
                return entry
        return None

    def caption_top_fade(self, param):
        scroll = param.thisObject
        if self.managed_caption_scroll(scroll) is not None and scroll.getScrollY() <= 0:
            param.setResult(self.float_value(0.0))

    def caption_bottom_fade(self, param):
        scroll = param.thisObject
        entry = self.managed_caption_scroll(scroll)
        if entry is not None and not entry.preview_fade and (not entry.has_more or not scroll.canScrollVertically(1)):
            param.setResult(self.float_value(0.0))

    def sync_caption_shadow(self, param):
        container = param.thisObject
        self.step_status_slide(container)
        viewer = self.outer.get(container)
        entry = self.top_caption(viewer)
        shade = entry.shade if entry is not None else self.photo_header(viewer)
        if shade is not None:
            bar = self.action_bar.get(viewer)
            if bar.getBackground() is not None:
                self.manage_shadow_background(bar, True)
            alpha = float(bar.getAlpha())
            if shade.getAlpha() != alpha:
                shade.setAlpha(alpha)
        if entry is not None:
            if entry.scroll is not None:
                upper_slide = (alpha - 1.0) * self.dp(24)
                if abs(entry.scroll.getTranslationY() - upper_slide) >= 0.25:
                    entry.scroll.setTranslationY(float(upper_slide))
            self.sync_caption_button(entry)
            if entry.scroll is None:
                self.update_caption_exit_shadow(viewer, entry, self.action_bar.get(viewer).getMeasuredHeight())
        self.sync_thumbnail_visibility(viewer)
        self.sync_thumbnail_caption_mask(viewer)
        rail = getattr(self, "thumbnail_rail", None)
        if rail is not None and rail.container == container:
            self.sync_thumbnail_handle(rail)
        self.sync_footer_shadow(viewer, container)
        self.draw_player_shadows(param.args[0], viewer, container, shade, rail)

    def shade_span(self, view, stops):
        if view is None or view.getVisibility() != 0 or view.getAlpha() <= 0.01 or view.getHeight() <= 0:
            return None
        scale = view.getScaleY()
        if scale <= 0:
            return None
        top = view.getY() + view.getPivotY() * (1.0 - scale)
        return top, top + view.getHeight() * scale, stops

    def draw_player_shadows(self, canvas, viewer, container, header, rail):
        bar = self.action_bar.get(viewer)
        if bar is None or bar.getAlpha() <= 0.01:
            return
        width, height = container.getWidth(), container.getHeight()
        if width <= 0 or height <= 0:
            return
        upper = None
        if header is not None:
            drawable = header.getBackground()
            if drawable is not None:
                cached = self.caption_shadow_stops
                stops = cached[1] if cached is not None and cached[0] == drawable else tuple(drawable.getColors())
                upper = self.shade_span(header, stops)
        elif any(ref.get() == bar and gradient is not None for ref, _, gradient in self.shadows):
            upper = self.shade_span(bar, self.header_shadow_stops)
        lower = self.shade_span(self.footer_shade(self.background.get(viewer)), self.footer_shadow_stops)
        side = None
        if rail is not None and rail.container == container and rail.ready and rail.height > rail.mask_top:
            visible = self.visible_thumbnail_width(rail)
            if visible > 0:
                reach = self.dp(56)
                top, bottom = max(0, rail.top - reach), min(height, rail.top + rail.height + reach)
                if bottom > top:
                    left = max(0, rail.left + rail.tile_width - visible - self.dp(28))
                    fade = min(reach, (bottom - top) * 0.4)
                    opacity = 136 * smoothstep(visible / self.dp(36))
                    opacity *= smoothstep((rail.height - rail.mask_top) / self.dp(36))
                    side = (left, top, bottom, self.dp(72), fade, opacity)
        if upper is None and lower is None and side is None:
            return
        key = (width, height, upper, lower, side)
        if self.player_shadow_cache is None or self.player_shadow_cache[0] != key:
            sample = self.dp(4)
            cols, rows = max(2, (width + sample - 1) // sample), max(2, (height + sample - 1) // sample)
            pixels = player_shadow_pixels(width, height, cols, rows, upper, lower, side)
            bitmap = self.bitmap.createBitmap(self.positions(pixels), cols, rows, self.bitmap_config)
            self.player_shadow_cache = key, bitmap
        self.player_shadow_rect.set(0.0, 0.0, float(width), float(height))
        self.player_shadow_paint.setAlpha(round(255 * float(bar.getAlpha())))
        canvas.drawBitmap(self.player_shadow_cache[1], None, self.player_shadow_rect, self.player_shadow_paint)

    def measure_top_caption(self, viewer, container, entry):
        bar = self.action_bar.get(viewer)
        header = bar.getMeasuredHeight()
        width = container.getMeasuredWidth() - container.getPaddingLeft() - container.getPaddingRight()
        caption_height = self.measure_caption_viewport(viewer, container, entry, header, width) if entry.scroll is not None else 0
        text_bottom = header + caption_height
        shadow_height = text_bottom + self.dp(30)
        exit_height = self.update_caption_exit_shadow(viewer, entry, header) if entry.scroll is None else 0
        if exit_height:
            shadow_height = exit_height
        else:
            self.set_caption_shadow_shape(entry.shade, header, text_bottom, shadow_height)
        self.measure_panel_shadow(entry.shade, container, shadow_height)
        entry.shade.setAlpha(float(bar.getAlpha()))

    def update_caption_exit_shadow(self, viewer, entry, header):
        state = self.caption_exit
        if state is None or state[0].get() != viewer:
            return 0
        _, overlay, initial_alpha, old_height, old_colors = state
        short_height = header + self.dp(30)
        if old_height <= short_height or len(old_colors) != 65:
            return 0
        remaining = max(0.0, min(1.0, overlay.getAlpha() / initial_alpha))
        short_profile = caption_shadow_profile(header, header, short_height, old_height)
        colors = tuple(caption_shadow_color(remaining * ((old >> 24) & 255) + (1.0 - remaining) * target)
                       for old, target in zip(old_colors, short_profile))
        self.set_shadow_colors(entry.shade.getBackground(), colors)
        return old_height

    def measure_photo_header(self, viewer, container, shade):
        bar = self.action_bar.get(viewer)
        header = bar.getMeasuredHeight()
        height = header + self.dp(30)
        self.set_caption_shadow_shape(shade, header, header, height)
        self.measure_panel_shadow(shade, container, height)
        shade.setAlpha(float(bar.getAlpha()))

    def measure_caption_viewport(self, viewer, container, entry, header_height, width):
        switcher = entry.switcher
        text = switcher.getCurrentView()
        frame = entry.scroll.getLayoutParams()
        frame.gravity, frame.topMargin = 51, header_height
        # CaptionTextView already supplies 16 dp of horizontal text padding.
        if container.getMeasuredWidth() > container.getMeasuredHeight():
            reserved = self.thumbnail_right_reservation(viewer)
            gutter = landscape_gutter(self.dp, width - reserved)
            frame.leftMargin = max(0, gutter - self.dp(16))
            frame.rightMargin = max(reserved + gutter, width - frame.leftMargin - self.dp(560))
            button_margin = reserved + gutter
        else:
            frame.leftMargin = frame.rightMargin = 0
            button_margin = self.dp(8)
        button_frame = entry.button.getLayoutParams()
        button_frame.rightMargin = button_margin
        exact = self.measure_spec.EXACTLY
        unbounded = self.measure_spec.makeMeasureSpec(0, self.measure_spec.UNSPECIFIED)
        width_spec = self.measure_spec.makeMeasureSpec(max(1, width - frame.leftMargin - frame.rightMargin), exact)
        text.measure(width_spec, unbounded)
        layout = text.getLayout()
        if layout is not None and layout.getLineCount() > 4:
            frame.rightMargin = max(frame.rightMargin, button_frame.width + button_margin)
            width_spec = self.measure_spec.makeMeasureSpec(max(1, width - frame.leftMargin - frame.rightMargin), exact)
            text.measure(width_spec, unbounded)
            layout = text.getLayout()
            button_frame.topMargin = header_height + max(0, text.getTotalPaddingTop()
                + (layout.getLineTop(0) + layout.getLineBottom(0) - button_frame.height) // 2)
        total = text.getMeasuredHeight() + switcher.getPaddingBottom()
        controls = self.controls.get(viewer)
        footer = self.dp(16)
        if controls is not None and controls.getVisibility() == 0:
            footer += controls.getMeasuredHeight() + max(0, controls.getLayoutParams().bottomMargin)
        available = container.getMeasuredHeight() - container.getPaddingBottom() - frame.topMargin - footer
        height, entry.has_more, entry.preview_fade = caption_viewport(
            layout, total, available, text.getTotalPaddingTop(), self.dp(2), entry.expanded)
        entry.collapsed_height = (caption_viewport(layout, total, available, text.getTotalPaddingTop(), self.dp(2), False)[0]
                                  if entry.expanded else height)
        self.update_caption_button(entry)
        fade_length = entry.preview_fade or entry.original_fade
        if entry.scroll.getVerticalFadingEdgeLength() != fade_length:
            entry.scroll.setFadingEdgeLength(fade_length)
        self.caption_content.get(viewer).getLayoutParams().topMargin = 0
        entry.scroll.measure(width_spec, self.measure_spec.makeMeasureSpec(height, exact))
        if entry.reset_scroll_on_measure:
            entry.reset_scroll_on_measure = False
            entry.scroll.scrollTo(0, 0)
        return height

    def set_caption_shadow_shape(self, panel, header, text_bottom, height):
        colors = tuple(caption_shadow_color(alpha) for alpha in caption_shadow_profile(header, text_bottom, height))
        self.set_shadow_colors(panel.getBackground(), colors)

    def hide_native_caption_backdrop(self, param):
        viewer = param.thisObject
        if self.top_caption(viewer) is not None or self.photo_header(viewer) is not None:
            param.setResult(None)

    def align_caption_date(self, viewer):
        entry = self.top_caption(viewer)
        if entry is None:
            return False
        back = self.header_back.get(viewer)
        if back is not None and back.getHeight() > 0:
            subtitle = entry.subtitle
            back_location, date_location = self.positions([0, 0]), self.positions([0, 0])
            back.getLocationInWindow(back_location)
            subtitle.getLocationInWindow(date_location)
            delta = back_location[1] + back.getHeight() / 2 - date_location[1] - subtitle.getHeight() / 2
            if abs(delta) >= 1:
                subtitle.setTranslationY(float(subtitle.getTranslationY() + delta))
            natural_left = date_location[0] - subtitle.getTranslationX()
            target_x = back_location[0] + back.getWidth() + self.dp(8) - natural_left
            if self.landscape_header is not None and self.landscape_header[0] == viewer:
                target_x = max(entry.subtitle_translation_x, target_x)
            if abs(subtitle.getTranslationX() - target_x) >= 1:
                subtitle.setTranslationX(float(target_x))
                return True
        return False

    def hide_native_caption_shadow(self, param):
        self.caption_shadow_stack.append(None)
        caption = param.thisObject
        container = caption.getParent()
        if container is None or not self.drawer_type.isInstance(container):
            return
        viewer = self.outer.get(container)
        shade = self.footer_shade(self.background.get(viewer))
        if (self.top_caption(viewer) is None and self.photo_header(viewer) is None
                and (shade is None or shade.getVisibility() != 0)):
            return
        self.caption_shadow_stack[-1] = (caption, self.caption_alpha.getFloat(caption))
        self.caption_alpha.setFloat(caption, 0.0)

    def expand_landscape_caption(self, param):
        margin = int(param.getResult())
        if margin < 0:
            return
        scroll = param.thisObject
        container = scroll.getParent()
        if container is None or not self.drawer_type.isInstance(container):
            return
        viewer = self.outer.get(container)
        if self.top_caption(viewer) is not None:
            return
        compact = self.compact_control(viewer)
        switcher = self.caption_text.get(viewer)
        if compact is None or compact.getVisibility() != 0 or switcher is None:
            return
        text = switcher.getCurrentView()
        layout = text.getLayout() if text is not None else None
        if layout is None or layout.getLineCount() == 0:
            return
        lines = 0
        for index in range(min(5, layout.getLineCount())):
            if layout.getLineVisibleEnd(index) > layout.getLineStart(index):
                lines += 1
                if lines == 3:
                    break
        height = int(param.args[1])
        lines_height = layout.getLineBottom(index) + text.getCompoundPaddingTop() + text.getCompoundPaddingBottom()
        preview = min(self.dp(108), lines_height + switcher.getPaddingBottom() + self.dp(6))
        param.setResult(self.integer(min(margin, max(0, height - preview))))

    def restore_native_caption_shadow(self, param):
        entry = self.caption_shadow_stack.pop()
        if entry is not None:
            self.caption_alpha.setFloat(*entry)

    def after_controls_progress(self, param):
        control = param.thisObject
        viewer = self.control_outer.get(control)
        progress = float(param.args[0])
        self.position_collapsed_scrubber(viewer, control, progress)
        self.refresh_fullscreen_button(viewer, progress)

    def position_collapsed_scrubber(self, viewer, control, progress=None):
        if control is None or not control.isSeekBarTransitionEnabled():
            return
        button = self.fullscreen_control(viewer)
        seek = self.video_seek_view.get(viewer)
        container = control.getParent()
        offset = 0.0
        if (button is not None and button.getVisibility() == 0 and seek is not None
                and seek.getParent() == control and seek.getHeight() > 0 and container is not None):
            progress = float(control.getProgress()) if progress is None else progress
            content_bottom = container.getHeight() - container.getPaddingBottom()
            bar_bottom = control.getTop() + seek.getBottom() - self.dp(NATIVE_THIN_BAR_BOTTOM_GAP)
            offset = max(0, content_bottom - bar_bottom) * (1.0 - progress)
        if control.getTranslationY() != offset:
            control.setTranslationY(float(offset))

    def fit_header(self, viewer, date_shifted=False):
        title, menu = self.header_title.get(viewer), self.header_menu.get(viewer)
        if title is None:
            return
        caption = self.top_caption(viewer)
        if (caption is None and not self.footer_active(viewer)) or menu is None:
            self.clear_title_clip(title, viewer)
            return
        width = title.getWidth()
        if width <= 0 or title.getHeight() <= 0:
            return
        title_location = self.positions([0, 0])
        item_location = self.positions([0, 0])
        title.getLocationInWindow(title_location)
        edge = max(0, width - self.dp(12))
        first_icon = None
        for index in range(menu.getChildCount()):
            item = menu.getChildAt(index)
            if item.getVisibility() == 0 and item.getWidth() > 0 and item.getAlpha() > 0.01:
                item.getLocationInWindow(item_location)
                left = item_location[0] - title_location[0]
                first_icon = left if first_icon is None else min(first_icon, left)
        if first_icon is not None:
            edge = min(edge, max(0, first_icon - self.dp(8)))
        bounds = title.getClipBounds()
        if date_shifted or bounds is None or bounds.right != edge or bounds.bottom != title.getHeight():
            shift = caption.subtitle.getTranslationX() - caption.subtitle_translation_x if caption is not None else 0
            title.updateRightPadding(float(max(0, width - edge + shift)), False)
            title.setClipBounds(self.rect(0, 0, edge, title.getHeight()))
            self.clipped_titles = [(t, v) for t, v in self.clipped_titles if t.get() is not None]
            if not any(t.get() == title for t, _ in self.clipped_titles):
                self.clipped_titles.append((self.weak_reference(title), self.weak_reference(viewer)))

    def clear_title_clip(self, title, viewer):
        for index, (ref, _) in enumerate(self.clipped_titles):
            if ref.get() == title:
                self.clipped_titles.pop(index)
                title.setClipBounds(None)
                self.call(viewer, "updateActionBarTitlePadding")
                return

    def after_container_measure(self, param):
        container = param.thisObject
        viewer = self.outer.get(container)
        window = self.window.get(viewer)
        if window is None or container.getParent() != window:
            return

        lift, tap_inset = 0, 0
        controls = self.controls.get(viewer)
        show_row = False
        if controls is not None and self.video_surface(viewer):
            lift, tap_inset = self.footer_lift(viewer, window, container)
            show_row = True
        album = self.dock_album_strip(viewer, window, container, tap_inset if show_row else None)
        if show_row:
            lift, tap_inset = max(lift, album), max(tap_inset, album)
        elif album and controls is not None and self.video_surface(viewer):
            lift = max(lift, album)
        background = self.background.get(viewer)
        row = self.lookup_row(background)
        if row is not None:
            toolbar_active = show_row and self.option("video_toolbar")
            show_row = toolbar_active and background.getVisibility() != 8
            compact = self.compact_control(viewer)
            use_compact = compact is not None and compact.getVisibility() == 0
            row.setVisibility(0 if show_row and not use_compact else 8)
            if show_row:
                if not use_compact:
                    lift, bottom_margin = row_spacing(self.row_height, lift, tap_inset, self.bottom_gap)
                    row.getLayoutParams().bottomMargin = bottom_margin
                else:
                    lift = album
                self.hide_header(self.video_menu.get(viewer))
                self.hide_floating_fullscreen(viewer)
                self.refresh_row(viewer)
                self.hide_center_accessibility(viewer)
            else:
                self.refresh_zoom(viewer)
                menu = self.video_menu.get(viewer)
                if menu is not None and not toolbar_active:
                    self.restore_header(menu, self.has_player(viewer))
                if not self.option("video_toolbar"):
                    lift = album
        self.margins = [entry for entry in self.margins if entry.reference.get() is not None]
        top_caption = self.top_caption(viewer)
        extra_height = max(0, controls.getLayoutParams().height - self.dp(48)) if controls is not None else 0
        for footer_field, native_measures_margin in self.footer_fields:
            if top_caption is not None and top_caption.scroll is not None and footer_field == self.caption:
                continue
            view = footer_field.get(viewer)
            if album and view == self.album_strip.get(viewer):
                continue
            if view is not None and view.getParent() == container:
                self.apply_margin(view, lift if view == controls else lift + extra_height,
                                  native_measures_margin and view.getVisibility() != 8)

        if lift or extra_height:
            # Expand the background upward from its native bottom, filling the gap.
            self.resize_footer(background, container, lift + extra_height)
            if top_caption is None or top_caption.scroll is None:
                self.resize_footer(self.caption.get(viewer), container, -lift - extra_height)
        if row is not None and row.getVisibility() == 0:
            exact = self.measure_spec.EXACTLY
            width = portrait_toolbar_width(self.dp, background.getMeasuredWidth() - background.getPaddingLeft()
                                           - background.getPaddingRight())
            row.getLayoutParams().width = width
            row.measure(self.measure_spec.makeMeasureSpec(width, exact),
                        self.measure_spec.makeMeasureSpec(self.row_height, exact))
        if top_caption is not None:
            self.measure_top_caption(viewer, container, top_caption)
        photo_shade = self.photo_header(viewer)
        if photo_shade is not None:
            self.measure_photo_header(viewer, container, photo_shade)
        self.layout_footer_shade(viewer, container, background,
                                 show_row and row is not None,
                                 photo=self.option("photo_shadows") and self.photo_surface(viewer))
        self.measure_portrait_thumbnail_rail(viewer, container)

    def dock_album_strip(self, viewer, window, container, nav_inset):
        rail = getattr(self, "thumbnail_rail", None)
        if rail is not None and rail.viewer == viewer and rail.ready:
            return 0
        strip = self.album_strip.get(viewer)
        if (not self.option("album_thumbnails") or strip is None or strip.getParent() != container
                or strip.getVisibility() != 0 or not strip.hasPhotos()
                or not (self.video_surface(viewer) or self.photo_surface(viewer))):
            return 0
        if nav_inset is None:
            _, nav_inset = self.footer_lift(viewer, window, container)
        params = strip.getLayoutParams()
        self.apply_margin(strip, nav_inset - params.bottomMargin, True)
        return strip.getMeasuredHeight() + nav_inset

    def resize_footer(self, view, container, delta):
        if view is None or view.getParent() != container or view.getVisibility() == 8:
            return
        exact = self.measure_spec.EXACTLY
        width = self.measure_spec.makeMeasureSpec(view.getMeasuredWidth(), exact)
        height = self.measure_spec.makeMeasureSpec(max(0, view.getMeasuredHeight() + delta), exact)
        view.measure(width, height)

    def apply_margin(self, view, lift, fresh_base):
        params = view.getLayoutParams()
        for entry in self.margins:
            if entry.reference.get() == view:
                entry.update(params, lift, fresh_base)
                return
        if lift:
            entry = ControlMargin(self.weak_reference(view), params.bottomMargin)
            entry.update(params, lift)
            self.margins.append(entry)

    def on_plugin_unload(self):
        if not hasattr(self, "hooks"):
            return
        self.active = False
        for hook in self.hooks:
            self.unhook_method(hook)
        margins, self.margins = self.margins, []
        rows, self.rows = self.rows, []
        zoom_buttons, self.zoom_buttons = self.zoom_buttons, []
        fullscreen_controls, self.fullscreen_controls = self.fullscreen_controls, []
        compact_controls, self.compact_controls = self.compact_controls, []
        shadows, self.shadows = self.shadows, []
        footer_shades, self.footer_shades = self.footer_shades, []
        header_icons, self.header_icons = self.header_icons, []
        clipped_titles, self.clipped_titles = self.clipped_titles, []
        gears, self.gear_state = self.gear_state, []
        popup_rows, self.popup_rows = self.popup_rows, []
        popup_colors, self.popup_colors = self.popup_colors, []

        def restore():
            self.finish_status_slide()
            self.clear_thumbnail_preload()
            self.remove_thumbnail_rail()
            self.pending_chat_jump = None
            self.pending_sidebar_chat = None
            self.opening_chat_viewport = None
            self.pending_chat_reflow = None
            self.pending_media_library = None
            if self.library_return is not None:
                self.remove_library_selection(self.library_return)
            self.library_return = self.library_resume = None
            self.restore_return_seek_preview()
            self.stop_library_preview()
            self.clear_caption_exit()
            self.restore_held_speed()
            self.stop_media_rotation()
            self.restore_landscape_header()
            self.restore_header_buttons()
            for _, shade in self.photo_headers:
                if shade.getParent() is not None:
                    shade.getParent().removeView(shade)
            self.photo_headers.clear()
            for saved in self.album_styles:
                strip = saved[0].get()
                if strip is not None:
                    self.apply_album_style(strip, saved, False, False)
                    strip.requestLayout()
            self.album_styles.clear()
            for entry in self.top_captions[:]:
                viewer = entry.viewer_ref.get()
                if viewer is not None:
                    self.restore_top_caption(viewer)
            self.restore_volume()
            self.restore_brightness()
            self.remove_level_hud()
            for saved in reversed(popup_rows):
                self.restore_popup_row(saved)
            for ref, color in popup_colors:
                layout = ref.get()
                if layout is not None:
                    layout.setBackgroundColor(color)
            for _, shade_ref in footer_shades:
                shade = shade_ref.get()
                if shade is not None and shade.getParent() is not None:
                    shade.getParent().removeView(shade)
            for ref, scale_x, scale_y in header_icons:
                icon = ref.get()
                if icon is not None:
                    icon.setScaleX(scale_x)
                    icon.setScaleY(scale_y)
            for ref, original, gradient in shadows:
                panel = ref.get()
                if panel is not None and panel.getBackground() == gradient:
                    panel.setBackground(original)
            for _, compact_ref in compact_controls:
                compact = compact_ref.get()
                if compact is not None and compact.getParent() is not None:
                    compact.getParent().removeView(compact)
            for title_ref, viewer_ref in clipped_titles:
                title, viewer = title_ref.get(), viewer_ref.get()
                if title is not None:
                    title.setClipBounds(None)
                    if viewer is not None:
                        self.call(viewer, "updateActionBarTitlePadding")
            for viewer_ref, button_ref, play_ref in fullscreen_controls:
                viewer, button = viewer_ref.get(), button_ref.get()
                play = play_ref.get()
                if play is not None and play.getParent() is not None:
                    play.getParent().removeView(play)
                if button is not None and button.getParent() is not None:
                    button.getParent().removeView(button)
                if viewer is not None:
                    controls = self.controls.get(viewer)
                    if controls is not None:
                        if controls.isSeekBarTransitionEnabled():
                            controls.setTranslationY(0.0)
                        controls.getLayoutParams().height = self.dp(48)
                        self.restore_scrubber_view(self.video_seek_view.get(viewer))
                        controls.requestLayout()
                    self.restore_time(self.video_time.get(viewer))
                    viewer.checkFullscreenButton()
            session = self.fullscreen_session
            if session is not None:
                viewer = session[0].get()
                if viewer is not None:
                    self.close_fullscreen(viewer)
            if self.axis_lock is not None:
                viewer = self.axis_lock[0].get()
                if viewer is not None:
                    self.clear_playback_axis(viewer)
            for ref, visibility, anchor_ref, above, side, offset in gears:
                menu = ref.get()
                if menu is not None:
                    self.restore_menu(menu, visibility, anchor_ref, above, side, offset)
            for _, button_ref in zoom_buttons:
                button = button_ref.get()
                if button is not None and button.getParent() is not None:
                    button.getParent().removeView(button)
            for background_ref, row_ref in rows:
                background, row = background_ref.get(), row_ref.get()
                if background is not None and row is not None and row.getParent() == background:
                    background.removeView(row)
            for entry in margins:
                view = entry.reference.get()
                if view is not None and view.getLayoutParams() is not None:
                    entry.update(view.getLayoutParams(), 0)
                    view.requestLayout()

        run_on_ui_thread(restore)


PRESETS = (15, 30, 45, 60, 90, 120)
MENU_ID = 65347
STATE_ENDED = 4
VIDEO_SHEET_COLOR = 0xF21C2229 - (1 << 32)
VIDEO_TIMER_BLUE = 0xFF62AFF5 - (1 << 32)
AUDIO_TIMER_BLUE = 0xFF216BC2 - (1 << 32)
AUDIO_ROW_HEIGHT = 48


def resolve_method(owner, name, arity):
    result, = (m for m in owner.getDeclaredMethods()
               if m.getName() == name and len(m.getParameterTypes()) == arity)
    result.setAccessible(True)
    return result


def resolve_field(owner, name):
    result = owner.getDeclaredField(name)
    result.setAccessible(True)
    return result


def duration_minutes(selection, custom):
    if 0 <= selection < len(PRESETS):
        return PRESETS[selection]
    try:
        minutes = int(custom)
    except ValueError:
        return None
    return minutes if 1 <= minutes <= 1440 else None


def format_timer_time(seconds):
    hours, rest = divmod(seconds, 3600)
    minutes, seconds = divmod(rest, 60)
    return f"{hours}:{minutes:02d}:{seconds:02d}" if hours else f"{minutes:02d}:{seconds:02d}"


def audio_slots(width, padding, count):
    usable = max(0, width - 2 * padding)
    edges = [padding + usable * index // count for index in range(count + 1)]
    return list(zip(edges, edges[1:]))


def centered_audio_slots(width, padding, left_count, right_count):
    available = max(0, width - 2 * padding)
    slot = available // (2 * max(1, left_count, right_count) + 1)
    start = (width - slot) // 2
    center = (start, start + slot)
    left = [(padding + first, padding + last)
            for first, last in audio_slots(start - padding, 0, left_count)] if left_count else []
    right = [(center[1] + first, center[1] + last)
             for first, last in audio_slots(width - padding - center[1], 0, right_count)] if right_count else []
    return [*left, center, *right]


class MediaSleepTimer(PluginFeature):
    def on_plugin_load(self):
        self.active = True
        self.session = None
        self.waiting = None
        self.last_minutes = duration_minutes(-1, str(self.get_setting("sleep_timer_minutes", 60))) or 60
        self.last_finish = bool(self.get_setting("sleep_timer_finish_current", False))
        self.menus = []
        self.audio_rows = []
        self.dialog = None
        self.dialog_is_sheet = False
        self.editor_dialog = None
        self.dialog_viewer = None
        self.dialog_generation = 0
        self.hooks = []
        self.weak = jclass("java.lang.ref.WeakReference")
        self.clock = jclass("android.os.SystemClock")
        self.handler = jclass("android.os.Handler")(jclass("android.os.Looper").getMainLooper())
        self.tick_runnable = R(self.run_tick)
        self.countdown_runnable = R(self.run_countdown)
        controller = jclass("org.telegram.messenger.MediaController")
        self.controller = controller.getInstance()
        self.audio_player = resolve_field(controller.getClass(), "audioPlayer")
        viewer = jclass("org.telegram.ui.PhotoViewer").getClass()
        video_player = jclass("org.telegram.ui.Components.VideoPlayer").getClass()
        audio_ui = jclass("org.telegram.ui.Components.AudioPlayerAlert").getClass()
        menu = jclass("org.telegram.ui.ActionBar.ActionBarMenuItem").getClass()
        self.video_menu = resolve_field(viewer, "videoItem")
        self.loop_item = resolve_field(viewer, "loopItem")
        self.viewer_window = resolve_field(viewer, "windowView")
        self.current_index = resolve_field(viewer, "currentIndex")
        self.manually_paused = resolve_field(viewer, "manuallyPaused")
        self.native_alert = jclass("org.telegram.ui.ActionBar.AlertDialog$Builder")
        self.dialog_option_listener = jclass("android.content.DialogInterface$OnClickListener")
        self.timer_labels = jarray(jclass("java.lang.CharSequence"))
        self.timer_layout = jclass("android.widget.LinearLayout")
        self.layout_helper = jclass("org.telegram.ui.Components.LayoutHelper")
        self.toast = jclass("android.widget.Toast")
        drawables = jclass("org.telegram.messenger.R$drawable")
        self.clock_icon = drawables.msg_timer
        self.track_icons = (drawables.baseline_skip_previous_24_white, drawables.baseline_skip_next_24_white)
        self.audio_native_buttons = resolve_field(audio_ui, "buttons")
        self.audio_layout = resolve_field(audio_ui, "playerLayout")
        self.audio_speed = resolve_field(audio_ui, "playbackSpeedButton")
        self.audio_title_color = resolve_field(audio_ui, "forwardButton")
        self.audio_profile_add = resolve_field(audio_ui, "saveToProfileButton")
        self.audio_profile_remove = resolve_field(audio_ui, "unsaveFromProfileButton")
        self.audio_shadow = resolve_field(audio_ui, "playerShadow")
        self.audio_list = resolve_field(audio_ui, "listView")
        self.audio_noforwards = resolve_field(audio_ui, "noforwards")
        self.audio_my_list = resolve_method(audio_ui, "isMyList", 0)
        self.audio_update_title = resolve_method(audio_ui, "updateTitle", 1)
        self.object_args = jarray(jclass("java.lang.Object"))
        self.boolean = jclass("java.lang.Boolean")
        self.image_view = jclass("android.widget.ImageView")
        self.text_view = jclass("android.widget.TextView")
        self.frame_layout = jclass("android.widget.FrameLayout")
        self.measure_spec = jclass("android.view.View$MeasureSpec")
        self.sdk = int(jclass("android.os.Build$VERSION").SDK_INT)
        self.center = jclass("android.widget.ImageView$ScaleType").CENTER
        self.frame_params = jclass("android.widget.FrameLayout$LayoutParams")
        self.linear_params = jclass("android.widget.LinearLayout$LayoutParams")
        self.layout_listener = jclass("android.view.View$OnLayoutChangeListener")
        self.theme = jclass("org.telegram.ui.ActionBar.Theme")
        self.dp = jclass("org.telegram.messenger.AndroidUtilities").dp
        self.bind(viewer, "setParentActivity", 3, after=self.after_viewer_setup)
        for name, arity in (("closePhoto", 2), ("onPause", 0), ("onHideView", 0),
                            ("onUserLeaveHint", 0),
                            ("pipHidePrimaryWindowView", 1), ("switchToPip", 1),
                            ("destroyPhotoViewer", 0)):
            self.bind(viewer, name, arity, before=lambda param: self.dismiss_timer_ui(param.thisObject))
        launch = jclass("org.telegram.ui.LaunchActivity").getClass()
        self.bind(launch, "onPause", 0, before=self.before_launch_transition)
        self.bind(launch, "onNewIntent", 2, before=self.before_launch_transition)
        self.bind(menu, "toggleSubMenu", 3, before=self.before_submenu)
        self.hooks.extend(self.hook_all_constructors(audio_ui, after=self.install_audio_bar))
        self.bind(audio_ui, "updateColors", 0, after=self.after_audio_colors)
        self.bind(audio_ui, "updateTitle", 1, after=self.after_audio_title)
        self.bind(audio_ui, "setVisibleInProfile", 1, before=self.before_audio_profile)
        self.bind(video_player, "maybeReportPlayerState", 0,
                  before=self.before_player_state, after=self.after_player_state)
        self.bind(video_player, "onPositionDiscontinuity", 3, before=self.before_repeat)
        def install_existing():
            if not self.active:
                return
            for name in ("Instance", "Instance2", "PipInstance"):
                existing = resolve_field(viewer, name).get(None)
                if existing is not None:
                    self.install_video_menu(existing)

        run_on_ui_thread(install_existing)

    def bind(self, owner, name, arity, **callbacks):
        self.hooks.append(self.hook_method(resolve_method(owner, name, arity), **callbacks))

    def option(self, key):
        return getattr(self, "flags", {}).get(key, True)

    def after_viewer_setup(self, param):
        if self.active:
            self.install_video_menu(param.thisObject)

    def install_video_menu(self, viewer):
        if not self.option("timer"):
            return
        menu = self.video_menu.get(viewer)
        if menu is None:
            return
        self.menus = [entry for entry in self.menus if entry[0].get() is not None]
        if any(entry[0].get() == menu for entry in self.menus):
            return
        row = menu.addSubItem(MENU_ID, self.clock_icon, "定时停止")
        row.setColors(WHITE, WHITE)
        row.setSelectorColor(0x0FFFFFFF)
        parent = row.getParent()
        loop = self.loop_item.get(viewer)
        if parent is not None and loop is not None and loop.getParent() == parent:
            params = row.getLayoutParams()
            parent.removeView(row)
            parent.addView(row, parent.indexOfChild(loop) + 1, params)
        viewer_ref = self.weak(viewer)

        def open_timer(view):
            menu.closeSubMenu()
            current = viewer_ref.get()
            if self.active and current is not None:
                anchor = self.viewer_window.get(current)
                if anchor is not None:
                    self.open_video_timer(anchor, viewer_ref)

        row.setOnClickListener(self.timer_click(open_timer))
        self.menus.append((self.weak(menu), self.weak(row), viewer_ref))
        self.render_video_timer(row, viewer, self.timer_label(viewer))

    def before_submenu(self, param):
        if not self.active:
            return
        for menu_ref, row_ref, viewer_ref in self.menus:
            if menu_ref.get() != param.thisObject:
                continue
            row, viewer = row_ref.get(), viewer_ref.get()
            if row is not None:
                if viewer is not None:
                    self.render_video_timer(row, viewer, self.timer_label(viewer))
                player = viewer.getVideoPlayer() if viewer is not None else None
                row.setVisibility(0 if player is not None else 8)
            break

    def install_audio_bar(self, param):
        audio = param.thisObject
        player_layout = self.audio_layout.get(audio)
        native = self.audio_native_buttons.get(audio)
        if not self.active or player_layout is None or native is None or len(native) != 7 or native[6] is None:
            return
        toolbar = native[6].getParent()
        if toolbar is None:
            return
        self.audio_rows = [row for row in self.audio_rows if row[0].get() is not None]
        if any(row[0].get() == audio for row in self.audio_rows):
            return

        context = toolbar.getContext()
        timer = self.frame_layout(context)
        icon = self.image_view(context)
        icon.setImageResource(self.clock_icon)
        icon.setScaleType(jclass("android.widget.ImageView$ScaleType").FIT_CENTER)
        timer.addView(icon, self.frame_params(self.dp(22), self.dp(22), 17))
        timer.setContentDescription("定时停止")
        timer.setOnClickListener(OnClickListener(lambda view: self.show_timer(view, None)))
        toolbar.addView(timer, self.frame_params(self.dp(48), self.dp(56)))
        audio_ref, timer_ref = self.weak(audio), self.weak(timer)
        plugin = self

        class LayoutListener(dynamic_proxy(self.layout_listener)):
            def onLayoutChange(self, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
                audio, timer = audio_ref.get(), timer_ref.get()
                if plugin.active and audio is not None and timer is not None:
                    plugin.update_audio_footer(audio)
                    plugin.layout_audio_buttons(audio, timer)

        listener = LayoutListener()
        player_layout.addOnLayoutChangeListener(listener)
        self.audio_rows.append((audio_ref, timer_ref, listener))
        self.color_audio_clock(audio, timer)
        self.update_audio_footer(audio)

    def layout_audio_buttons(self, audio, timer):
        native = self.audio_native_buttons.get(audio)
        toolbar = timer.getParent()
        speed = self.audio_speed.get(audio)
        use_timer = self.option("timer")
        move_speed = self.option("audio_toolbar")
        timer.setVisibility(0 if use_timer else 8)
        if toolbar is None:
            return
        self.style_audio_track_icons(audio, toolbar, restore=not (use_timer or move_speed))
        if not (use_timer or move_speed) or toolbar.getWidth() <= 0:
            return
        def visible(buttons):
            return [button for button in buttons if button is not None
                    and button.getParent() is not None and button.getVisibility() == 0]

        native_playback = tuple(native[index] for index in range(1, 6))
        playback = visible(native_playback)
        tools = visible((native[0], speed if move_speed else None, timer, native[6]))
        play = native[3]
        if play not in playback:
            return
        row_width = min(toolbar.getWidth(), self.dp(420))
        inset = (toolbar.getWidth() - row_width) // 2
        padding = min(self.dp(14), row_width // 24)
        if not move_speed:
            playback = visible((native[0], *native_playback, timer, native[6]))
        play_index = playback.index(play)
        slots = centered_audio_slots(row_width, padding, play_index, len(playback) - play_index - 1)
        self.layout_audio_line(playback, slots, inset, self.dp(29), native, speed, toolbar)
        if move_speed and tools:
            self.layout_audio_line(tools, audio_slots(row_width, padding, len(tools)),
                                   inset, self.dp(29 + AUDIO_ROW_HEIGHT), native, speed, toolbar)

    def layout_audio_line(self, buttons, slots, inset, center_y, native, speed, toolbar):
        for button, (left, right) in zip(buttons, slots):
            params = button.getLayoutParams()
            available = right - left
            width = min(params.width, available) if params.width >= 0 else available
            height = params.height if params.height >= 0 else button.getMeasuredHeight()
            if button in (native[1], native[5]):
                # Keep the native seek labels legible even when all nine buttons are present.
                padding = min(self.dp(8), max(self.dp(2), (available - self.dp(27)) // 2))
                if button.getPaddingLeft() != padding:
                    button.setPadding(padding, 0, padding, 0)
            mode = self.measure_spec.EXACTLY if params.width >= 0 else self.measure_spec.AT_MOST
            button.measure(self.measure_spec.makeMeasureSpec(width, mode),
                           self.measure_spec.makeMeasureSpec(height, self.measure_spec.EXACTLY))
            width = button.getMeasuredWidth()
            x = inset + left + (right - left - width) // 2
            y = center_y - height // 2
            if button == speed:
                x += toolbar.getLeft()
                y += toolbar.getTop()
            button.layout(x, y, x + width, y + height)

    def before_audio_profile(self, param):
        if self.active and self.option("hide_audio_profile_button"):
            self.update_audio_footer(param.thisObject)
            param.setResult(None)

    def after_audio_title(self, param):
        audio = param.thisObject
        self.update_audio_footer(audio)
        layout = self.audio_layout.get(audio)
        if layout is not None:
            layout.requestLayout()

    def update_audio_footer(self, audio, restore=False):
        layout, shadow = self.audio_layout.get(audio), self.audio_shadow.get(audio)
        if layout is None or shadow is None:
            return
        separate_rows = self.active and self.option("audio_toolbar")
        extra_height = AUDIO_ROW_HEIGHT if separate_rows else 0
        hide = self.option("hide_audio_profile_button") and not restore
        if hide:
            height = self.dp(179)
            for profile in (self.audio_profile_add, self.audio_profile_remove):
                button = profile.get(audio)
                if button is not None:
                    button.animate().cancel()
                    button.setVisibility(8)
        else:
            extra = not self.audio_noforwards.getBoolean(audio) and not self.audio_my_list.invoke(audio, self.object_args([]))
            height = self.dp(179 + (52 if extra else 0))
        height += self.dp(extra_height)
        native = self.audio_native_buttons.get(audio)
        toolbar = native[6].getParent() if native is not None and native[6] is not None else None
        if toolbar is not None:
            params = toolbar.getLayoutParams()
            target = self.dp(66 + extra_height)
            if params is not None and params.height != target:
                params.height = target
                toolbar.setLayoutParams(params)
        params = layout.getLayoutParams()
        if params is not None and params.height != height:
            params.height = height
            layout.setLayoutParams(params)
        params = shadow.getLayoutParams()
        if params is not None and params.bottomMargin != height:
            params.bottomMargin = height
            shadow.setLayoutParams(params)
        playlist = self.audio_list.get(audio)
        if playlist is not None and playlist.getPaddingBottom() > 0:
            padding = self.dp(179 + 52 + extra_height)
            if playlist.getPaddingBottom() != padding:
                playlist.setPadding(playlist.getPaddingLeft(), playlist.getPaddingTop(),
                                    playlist.getPaddingRight(), padding)
        if restore and layout.isAttachedToWindow():
            self.audio_update_title.invoke(audio, self.object_args([self.boolean(False)]))

    def color_audio_clock(self, audio, timer):
        color = self.audio_title_color.get(audio).getCurrentTextColor()
        timer.setBackground(self.theme.createSelectorDrawable(color & 0x19FFFFFF, 1, self.dp(18)))
        self.render_timer_control(timer, color, self.audio_timer_blue(), self.timer_label(None))

    def style_audio_track_icons(self, audio, toolbar, *, restore):
        if toolbar is None:
            return
        native = self.audio_native_buttons.get(audio)
        color = self.audio_title_color.get(audio).getCurrentTextColor()
        for index, resource in zip((2, 4), self.track_icons):
            button = native[index]
            if button is None or button.getParent() != toolbar:
                continue
            animated = button.getAnimatedDrawable()
            if restore:
                if button.getDrawable() != animated:
                    button.setImageDrawable(animated)
                    button.setRotation(0.0 if index == 2 else 180.0)
                    button.clearColorFilter()
            else:
                if button.getDrawable() == animated:
                    button.setImageResource(resource)
                    button.setRotation(0.0)
                button.setColorFilter(color)
        if restore:
            padding = self.dp(8)
            for index in (1, 5):
                button = native[index]
                if button is not None and button.getPaddingLeft() != padding:
                    button.setPadding(padding, 0, padding, 0)

    def after_audio_colors(self, param):
        for audio_ref, timer_ref, _ in self.audio_rows:
            timer = timer_ref.get()
            if timer is not None and audio_ref.get() == param.thisObject:
                self.color_audio_clock(param.thisObject, timer)
                self.style_audio_track_icons(param.thisObject, timer.getParent(),
                                             restore=not (self.option("timer") or self.option("audio_toolbar")))

    def audio_timer_blue(self):
        return VIDEO_TIMER_BLUE if self.theme.isCurrentThemeDark() else AUDIO_TIMER_BLUE

    def render_timer_control(self, button, normal, blue, label):
        icon = button.getChildAt(0)
        if button.getChildCount() == 1 and label:
            text = self.text_view(button.getContext())
            text.setGravity(17)
            text.setMaxLines(1)
            text.setIncludeFontPadding(False)
            text.setTextSize(12.0)
            if self.sdk >= 26:
                text.setAutoSizeTextTypeUniformWithConfiguration(10, 12, 1, 2)
            text.setImportantForAccessibility(2)
            params = self.frame_params(-1, self.dp(14), 81)
            button.addView(text, params)
        text = button.getChildAt(1)
        if text is not None:
            text.setTextColor(blue)
            if str(text.getText()) != label:
                text.setText(label)
            if text.getVisibility() != (0 if label else 4):
                text.setVisibility(0 if label else 4)
        icon.setColorFilter(blue if label else normal)
        icon.setTranslationY(0.0)
        button.setContentDescription(f"定时停止，剩余 {label}" if label else "定时停止")

    def render_video_timer(self, item, viewer, label):
        color = VIDEO_TIMER_BLUE if label else WHITE
        item.setColors(color, color)
        title = f"定时停止  {label}" if label else "定时停止"
        if str(item.getTextView().getText()) != title:
            item.setText(title)
        window = self.viewer_window.get(viewer)
        if window is not None:
            for tag in (VIDEO_TIMER_CONTROL_TAG, VIDEO_TIMER_CONTROL_TAG + ".compact"):
                button = window.findViewWithTag(tag)
                if button is not None:
                    self.render_timer_control(button, WHITE, VIDEO_TIMER_BLUE, label)

    def timer_label(self, viewer):
        if self.session is None:
            return ""
        target = self.session[2]
        if (target is None) != (viewer is None) or (target is not None and target.get() != viewer):
            return ""
        return ("+" if self.waiting is not None else "") + format_timer_time(self.timer_seconds())

    def update_countdown(self):
        for _, item_ref, viewer_ref in self.menus:
            item, viewer = item_ref.get(), viewer_ref.get()
            if item is not None and viewer is not None:
                self.render_video_timer(item, viewer, self.timer_label(viewer))
        audio_label = self.timer_label(None)
        for audio_ref, timer_ref, _ in self.audio_rows:
            audio, timer = audio_ref.get(), timer_ref.get()
            if audio is not None and timer is not None:
                color = self.audio_title_color.get(audio).getCurrentTextColor()
                self.render_timer_control(timer, color, self.audio_timer_blue(), audio_label)

    def run_countdown(self):
        try:
            self.update_countdown()
        except Exception as error:
            self.log(f"Timer countdown failed: {type(error).__name__}: {error}")
        if self.active and self.session is not None:
            self.handler.postDelayed(self.countdown_runnable, 1000)

    def request_countdown(self):
        self.handler.removeCallbacks(self.countdown_runnable)
        self.handler.post(self.countdown_runnable)

    def timer_context(self, anchor, viewer_ref):
        viewer = viewer_ref.get() if viewer_ref is not None else None
        activity = viewer.getParentActivity() if viewer is not None else None
        return activity if activity is not None else anchor.getContext()

    def timer_provider(self, viewer_ref):
        if viewer_ref is None:
            return None
        try:
            return jclass("org.telegram.ui.Stories.DarkThemeResourceProvider")()
        except Exception:
            return None

    def open_video_timer(self, anchor, viewer_ref):
        self.dismiss_timer_ui()
        self.dialog_viewer = viewer_ref
        generation = self.dialog_generation
        self.run_timer_dialog_step(generation, lambda: self.show_timer(anchor, viewer_ref), 1)

    def run_timer_dialog_step(self, generation, callback, delay):
        def run():
            if generation == self.dialog_generation:
                self.try_timer_action(callback)

        run_on_ui_thread(run, delay)

    def before_launch_transition(self, param):
        viewer = self.dialog_viewer.get() if self.dialog_viewer is not None else None
        if viewer is not None and viewer.getParentActivity() == param.thisObject:
            self.dismiss_timer_ui(viewer)

    def dismiss_timer_ui(self, viewer=None):
        owner = self.dialog_viewer
        if viewer is not None and (owner is None or owner.get() != viewer):
            return
        self.dialog_generation += 1
        dialogs = ((self.editor_dialog, False), (self.dialog, self.dialog_is_sheet))
        self.editor_dialog = self.dialog = self.dialog_viewer = None
        self.dialog_is_sheet = False
        for reference, is_sheet in dialogs:
            dialog = reference.get() if reference is not None else None
            if dialog is not None and dialog.isShowing():
                try:
                    if is_sheet:
                        dialog.skipDismissAnimation()
                    dialog.dismiss()
                except Exception as error:
                    self.log(f"Could not dismiss timer dialog: {type(error).__name__}")

    def show_timer(self, anchor, viewer_ref):
        viewer = viewer_ref.get() if viewer_ref is not None else None
        if (not self.active or not self.option("timer") or not anchor.isAttachedToWindow()
                or (viewer_ref is not None and (viewer is None or not viewer.isVisible()))):
            return
        try:
            self.dismiss_timer_ui()
            self.dialog_viewer = viewer_ref
            self.show_timer_panel(anchor, viewer_ref)
        except Exception as error:
            self.log(f"Could not open native timer sheet: {type(error).__name__}: {error}")
            try:
                self.show_timer_fallback(anchor, viewer_ref)
            except Exception as fallback_error:
                self.log(f"Could not open native timer options: {type(fallback_error).__name__}: {fallback_error}")
                self.toast.makeText(anchor.getContext(), "无法打开睡眠定时", 0).show()

    def timer_click(self, callback):
        def invoke(view):
            self.try_timer_action(lambda: callback(view))

        return OnClickListener(invoke)

    def try_timer_action(self, callback):
        try:
            if self.active:
                callback()
        except Exception as error:
            self.log(f"Timer action failed: {type(error).__name__}: {error}")

    def timer_seconds(self):
        if self.waiting is not None:
            player = self.waiting[0]
            engine = player.player
            speed = float(engine.getPlaybackParameters().speed) if engine is not None else 1.0
            return int(max(0, player.getDuration() - player.getCurrentPosition())
                       / max(0.1, speed) / 1000)
        return max(0, (self.session[0] - self.clock.elapsedRealtime() + 999) // 1000)

    def timer_status(self):
        if self.waiting is not None:
            return f"等待播完 +{format_timer_time(self.timer_seconds())}"
        if self.session is not None:
            return f"剩余 {format_timer_time(self.timer_seconds())}"
        return ""

    def timer_color(self, key, provider):
        return self.theme.getColor(key, provider) if provider is not None else self.theme.getColor(key)

    def show_timer_panel(self, anchor, viewer_ref):
        context = self.timer_context(anchor, viewer_ref)
        provider = self.timer_provider(viewer_ref)
        native_sheet = jclass("org.telegram.ui.ActionBar.BottomSheet$Builder")
        timer_setting = jclass("org.telegram.ui.Cells.TextSettingsCell")
        timer_check = jclass("org.telegram.ui.Cells.TextCheckCell")
        timer_button = jclass("org.telegram.ui.Stories.recorder.ButtonWithCounterView")
        scroll_type = jclass("androidx.core.widget.NestedScrollView")
        layout_listener = jclass("android.view.View$OnLayoutChangeListener")
        root = self.timer_layout(context)
        root.setOrientation(1)
        compact = viewer_ref is not None
        chosen = self.last_minutes
        custom = chosen if chosen not in PRESETS else None
        initial_finish = self.last_finish

        def add(view, height, sides=0, top=0, bottom=0):
            root.addView(view, self.layout_helper.createLinear(
                jint(-1), jint(height), jint(51), jint(sides), jint(top), jint(sides), jint(bottom)))

        duration = timer_setting(context, provider)
        make_capsule = getattr(self, "make_timer_capsule", None)
        duration.setTextAndValue("自定义时长", "" if make_capsule else f"{chosen} 分钟", False)
        duration.setBackground(self.theme.createSelectorDrawable(
            self.theme.getColor(self.theme.key_listSelector), 1))
        add(duration, 48)

        def timer_choices():
            return PRESETS if custom is None else (*PRESETS, custom)

        def choose(index):
            nonlocal chosen
            values = timer_choices()
            if 0 <= index < len(values):
                chosen = values[index]
                if make_capsule is None:
                    duration.setTextAndValue("自定义时长", f"{chosen} 分钟", False)

        if make_capsule is not None:
            slider_host = self.timer_layout(context)
            slider_host.setOrientation(1)
            add(slider_host, -2, 8)
            palette = None
            if not compact:
                primary = self.timer_color(self.theme.key_dialogTextBlack, provider)
                secondary = self.timer_color(self.theme.key_dialogTextGray2, provider)
                accent = self.audio_timer_blue()
                palette = (primary, secondary, accent, (primary & 0xFFFFFF) | 0x24000000, WHITE)

            def repaint_slider():
                values = timer_choices()
                positions = tuple(i / (len(values) - 1) for i in range(len(values)))
                labels = tuple(str(value) for value in PRESETS) + (("自定义",) if custom is not None else ())
                slider_host.removeAllViews()
                slider = make_capsule(context, "时长", positions, labels, positions[values.index(chosen)],
                                      None, lambda _, __, point: choose(point), palette=palette,
                                      value_labels=tuple(f"{value} 分钟" for value in values))
                slider_host.addView(slider, self.linear_params(-1, -2))
        else:
            timer_slider = jclass("org.telegram.ui.Components.SlideChooseView")
            slider_callback = jclass("org.telegram.ui.Components.SlideChooseView$Callback")
            timer_strings = jarray(jclass("java.lang.String"))
            slider = timer_slider(context, provider)

            class SliderCallback(dynamic_proxy(slider_callback)):
                def onOptionSelected(self, index):
                    choose(index)

                def onTouchEnd(self):
                    pass

            def repaint_slider():
                labels = [str(value) for value in PRESETS]
                if custom is not None:
                    labels.append("自定义")
                slider.setOptions(timer_choices().index(chosen), timer_strings(labels))
                duration.setTextAndValue("自定义时长", f"{chosen} 分钟", False)

            slider.setCallback(SliderCallback())
            slider.setContentDescription("睡眠定时时长")
            add(slider, 74)
        repaint_slider()

        finish = timer_check(context, provider)
        if compact:
            finish.setHeight(42)
        finish.setTextAndCheck("播完当前媒体再停止", initial_finish, not compact)
        finish.setOnClickListener(self.timer_click(lambda view: finish.setChecked(not finish.isChecked())))
        add(finish, 42 if compact else 48)

        if compact:
            status = self.text_view(context)
            status.setTextSize(13)
            status.setGravity(19)
            status.setTextColor(self.timer_color(self.theme.key_dialogTextGray2, provider))
            add(status, 26, 18)
        else:
            status = timer_setting(context, provider)
            add(status, 42)

        def update_status():
            if compact:
                status.setText(f"当前定时 · {self.timer_status()}")
            else:
                status.setTextAndValue("当前定时", self.timer_status(), False)

        update_status()
        status.setVisibility(0 if self.session is not None else 8)

        start = timer_button(context, provider).setRound()
        start.setText("重新定时" if self.session is not None else "开始定时")
        cancel = timer_button(context, provider).setRound().setNeutral()
        cancel.setText("取消定时")
        cancel.setVisibility(0 if self.session is not None else 8)
        if compact:
            actions = self.timer_layout(context)
            actions.setOrientation(0)
            cancel_params = self.linear_params(0, -1, 1.0)
            cancel_params.rightMargin = self.dp(8)
            actions.addView(cancel, cancel_params)
            actions.addView(start, self.linear_params(0, -1, 1.0))
            add(actions, 42, 16, 6, 8)
        else:
            add(start, 48, 16, 12, 12)
            add(cancel, 42, 16, 0, 12)

        def use_custom(minutes):
            nonlocal chosen, custom
            chosen = minutes
            custom = minutes if minutes not in PRESETS else None
            repaint_slider()

        duration.setOnClickListener(self.timer_click(
            lambda view: self.edit_timer_minutes(anchor, viewer_ref, chosen, use_custom)))
        builder = (native_sheet(context, False, provider, VIDEO_SHEET_COLOR)
                   if provider is not None else native_sheet(context))
        builder.setTitle("睡眠定时")
        scroll = scroll_type(context)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.addView(root, jclass("android.widget.FrameLayout$LayoutParams")(-1, -2))
        builder.setCustomView(scroll)
        sheet = builder.create()
        sheet.scrollNavBar = True

        class SheetLayoutListener(dynamic_proxy(layout_listener)):
            def onLayoutChange(self, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
                sheet.setCanDismissWithSwipe(root.getMeasuredHeight() <= bottom - top)

        scroll.addOnLayoutChangeListener(SheetLayoutListener())
        sheet.show()
        if not sheet.isShowing():
            raise RuntimeError("Nagram did not show the bottom sheet")
        self.dialog = self.weak(sheet)
        self.dialog_is_sheet = True

        def begin(view):
            if self.active:
                self.start_timer(chosen, bool(finish.isChecked()), viewer_ref)
            sheet.dismiss()

        def stop_timer(view):
            self.clear()
            sheet.dismiss()

        start.setOnClickListener(self.timer_click(begin))
        cancel.setOnClickListener(self.timer_click(stop_timer))

        def refresh():
            try:
                if not self.active or not sheet.isShowing():
                    return
                is_running = self.session is not None
                status.setVisibility(0 if is_running else 8)
                cancel.setVisibility(0 if is_running else 8)
                update_status()
                start.setText("重新定时" if is_running else "开始定时")
                if is_running:
                    run_on_ui_thread(refresh, 1000)
            except Exception as error:
                self.log(f"Timer status update failed: {type(error).__name__}")

        if self.session is not None:
            run_on_ui_thread(refresh, 1000)

    def native_timer_alert(self, context, viewer_ref):
        provider = self.timer_provider(viewer_ref)
        return self.native_alert(context, provider) if provider is not None else self.native_alert(context)

    def show_native_timer_alert(self, builder, viewer_ref):
        dialog = builder.create()
        viewer = viewer_ref.get() if viewer_ref is not None else None
        if viewer is not None:
            viewer.showAlertDialog(builder)
        else:
            dialog.show()
        if not dialog.isShowing():
            raise RuntimeError("Nagram did not show the alert")
        return dialog

    def edit_timer_minutes(self, anchor, viewer_ref, selected, accept):
        context = self.timer_context(anchor, viewer_ref)
        layout = self.timer_layout(context)
        layout.setOrientation(1)
        edit = jclass("org.telegram.ui.Components.EditTextBoldCursor")(context)
        edit.setInputType(2)
        edit.setSingleLine(True)
        edit.setSelectAllOnFocus(True)
        edit.setText(str(selected))
        edit.setHint("1–1440 分钟")
        theme_provider = self.timer_provider(viewer_ref)
        if theme_provider is not None:
            edit.setTextColor(self.theme.getColor(self.theme.key_dialogTextBlack, theme_provider))
            edit.setHintTextColor(self.theme.getColor(self.theme.key_dialogTextGray2, theme_provider))
        layout.addView(edit, self.layout_helper.createLinear(
            jint(-1), jint(52), jint(51), jint(24), jint(0), jint(24), jint(0)))
        builder = self.native_timer_alert(context, viewer_ref)
        builder.setTitle("自定义分钟数")
        builder.setView(layout)
        builder.setPositiveButton("确定", None)
        builder.setNegativeButton("取消", None)
        dialog = self.show_native_timer_alert(builder, viewer_ref)
        self.editor_dialog = self.weak(dialog)
        button = dialog.getButton(-1)

        def done(view):
            minutes = duration_minutes(len(PRESETS), str(edit.getText()).strip())
            if minutes is None:
                edit.setError("请输入 1–1440 之间的整数")
                return
            accept(minutes)
            dialog.dismiss()

        button.setOnClickListener(self.timer_click(done))

    def show_timer_fallback(self, anchor, viewer_ref, finish=None):
        context = self.timer_context(anchor, viewer_ref)
        finish = self.last_finish if finish is None else finish
        options = [f"{value} 分钟" for value in PRESETS]
        options.extend(("自定义时长", "播完当前媒体再停止 · " + ("已开启" if finish else "已关闭")))
        if self.session is not None:
            options.append("取消当前定时")
        builder = self.native_timer_alert(context, viewer_ref)
        status = self.timer_status()
        builder.setTitle(f"睡眠定时 · {status}" if status else "睡眠定时")
        plugin = self
        generation = self.dialog_generation

        def start(minutes):
            if plugin.active:
                plugin.start_timer(minutes, bool(finish), viewer_ref)

        class OptionsListener(dynamic_proxy(self.dialog_option_listener)):
            def onClick(self, dialog, which):
                try:
                    if not plugin.active or generation != plugin.dialog_generation:
                        return
                    if 0 <= which < len(PRESETS):
                        start(PRESETS[which])
                    elif which == len(PRESETS):
                        plugin.run_timer_dialog_step(generation, lambda: plugin.edit_timer_minutes(
                            anchor, viewer_ref, plugin.last_minutes, start), 120)
                    elif which == len(PRESETS) + 1:
                        plugin.run_timer_dialog_step(generation,
                            lambda: plugin.show_timer_fallback(anchor, viewer_ref, not finish), 120)
                    elif which == len(PRESETS) + 2:
                        plugin.clear()
                except Exception as error:
                    plugin.log(f"Timer option failed: {type(error).__name__}: {error}")

        builder.setItems(self.timer_labels(options), OptionsListener())
        self.dialog = self.weak(self.show_native_timer_alert(builder, viewer_ref))
        self.dialog_is_sheet = False

    def start_timer(self, minutes, finish, viewer_ref):
        self.clear()
        self.last_minutes, self.last_finish = minutes, finish
        self.set_setting("sleep_timer_minutes", minutes)
        self.set_setting("sleep_timer_finish_current", finish)
        self.session = (self.clock.elapsedRealtime() + minutes * 60000, finish, viewer_ref)
        self.tick()

    def follow_background_audio(self, viewer):
        if self.session is None:
            return
        deadline, finish, viewer_ref = self.session
        if viewer_ref is None or viewer_ref.get() != viewer:
            return
        self.session = (deadline, finish, None)
        if self.waiting is not None:
            _, _, new_key = self.target()
            self.waiting = (self.waiting[0], new_key, self.waiting[2])
        self.request_countdown()

    def target(self):
        viewer_ref = self.session[2]
        if viewer_ref is not None:
            viewer = viewer_ref.get()
            if viewer is None:
                return None, None, None
            return viewer.getVideoPlayer(), None, self.current_index.getInt(viewer)
        message = self.controller.getPlayingMessageObject()
        if message is None:
            return None, None, None
        player = self.audio_player.get(self.controller)
        if player is None:
            player = self.controller.getVideoPlayer()
        key = (int(message.currentAccount), int(message.getDialogId()), int(message.getId()))
        return player, message, key

    def tick(self):
        if not self.active or self.session is None:
            return
        remaining = self.session[0] - self.clock.elapsedRealtime()
        if remaining > 0:
            self.handler.postDelayed(self.tick_runnable, remaining)
            return
        player, message, key = self.target()
        if player is None:
            self.clear()
        elif self.waiting is not None:
            if self.waiting[:2] != (player, key) or not player.isPlaying():
                self.clear()
            else:
                self.handler.postDelayed(self.tick_runnable, 750)
        elif self.session[1] and player.isPlaying():
            self.wait_at_end(player, key)
            self.request_countdown()
            self.handler.postDelayed(self.tick_runnable, 750)
        else:
            self.stop(player, message)

    def run_tick(self):
        try:
            self.tick()
        except Exception as error:
            self.log(f"Playback timer failed: {type(error).__name__}")
            self.clear()

    def wait_at_end(self, player, key):
        looping = bool(player.isLooping())
        self.waiting = (player, key, looping)
        if looping:
            player.setLooping(False)

    def reached_deadline_for(self, player):
        if not self.active or self.session is None or self.clock.elapsedRealtime() < self.session[0]:
            return None
        target, message, key = self.target()
        if target != player or (self.waiting is not None and self.waiting[:2] != (player, key)):
            return None
        return message, key

    def before_player_state(self, param):
        player = param.thisObject
        current = self.reached_deadline_for(player)
        if current is None:
            return
        message, _ = current
        engine = player.player
        if engine is None:
            return
        state = int(engine.getPlaybackState())
        audio_end = (message is not None
                     and (state == STATE_ENDED or (state in (1, 2)
                          and engine.getPlayWhenReady() and message.audioProgress >= 0.999)))
        if audio_end:
            # Suppress the delegate's automatic advance and keep the current item paused.
            param.setResult(None)
            self.stop(player, message, rewind=True)

    def after_player_state(self, param):
        player = param.thisObject
        current = self.reached_deadline_for(player)
        if current is not None and current[0] is None and player.player is not None:
            if player.player.getPlaybackState() == STATE_ENDED:
                self.stop(player, None)

    def before_repeat(self, param):
        if int(param.args[2]) != 0:  # DISCONTINUITY_REASON_AUTO_TRANSITION
            return
        player = param.thisObject
        current = self.reached_deadline_for(player)
        if current is not None:
            self.stop(player, current[0])

    def stop(self, player, message, *, rewind=False):
        viewer_ref = self.session[2]
        self.clear(restore_loop=False)
        try:
            if message is not None:
                self.controller.pauseMessage(message, False)
                if rewind:
                    player.seekTo(0)
            else:
                viewer = viewer_ref.get() if viewer_ref else None
                if viewer is not None:
                    self.manually_paused.setBoolean(viewer, True)
                player.pause()
        finally:
            self.restore_loop()

    def restore_loop(self):
        waiting, self.waiting = self.waiting, None
        if waiting is not None and waiting[2] and waiting[0].player is not None:
            waiting[0].setLooping(True)

    def clear(self, *, restore_loop=True):
        self.session = None
        self.handler.removeCallbacks(self.tick_runnable)
        if restore_loop:
            self.restore_loop()
        self.request_countdown()

    def on_plugin_unload(self):
        self.active = False
        for hook in self.hooks:
            self.unhook_method(hook)

        def restore():
            self.clear()
            self.run_countdown()
            self.dismiss_timer_ui()
            for _, row_ref, _ in self.menus:
                row = row_ref.get()
                if row is not None and row.getParent() is not None:
                    row.getParent().removeView(row)
            self.menus.clear()
            for audio_ref, timer_ref, listener in self.audio_rows:
                audio, timer = audio_ref.get(), timer_ref.get()
                if audio is not None:
                    self.audio_layout.get(audio).removeOnLayoutChangeListener(listener)
                    if timer is not None:
                        self.style_audio_track_icons(audio, timer.getParent(), restore=True)
                    self.update_audio_footer(audio, restore=self.option("hide_audio_profile_button"))
                if timer is not None and timer.getParent() is not None:
                    timer.getParent().removeView(timer)
            self.audio_rows.clear()

        run_on_ui_thread(restore)


LEGACY_NOTIFICATION_ID = 65027
PENDING_REQUEST = 65120
FLAG_SECURE = 0x2000
PIP_ITEM = 6
PLAY_PAUSE = 1
BACK = 2
FORWARD = 3
STOP_AUDIO = 4
BACKGROUND_AUDIO_ITEM = 65348
BACKGROUND_AUDIO_BLUE = 0xFF62AFF5 - (1 << 32)
MUSIC_NOTIFICATION_ID = 5
IN_APP_AUDIO_STYLE = 0  # FragmentContextView.STYLE_AUDIO_PLAYER
SKIP_MS = 15000
COVER_SIZE = 256
COVER_RETRIES = (1, 90, 220, 450, 900)
CHAT_VIDEO_LIFECYCLE = ("updateTextureViewPosition", "updateMessagesVisiblePart",
                        "onRemoveFromParent", "onConfigurationChanged")






def video_dimensions(size, fallback_width, fallback_height):
    if size is not None and size.width > 0 and size.height > 0:
        if size.unappliedRotationDegrees in (90, 270):
            return size.height, size.width
        return size.width, size.height
    return fallback_width, fallback_height


def is_playing(player):
    return player.getPlayWhenReady() and player.getPlaybackState() != STATE_ENDED


def skip_position(position, duration, action):
    return max(0, min(duration, position + (SKIP_MS if action == FORWARD else -SKIP_MS)))


def title_line(text):
    for line in str(text if text is not None else "").splitlines():
        title = " ".join(line.split())
        if title:
            return title[:96]
    return ""


def media_title(caption, filename):
    return title_line(caption) or title_line(filename) or "视频播放"


def video_caption_title(message):
    raw = message.messageOwner
    return title_line(raw.message if raw is not None else None) or title_line(message.caption)


def cover_size(width, height):
    factor = min(1.0, COVER_SIZE / max(1, width, height))
    return max(1, round(width * factor)), max(1, round(height * factor))


def message_key(message):
    return int(message.currentAccount), int(message.getDialogId()), int(message.getId())


def loaded_video_cover(plugin, viewer):
    receiver = viewer.centerImage
    current = viewer.getCurrentMessageObject()
    owner = receiver.getParentObject()
    same_message = (current is None or (owner is not None and plugin.message_type.isInstance(owner)
                                       and message_key(owner) == message_key(current)))
    if not same_message:
        return None
    holder = receiver.getThumbBitmapSafe() or receiver.getBitmapSafe()
    if holder is None:
        return None
    try:
        bitmap = holder.bitmap
        if bitmap is None or bitmap.isRecycled():
            return None
        width, height = cover_size(bitmap.getWidth(), bitmap.getHeight())
        scaled = plugin.bitmap.createScaledBitmap(bitmap, width, height, True)
        try:
            return scaled.copy(plugin.bitmap_config, False)
        finally:
            if scaled != bitmap:
                scaled.recycle()
    finally:
        holder.release()


def video_metadata(plugin, title, artist, duration, cover):
    metadata = plugin.metadata_builder()
    metadata.putString("android.media.metadata.TITLE", title)
    metadata.putString("android.media.metadata.DISPLAY_TITLE", title)
    if artist:
        metadata.putString("android.media.metadata.ARTIST", artist)
        metadata.putString("android.media.metadata.DISPLAY_SUBTITLE", artist)
    if duration > 0:
        metadata.putLong("android.media.metadata.DURATION", duration)
    if cover is not None:
        for name in ("ART", "ALBUM_ART", "DISPLAY_ICON"):
            metadata.putBitmap("android.media.metadata." + name, cover)
    return metadata.build()


def media_notification(plugin, context, session, title, subtitle, cover, open_player, ongoing, *, compact=(0, 1, 2)):
    style = plugin.media_style()
    style.setMediaSession(session.getSessionToken().getToken())
    style.setShowActionsInCompactView(*compact)
    notification = (plugin.notification_builder(context, plugin.music_channel())
                    .setSmallIcon(plugin.notification_icon)
                    .setContentTitle(title)
                    .setContentIntent(open_player)
                    .setCategory("transport")
                    .setShowWhen(False)
                    .setOnlyAlertOnce(True)
                    .setVisibility(0)
                    .setOngoing(ongoing)
                    .setStyle(style))
    if subtitle is not None:
        notification.setContentText(subtitle)
    if cover is not None:
        notification.setLargeIcon(cover)
    return notification


def video_playback_state(plugin, service, engine, playing, position, actions):
    session = plugin.music_session.get(service)
    builder = plugin.state_builder()
    builder.setActions((2 if playing else 4) | 256 | 512)
    speed = engine.getPlaybackParameters().speed if playing and engine is not None else 0.0
    builder.setState(3 if playing else 2, max(0, position), float(speed))
    for name, label, icon in actions:
        builder.addCustomAction(plugin.action_builder(name, label, icon).build())
    plugin.music_playback_state.set(service, builder)
    session.setPlaybackState(builder.build())
    return session


class SystemVideoPip(PluginFeature):
    def on_plugin_load(self):
        self.sdk = int(jclass("android.os.Build$VERSION").SDK_INT)
        self.hooks = []
        self.owned_sources = []
        self.card = None
        self.visual_owner = None
        self.music_service_instance = None
        self.service_start_requested = False
        self.suppressed_pip = None
        self.transfers = []
        self.active = False
        self.background = None
        self.background_chats = {}
        self.background_choice = None
        self.background_before_pause = None
        self.background_return = None
        self.background_session_activity = None
        self.detached_background_viewer = None
        self.background_items = []
        if self.sdk < 26:
            return
        application = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        self.application = application
        self.has_pip = application.getPackageManager().hasSystemFeature("android.software.picture_in_picture")

        self.active = True
        self.android = jclass("org.telegram.messenger.AndroidUtilities")
        self.photo_viewer = jclass("org.telegram.ui.PhotoViewer")
        self.viewer_type = self.photo_viewer.getClass()
        self.launch = jclass("org.telegram.ui.LaunchActivity").getClass()
        controller = jclass("org.telegram.messenger.pip.PipActivityController").getClass()
        source_type = jclass("org.telegram.messenger.pip.PipSource").getClass()
        handler = jclass("org.telegram.messenger.pip.PipActivityHandler").getClass()
        self.dialog_object = jclass("org.telegram.messenger.DialogObject")
        self.messages = jclass("org.telegram.messenger.MessagesController")
        self.user_object = jclass("org.telegram.messenger.UserObject")
        self.locale = jclass("org.telegram.messenger.LocaleController")
        self.saved_messages_title = jclass("org.telegram.messenger.R$string").SavedMessages
        self.source_builder = jclass("org.telegram.messenger.pip.PipSource$Builder")
        self.pip_action = jclass("org.telegram.messenger.pip.utils.PipActions")
        self.pip_utils = jclass("org.telegram.messenger.pip.utils.PipUtils")
        self.pip_params = jclass("android.app.PictureInPictureParams$Builder")
        self.remote_actions = field(source_type, "remoteActions")
        self.array_list = jclass("java.util.ArrayList")
        self.pip_action_stack = []
        self.action_interface = jclass("org.telegram.messenger.pip.activity.IPipActivityActionListener")
        self.source = field(self.viewer_type, "pipSource")
        self.aspect = field(self.viewer_type, "aspectRatioFrameLayout")
        self.placeholder = field(self.viewer_type, "pipPlaceholderView")
        self.layout_params = field(self.viewer_type, "windowLayoutParams")
        self.menu = field(self.viewer_type, "menuItem")
        self.video_settings = field(self.viewer_type, "videoItem")
        self.viewer_player = field(self.viewer_type, "videoPlayer")
        self.viewer_media = field(self.viewer_type, "imagesArr")
        self.media_loaded_event = jclass("org.telegram.messenger.NotificationCenter").mediaDidLoad
        self.viewer_window_hidden = field(self.viewer_type, "windowViewSkipRender")
