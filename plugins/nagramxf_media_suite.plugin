            self.hook_method(method(viewer, "releasePlayer", 1), before=self.before_player_release),
            self.hook_method(method(progress, "onDraw", 1), before=self.hide_center_draw),
            self.hook_method(method(viewer, "onSingleTapConfirmed", 1), before=self.center_tap),
            self.hook_method(method(viewer, "onSingleTapUp", 1), before=self.defer_video_single_tap),
            self.hook_method(method(viewer, "onDoubleTap", 1), before=self.before_native_double_tap,
