def auto_video_orientation(width, height):
    if width <= 0 or height <= 0:
        return None
    if width > height:
        return SENSOR_LANDSCAPE
    return SENSOR_PORTRAIT if height > width else None


def media_grid_anchor(result, message_id):
    if result is None or result.messages.isEmpty():
        return None
    messages = result.messages
    if not any(messages.get(i).id == message_id for i in range(messages.size())):
        return None
    if result.flags & 4:
        start = result.offset_id_offset
    elif result.count <= messages.size():
        start = 0
    else:
        return None
    return messages.get(0).id + 1, start, max(result.count, start + messages.size())


def media_grid_index(messages, dialog, message_id):
    for index in range(messages.size()):
        message = messages.get(index)
        if message.getId() == message_id and message.getDialogId() == dialog:
            return index
    return -1


def media_grid_scroll_target(position, count, columns, viewport, tile, obscured_top=0, obscured_bottom=0):
    if not 0 <= position < count or viewport <= 0:
        return None
    row = position // columns
    last_row = (count - 1) // columns
    center = max(0, (viewport + obscured_top - obscured_bottom - tile) // 2)
    scroll = row * tile - center
    max_scroll = max(0, (last_row + 1) * tile - viewport)
    if not max_scroll or scroll <= 0:
        return 0, 0
    if scroll >= max_scroll:
        return last_row * columns, viewport - tile
    return position, center


def device_orientation_axis(degrees):
    if not 0 <= degrees < 360 or abs(degrees % 90 - 45) < 15:
        return None
    return SENSOR_LANDSCAPE if ((degrees + 45) // 90) % 2 else SENSOR_PORTRAIT


def gravity_axis(x, y, z):
    if 4 * (x * x + y * y) < z * z:
        return None
    if x * x > 3 * y * y:
        return SENSOR_LANDSCAPE
    if y * y > 3 * x * x:
        return SENSOR_PORTRAIT
    return None


class ControlMargin:
    def __init__(self, reference, margin):
        self.reference = reference
        self.base = margin
        self.lift = 0

    def update(self, params, lift, fresh_base=False):
        if fresh_base or params.bottomMargin != self.base + self.lift:
            self.base = params.bottomMargin
        target = self.base + lift
        if params.bottomMargin != target:
            params.bottomMargin = target
        self.lift = lift


def shadow_ramp(start, end, opacity):
    colors = []
    for step in range(9):
        edge_fraction = start + (end - start) * step / 8
        smooth = edge_fraction ** 2 * (3 - 2 * edge_fraction)
        alpha = round(opacity * (1 - (1 - smooth) ** 2))
        color = (alpha << 24) | SHADOW_GRAY
        colors.append(color - ((color >> 31) << 32))
    return tuple(colors)


def caption_viewport(layout, total, available, padding_top, fade_padding, expanded):
    has_more = layout is not None and layout.getLineCount() > 4
    fade_length = 0
    preview = total
    if has_more and not expanded:
        line_bottom = layout.getLineBottom(3)
        line_height = line_bottom - layout.getLineTop(3)
        fade_length = max(1, round(line_height * 0.8)) + fade_padding
        preview = padding_top + line_bottom + fade_padding
    height = min(preview, max(0, available))
    return height, has_more, min(fade_length, height)


def smoothstep(value):
    value = max(0.0, min(1.0, value))
    return value * value * (3 - 2 * value)


def join_shadow_alpha(first, second):
    difference = first - second
    blend = 72.0
    if abs(difference) >= blend or min(first, second) <= 0:
        return max(first, second)
    blend = min(blend, first + second)
    return second + difference * smoothstep(0.5 + difference / (2 * blend))


def panel_shadow_alpha(y, panel):
    if panel is None:
        return 0
    top, bottom, stops = panel
    if not top <= y <= bottom:
        return 0
    position = (y - top) / (bottom - top) * (len(stops) - 1)
    index = min(int(position), len(stops) - 2)
    first, second = (stops[index] >> 24) & 255, (stops[index + 1] >> 24) & 255
    return first + (second - first) * (position - index)


def player_shadow_pixels(width, height, cols, rows, header, footer, side):
    # Sample at bitmap pixel centers so filtering aligns the gradients with the viewport.
    side_columns = ()
    if side is not None:
        side_left, side_top, side_bottom, horizontal_fade, vertical_fade, opacity = side
        side_columns = tuple(opacity * smoothstep(((x + 0.5) * width / cols - side_left) / horizontal_fade)
                             for x in range(cols))
    start = next((i for i, strength in enumerate(side_columns) if strength > 0), cols)
    pixels = []
    for row in range(rows):
        y = (row + 0.5) * height / rows
        panel = join_shadow_alpha(panel_shadow_alpha(y, header), panel_shadow_alpha(y, footer))
        if side is None or start == cols or not side_top < y < side_bottom:
            pixels.extend([caption_shadow_color(panel)] * cols)
            continue
        fade = smoothstep(min(y - side_top, side_bottom - y) / vertical_fade)
        pixels.extend([caption_shadow_color(panel)] * start)
        pixels.extend(caption_shadow_color(join_shadow_alpha(panel, strength * fade))
                      for strength in side_columns[start:])
    return pixels


def caption_shadow_profile(header, text_bottom, fade_end, sample_height=None):
    fast_start = (header + (text_bottom - header) * 0.58) / fade_end
    span = 1.0 if sample_height is None else sample_height / fade_end
    return tuple(
        CAPTION_SHADE_ALPHA * (1 - 0.64 * smoothstep(fraction)
                              - 0.36 * smoothstep((fraction - fast_start) / (1 - fast_start)))
        for fraction in (span * index / 64 for index in range(65)))


def caption_shadow_color(alpha):
    color = (round(alpha) << 24) | SHADOW_GRAY
    return color - ((color >> 31) << 32)


class TopMediaCaption:
    def __init__(self, viewer_ref, scroll, title, subtitle, switcher, shade, button):
        self.viewer_ref = viewer_ref
        self.scroll, self.title, self.subtitle = scroll, title, subtitle
        self.switcher, self.shade, self.button = switcher, shade, button
        params = scroll.getLayoutParams() if scroll is not None else None
        self.original_frame = ((params.gravity, params.leftMargin, params.topMargin, params.rightMargin)
                               if params is not None else None)
        self.title_visibility = title.getVisibility()
        self.subtitle_translation_x = subtitle.getTranslationX()
        self.subtitle_translation = subtitle.getTranslationY()
        self.caption_visibility = switcher.getVisibility() if scroll is not None else None
        self.original_fade = scroll.getVerticalFadingEdgeLength() if scroll is not None else 0
        self.preview_fade = 0
        self.collapsed_height = 0
        self.caption_key = None
        self.expanded = False
        self.has_more = False
        self.touch = None
        self.arrow_pressed = False
        self.reset_scroll_on_measure = False
        self.text_layouts = []


class StatusBarSlide:
    def __init__(self, viewer, container, system, shown):
        self.viewer, self.container, self.system = viewer, container, system
        self.shown = shown
        self.animator = self.signal = self.control = None
        self.progress = None


def landscape_gutter(dp, width):
    return min(dp(28), max(dp(12), width // 20))


def portrait_toolbar_width(dp, width):
    margin = min(dp(20), max(dp(6), width // 12))
    return max(1, min(dp(216), width - 2 * margin))


def landscape_toolbar_gutters(dp, width, left_safe, right_safe, left_consumed, right_consumed):
    gutter = landscape_gutter(dp, width)
    return (max(gutter, left_safe + dp(6) - left_consumed),
            max(gutter, right_safe + dp(6) - right_consumed))


class ThumbnailRail:
    def __init__(self, viewer, strip, container, dimensions):
        self.viewer, self.strip, self.container = viewer, strip, container
        self.native_visibility = strip.getVisibility() if strip is not None else None
        self.tile_width, self.tile_height = dimensions
        self.right_reservation = 0
        self.reserved_views = []
        self.dirty = True
        self.source = None
        self.entries, self.offsets = [], []
        self.extent = 0
        self.landscape = False
        self.safe_top = 0
        self.safe_bottom = 0
        self.left = self.top = self.height = self.position = 0
        self.center = 0
        self.alpha = 0.0
        self.ui_shift = 0
        self.scroller = self.touch = None
        self.scroll_direction = 0
        self.priority_window = range(0)
        self.flinging = False
        self.collapsed = False
        self.collapse_key = None
        self.slide = 0.0
        self.drag_width = None
        self.slide_motion = self.handle_touch = self.handle = self.handle_icon = None
        self.handle_tint = WHITE
        self.next_handle_sample = 0.0
        self.mask_top = 0
        self.cells = {}
        self.selected = None
        self.follow_selection = True
        self.pending_offset = None
        self.center_pending = False
        self.refresh_pending = None
        self.ready = False
        self.revealed = False
        self.reveal_check = None
        self.opened_at = monotonic()

    def set_right_reservation(self, views, width):
        for view, original in tuple(self.reserved_views):
            if view not in views:
                view.getLayoutParams().rightMargin = original
                self.reserved_views.remove((view, original))
        for view in views:
            if all(existing != view for existing, _ in self.reserved_views):
                self.reserved_views.append((view, view.getLayoutParams().rightMargin))
        for view, original in self.reserved_views:
            view.getLayoutParams().rightMargin = original + width
        self.right_reservation = width


