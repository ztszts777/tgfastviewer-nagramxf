TAG = "TgFastViewerNative"
WINDOW = 64
PAGE_LIMIT = 65
ALBUM_LIMIT = 10
EDGE_MARGIN = 6
PAGE_INDEX_START = -1000000
TIMEOUT_MS = 6000
FILTERS = (
    "PhotoVideo", "Document", "RoundVoice", "Url", "Music", "Gif",
    "Photos", "Video", "Poll",
)


def declared_method(owner, name, arity):
    matches = [method for method in owner.getDeclaredMethods()
               if method.getName() == name and len(method.getParameterTypes()) == arity]
    if len(matches) != 1:
        raise RuntimeError(f"Cannot resolve {owner.getName()}.{name}/{arity}")
    method = matches[0]
    method.setAccessible(True)
    return method


def ordered_messages(messages, *, older=True, boundary=None):
    unique = {}
    for index in range(messages.size()):
        item = messages.get(index)
        if item.id > 0 and (boundary is None or (item.id < boundary if older else item.id > boundary)):
            unique[item.id] = item
    return sorted(unique.values(), key=lambda item: item.id, reverse=older)


def album_cut(items, target, keep_group=0):
    """Take a prefix without slicing through an album at its far end."""
    end = min(target, len(items))
    group = items[end - 1].grouped_id
    if not group:
        return end, False
    while end < len(items) and items[end].grouped_id == group:
        end += 1
    if end < len(items):
        return end, False

    start = end - 1
    while start > 0 and items[start - 1].grouped_id == group:
        start -= 1
    if end - start >= ALBUM_LIMIT:
        return end, False
    if start == 0 or group == keep_group:
        return end, True
    # The next page starts before this group and can take it as a unit.
    return start, False


class FastViewerPlugin(PluginFeature):
    def on_plugin_load(self):
        self.logcat = jclass("android.util.Log")
        self.looper = jclass("android.os.Looper")
        self.conn = jclass("org.telegram.tgnet.ConnectionsManager")
        self.messages = jclass("org.telegram.messenger.MessagesController")
        self.chat = jclass("org.telegram.messenger.ChatObject")
        self.dialog = jclass("org.telegram.messenger.DialogObject")
        self.users = jclass("org.telegram.messenger.UserConfig")
        self.search = jclass("org.telegram.tgnet.TLRPC$TL_messages_search")
        self.response_type = jclass("org.telegram.tgnet.TLRPC$messages_Messages").getClass()
        self.media_filters = [jclass("org.telegram.tgnet.TLRPC$TL_inputMessagesFilter" + name)
                              for name in FILTERS]
        self.bridge = jclass("de.robv.android.xposed.XposedBridge")
        self.box_int = jclass("java.lang.Integer")
        self.box_long = jclass("java.lang.Long")
        self.box_bool = jclass("java.lang.Boolean")
        self.array_list = jclass("java.util.ArrayList")
        self.object_array = jarray(jclass("java.lang.Object"))

        viewer = jclass("org.telegram.ui.PhotoViewer").getClass()
        media = jclass("org.telegram.messenger.MediaDataController").getClass()
        notification_center = jclass("org.telegram.messenger.NotificationCenter")
        self.count_event = notification_center.mediaCountDidLoad
        self.media_event = notification_center.mediaDidLoad
        self.fields = {}
        for name in (
            "classGuid", "currentAccount", "currentDialogId", "topicId", "mergeDialogId",
            "currentFiltered", "opennedFromMedia", "needSearchImageInArr", "sharedMediaType",
            "currentMessageObject", "currentIndex", "imagesArr", "imagesByIds", "countView",
            "loadingMoreImages",
        ):
            field = viewer.getDeclaredField(name)
            field.setAccessible(True)
            self.fields[name] = field

        self.load_media = declared_method(media, "loadMedia", 12)
        self.deliver = declared_method(media, "processLoadedMedia", 13)
        self.set_index = declared_method(viewer, "setImageIndex", 4)
        notification = declared_method(viewer, "didReceivedNotification", 3)
        draw = declared_method(self.fields["countView"].getType(), "onDraw", 1)
        self.viewer_stack = []
        self.hidden_counter = None
        self.pending = {}
        self.gallery = None
        self.page_index = PAGE_INDEX_START
        self.enabled = True
        self.hooks = []
        try:
            for method, before, after in (
                (self.load_media, self.before_load, None),
                (draw, self.before_draw, None),
                (notification, self.before_notification, self.after_notification),
                (self.set_index, None, self.after_index),
            ):
                handle = self.hook_method(method, before=before, after=after)
                if handle is None:
                    raise RuntimeError(f"Hook rejected for {method.getName()}")
                self.hooks.append(handle)
        except Exception:
            self.enabled = False
            for handle in self.hooks:
                self.unhook_method(handle)
            self.hooks.clear()
            raise
        self.logcat.i(TAG, "NagramXF native media hooks ready")

    def on_plugin_unload(self):
        self.enabled = False
        for handle in getattr(self, "hooks", ()):
            self.unhook_method(handle)
        if not hasattr(self, "pending"):
            return
        self.hooks.clear()

        def finish():
            load = self.gallery
            self.gallery = None
            if load is not None:
                load.cancel_page()
                if self.active(load):
                    self.fields["loadingMoreImages"].setBoolean(load.viewer, False)
            hidden = self.hidden_counter
            if hidden is not None:
                self.restore_counter(hidden)
            for load in tuple(self.pending.values()):
                load.timeout()

        run_on_ui_thread(finish)

    def before_notification(self, param):
        if self.looper.myLooper() != self.looper.getMainLooper():
            return
        if param.args[0] == self.count_event:
            self.viewer_stack.append(param.thisObject)
        elif param.args[0] == self.media_event:
            load = self.gallery
            args = param.args[2]
            if (load is not None and len(args) >= 8 and args[0] == load.dialog
                    and args[4] == load.media_type and args[3] == args[7]
                    and args[7] <= PAGE_INDEX_START and param.thisObject == load.viewer):
                param.setResult(None)
                if self.enabled and self.active(load):
                    load.on_page_ready(args[7], args[2])

    def after_notification(self, param):
        if (self.looper.myLooper() == self.looper.getMainLooper()
                and param.args[0] == self.count_event and self.viewer_stack):
            self.viewer_stack.pop()

    def active(self, load):
        view = load.viewer
        fields = self.fields
        return (view.isVisible() and fields["classGuid"].getInt(view) == load.guid
                and fields["currentAccount"].getInt(view) == load.account
                and fields["currentDialogId"].getLong(view) == load.dialog
                and fields["topicId"].getLong(view) == load.topic
                and fields["sharedMediaType"].getInt(view) == load.media_type
                and not fields["currentFiltered"].getBoolean(view)
                and not fields["opennedFromMedia"].getBoolean(view))

    def after_index(self, param):
        load = self.gallery
        if self.enabled and load is not None and param.thisObject == load.viewer and self.active(load):
            load.prefetch()

    def restore_counter(self, load):
        if self.hidden_counter is load:
            self.hidden_counter = None
            load.counter.invalidate()

    def before_draw(self, param):
        load = self.hidden_counter
        if load is not None:
            if not self.enabled or not self.active(load):
                self.hidden_counter = None
            elif load.counter == param.thisObject:
                param.setResult(None)

    def before_load(self, param):
        if not self.enabled or self.looper.myLooper() != self.looper.getMainLooper():
            return
        args = param.args
        dialog, count, max_id, min_id, media_type, topic, source, guid = (args[i] for i in range(8))
        if (not dialog or not guid or source != 1
                or media_type < 0 or media_type >= len(self.media_filters)
                or args[9] is not None or args[10] or args[11]):
            return

        gallery = self.gallery
        if (count == 80 and max_id > 0 and not min_id and gallery is not None
                and (dialog, topic, media_type, guid)
                == (gallery.dialog, gallery.topic, gallery.media_type, gallery.guid)
                and self.active(gallery)):
            # The plugin schedules both directions for this gallery.
            param.setResult(None)
            return

        if (not self.viewer_stack or count != 20 or max_id or min_id or guid in self.pending
                or self.dialog.isEncryptedDialog(dialog)):
            return

        view = self.viewer_stack[-1]
        fields = self.fields
        if (fields["classGuid"].getInt(view) != guid
                or fields["currentDialogId"].getLong(view) != dialog
                or fields["topicId"].getLong(view) != topic
                or fields["mergeDialogId"].getLong(view)
                or fields["currentFiltered"].getBoolean(view)
                or fields["opennedFromMedia"].getBoolean(view)
                or not fields["needSearchImageInArr"].getBoolean(view)):
            return
        message = fields["currentMessageObject"].get(view)
        images = fields["imagesArr"].get(view)
        if (message is None or images.size() != 1 or images.get(0) != message
                or message.getDialogId() != dialog or message.isHiddenSensitive()
                or message.getId() <= 0):
            return

        try:
            load = WindowLoad(self, view, message.getId(), param.thisObject, args)
            if load.start():
                param.setResult(None)
        except Exception as error:
            self.logcat.w(TAG, f"Could not start media window ({type(error).__name__})")


class WindowLoad:
    def __init__(self, plugin, viewer, anchor, controller, args):
        self.plugin = plugin
        self.viewer = viewer
        self.controller = controller
        self.args = args
        self.dialog, self.media_type, self.topic, self.guid = args[0], args[4], args[5], args[7]
        self.account = plugin.fields["currentAccount"].getInt(viewer)
        self.counter = plugin.fields["countView"].get(viewer)
        self.anchor = anchor
        self.messages = plugin.messages.getInstance(self.account)
        self.connection = plugin.conn.getInstance(self.account)
        self.token = 0
        self.cursors = {}
        self.ends = set()
        self.page = None
        self.retried = {}

    def start(self):
        p = self.plugin
        self.token = self.send(
            self.anchor, WINDOW + 2 * ALBUM_LIMIT, -(WINDOW // 2 + ALBUM_LIMIT + 1), self.on_window,
        )
        if not self.token:
            return False
        p.pending[self.guid] = self
        if self.counter is not None:
            p.hidden_counter = self
            self.counter.invalidate()
        run_on_ui_thread(self.timeout, TIMEOUT_MS)
        p.logcat.i(TAG, "Requested media window")
        return True

    def send(self, offset, limit, add_offset, callback, *, max_id=0, min_id=0):
        p = self.plugin
        request = p.search()
        request.peer = self.messages.getInputPeer(self.dialog)
        if request.peer is None:
            return 0
        request.filter = p.media_filters[self.media_type]()
        request.q = ""
        request.offset_id = offset
        request.limit = limit
        request.add_offset = add_offset
        request.max_id = max_id
        request.min_id = min_id
        if self.topic:
            if self.dialog == p.users.getInstance(self.account).getClientUserId():
                request.saved_peer_id = self.messages.getInputPeer(self.topic)
                if request.saved_peer_id is None:
                    return 0
                request.flags |= 4
            else:
                if not (0 < self.topic <= 2147483647):
                    return 0
                request.top_msg_id = self.topic
                request.flags |= 2
        delegate = RequestCallback(
            lambda result, error: run_on_ui_thread(lambda: callback(result, error)),
            self.account,
        )
        token = self.connection.sendRequest(request, delegate)
        if token:
            try:
                self.connection.bindRequestToGuid(token, self.guid)
            except Exception as error:
                p.logcat.w(TAG, f"Could not bind media request ({type(error).__name__})")
        return token

    def send_page(self, direction, boundary, limit, callback):
        older = direction == "older"
        return self.send(
            boundary, limit, 0 if older else -limit, callback,
            max_id=boundary if older else 0, min_id=0 if older else boundary,
        )

    def deliver(self, response, max_id, min_id, request_index, *, pagination=False):
        p = self.plugin
        channel = self.dialog < 0 and p.chat.isChannel(-self.dialog, self.account)
        # A separate notification GUID lets the client ignore a late page after plugin unload.
        notification_guid = request_index if pagination else self.guid
        values = p.object_array([
            response, p.box_long(self.dialog), p.box_int(PAGE_LIMIT if pagination else WINDOW), p.box_int(max_id),
            p.box_int(min_id), p.box_int(self.media_type), p.box_long(self.topic), p.box_int(0),
            p.box_int(notification_guid), p.box_bool(channel), p.box_bool(False),
            p.box_int(request_index), p.box_bool(self.args[11]),
        ])
        p.bridge.invokeOriginalMethod(p.deliver, self.controller, values)

    def take_pending(self):
        if self.plugin.pending.get(self.guid) is not self:
            return False
        del self.plugin.pending[self.guid]
        return True

    def results(self, response, error):
        p = self.plugin
        if error is not None or not p.response_type.isInstance(response):
            return ()
        # Use the same deletion filter as NagramXF's native media search.
        self.messages.removeDeletedMessagesFromArray(self.dialog, response.messages)
        messages = response.messages
        return tuple(messages.get(i).id for i in range(messages.size()))

    def on_window(self, response, error):
        p = self.plugin
        if p.pending.get(self.guid) is not self:
            return
        if not p.enabled or not p.active(self) or error is not None or not p.response_type.isInstance(response):
            self.window_failed()
            return
        try:
            items = ordered_messages(response.messages)
            anchor_index = next((i for i, item in enumerate(items) if item.id == self.anchor), None)
            if anchor_index is None:
                self.window_failed()
                return
            group = items[anchor_index].grouped_id
            older = items[anchor_index:]
            newer = items[anchor_index::-1]
            old_end, check_old = album_cut(older, WINDOW // 2, group)
            new_end, check_new = album_cut(newer, WINDOW // 2 + 1, group)
            selected = newer[new_end - 1:0:-1] + older[:old_end]
            directions = tuple(direction for direction, check in (
                ("older", check_old), ("newer", check_new),
            ) if check)
            self.confirm_albums(response, selected, directions)
        except Exception as failure:
            self.window_failed(type(failure).__name__)

    def window_failed(self, reason=None):
        if self.take_pending():
            if reason is not None:
                self.plugin.logcat.w(TAG, f"Could not load media window ({reason})")
            self.fallback()

    def commit_window(self, response, items):
        if not self.take_pending():
            return
        p = self.plugin
        if not p.enabled or not p.active(self):
            self.fallback()
            return
        try:
            response.messages = self.java_messages(items)
            ids = self.results(response, None)
            if self.anchor not in ids:
                self.fallback()
                return
            top = items[0].id
            self.cursors = {"older": items[-1].id, "newer": top}
            if p.gallery is not None:
                p.gallery.cancel_page()
            p.gallery = self
            # Bounded max_id keeps the client's media cache and deleted-media window accurate.
            self.deliver(response, top, 0, self.args[8])
        except Exception as failure:
            if p.gallery is self:
                p.gallery = None
            p.logcat.w(TAG, f"Could not deliver media window: {failure}")
            self.fallback()
            return
        p.logcat.i(TAG, f"Delivered {len(ids)} media items")
        run_on_ui_thread(lambda: self.probe(top), 300)

    def java_messages(self, items):
        messages = self.plugin.array_list()
        for item in items:
            messages.add(item)
        return messages

    def confirm_albums(self, response, items, directions, page=None):
        p = self.plugin

        def is_pending():
            return self.page is page if page is not None else p.pending.get(self.guid) is self

        def fail(reason):
            if page is not None:
                self.fail_page(page, reason)
            else:
                self.window_failed(reason)

        if not is_pending():
            return
        if not p.enabled or not p.active(self):
            fail("viewer changed")
            return
        if not directions:
            if page is not None:
                self.commit_page(page, response, items)
            else:
                self.commit_window(response, items)
            return

        direction = directions[0]
        older = direction == "older"
        edge = items[-1] if older else items[0]
        group = edge.grouped_id
        if sum(item.grouped_id == group for item in items) >= ALBUM_LIMIT:
            self.confirm_albums(response, items, directions[1:], page)
            return

        def on_extension(reply, error):
            if not is_pending():
                return
            if error is not None or not p.response_type.isInstance(reply):
                fail("album lookup failed")
                return
            try:
                beyond = ordered_messages(reply.messages, older=older, boundary=edge.id)
                siblings = []
                for item in beyond:
                    if item.grouped_id != group:
                        break
                    siblings.append(item)
                if siblings:
                    response.users.addAll(reply.users)
                    response.chats.addAll(reply.chats)
                combined = items + siblings if older else list(reversed(siblings)) + items
                next_edges = directions[1:] if not beyond or len(siblings) < len(beyond) else directions
                self.confirm_albums(response, combined, next_edges, page)
            except Exception as error:
                fail(type(error).__name__)

        try:
            token = self.send_page(direction, edge.id, ALBUM_LIMIT + 1, on_extension)
            if not token:
                fail("album lookup did not start")
            elif page is not None:
                page.token = token
            else:
                self.token = token
        except Exception as error:
            fail(type(error).__name__)

    def probe(self, top):
        p = self.plugin

        def on_newest(response, error):
            if not p.enabled or p.hidden_counter is not self or not p.active(self):
                return
            ids = self.results(response, error)
            if ids and ids[0] == top == self.cursors["newer"]:
                self.ends.add("newer")
                p.restore_counter(self)

        if p.enabled and p.hidden_counter is self and p.active(self):
            try:
                self.send(0, 1, 0, on_newest)
            except Exception as error:
                p.logcat.w(TAG, f"Could not verify media count ({type(error).__name__})")

    def prefetch(self, index=None, direction=None):
        p = self.plugin
        fields = p.fields
        if (not p.enabled or p.gallery is not self or self.page is not None or not p.active(self)
                or fields["needSearchImageInArr"].getBoolean(self.viewer)):
            return
        if index is None:
            index = fields["currentIndex"].getInt(self.viewer)
        size = fields["imagesArr"].get(self.viewer).size()
        if not 0 <= index < size:
            return
        if direction is not None:
            if direction in self.ends:
                return
        elif index < EDGE_MARGIN and "older" not in self.ends:
            direction = "older"
        elif size - 1 - index < EDGE_MARGIN and "newer" not in self.ends:
            direction = "newer"
        else:
            return

        boundary = self.cursors[direction]
        page = MediaPage(direction, boundary, p.page_index)
        p.page_index -= 1
        self.page = page
        try:
            page.token = self.send_page(
                direction, boundary, PAGE_LIMIT + ALBUM_LIMIT,
                lambda response, error: self.on_page_response(page, response, error),
            )
        except Exception as error:
            self.fail_page(page, type(error).__name__)
            return
        if not page.token:
            self.fail_page(page, "request did not start")
            return
        p.logcat.i(TAG, f"Requested {direction} media page")
        run_on_ui_thread(lambda: self.page_timeout(page), TIMEOUT_MS)

    def on_page_response(self, page, response, error):
        p = self.plugin
        if self.page is not page:
            return
        if not p.enabled or p.gallery is not self or not p.active(self):
            self.page = None
            return
        if error is not None or not p.response_type.isInstance(response):
            self.fail_page(page, "search failed")
            return

        try:
            older = page.direction == "older"
            items = ordered_messages(response.messages, older=older, boundary=page.boundary)
            if not items:
                self.ends.add(page.direction)
                if not older:
                    p.restore_counter(self)
                self.finish_page(page)
                return

            end, check = album_cut(items, PAGE_LIMIT)
            selected = items[:end] if older else items[end - 1::-1]
            self.confirm_albums(response, selected, (page.direction,) if check else (), page)
        except Exception as failure:
            self.fail_page(page, type(failure).__name__)

    def commit_page(self, page, response, items):
        older = page.direction == "older"
        try:
            page.next_cursor = (items[-1] if older else items[0]).id
            selected = self.java_messages(items)
            self.messages.removeDeletedMessagesFromArray(self.dialog, selected)
            if selected.isEmpty():
                self.finish_page(page)
                return

            response.messages = selected
            self.deliver(response, page.boundary if older else 0,
                         0 if older else page.boundary, page.request_index, pagination=True)
        except Exception as failure:
            self.fail_page(page, type(failure).__name__)

    def on_page_ready(self, request_index, items):
        p = self.plugin
        page = self.page
        if page is None or request_index != page.request_index:
            return
        try:
            images = p.fields["imagesArr"].get(self.viewer)
            index_field = p.fields["currentIndex"]
            index = index_field.getInt(self.viewer)
            if not 0 <= index < images.size():
                self.page = None
                return

            older = page.direction == "older"
            edge = images.get(0 if older else images.size() - 1).getId()
            index_by_id = p.fields["imagesByIds"].get(self.viewer)[0]
            additions = {}
            for i in range(items.size()):
                item = items.get(i)
                message_id = item.getId()
                if ((0 < message_id < edge if older else message_id > edge)
                        and index_by_id.indexOfKey(message_id) < 0 and not item.isHiddenSensitive()):
                    additions[message_id] = item

            if additions:
                ordered = p.array_list()
                for message_id in sorted(additions):
                    item = additions[message_id]
                    ordered.add(item)
                    index_by_id.put(message_id, item)
                images.addAll(0 if older else images.size(), ordered)
                index += len(additions) if older else 0
                # Refresh both neighboring receivers while preserving the current photo/video.
                index_field.setInt(self.viewer, index)
                args = p.object_array([
                    p.box_int(index), p.box_bool(True), p.box_bool(False), p.box_bool(True),
                ])
                p.bridge.invokeOriginalMethod(p.set_index, self.viewer, args)
                p.logcat.i(TAG, f"Added {len(additions)} {page.direction} media items")
        except Exception as error:
            self.fail_page(page, type(error).__name__)
            return
        self.finish_page(page)

    def finish_page(self, page):
        self.page = None
        self.cursors[page.direction] = page.next_cursor
        run_on_ui_thread(self.prefetch, 150)

    def page_timeout(self, page):
        if self.page is page:
            self.cancel_page()
            self.fail_page(page, "timed out")

    def cancel_page(self):
        page = self.page
        self.page = None
        if page is not None and page.token:
            try:
                self.connection.cancelRequest(page.token, True)
            except Exception as error:
                self.plugin.logcat.w(TAG, f"Could not cancel media page ({type(error).__name__})")

    def fail_page(self, page, reason):
        self.page = None
        self.plugin.logcat.w(TAG, f"Could not load {page.direction} media page ({reason})")
        if self.retried.get(page.direction) != page.boundary:
            self.retried[page.direction] = page.boundary
            run_on_ui_thread(self.prefetch, 1500)

    def timeout(self):
        if self.take_pending():
            try:
                self.connection.cancelRequest(self.token, True)
            finally:
                self.fallback()

    def fallback(self):
        p = self.plugin
        p.restore_counter(self)
        if p.active(self):
            try:
                p.bridge.invokeOriginalMethod(p.load_media, self.controller, self.args)
                p.logcat.i(TAG, "Fell back to NagramXF media loading")
            except Exception as error:
                p.logcat.w(TAG, f"Could not restore media loading ({type(error).__name__})")


class MediaPage:
    def __init__(self, direction, boundary, request_index):
        self.direction = direction
        self.boundary = boundary
        self.request_index = request_index
        self.next_cursor = boundary
        self.token = 0


PAGE_SIZE = 32
PREVIEW_CACHE_SIZE = 256
PREVIEW_WARM_ROWS = 12
PREVIEW_WARM_SCAN = 192
HIDDEN_ROW = -1000
DENSE_MEDIA_TABS = (0, 1, 2, 4)
FAST_VIEWER_PAGE_INDEX = -1000000
PINNED_CHAT_MODE = 2






def media_cursor(mid, maximum, minimum, encrypted):
    if encrypted:
        return max(mid, maximum), min(mid, minimum)
    if mid > 0:
        return min(mid, maximum), max(mid, minimum)
    return maximum, minimum


def day_has_visible_message(messages, index, day, visible):
    for step in (-1, 1):
        offset = index + step
        while 0 <= offset < messages.size():
            msg = messages.get(offset)
            if (msg is not None and msg.messageOwner is not None
                    and not msg.isDateObject and msg.contentType != 2 and msg.getId() != 0):
                if msg.dateKeyInt != day:
                    break
                if visible(offset):
                    return True
            offset += step
    return False


class AlbumPages:
    def __init__(self):
        self.pending = []

    def consume(self, batch, choose, *, end=False):
        for raw in batch:
            if self.pending and (not raw.grouped_id
                                 or raw.grouped_id != self.pending[0].grouped_id):
                match = choose(self.pending)
                if match is not None:
                    return match
                self.pending = []
            if raw.grouped_id:
                self.pending.append(raw)
            else:
                match = choose([raw])
                if match is not None:
                    return match
        if end and self.pending:
            album, self.pending = self.pending, []
            return choose(album)
        return None


class AyuFilterDisplayFix(PluginFeature):
    def on_plugin_load(self):
        self.active = True
        self.date_adapter = None
        self.date_visibility = {}
        self.date_refresh_pending = False
        self.page_down_context = None
        self.latest_read_request = None
        self.cells = {}
        self.attached = {}
        self.layouts = []
        self.pinned_chats = []
        self.pinned_frames = []
        self.cache = OrderedDict()
        self.preview_rules_pending = None
        self.queued = OrderedDict()
        self.running = {}
        self.preview_drain_pending = False
        self.preview_warm_accounts = {}
        self.preview_warm_at = {}
        self.hooks = []
        self.weak = jclass("java.lang.ref.WeakReference")
        self.system = jclass("java.lang.System")
        self.integer = jclass("java.lang.Integer")
        self.original = jclass("de.robv.android.xposed.XposedBridge").invokeOriginalMethod
        self.object_array = jarray(jclass("java.lang.Object"))
        self.ayu = jclass("tw.nekomimi.nekogram.filters.AyuFilter")
        self.mc = jclass("org.telegram.messenger.MessagesController")
        self.account_instance = jclass("org.telegram.messenger.AccountInstance")
        self.chat_object = jclass("org.telegram.messenger.ChatObject")
        self.dialog_object = jclass("org.telegram.messenger.DialogObject")
        self.storage = jclass("org.telegram.messenger.MessagesStorage")
        self.conn = jclass("org.telegram.tgnet.ConnectionsManager")
        self.history = jclass("org.telegram.tgnet.TLRPC$TL_messages_getHistory")
        self.empty_message = jclass("org.telegram.tgnet.TLRPC$TL_messageEmpty").getClass()
        self.message = jclass("org.telegram.messenger.MessageObject")
        self.album = jclass("org.telegram.messenger.MessageObject$GroupedMessages")
        chat = jclass("org.telegram.ui.ChatActivity").getClass()
        adapter = jclass("org.telegram.ui.ChatActivity$ChatActivityAdapter").getClass()
        cell = jclass("org.telegram.ui.Cells.DialogCell").getClass()
        dialogs = jclass("org.telegram.ui.DialogsActivity").getClass()
        events = jclass("org.telegram.messenger.NotificationCenter")
        self.filters_changed = events.regexFiltersUpdated
        self.messages_deleted = events.messagesDeleted
        self.messages_loaded = events.messagesDidLoad
        self.dialogs_loaded = events.dialogsNeedReload
        self.dialog_folders_changed = events.dialogFiltersUpdated
        self.date_events = {self.messages_loaded, events.didReceiveNewMessages,
                            events.messagesDeleted, events.replaceMessagesObjects}
        self.pinned_events = {events.pinnedInfoDidLoad, events.didLoadPinnedMessages}
        self.adapter = field(chat, "chatAdapter")
        self.hide_mode = field(chat, "hideFilteredMessages")
        self.pinned_ids = field(chat, "pinnedMessageIds")
        self.pinned_objects = field(chat, "pinnedMessageObjects")
        self.message_dict = field(chat, "messagesDict")
        self.forward_end = field(chat, "forwardEndReached")
        self.chat_paused = field(chat, "paused")
        self.chat_first_loading = field(chat, "firstLoading")
        self.latest_query = field(chat, "postponedScrollToLastMessageQueryIndex")
        self.latest_query_canceled = field(chat, "postponedScrollIsCanceled")
        self.postponed_message = field(chat, "postponedScrollMessageId")
        self.current_pin = field(chat, "currentPinnedMessageId")
        self.pin_index = field(chat, "currentPinnedMessageIndex")
        self.loaded_pin_count = field(chat, "loadedPinnedMessagesCount")
        self.total_pin_count = field(chat, "totalPinnedMessagesCount")
        self.find_pin = method(chat, "findClosest", 3)
        self.hide_pin_view = method(chat, "hidePinnedMessageView", 1)
        self.check_pin_paddings = method(chat, "checkListViewPaddings", 0)
        self.reply_header = field(chat, "replyMessageHeaderObject")
        self.outer = field(adapter, "this$0")
        self.start = field(adapter, "messagesStartRow")
        self.end = field(adapter, "messagesEndRow")
        self.account = field(cell, "currentAccount")
        self.cell_message = field(cell, "message")
        self.cell_group = field(cell, "groupMessages")
        self.cell_date = field(cell, "lastMessageDate")
        self.dummies = field(cell, "filteredDummyMessages").get(None)
        self.view_type = method(adapter, "getItemViewType", 1)
        self.hooks.append(self.hook_method(self.view_type, after=self.after_view_type))
        self.hooks.append(self.hook_method(method(chat, "didReceivedNotification", 3),
                                           after=self.after_chat_event))
        self.hooks.append(self.hook_method(method(chat, "onPageDownClicked", 0),
                                           before=self.before_page_down,
                                           after=self.after_page_down))
        self.hooks.append(self.hook_method(method(chat, "scrollToLastMessage", 3),
                                           after=self.after_scroll_to_latest))
        self.hooks.append(self.hook_method(self.find_pin, after=self.after_choose_pin))
        for name, arity, role in (("updatePinnedMessageView", 2, "banner"),
                                  ("updatePinnedListButton", 1, "button"),
                                  ("openPinnedMessagesList", 1, "open")):
            self.hooks.append(self.hook_method(method(chat, name, arity),
                                               before=lambda param, role=role: self.before_pinned_ui(param, role),
                                               after=self.after_pinned_ui))
        chat_constructor = chat.getDeclaredConstructor(jclass("android.os.Bundle").getClass())
        chat_constructor.setAccessible(True)
        self.hooks.append(self.hook_method(chat_constructor, after=self.inherit_pinned_filter))
        self.hooks.append(self.hook_method(method(adapter, "notifyDataSetChanged", 1),
                                           after=self.after_pinned_mode_change))
        self.hooks.append(self.hook_method(method(chat, "getPinnedMessagesCount", 0),
                                           after=self.after_pinned_count))
        self.hooks.append(self.hook_method(method(cell, "buildLayout", 0),
                                           before=self.before_layout, after=self.after_layout))
        self.hooks.append(self.hook_method(method(cell, "onAttachedToWindow", 0),
                                           after=self.after_cell_attach))
        self.hooks.append(self.hook_method(method(dialogs, "didReceivedNotification", 3),
                                           after=self.after_dialogs_event))
        self.hooks.append(self.hook_method(method(dialogs, "onResume", 0),
                                           after=lambda param: self.schedule_preview_warm(param.thisObject.getCurrentAccount())))
        layout = jclass("org.telegram.ui.Components.SharedMediaLayout").getClass()
        page = jclass("org.telegram.ui.Components.SharedMediaLayout$MediaPage").getClass()
        shared = jclass("org.telegram.ui.Components.SharedMediaLayout$SharedMediaData").getClass()
        search = jclass("org.telegram.ui.Components.SharedMediaLayout$MediaSearchAdapter").getClass()
        photos = jclass("org.telegram.ui.Components.SharedMediaLayout$SharedPhotoVideoAdapter").getClass()
        documents = jclass("org.telegram.ui.Components.SharedMediaLayout$SharedDocumentsAdapter").getClass()
        viewer = jclass("org.telegram.ui.PhotoViewer").getClass()
        self.media_controller = jclass("org.telegram.messenger.MediaDataController")
        self.java_list = jclass("java.util.ArrayList")
        self.java_boolean = jclass("java.lang.Boolean")
        self.shared_data = field(layout, "sharedMediaData")
        self.shared_preloader = field(layout, "sharedMediaPreloader")
        self.photo_adapter = field(layout, "photoVideoAdapter")
        self.supporting_photo_adapter = field(layout, "animationSupportingPhotoVideoAdapter")
        self.media_adapters = {0: self.photo_adapter, 1: field(layout, "documentsAdapter"),
                               2: field(layout, "voiceAdapter"), 4: field(layout, "audioAdapter")}
        self.photo_outer = field(photos, "this$0")
        self.document_outer = field(documents, "this$0")
        self.document_type = field(documents, "currentType")
        self.media_dialog = field(layout, "dialog_id")
        self.media_merge = field(layout, "mergeDialogId")
        self.media_messages = field(shared, "messages")
        self.media_loading = field(shared, "loading")
        self.media_start = field(shared, "startOffset")
        self.media_frozen_start = field(shared, "frozenStartOffset")
        self.media_request = field(shared, "requestIndex")
        self.viewer_dialog = field(viewer, "currentDialogId")
        self.viewer_merge = field(viewer, "mergeDialogId")
        self.viewer_topic = field(viewer, "topicId")
        self.viewer_chat = field(viewer, "parentChatActivity")
        self.viewer_media_type = field(viewer, "sharedMediaType")
        self.viewer_tag = field(viewer, "currentFilterTag")
        self.media_max = field(shared, "max_id")
        self.media_min = field(shared, "min_id")
        self.media_results = field(search, "searchResult")
        self.media_remote = field(search, "globalSearch")
        self.media_pages = field(layout, "mediaPages")
        self.media_parent = field(layout, "profileActivity")
        self.media_list = field(page, "listView")
        self.media_selected = field(page, "selectedType")
        self.media_more = method(layout, "checkLoadMoreScroll", 3)
        self.media_event = events.mediaDidLoad
        self.media_cached_lists = []
        self.media_layouts = []
        self.filtered_media_data = []
        self.checked_media_data = []
        self.viewer_cursors = {}
        self.hooks.append(self.hook_method(method(shared, "addMessage", 4), before=self.before_media_add))
        for name in ("getItemCount", "getTotalItemsCount"):
            self.hooks.append(self.hook_method(method(photos, name, 0), after=self.after_photo_count))
            self.hooks.append(self.hook_method(method(documents, name, 0), after=(
                lambda param, empty_row=name == "getItemCount": self.after_document_count(param, empty_row))))
        self.hooks.append(self.hook_method(method(layout, "fillMediaData", 1), after=self.after_fill_media))
        self.hooks.append(self.hook_method(method(layout, "jumpToDate", 4), before=self.before_media_jump,
                                           after=self.after_media_jump))
        self.hooks.append(self.hook_method(method(search, "getItemCount", 0), before=self.before_media_count))
        self.hooks.append(self.hook_method(method(layout, "didReceivedNotification", 3),
                                           after=self.after_media_page))
        self.hooks.append(self.hook_method(method(viewer, "openPhoto", 16),
                                           before=self.before_viewer_open))
        self.hooks.append(self.hook_method(method(viewer, "addPhoto", 2), before=self.before_viewer_add))
        self.hooks.append(self.hook_method(method(chat, "getFilteredMessages", 0),
                                           after=self.after_chat_media_list))
        self.hooks.append(self.hook_method(method(viewer, "didReceivedNotification", 3),
                                           priority=100, before=self.before_viewer_page))
        self.hooks.append(self.hook_method(method(viewer, "onPhotoClosed", 1),
                                           before=self.clear_viewer_cursors))
        for name in ("rebuildCache", "invalidateFilteredCache"):
            self.hooks.append(self.hook_method(method(self.ayu.getClass(), name, 0),
                                               after=self.after_filter_change))
        self.hooks.append(self.hook_method(method(self.ayu.getClass(), "onMessageEdited", 2),
                                           after=self.after_preview_edit))

    def media_hidden(self, message, chat=None, group=None):
        if message is None or message.messageOwner is None:
            return False
        if message.isRestrictedMessage or message.isHiddenSensitive():
            return True
        dialog = message.getDialogId()
        if self.ayu.isDialogExcluded(dialog):
            return False
        if message.messageOwner.hide:
            return True
        if chat is not None and not self.hide_mode.getBoolean(chat):
            return False
        group_id = message.getGroupId()
        if group is None and group_id and chat is not None:
            group = chat.getGroup(group_id)
        primary = group.findPrimaryMessageObject() if group is not None else None
        primary = primary if primary is not None else message
        if self.ayu.shouldMaskMessage(primary, group):
            return True
        if not self.ayu.shouldHideFilteredMessages():
            return False
        if self.ayu.shouldHideIgnoredBlockedMessages() and dialog < 0:
            peer = self.mc.getInstance(message.currentAccount).getChat(-dialog)
            if self.chat_object.isMegagroup(peer) and self.ayu.isIgnoredBlockedMessage(message):
                return True
        return self.ayu.shouldHideFilteredMessage(primary, group)

    def before_media_add(self, param):
        message, index, _, encrypted = param.args
        if not self.media_hidden(message):
            return
        data = param.thisObject
        offsets = self.media_max.get(data)
        index = int(index)
        maximum, minimum = media_cursor(message.getId(), offsets[index],
                                        self.media_min.getInt(data), bool(encrypted))
        offsets[index] = maximum
        self.media_min.setInt(data, minimum)
        self.remember_media_ref(self.filtered_media_data, data)
        param.setResult(self.java_boolean(False))

    def remember_media_ref(self, references, value):
        references[:] = [ref for ref in references if ref.get() is not None]
        if not any(ref.get() == value for ref in references):
            references.append(self.weak(value))

    def uses_compact_grid(self, layout, data):
        if self.has_suppressed_media(data):
            return True
        dialog = self.media_dialog.getLong(layout)
        merge = self.media_merge.getLong(layout)
        eligible = not self.ayu.isDialogExcluded(dialog) or (merge != 0 and not self.ayu.isDialogExcluded(merge))
        return eligible and (self.ayu.shouldHideFilteredMessages() or self.ayu.shouldHideIgnoredBlockedMessages()
                             or self.ayu.shouldMaskFilteredMessages())

    def has_suppressed_media(self, data):
        return any(ref.get() == data for ref in self.filtered_media_data)

    def after_photo_count(self, param):
        layout = self.photo_outer.get(param.thisObject)
        if param.thisObject not in (self.photo_adapter.get(layout), self.supporting_photo_adapter.get(layout)):
            return
        self.apply_dense_count(param, layout, 0)

    def after_document_count(self, param, empty_row):
        adapter = param.thisObject
        self.apply_dense_count(param, self.document_outer.get(adapter), self.document_type.getInt(adapter), empty_row)

    def apply_dense_count(self, param, layout, kind, empty_row=False):
        datasets = self.shared_data.get(layout)
        if datasets is None or datasets[kind] is None:
            return
        data = datasets[kind]
        self.remember_media_ref(self.media_layouts, layout)
        self.check_existing_media(layout, kind, data)
        if self.uses_compact_grid(layout, data):
            self.media_start.setInt(data, 0)
            self.media_frozen_start.setInt(data, 0)
            count = data.getMessages().size()
            if empty_row and count == 0 and not self.media_loading.getBoolean(data):
                count = 1
            param.setResult(self.integer(count))

    def check_existing_media(self, layout, kind, data):
        if layout.getParent() is None or any(ref.get() == data for ref in self.checked_media_data):
            return
        self.remember_media_ref(self.checked_media_data, data)

        def check():
            if (self.active and layout.getParent() is not None and self.shared_data.get(layout)[kind] == data
                    and self.prune_loaded_media(layout, data)):
                self.media_data_compacted(layout, kind)
                self.continue_media_page(layout, kind)

        run_on_ui_thread(check, 1)

    def media_data_compacted(self, layout, kind):
        adapter = self.media_adapters[kind].get(layout)
        if adapter is not None:
            adapter.notifyDataSetChanged()

    def prune_loaded_media(self, layout, data):
        removed, _ = self.prune_media_items(layout, data, self.media_messages.get(data))
        return removed

    def prune_media_items(self, layout, data, messages):
        merge = int(self.media_merge.getLong(layout))
        removed = hidden = False
        for index in range(messages.size() - 1, -1, -1):
            item = messages.get(index)
            if self.media_hidden(item):
                hidden = True
                load_index = 1 if merge and item.getDialogId() == merge else 0
                if data.deleteMessage(item.getId(), load_index) is not None:
                    removed = True
        if hidden:
            self.remember_media_ref(self.filtered_media_data, data)
        return removed, hidden

    def after_fill_media(self, param):
        layout, kind = param.thisObject, int(param.args[0])
        data = self.shared_data.get(layout)[kind]
        preloader = self.shared_preloader.get(layout)
        copied = preloader.getSharedMediaData() if preloader is not None else None
        if data is not None and copied is not None and self.has_suppressed_media(copied[kind]):
            self.remember_media_ref(self.filtered_media_data, data)
        if data is not None and self.prune_loaded_media(layout, data):
            param.setResult(self.java_boolean(self.media_messages.get(data).size() > 0))
        if data is not None:
            self.remember_media_ref(self.checked_media_data, data)

    def before_media_jump(self, param):
        kind = int(param.args[0])
        if kind in DENSE_MEDIA_TABS:
            layout = param.thisObject
            if self.uses_compact_grid(layout, self.shared_data.get(layout)[kind]):
                param.args[2] = self.integer(0)

    def after_media_jump(self, param):
        kind = int(param.args[0])
        if kind in DENSE_MEDIA_TABS:
            layout = param.thisObject
            if self.uses_compact_grid(layout, self.shared_data.get(layout)[kind]):
                self.continue_media_page(layout, kind)

    def viewer_batch_groups(self, messages, chat):
        buckets = {}
        if chat is not None and not self.hide_mode.getBoolean(chat):
            return buckets
        if not (self.ayu.shouldHideFilteredMessages() or self.ayu.shouldMaskFilteredMessages()):
            return buckets
        for index in range(messages.size()):
            item = messages.get(index)
            group_id = item.getGroupId()
            if group_id:
                buckets.setdefault((item.getDialogId(), group_id), []).append(item)
        groups = {}
        for (dialog, group_id), members in buckets.items():
            native = chat.getGroup(group_id) if chat is not None else None
            if native is not None:
                groups[dialog, group_id] = native
            elif len(members) > 1:
                album = self.album()
                album.groupId = group_id
                for item in members:
                    album.messages.add(item)
                album.calculate()
                groups[dialog, group_id] = album
        return groups

    def split_visible_media(self, messages, chat=None, *, albums=False):
        visible = self.java_list()
        hidden_ids = []
        groups = self.viewer_batch_groups(messages, chat) if albums else {}
        for index in range(messages.size()):
            item = messages.get(index)
            group = groups.get((item.getDialogId(), item.getGroupId())) if groups else None
            if self.media_hidden(item, chat, group):
                hidden_ids.append(int(item.getId()))
            else:
                visible.add(item)
        return visible, hidden_ids

    def before_viewer_open(self, param):
        args = param.args
        message, messages, index, chat = args[0], args[4], int(args[7]), args[9]
        if messages is None or not 0 <= index < messages.size():
            if message is not None and self.media_hidden(message, chat):
                param.setResult(self.java_boolean(False))
            return
        if chat is None:
            parent = self.viewer_chat.get(param.thisObject)
            if parent is not None and parent.getDialogId() == int(args[10]):
                chat = parent
        selected = messages.get(index)
        visible, hidden = self.split_visible_media(messages, chat, albums=True)
        if hidden:
            new_index = visible.indexOf(selected)
            if new_index < 0:
                param.setResult(self.java_boolean(False))
                return
            args[7] = self.integer(new_index)
            args[4] = visible

    def before_viewer_add(self, param):
        viewer = param.thisObject
        if int(param.args[1]) == viewer.getClassGuid() and self.media_hidden(
                param.args[0], self.viewer_chat.get(viewer)):
            param.setResult(None)

    def after_chat_media_list(self, param):
        results = param.getResult()
        if results is not None:
            visible, hidden = self.split_visible_media(results, param.thisObject, albums=True)
            if hidden:
                param.setResult(visible)

    def before_viewer_page(self, param):
        if int(param.args[0]) != self.media_event:
            return
        viewer, args = param.thisObject, param.args[2]
        if len(args) < 8:
            return
        dialog, guid = int(args[0]), int(args[3])
        if not dialog or dialog not in (
                int(self.viewer_dialog.getLong(viewer)), int(self.viewer_merge.getLong(viewer))):
            return
        # TG Fast Viewer routes its own pages through this event before appending them.
        fast_page = (guid <= FAST_VIEWER_PAGE_INDEX and guid == int(args[7]) and viewer.isVisible()
                     and int(args[4]) == self.viewer_media_type.getInt(viewer))
        if guid != int(viewer.getClassGuid()) and not fast_page:
            return
        visible, hidden = self.split_visible_media(args[2], self.viewer_chat.get(viewer), albums=True)
        if not hidden:
            return
        payload = self.object_array([None] * len(args))
        self.system.arraycopy(args, 0, payload, 0, len(args))
        payload[2] = visible
        param.args[2] = payload
        if not fast_page and not visible.size() and not bool(args[5]):
            from_start = bool(args[6])
            encrypted = self.dialog_object.isEncryptedDialog(dialog)
            towards_larger_id = from_start != encrypted
            ids = [mid for mid in hidden if mid != 0]
            if not ids:
                return
            cursor = (max if towards_larger_id else min)(ids)
            key = guid, dialog, from_start
            last = self.viewer_cursors.get(key)
            if last is not None and (cursor <= last if towards_larger_id else cursor >= last):
                return
            try:
                self.media_controller.getInstance(int(param.args[1])).loadMedia(
                    dialog, 40, 0 if from_start else cursor, cursor if from_start else 0,
                    int(args[4]), int(self.viewer_topic.getLong(viewer)), 1, guid, int(args[7]),
                    self.viewer_tag.get(viewer), None)
                self.viewer_cursors[key] = cursor
                param.setResult(None)
            except Exception as error:
                self.log(f"Filtered gallery could not continue: {type(error).__name__}")

    def clear_viewer_cursors(self, param):
        guid = int(param.thisObject.getClassGuid())
        self.viewer_cursors = {key: cursor for key, cursor in self.viewer_cursors.items() if key[0] != guid}

    def before_media_count(self, param):
        adapter = param.thisObject
        for result_field in (self.media_results, self.media_remote):
            messages = result_field.get(adapter)
            if messages is None:
                continue
            size = messages.size()
            identity = int(self.system.identityHashCode(messages))
            if any(ref.get() == messages and cached == (identity, size)
                   for ref, cached in self.media_cached_lists):
                continue
            for index in range(size - 1, -1, -1):
                if self.media_hidden(messages.get(index)):
                    # remove(int) and remove(Object) have different semantics.
                    messages.remove(index)
            self.media_cached_lists = [(ref, cached) for ref, cached in self.media_cached_lists
                                       if ref.get() is not None and cached[0] != identity]
            self.media_cached_lists.append((self.weak(messages), (identity, messages.size())))

    def after_media_page(self, param):
        if int(param.args[0]) != self.media_event:
            return
        layout, args = param.thisObject, param.args[2]
        if len(args) < 8:
            return
        if int(args[3]) != self.media_parent.get(layout).getClassGuid():
            return
        kind = int(args[4])
        if kind in (6, 7):
            kind = 0
        data = self.shared_data.get(layout)[kind]
        if int(args[7]) != self.media_request.getInt(data):
            return
        messages = args[2]
        if messages is None:
            return
        if kind in DENSE_MEDIA_TABS:
            removed, hidden = self.prune_media_items(layout, data, messages)
            if removed:
                self.media_data_compacted(layout, kind)
        else:
            hidden = any(self.media_hidden(messages.get(i)) for i in range(messages.size()))
        if hidden and not bool(args[5]):
            self.continue_media_page(layout, kind)

    def continue_media_page(self, layout, kind):
        def continue_visible():
            if not self.active or layout.getParent() is None:
                return
            page = self.media_pages.get(layout)[0]
            if page is None or self.media_selected.getInt(page) != kind:
                return
            listing = self.media_list.get(page)
            if listing is not None and listing.getLayoutManager() is not None:
                self.media_more.invoke(layout, self.object_array(
                    [page, listing, listing.getLayoutManager()]))

        run_on_ui_thread(continue_visible, 8)

    def position_type(self, adapter, position):
        return int(self.original(self.view_type, adapter,
                                 self.object_array([self.integer(position)])))

    def pinned_hidden(self, chat, message):
        if message is None or message.messageOwner is None:
            return False
        group = None
        if message.getGroupId():
            group = chat.getGroup(message.getGroupId())
            if group is None:
                group = chat.getValidGroupedMessage(message)
        primary = group.findPrimaryMessageObject() if group is not None else None
        primary = primary if primary is not None else message
        previous = primary.skipAyuFiltering
        primary.skipAyuFiltering = not self.hide_mode.getBoolean(chat)
        try:
            return self.media_hidden(message, chat, group)
        finally:
            primary.skipAyuFiltering = previous

    def pinned_message(self, chat, mid):
        entry = self.pinned_objects.get(chat).get(self.integer(mid))
        return entry if entry is not None else self.message_dict.get(chat)[0].get(mid)

    def visible_pins(self, chat, source):
        visible = self.java_list()
        loaded = self.java_list()
        for i in range(source.size()):
            mid = int(source.get(i))
            message = self.pinned_message(chat, mid)
            if not self.pinned_hidden(chat, message):
                boxed = self.integer(mid)
                visible.add(boxed)
                if message is not None:
                    loaded.add(boxed)
        return visible, loaded

    def nearest_pin(self, chat, visible, loaded, target, index):
        candidates = visible if loaded.isEmpty() else loaded
        return int(self.original(self.find_pin, chat,
                                 self.object_array([candidates, self.integer(target), index])))

    def after_choose_pin(self, param):
        chat = param.thisObject
        source, target, index = param.args
        if chat.getChatMode() != 0 or source != self.pinned_ids.get(chat):
            return
        mid = int(param.getResult())
        if not mid or not self.pinned_hidden(chat, self.pinned_message(chat, mid)):
            return
        visible, loaded = self.visible_pins(chat, source)
        replacement = self.nearest_pin(chat, visible, loaded, int(target), index)
        index[0] = source.indexOf(self.integer(replacement)) if replacement else max(0, source.size() - 1)
        param.setResult(self.integer(replacement))

    def watch_pinned_chat(self, chat):
        self.pinned_chats = [record for record in self.pinned_chats if record[0].get() is not None]
        record = next((entry for entry in self.pinned_chats if entry[0].get() == chat), None)
        if record is None:
            record = [self.weak(chat), self.hide_mode.getBoolean(chat)]
            self.pinned_chats.append(record)
        return record

    def native_pin_dismissed(self, chat, source):
        preferences = self.mc.getNotificationsSettings(chat.getCurrentAccount())
        return preferences.getInt(f"pin_{chat.getDialogId()}", 0) == int(source.get(0))

    def before_pinned_ui(self, param, role):
        chat = param.thisObject
        frame = [chat, role, None]
        self.pinned_frames.append(frame)
        if chat.getChatMode() != 0:
            return
        self.watch_pinned_chat(chat)
        if (role == "banner" and chat.isThreadChat() and not chat.isTopic
                and self.pinned_hidden(chat, chat.getThreadMessage())):
            if self.original(self.hide_pin_view, chat, self.object_array([self.java_boolean(False)])):
                self.original(self.check_pin_paddings, chat, self.object_array([]))
            param.setResult(None)
            return
        source = self.pinned_ids.get(chat)
        if source.isEmpty():
            return
        visible, loaded = self.visible_pins(chat, source)
        if visible.size() == source.size():
            return
        # NagramXF stores dismissal against the newest original pin.
        if role == "banner" and self.native_pin_dismissed(chat, source):
            return
        frame[2] = (source, visible, self.loaded_pin_count.getInt(chat), self.total_pin_count.getInt(chat))
        self.pinned_ids.set(chat, visible)
        if role != "button":
            self.loaded_pin_count.setInt(chat, visible.size())
            self.total_pin_count.setInt(chat, visible.size())
        if role == "banner":
            index = self.pin_index.get(chat)
            mid = self.current_pin.getInt(chat)
            if mid and not visible.contains(self.integer(mid)):
                mid = self.nearest_pin(chat, visible, loaded, mid, index)
                self.current_pin.setInt(chat, mid)
            index[0] = max(0, visible.indexOf(self.integer(mid)))
            param.args[0], param.args[1] = self.java_boolean(False), self.integer(0)

    def after_pinned_ui(self, param):
        chat, role, projection = self.pinned_frames.pop()
        if projection is None:
            return
        source, visible, loaded, total = projection
        if self.pinned_ids.get(chat) != visible:
            return
        self.pinned_ids.set(chat, source)
        if role != "button":
            self.loaded_pin_count.setInt(chat, loaded)
            self.total_pin_count.setInt(chat, total)
        if role == "banner":
            index = self.pin_index.get(chat)
            index[0] = max(0, source.indexOf(self.integer(self.current_pin.getInt(chat))))

    def inherit_pinned_filter(self, param):
        if not self.pinned_frames or len(param.args) != 1:
            return
        parent, role, _ = self.pinned_frames[-1]
        args = param.args[0]
        if role == "open" and args is not None and args.getInt("chatMode") == PINNED_CHAT_MODE:
            chat = param.thisObject
            self.hide_mode.setBoolean(chat, self.hide_mode.getBoolean(parent))
            self.watch_pinned_chat(chat)

    def after_pinned_count(self, param):
        chat = param.thisObject
        if chat.getChatMode() == PINNED_CHAT_MODE:
            source = self.pinned_ids.get(chat)
            visible, _ = self.visible_pins(chat, source)
            if visible.size() < source.size():
                param.setResult(self.integer(visible.size()))

    def after_pinned_mode_change(self, param):
        chat = self.outer.get(param.thisObject)
        for record in self.pinned_chats:
            if record[0].get() == chat:
                hiding = self.hide_mode.getBoolean(chat)
                if hiding != record[1]:
                    record[1] = hiding
                    run_on_ui_thread(lambda: self.refresh_pinned_chat(chat), 1)
                return

    def refresh_pinned_chat(self, chat):
        if not self.active or chat.getFragmentView() is None:
            return
        if chat.getChatMode() == 0:
            chat.updateMessagesVisiblePart(False)
            chat.updatePinnedMessageView(False)
        elif chat.getChatMode() == PINNED_CHAT_MODE:
            adapter = self.adapter.get(chat)
            if adapter is not None:
                adapter.notifyDataSetChanged(False)

    def is_date(self, chat, msg):
        return (msg is not None and msg.isDateObject and msg.type == self.message.TYPE_DATE
                and not msg.isVideoConversionObject and msg != self.reply_header.get(chat))

    def day_visible(self, adapter, messages, index, start):
        return day_has_visible_message(
            messages, index, messages.get(index).dateKeyInt,
            lambda row: self.position_type(adapter, start + row) >= 0,
        )

    def after_view_type(self, param):
        result = int(param.getResult())
        if result == HIDDEN_ROW:
            return
        adapter, position = param.thisObject, int(param.args[0])
        start = self.start.getInt(adapter)
        if not start <= position < self.end.getInt(adapter):
            return
        chat = self.outer.get(adapter)
        pinned = chat.getChatMode() == PINNED_CHAT_MODE
        date_candidate = result == 1 and self.ayu.shouldHideFilteredMessages() and self.hide_mode.getBoolean(chat)
        if not pinned and not date_candidate:
            return
        messages = adapter.getMessages()
        index = position - start
        if index >= messages.size():
            return
        msg = messages.get(index)
        if pinned and self.pinned_hidden(chat, msg):
            param.setResult(self.integer(HIDDEN_ROW))
            return
        if not date_candidate:
            return
        if not self.is_date(chat, msg):
            return
        visible = self.day_visible(adapter, messages, index, start)
        if self.date_adapter is None or self.date_adapter.get() != adapter:
            self.date_adapter = self.weak(adapter)
            self.date_visibility = {}
        self.date_visibility[int(msg.stableId)] = visible
        if not visible:
            param.setResult(self.integer(HIDDEN_ROW))

    def after_chat_event(self, param):
        event = int(param.args[0])
        if event == self.messages_loaded and self.latest_read_request is not None:
            self.after_latest_load(param.thisObject, param.args[2])
        if event in self.pinned_events:
            chat, payload = param.thisObject, param.args[2]
            if len(payload) and int(payload[0]) == chat.getDialogId():
                run_on_ui_thread(lambda: self.refresh_pinned_chat(chat), 1)
        if (event not in self.date_events or self.date_refresh_pending
                or self.date_adapter is None
                or self.date_adapter.get() != self.adapter.get(param.thisObject)):
            return
        self.date_refresh_pending = True
        run_on_ui_thread(self.refresh_dates, 1)

    def before_page_down(self, param):
        chat = param.thisObject
        view = chat.getChatListView()
        if (self.active and chat.getChatMode() == 0 and not chat.isFeedSearch()
                and view is not None and not view.isFastScrollAnimationRunning()):
            self.latest_read_request = None
            self.page_down_context = chat, self.latest_query.getInt(chat)

    def after_page_down(self, param):
        self.page_down_context = None

    def after_scroll_to_latest(self, param):
        chat = param.thisObject
        context = self.page_down_context
        if context is None or context[0] != chat:
            return
        query = self.latest_query.getInt(chat)
        if query > 0 and query != context[1]:
            self.latest_read_request = self.weak(chat), query
        elif query == 0:
            self.read_hidden_latest(chat)

    def after_latest_load(self, chat, payload):
        ref, query = self.latest_read_request
        if (ref.get() != chat or len(payload) < 15 or int(payload[0]) != chat.getDialogId()
                or int(payload[10]) != chat.getClassGuid() or abs(int(payload[11])) != query):
            return
        next_query = self.latest_query.getInt(chat)
        if next_query == query:
            return
        self.latest_read_request = None
        if self.latest_query_canceled.getBoolean(chat) or self.postponed_message.getInt(chat):
            return
        if next_query > 0:
            # An incomplete cache page can be replaced by the host's network request.
            self.latest_read_request = ref, next_query
        else:
            self.read_hidden_latest(chat)

    def read_hidden_latest(self, chat):
        if (not self.active or chat.getChatMode() != 0 or chat.isFeedSearch() or chat.isSecretChat()
                or chat.isTopic or chat.isThreadChat() or chat.isInPreviewMode()
                or self.chat_paused.getBoolean(chat) or self.chat_first_loading.getBoolean(chat)
                or not self.hide_mode.getBoolean(chat) or not self.forward_end.get(chat)[0]):
            return
        dialog_id = int(chat.getDialogId())
        if self.ayu.isDialogExcluded(dialog_id):
            return
        controller = self.mc.getInstance(chat.getCurrentAccount())
        if controller.ignoreSetOnline:
            return
        dialog = controller.dialogs_dict.get(dialog_id)
        if dialog is None or dialog.unread_count <= 0 or dialog.top_message <= 0:
            return
        latest = int(dialog.top_message)
        message = self.message_dict.get(chat)[0].get(latest)
        adapter = self.adapter.get(chat)
        if message is None or message.messageOwner is None or adapter is None or adapter.isFiltered or adapter.isFrozen:
            return
        index = adapter.getMessages().indexOf(message)
        start = self.start.getInt(adapter)
        if index < 0 or start + index >= self.end.getInt(adapter):
            return
        if self.position_type(adapter, start + index) == HIDDEN_ROW:
            # Use the server-backed top ID and the native storage, badge, and read-receipt flow.
            controller.markDialogAsRead(dialog_id, latest, latest, message.messageOwner.date,
                                        False, 0, dialog.unread_count, True, 0)

    def refresh_dates(self):
        self.date_refresh_pending = False
        adapter = self.date_adapter.get() if self.active and self.date_adapter else None
        if adapter is None:
            return
        chat = self.outer.get(adapter)
        if not self.hide_mode.getBoolean(chat) or not self.ayu.shouldHideFilteredMessages():
            return
        messages = adapter.getMessages()
        start = self.start.getInt(adapter)
        observed = {}
        for index in range(messages.size()):
            msg = messages.get(index)
            if msg is None or not msg.isDateObject:
                continue
            stable_id = int(msg.stableId)
            if stable_id in self.date_visibility and self.is_date(chat, msg):
                if self.position_type(adapter, start + index) != 1:
                    continue
                visible = self.day_visible(adapter, messages, index, start)
                if visible != self.date_visibility[stable_id]:
                    adapter.notifyItemChanged(start + index)
                observed[stable_id] = visible
        self.date_visibility = observed

    def preview_scope(self, cell):
        if not cell.isDialogCell or cell.insideCommunityListNoDialog:
            return None
        if cell.isDialogFolder() or cell.isDialogCommunity():
            return None
        return int(self.account.getInt(cell)), int(cell.getDialogId())

    def preview_key(self, cell, scope=None):
        scope = self.preview_scope(cell) if scope is None else scope
        if scope is None or self.cell_message.get(cell) != self.dummies[scope[0]]:
            return None
        account, dialog_id = scope
        controller = self.mc.getInstance(account)
        dialog = controller.dialogs_dict.get(dialog_id)
        return self.dialog_preview_key(account, dialog_id, dialog, controller)

    def dialog_preview_key(self, account, dialog_id, dialog, controller):
        if dialog is None or not dialog.top_message:
            return None
        if dialog.top_message < 0 and not self.dialog_object.isEncryptedDialog(dialog_id):
            return None
        top_group = controller.dialogMessage.get(dialog_id)
        top = top_group.get(0) if top_group is not None and top_group.size() else None
        edit_date = int(top.messageOwner.edit_date) if top is not None else 0
        group_id = int(top.messageOwner.grouped_id) if top is not None else 0
        return account, dialog_id, int(dialog.top_message), int(dialog.last_message_date), edit_date, group_id

    def before_layout(self, param):
        self.layouts.append(None)
        cell = param.thisObject
        scope = self.preview_scope(cell)
        if scope is None:
            return
        key = self.preview_key(cell, scope)
        if key is None:
            self.remember_native_preview(cell, scope)
            return
        checked, retry_at, candidate = self.cache.get(scope, (None, None, None))
        if checked != key and candidate is not None and not self.allowed(*candidate, scope):
            checked = retry_at = candidate = None
            self.store_preview(scope, checked, retry_at, candidate)
        if checked != key or (retry_at is not None and retry_at <= monotonic()):
            self.schedule(cell, key)
        else:
            self.track_cell(cell, key)
        if candidate is None:
            return
        self.cache.move_to_end(scope)
        message, group = candidate
        self.layouts[-1] = (cell, self.cell_message.get(cell), self.cell_group.get(cell),
                            self.cell_date.getInt(cell))
        self.cell_message.set(cell, message)
        self.cell_group.set(cell, group.messages if group is not None else None)
        self.cell_date.setInt(cell, message.messageOwner.date)

    def store_preview(self, scope, checked, retry_at, candidate):
        self.cache[scope] = checked, retry_at, candidate
        self.cache.move_to_end(scope)
        if len(self.cache) > PREVIEW_CACHE_SIZE:
            self.cache.popitem(last=False)

    def preview_rank(self, scope, message):
        mid = int(message.getId())
        return (-mid if self.dialog_object.isEncryptedDialog(scope[1]) else mid,
                int(message.messageOwner.edit_date))

    def preview_members(self, candidate):
        message, group = candidate
        if group is None:
            return (message,)
        return tuple(group.messages.get(i) for i in range(group.messages.size()))

    def make_preview_group(self, group_id, members):
        group = self.album()
        group.groupId = group_id
        for member in members:
            group.messages.add(member)
        group.calculate()
        return group

    def remember_native_preview(self, cell, scope):
        message = self.cell_message.get(cell)
        if (message is None or message == self.dummies[scope[0]] or message.messageOwner is None
                or message.getDialogId() != scope[1]):
            return
        if scope not in self.cache and not (self.ayu.shouldHideFilteredMessages()
                                             or self.ayu.shouldHideIgnoredBlockedMessages()):
            return
        checked, retry_at, previous = self.cache.get(scope, (None, None, None))
        rank = self.preview_rank(scope, message)
        if rank[0] <= 0 or (previous is not None and rank <= self.preview_rank(scope, previous[0])):
            return
        group_id, members = message.getGroupId(), self.cell_group.get(cell)
        group = None
        if group_id and members is not None and members.size() > 1:
            group = self.make_preview_group(group_id, (members.get(i) for i in range(members.size())))
        if self.allowed(message, group, scope):
            self.store_preview(scope, checked, retry_at, (message, group))

    def after_layout(self, param):
        saved = self.layouts.pop()
        if saved is not None:
            cell, message, group, date = saved
            self.cell_message.set(cell, message)
            self.cell_group.set(cell, group)
            self.cell_date.setInt(cell, date)

    def track_cell(self, cell, key):
        self.cells[int(self.system.identityHashCode(cell))] = (self.weak(cell), key)

    def after_cell_attach(self, param):
        cell = param.thisObject
        if len(self.attached) >= 96:
            self.attached = {key: ref for key, ref in self.attached.items()
                             if (attached := ref.get()) is not None and attached.isAttachedToWindow()}
        self.attached[int(self.system.identityHashCode(cell))] = self.weak(cell)
        key = self.preview_key(cell)
        if key is not None:
            checked, retry_at, _ = self.cache.get(key[:2], (None, None, None))
            if checked != key or (retry_at is not None and retry_at <= monotonic()):
                self.schedule(cell, key)
            else:
                self.track_cell(cell, key)

    def rebuild_cell(self, cell):
        if self.active and cell.isAttachedToWindow():
            cell.buildLayout()
            cell.invalidate()

    def schedule(self, cell, key):
        self.track_cell(cell, key)
        lookup = self.running.get(key)
        if lookup is not None:
            lookup.prefetch = False
        elif self.queued.get(key) is not False:
            self.queued[key] = False
            self.queued.move_to_end(key, last=False)
            self.request_preview_drain()

    def request_preview_drain(self):
        if not self.preview_drain_pending:
            self.preview_drain_pending = True
            run_on_ui_thread(self.drain_queue, 32)

    def matching_cells(self, key=None):
        for identity, (ref, previous) in list(self.cells.items()):
            cell = ref.get()
            if cell is None or self.preview_key(cell) != previous:
                self.cells.pop(identity, None)
            elif cell.isAttachedToWindow() and (key is None or key == previous):
                yield cell

    def drain_queue(self):
        self.preview_drain_pending = False
        for _ in range(4):
            if not self.active or not self.queued or len(self.running) >= 2:
                return
            key, prefetch = next(iter(self.queued.items()))
            if prefetch and self.running:
                return
            del self.queued[key]
            if not prefetch and not any(True for _ in self.matching_cells(key)):
                continue
            lookup = PreviewSearch(self, key, prefetch)
            self.running[key] = lookup
            lookup.next_page()
        if self.queued and len(self.running) < 2:
            self.request_preview_drain()

    def schedule_preview_warm(self, account):
        now = monotonic()
        if (not self.active or account in self.preview_warm_accounts
                or now < self.preview_warm_at.get(account, 0)):
            return
        if not (self.ayu.shouldHideFilteredMessages() or self.ayu.shouldHideIgnoredBlockedMessages()):
            return
        ticket = self.preview_warm_accounts[account] = object()
        self.preview_warm_at[account] = now + 3
        run_on_ui_thread(lambda: self.warm_preview_rows(account, ticket), 480)

    def warm_preview_rows(self, account, ticket):
        if not self.active or self.preview_warm_accounts.get(account) is not ticket:
            return
        controller = self.mc.getInstance(account)
        instance = self.account_instance.getInstance(account)
        filters = controller.getDialogFilters()
        limits = [[filters.get(i), PREVIEW_WARM_ROWS] for i in range(filters.size())]
        limits.insert(0, [None, PREVIEW_WARM_ROWS])
        dialogs = controller.getAllDialogs()
        check_regex = self.ayu.shouldHideFilteredMessages()
        check_blocked = self.ayu.shouldHideIgnoredBlockedMessages()

        def scan(index):
            if not self.active or self.preview_warm_accounts.get(account) is not ticket:
                return
            stop = min(PREVIEW_WARM_SCAN, dialogs.size())
            end = min(index + 4, stop)
            for position in range(index, end):
                dialog = dialogs.get(position)
                dialog_id = int(dialog.id)
                if not dialog.top_message:
                    continue
                belongs = False
                for quota in limits:
                    folder, remaining = quota
                    if remaining and (folder is None or folder.includesDialog(instance, dialog_id, dialog)):
                        quota[1] -= 1
                        belongs = True
                if belongs:
                    self.warm_dialog_preview(account, dialog_id, dialog, controller, check_regex, check_blocked)
            if end < stop and any(remaining for _, remaining in limits):
                run_on_ui_thread(lambda: scan(end), 58)
            else:
                self.preview_warm_accounts.pop(account, None)

        scan(0)

    def warm_dialog_preview(self, account, dialog_id, dialog, controller, check_regex, check_blocked):
        group = controller.dialogMessage.get(dialog_id)
        message = group.get(0) if group is not None and group.size() else None
        if message is None:
            return
        if not ((check_regex and self.ayu.shouldHideFilteredMessage(message, None))
                or (check_blocked and dialog_id < 0 and self.chat_object.isMegagroup(controller.getChat(-dialog_id))
                    and self.ayu.isIgnoredBlockedMessage(message))):
            return
        key = self.dialog_preview_key(account, dialog_id, dialog, controller)
        if key is None or key in self.queued or key in self.running:
            return
        checked, retry_at, _ = self.cache.get(key[:2], (None, None, None))
        if checked == key and (retry_at is None or retry_at > monotonic()):
            return
        self.queued[key] = True
        self.request_preview_drain()

    def allowed(self, message, group, key):
        account, dialog_id = key[:2]
        members = group.messages if group is not None else [message]
        chat = self.mc.getInstance(account).getChat(-dialog_id) if dialog_id < 0 else None
        block_enabled = self.ayu.shouldHideIgnoredBlockedMessages() and self.chat_object.isMegagroup(chat)
        for i in range(members.size() if group is not None else 1):
            member = members.get(i) if group is not None else members[i]
            if (member.messageOwner.hide or member.isHiddenSensitive()
                    or (block_enabled and self.ayu.isIgnoredBlockedMessage(member))):
                return False
        primary = group.findPrimaryMessageObject() if group is not None else None
        return not self.ayu.shouldHideFilteredMessage(primary if primary is not None else message, group)

    def refresh_previews(self, *, rebind=False, scopes=None, invalid_ids=()):
        if not self.active:
            return
        if scopes is None:
            self.preview_warm_accounts.clear()
            self.preview_warm_at.clear()
        for scope, (_, _, candidate) in list(self.cache.items()):
            if scopes is None or scope in scopes:
                if candidate is not None and any(member.getId() in invalid_ids for member in self.preview_members(candidate)):
                    candidate = None
                self.cache[scope] = None, None, candidate
        for key in tuple(self.queued):
            if scopes is None or key[:2] in scopes:
                self.queued.pop(key)
        for key in tuple(self.running):
            if scopes is None or key[:2] in scopes:
                self.running.pop(key).cancel()
        if rebind:
            for ref in list(self.attached.values()):
                cell = ref.get()
                if cell is not None and cell.isAttachedToWindow() and cell.isDialogCell:
                    cell.update(0, False)
                    self.rebuild_cell(cell)
        else:
            for cell in list(self.matching_cells()):
                if scopes is None or self.preview_scope(cell) in scopes:
                    self.rebuild_cell(cell)

    def queue_preview_rule_refresh(self, rebind=False):
        if self.preview_rules_pending is not None:
            self.preview_rules_pending |= rebind
            return
        self.preview_rules_pending = rebind

        def refresh():
            update = self.preview_rules_pending
            self.preview_rules_pending = None
            self.refresh_previews(rebind=update)

        run_on_ui_thread(refresh, 1)

    def after_filter_change(self, param, refresh_previews=True):
        if refresh_previews:
            self.queue_preview_rule_refresh(rebind=True)

        def refresh():
            if not self.active:
                return
            self.media_cached_lists.clear()
            for ref, _ in self.pinned_chats[:]:
                chat = ref.get()
                if chat is not None:
                    self.refresh_pinned_chat(chat)
            for ref in self.media_layouts[:]:
                layout = ref.get()
                if layout is not None and layout.getParent() is not None:
                    datasets = self.shared_data.get(layout)
                    for kind, adapter_field in self.media_adapters.items():
                        self.prune_loaded_media(layout, datasets[kind])
                        adapter = adapter_field.get(layout)
                        if adapter is not None:
                            adapter.notifyDataSetChanged()
                        self.continue_media_page(layout, kind)

        run_on_ui_thread(refresh, 1)

    def after_preview_edit(self, param):
        mid, dialog = map(int, param.args)

        def refresh():
            scopes = {scope for scope, (_, _, candidate) in self.cache.items()
                      if scope[1] == dialog and (candidate is None
                          or any(member.getId() == mid for member in self.preview_members(candidate))
                          or (abs(mid) >= self.preview_rank(scope, candidate[0])[0]))}
            if scopes:
                self.refresh_previews(scopes=scopes, invalid_ids={mid})

        run_on_ui_thread(refresh, 1)
        self.after_filter_change(param, refresh_previews=False)

    def delete_previews(self, account, ids, channel):
        controller = self.mc.getInstance(account)
        scopes = {scope for scope, (_, _, candidate) in self.cache.items()
                  if scope[0] == account and candidate is not None
                  and any(member.getId() in ids for member in self.preview_members(candidate))
                  and (scope[1] == -channel if channel else (
                      scope[1] > 0 or not self.chat_object.isChannel(controller.getChat(-scope[1]))))}
        if scopes:
            self.refresh_previews(scopes=scopes, invalid_ids=ids)

    def after_dialogs_event(self, param):
        event, account, payload = param.args
        if event == self.filters_changed:
            self.queue_preview_rule_refresh(rebind=True)
        elif event in (self.dialogs_loaded, self.dialog_folders_changed):
            self.schedule_preview_warm(int(account))
        elif event == self.messages_deleted and len(payload) >= 3 and not payload[2]:
            ids = payload[0]
            deleted_ids = {int(ids.get(i)) for i in range(ids.size())}
            channel = int(payload[1])
            run_on_ui_thread(lambda: self.delete_previews(int(account), deleted_ids, channel), 1)

    def on_plugin_unload(self):
        self.active = False
        self.page_down_context = None
        self.latest_read_request = None
        for hook in self.hooks:
            self.unhook_method(hook)

        def restore():
            for ref, _ in self.pinned_chats:
                chat = ref.get()
                if chat is not None and chat.getFragmentView() is not None and chat.getChatMode() == 0:
                    chat.updateMessagesVisiblePart(False)
                    chat.updatePinnedMessageView(False)
            self.pinned_chats.clear()
            for lookup in self.running.values():
                lookup.cancel()
            self.running.clear()
            self.queued.clear()
            self.preview_warm_accounts.clear()
            self.cache.clear()
            adapter = self.date_adapter.get() if self.date_adapter else None
            if adapter is not None:
                adapter.notifyDataSetChanged()
            for ref, _ in self.cells.values():
                cell = ref.get()
                if cell is not None and cell.isAttachedToWindow():
                    cell.buildLayout()
                    cell.invalidate()
            self.cells.clear()
            self.attached.clear()

        run_on_ui_thread(restore)


class PreviewSearch:
    def __init__(self, plugin, key, prefetch=False):
        self.plugin = plugin
        self.key = key
        self.account, self.dialog_id, self.top, _, _, self.top_group = key
        self.controller = plugin.mc.getInstance(self.account)
        self.connection = plugin.conn.getInstance(self.account)
        self.offset = min(self.top + 1, 2147483647)
        self.encrypted = bool(plugin.dialog_object.isEncryptedDialog(self.dialog_id))
        self.local_offset = self.top - 1
        self.pages = AlbumPages()
        self.ticket = None
        self.token = 0
        self.prefetch = prefetch
        self.prefetch_pages = 2

    def active_scope(self):
        p = self.plugin
        if self.prefetch:
            dialog = self.controller.dialogs_dict.get(self.dialog_id)
            return p.dialog_preview_key(self.account, self.dialog_id, dialog, self.controller) == self.key
        return next(iter(p.matching_cells(self.key)), None) is not None

    def next_page(self):
        p = self.plugin
        if not p.active or p.running.get(self.key) is not self:
            return
        if self.prefetch:
            if self.prefetch_pages <= 0:
                self.finish(retain=False)
                return
            self.prefetch_pages -= 1
        if self.encrypted:
            self.next_secret_page()
            return
        request = p.history()
        request.peer = self.controller.getInputPeer(self.dialog_id)
        if request.peer is None:
            self.finish(retry=True)
            return
        request.offset_id = self.offset
        request.limit = PAGE_SIZE
        ticket = self.ticket = object()
        delegate = RequestCallback(
            lambda result, error: run_on_ui_thread(lambda: self.receive(ticket, result, error)),
            self.account,
        )
        self.token = self.connection.sendRequest(request, delegate)
        run_on_ui_thread(lambda: self.timeout(ticket), 7000)

    def next_secret_page(self):
        # Secret chats have no getHistory endpoint. Use the host's local order and decoder.
        p = self.plugin
        ticket = self.ticket = object()
        storage = p.storage.getInstance(self.account)
        start = self.local_offset

        def read():
            ids = []
            try:
                cursor = storage.getDatabase().queryFinalized(
                    f"SELECT mid FROM messages_v2 WHERE uid = {self.dialog_id} "
                    f"AND mid > {start} AND mid < 0 ORDER BY mid ASC LIMIT {PAGE_SIZE}")
                try:
                    while cursor.next():
                        ids.append(int(cursor.intValue(0)))
                finally:
                    cursor.dispose()
                batch = [storage.getMessageLegit(self.dialog_id, mid) for mid in ids]
                batch = [raw for raw in batch if raw is not None]
                result = (batch, ids[-1] if ids else None)
            except Exception:
                result = None
            run_on_ui_thread(lambda: self.receive_secret(ticket, result))

        storage.getStorageQueue().postRunnable(R(read))
        run_on_ui_thread(lambda: self.timeout(ticket), 7000)

    def receive_secret(self, ticket, result):
        p = self.plugin
        if ticket is not self.ticket or not p.active:
            return
        self.ticket = None
        if not self.active_scope():
            self.finish(retain=False)
        elif result is None:
            self.finish(retry=True)
        else:
            batch, self.local_offset = result
            end = self.local_offset is None
            match = self.pages.consume(batch, self.choose, end=end)
            if match is not None or end:
                self.finish(match)
            else:
                run_on_ui_thread(self.next_page, 1)

    def receive(self, ticket, response, error):
        p = self.plugin
        if ticket is not self.ticket or not p.active:
            return
        self.ticket, self.token = None, 0
        if not self.active_scope():
            self.finish(retain=False)
            return
        if error is not None or response is None or not hasattr(response, "messages"):
            self.finish(retry=True)
            return

        self.controller.removeDeletedMessagesFromArray(self.dialog_id, response.messages)
        items = {}
        for index in range(response.messages.size()):
            raw = response.messages.get(index)
            if raw is not None and 0 < raw.id < self.offset and raw.id <= self.top:
                items[int(raw.id)] = raw
        if items:
            self.controller.putUsers(response.users, True)
            self.controller.putChats(response.chats, True)
        ordered = [items[mid] for mid in sorted(items, reverse=True)]
        candidate = self.pages.consume(ordered, self.choose, end=not ordered)
        if candidate is not None or not ordered:
            self.finish(candidate)
        else:
            self.offset = int(ordered[-1].id)
            run_on_ui_thread(self.next_page, 1)

    def choose(self, raw_messages):
        p = self.plugin
        if any(raw.id == self.top or (self.top_group and raw.grouped_id == self.top_group)
               for raw in raw_messages):
            return None
        if any(raw.hide or p.empty_message.isInstance(raw) for raw in raw_messages):
            return None
        messages = []
        for raw in raw_messages:
            raw.dialog_id = self.dialog_id
            messages.append(p.message(self.account, raw, False, False))
        group = None
        if raw_messages[0].grouped_id:
            group = p.make_preview_group(raw_messages[0].grouped_id, messages)
        if p.allowed(messages[0], group, self.key):
            return messages[0], group
        return None

    def timeout(self, ticket):
        if ticket is self.ticket:
            self.cancel()
            self.finish(retry=True)

    def cancel(self):
        self.ticket = None
        if self.token:
            self.connection.cancelRequest(self.token, True)
            self.token = 0

    def finish(self, candidate=None, *, retry=False, retain=True):
        p = self.plugin
        if p.running.get(self.key) is not self:
            return
        del p.running[self.key]
        cells = list(p.matching_cells(self.key)) if retain else []
        if cells or (retain and self.prefetch and self.active_scope()):
            scope = self.key[:2]
            _, _, previous = p.cache.get(scope, (None, None, None))
            if previous is not None and not p.allowed(*previous, scope):
                previous = None
            newest = (candidate if candidate is not None and
                      (previous is None or p.preview_rank(scope, candidate[0]) > p.preview_rank(scope, previous[0]))
                      else previous)
            p.store_preview(scope, self.key, monotonic() + 8 if retry else None, newest)
            if newest is not previous:
                for cell in cells:
                    p.rebuild_cell(cell)
        p.request_preview_drain()


SETTINGS_GROUPS = (
    ("媒体浏览", (
        ("fast_viewer", "快速浏览", "预载相邻媒体，保留完整相册"),
        ("album_thumbnails", "缩略图侧栏", "横竖屏均可收起和调宽"),
