            self.hook_method(method(viewer, "canDoubleTap", 1), after=self.allow_boundary_double_tap),
            self.hook_method(method(seek_visual_type, "draw", 1),
                             before=self.before_seek_visual_draw, after=self.after_seek_visual_draw),
            self.hook_method(method(seek_visual_type, "addTime", 1), after=self.after_native_seek_time),
            self.hook_method(method(viewer, "onLongPress", 0), before=self.start_held_speed),
            self.hook_method(self.touch_method, before=self.before_touch, after=self.after_touch),
            self.hook_method(method(window_type, "dispatchTouchEvent", 1), before=self.route_video_touch),
            self.hook_method(method(viewer, "updateAccessibilityOverlayVisibility", 0),
