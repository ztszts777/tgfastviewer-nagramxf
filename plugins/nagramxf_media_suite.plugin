            self.hook_method(method(viewer, "closePhoto", 2),
                             before=self.before_viewer_close),
            self.hook_method(method(player_type, "onVideoSizeChanged", 1), after=self.after_video_size),
            self.hook_method(method(viewer, "onPhotoClosed", 1),
                             before=self.before_viewer_closed,
                             after=self.after_viewer_closed),
            self.hook_method(method(viewer, "onHideView", 0),
