            self.status_end_listener = self.make_status_end_listener()

        self.hooks = [
            self.hook_method(method(container, "onMeasure", 2), before=self.before_container_measure,
                             after=self.finish_container_measure),
            self.hook_method(method(container, "onLayout", 5), before=self.before_container_layout,
