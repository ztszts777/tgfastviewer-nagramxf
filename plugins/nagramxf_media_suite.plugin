def field(owner, name):
    result = owner.getDeclaredField(name)
    result.setAccessible(True)
    return result


def method(owner, name, arity):
    result, = (m for m in owner.getDeclaredMethods()
               if m.getName() == name and len(m.getParameterTypes()) == arity)
    result.setAccessible(True)
    return result


def gear_snap_point(positions, progress, span, previous, enter, release):
    nearest = min(range(len(positions)), key=lambda i: abs(positions[i] - progress))
    if span is None or abs(positions[nearest] - progress) * span <= enter:
        return nearest
    if previous is not None and abs(positions[previous] - progress) * span <= release:
        return previous
    return None


def selected_thumbnail_size(preset):
    try:
        index = int(preset)
        if 0 <= index < len(THUMBNAIL_WIDTHS):
            return index
    except (TypeError, ValueError):
        pass
    return DEFAULT_THUMBNAIL_SIZE


