            self.hook_method(method(viewer, "showVideoSeekPreviewPosition", 1), before=self.show_return_seek_preview),
            self.hook_method(method(self.chat_activity, "onPause", 0), before=self.remember_paused_chat_viewport),
            self.hook_method(method(self.chat_activity, "onFragmentDestroy", 0), after=self.forget_paused_chat_viewport),
