        self.dialog_object = jclass("org.telegram.messenger.DialogObject")
        self.messages = jclass("org.telegram.messenger.MessagesController")
        self.source_builder = jclass("org.telegram.messenger.pip.PipSource$Builder")
        self.pip_action = jclass("org.telegram.messenger.pip.utils.PipActions")
        self.pip_utils = jclass("org.telegram.messenger.pip.utils.PipUtils")
        self.pip_params = jclass("android.app.PictureInPictureParams$Builder")
        self.remote_actions = field(source_type, "remoteActions")
        self.array_list = jclass("java.util.ArrayList")
        self.pip_action_stack = []
