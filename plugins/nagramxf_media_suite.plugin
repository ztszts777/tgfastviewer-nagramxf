            self.hook_method(method(cell_type, "drawSideButton", 2), after=self.draw_share_bookmark),
            self.hook_method(method(cell_type, "onTouchEvent", 1), before=self.touch_chat_bookmark),
            self.hook_method(method(collection_type, "updateVisibleMessageCells", 0), after=self.focus_bookmark_collection),
            self.hook_method(self.bookmark_chat_action, before=self.before_bookmark_chat_action),
            self.hook_method(method(self.bookmarks.getClass(), "toggleBookmarks", 3), after=self.after_bookmark_change),
