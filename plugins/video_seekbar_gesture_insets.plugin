    ]


def auto_video_orientation(width, height):
    if width <= 0 or height <= 0:
        return None
    if width > height:
        return SENSOR_LANDSCAPE
    return SENSOR_PORTRAIT if height > width else None


def media_grid_anchor(result, message_id):
    if result is None or result.messages.isEmpty():
        return None
    messages = result.messages
    if not any(messages.get(i).id == message_id for i in range(messages.size())):
        return None
    if result.flags & 4:
        start = result.offset_id_offset
    elif result.count <= messages.size():
        start = 0
    else:
        return None
    return messages.get(0).id + 1, start, max(result.count, start + messages.size())


def media_grid_index(messages, dialog, message_id):
    for index in range(messages.size()):
        message = messages.get(index)
        if message.getId() == message_id and message.getDialogId() == dialog:
            return index
    return -1


def media_grid_scroll_target(position, count, columns, viewport, tile, obscured_top=0, obscured_bottom=0):
    if not 0 <= position < count or viewport <= 0:
        return None
    row = position // columns
    last_row = (count - 1) // columns
    center = max(0, (viewport + obscured_top - obscured_bottom - tile) // 2)
    scroll = row * tile - center
    max_scroll = max(0, (last_row + 1) * tile - viewport)
    if not max_scroll or scroll <= 0:
        return 0, 0
    if scroll >= max_scroll:
        return last_row * columns, viewport - tile
    return position, center


def surface_rotation_from_angle(degrees):
    if not 0 <= degrees < 360 or abs(degrees % 90 - 45) < 15:
        return None
    # Display graphics compensate for the physical rotation, so the angles run in opposite directions.
    return (-((degrees + 45) // 90)) % 4


def surface_rotation_from_gravity(x, y, z):
    if 4 * (x * x + y * y) < z * z:
        return None
    if x * x > 3 * y * y:
        return 1 if x > 0 else 3
    if y * y > 3 * x * x:
        return 0 if y > 0 else 2
    return None


def device_orientation_request(rotation, natural_landscape, reverse_default):
    if rotation is None:
        return None
    if natural_landscape:
        if rotation % 2:
            return SENSOR_PORTRAIT
        return LANDSCAPE if rotation == 0 else REVERSE_LANDSCAPE
    if rotation % 2 == 0:
        return SENSOR_PORTRAIT
    return LANDSCAPE if (rotation == 1) != reverse_default else REVERSE_LANDSCAPE


class ControlMargin:
    def __init__(self, reference, margin):
        self.reference = reference
        self.base = margin
        self.lift = 0

    def update(self, params, lift, fresh_base=False):
        if fresh_base or params.bottomMargin != self.base + self.lift:
            self.base = params.bottomMargin
        target = self.base + lift
        if params.bottomMargin != target:
            params.bottomMargin = target
        self.lift = lift


def shadow_ramp(start, end, opacity):
    colors = []
    for step in range(9):
        edge_fraction = start + (end - start) * step / 8
        smooth = edge_fraction ** 2 * (3 - 2 * edge_fraction)
        alpha = round(opacity * (1 - (1 - smooth) ** 2))
        color = (alpha << 24) | SHADOW_GRAY
        colors.append(color - ((color >> 31) << 32))
    return tuple(colors)


def caption_last_text_line(layout, line):
    content = layout.getText()
    utf16 = content.encode("utf-16-le", "surrogatepass") if isinstance(content, str) else None
    while line >= 0:
        start, end = layout.getLineStart(line), layout.getLineVisibleEnd(line)
        if end > start:
            part = (utf16[2 * start:2 * end].decode("utf-16-le", "surrogatepass") if utf16 is not None
                    else str(content.subSequence(start, end)))
            if part.strip():
                return line
        line -= 1
    return line


def caption_viewport(layout, total, available, padding_top, padding_bottom, expanded, arrow_height=0):
    lines = layout.getLineCount() if layout is not None else 0
    last = caption_last_text_line(layout, lines - 1) if lines else -1
    if last < 0:
        return 0, False
    end = padding_top + layout.getLineBottom(last)
    has_more = last >= 4 or end > available
    available = max(0, available - (arrow_height if has_more and available > arrow_height else 0))
    full_height = total if last == lines - 1 else end + padding_bottom
    if expanded or not has_more:
        return min(full_height, available), has_more
    last_visible = min(3, last)
    while last_visible >= 0 and padding_top + layout.getLineBottom(last_visible) > available:
        last_visible -= 1
    last_visible = caption_last_text_line(layout, last_visible)
    return (padding_top + layout.getLineBottom(last_visible) if last_visible >= 0 else 0), has_more


def caption_complete_line_height(layout, padding_top, viewport, scroll_y):
    bottom = scroll_y + viewport
    index = layout.getLineForVertical(max(0, bottom - padding_top - 1))
    while index >= 0:
        line_bottom = padding_top + layout.getLineBottom(index)
        if line_bottom <= bottom:
            return max(0, line_bottom - scroll_y)
        index -= 1
    return 0


def smoothstep(value):
    value = max(0.0, min(1.0, value))
    return value * value * (3 - 2 * value)


def player_shadow_edge_alpha(distance):
    return smoothstep(1 - distance) ** 1.3


def player_shadow_texture(samples):
    ramp = []
    for i in range(samples):
        distance = ((i + 0.5) / samples) ** 2.4
        alpha = round(PLAYER_SHADOW_ALPHA * player_shadow_edge_alpha(distance))
        ramp.append(((alpha << 24) | SHADOW_GRAY) - ((alpha >> 7) << 32))
    return ramp + [0] * samples + ramp[::-1]


def player_shadow_mesh(width, height, top, bottom):
    total = top + bottom
    if total > height:
        top = height * (top / total)
        bottom = height - top
    columns = 0.0, float(width)
    rows = 0.0, top, height - bottom, float(height)
    return tuple(point for y in rows for x in columns for point in (x, y))


class TopMediaCaption:
    def __init__(self, viewer_ref, scroll, subtitle, switcher, shade, title_sizes, subtitle_size):
        self.viewer_ref = viewer_ref
        self.scroll, self.subtitle = scroll, subtitle
        self.switcher, self.shade = switcher, shade
        self.title_sizes, self.subtitle_size = title_sizes, subtitle_size
        self.header_content = subtitle.getParent()
        self.header_padding = self.header_content.getPaddingLeft()
        self.chat_key = self.chat_name = None
        params = scroll.getLayoutParams() if scroll is not None else None
        self.original_frame = ((params.gravity, params.leftMargin, params.topMargin, params.rightMargin)
                               if params is not None else None)
        self.caption_visibility = switcher.getVisibility() if scroll is not None else None
        self.original_vertical_fade = scroll.isVerticalFadingEdgeEnabled() if scroll is not None else False
        self.arrow = None
        self.caption_key = None
        self.expanded = False
        self.has_more = False
        self.touch = None
        self.reset_scroll_on_measure = False
        self.caption_motion = None
        self.caption_frame_pending = False
        self.text_layouts = []


class StatusBarSlide:
    def __init__(self, viewer, container, system, shown):
        self.viewer, self.container, self.system = viewer, container, system
        self.shown = shown
        self.animator = self.signal = self.control = None
        self.progress = None


def landscape_gutter(dp, width):
    return min(dp(28), max(dp(12), width // 20))


def portrait_toolbar_width(dp, width):
    margin = min(dp(20), max(dp(6), width // 12))
    return max(1, min(dp(156), width - 2 * margin))


def landscape_toolbar_gutters(dp, width, left_safe, right_safe, left_consumed, right_consumed):
    gutter = landscape_gutter(dp, width)
    return (max(gutter, left_safe + dp(6) - left_consumed),
            max(gutter, right_safe + dp(6) - right_consumed))


class ThumbnailRail:
    def __init__(self, viewer, strip, container, dimensions):
        self.viewer, self.strip, self.container = viewer, strip, container
        self.native_visibility = strip.getVisibility() if strip is not None else None
        self.tile_width, self.tile_height = dimensions
        self.right_reservation = 0
        self.reserved_views = []
        self.dirty = True
        self.source = None
        self.entries, self.offsets = [], []
        self.extent = 0
        self.landscape = False
        self.bottom_docked = False
        self.span = 0
        self.safe_top = 0
        self.safe_bottom = 0
        self.status_height = 0
        self.left = self.top = self.height = self.position = 0
        self.center = 0
        self.alpha = 0.0
        self.ui_shift = 0
        self.scroller = self.touch = None
        self.scroll_direction = 0
        self.priority_window = range(0)
        self.loaded_window = None
        self.flinging = False
        self.collapsed = False
        self.collapse_key = None
        self.slide = 0.0
        self.drag_width = self.drag_height = None
        self.slide_motion = self.handle_touch = self.handle = self.handle_icon = None
        self.warm_pending = None
        self.parked_cells = False
        self.cells = {}
        self.selected = None
        self.follow_selection = True
        self.pending_offset = None
        self.pending_selection = None
        self.provisional = False
        self.center_pending = False
        self.refresh_pending = None
        self.ready = False
        self.reveal_check = None
        self.opened_at = monotonic()

    @property
    def viewport(self):
        return self.span if self.bottom_docked else self.height

    @property
    def tile_length(self):
        return self.tile_width if self.bottom_docked else self.tile_height

    def set_right_reservation(self, views, width):
        for view, original in tuple(self.reserved_views):
            if view not in views:
                view.getLayoutParams().rightMargin = original
                self.reserved_views.remove((view, original))
        for view in views:
            if all(existing != view for existing, _ in self.reserved_views):
                self.reserved_views.append((view, view.getLayoutParams().rightMargin))
        for view, original in self.reserved_views:
            view.getLayoutParams().rightMargin = original + width
        self.right_reservation = width


class ThumbnailSeed:
    def __init__(self, viewer, anchor, items, receivers):
        self.viewer, self.anchor = viewer, anchor
        self.items, self.receivers = items, receivers

    def release_unused(self):
        for receiver in self.receivers.values():
            receiver.onDetachedFromWindow()
        self.receivers.clear()


class LibraryVideoPreview:
    def __init__(self, fragment, listing, dialog, message_id, position, source):
        self.fragment, self.listing = fragment, listing
        self.dialog, self.message_id, self.position = dialog, message_id, position
        self.source = source
        self.frame = self.aspect = self.player = self.cell = self.host = None
        self.geometry = None
        self.corner_radii = self.outline_mask = None
        self.first_frame = False
        self.scrolling = False
        self.deadline = monotonic() + 2


class LibraryReturn:
    def __init__(self, viewer, activity, fragment, origin, chat, provider, viewer_parent,
                 message, queue, dialogs, orientation, playback, chat_layout_state):
        self.viewer, self.activity, self.fragment, self.origin = viewer, activity, fragment, origin
        self.chat, self.provider, self.viewer_parent = chat, provider, viewer_parent
        self.message, self.queue, self.dialogs = message, queue, dialogs
        self.orientation, self.playback, self.chat_layout_state = orientation, playback, chat_layout_state
