class MediaCapsule:
    def initialize_capsule_ui(self):
        self.sdk = int(jclass("android.os.Build$VERSION").SDK_INT)
        self.dp = jclass("org.telegram.messenger.AndroidUtilities").dp
        self.linear_layout = jclass("android.widget.LinearLayout")
        self.linear_params = jclass("android.widget.LinearLayout$LayoutParams")
        self.frame_layout = jclass("android.widget.FrameLayout")
        self.frame_params = jclass("android.widget.FrameLayout$LayoutParams")
        self.text_view = jclass("android.widget.TextView")
        self.view_type = jclass("android.view.View")
        self.pill_background = jclass("android.graphics.drawable.GradientDrawable")
        self.gear_seek = jclass("android.widget.SeekBar")
        self.haptic = jclass("android.view.HapticFeedbackConstants")
        self.gear_seek_listener = self.make_gear_seek_listener()
        self.gear_layout_listener = self.make_gear_layout_listener()
        self.gear_touch_listener = self.make_gear_touch_listener()

    def gear_label_width(self, positions, widths, edge):
        span = 0
        for i, (a, b) in enumerate(zip(positions, positions[1:])):
            left, right = widths[i] / 2, widths[i + 1] / 2
            left_shift = max(0, left + self.dp(4) - edge) if a == 0.0 else 0
            right_shift = max(0, right + self.dp(4) - edge) if b == 1.0 else 0
            span = max(span, (left + right + left_shift + right_shift + self.dp(5)) / (b - a))
        return max(self.dp(240), int(2 * edge + span + 0.999), max(widths) + self.dp(8))

    def make_gear_capsule(self, context, title, positions, labels, initial, format_value, apply, *,
                          tick=None, quantize=None, divider=False, value_labels=None, palette=None, steps=None):
        foreground, label_color, accent, track_color, thumb_color = palette or (
            WHITE, SLIDER_LABEL, SLIDER_ACTIVE, 0x42FFFFFF, WHITE)
        row = self.linear_layout(context)
        row.setOrientation(1)
        row.setPadding(0, self.dp(8), 0, 0 if divider else self.dp(8))
        header = self.linear_layout(context)
        header.setPadding(self.dp(14), 0, self.dp(14), 0)
        for text, gravity in ((title, 3), ("", 5)):
            value = self.text_view(context)
            value.setText(text)
            value.setSingleLine(True)
            value.setTextSize(14)
            value.setTextColor(jint(foreground))
            value.setGravity(gravity)
            header.addView(value, self.linear_params(0, -2, 1.0))
        row.addView(header, self.linear_params(-1, -2))
        if divider:
            line = self.view_type(context)
            line.setBackgroundColor(MENU_DIVIDER_COLOR)
            line.setImportantForAccessibility(2)
            params = self.linear_params(-1, self.dp(8))
            params.topMargin = self.dp(8)
            row.addView(line, params)
        if apply is None:
            value.setText(labels[0])
            return row

        body = self.frame_layout(context)
        body.setLayoutDirection(0)
        row.addView(body, 1, self.linear_params(-1, self.dp(58)))
        edge = self.dp(22)
        track_height, thumb_size = self.dp(18), self.dp(12)
        cap = track_height // 2
        track = self.view_type(context)
        fill = self.view_type(context)
        thumb = self.view_type(context)
        for part, color in ((track, track_color), (fill, accent)):
            part.setBackground(self.round_background(color, 9))
            part.setImportantForAccessibility(2)
            params = self.frame_params(-1, track_height, 51)
            params.leftMargin = params.rightMargin = edge - cap
            params.topMargin = (self.dp(32) - track_height) // 2
            body.addView(part, params)
        thumb.setBackground(self.round_background(thumb_color, 6))
        thumb.setImportantForAccessibility(2)
        dot_size = self.dp(4)
        nodes = []
        for point, label in zip(positions, labels):
            dot = None
            if 0 < point < 1:
                dot = self.view_type(context)
                dot.setImportantForAccessibility(2)
                background = self.pill_background()
                background.setColor(jint(foreground))
                background.setCornerRadius(dot_size / 2.0)
                dot.setBackground(background)
                params = self.frame_params(dot_size, dot_size, 51)
                params.topMargin = (self.dp(32) - dot_size) // 2
                body.addView(dot, params)
            cell = self.text_view(context)
            cell.setText(label)
            cell.setTextSize(12)
            cell.setGravity(17)
            cell.setSingleLine(True)
            width = int(cell.getPaint().measureText(label) + self.dp(4) + 0.999)
            params = self.frame_params(width, self.dp(28), 51)
            params.topMargin = self.dp(30)
            body.addView(cell, params)
            nodes.append((dot, cell, width))
        width = self.gear_label_width(positions, [width for _, _, width in nodes], edge)
        row.setMinimumWidth(width)
        thumb_params = self.frame_params(thumb_size, thumb_size, 51)
        thumb_params.topMargin = (self.dp(32) - thumb_size) // 2
        body.addView(thumb, thumb_params)

        # Reuse Android's accessible SeekBar for touch and keyboard input. The pill artwork
        # shares a coordinate system with its labels, so it always matches the popup's measured width.
        seek = self.gear_seek(context)
        seek.setBackground(None)
        seek.setProgressDrawable(None)
        seek.setThumb(None)
        seek.setPadding(edge, 0, edge, 0)
        maximum = steps if steps is not None else GEAR_SLIDER_TICKS
        seek.setMax(maximum)
        body.addView(seek, self.frame_params(-1, self.dp(32), 51))
        selected = next((i for i, point in enumerate(positions) if abs(initial - point) < 0.0001), None)
        locked = None
        last_tick = tick(initial) if tick is not None else None
        progress = initial
        width_px = 0

        def draw_progress():
            span = max(0, width_px - 2 * edge)
            filled = round(progress * span)
            pill_width = filled + 2 * cap
            fill.getLayoutParams().width = pill_width
            fill.setRight(edge - cap + pill_width)
            thumb.setTranslationX(jfloat(edge + filled - thumb_size / 2))

        def layout(width):
            nonlocal width_px
            width_px = width
            xs = [edge + position * max(0, width - 2 * edge) for position in positions]
            for i, (x, (dot, cell, label_width)) in enumerate(zip(xs, nodes)):
                if dot is not None:
                    dot.setTranslationX(jfloat(x - dot_size / 2))
                left = (xs[i - 1] + x) / 2 if i else self.dp(5)
                right = (x + xs[i + 1]) / 2 if i + 1 < len(xs) else width - self.dp(5)
                scale = min(1.0, max(1, right - left - self.dp(2)) / label_width)
                half = label_width * scale / 2
                center = min(right - half, max(left + half, x))
                cell.setPivotX(jfloat(label_width / 2))
                cell.setScaleX(jfloat(scale))
                cell.setTranslationX(jfloat(center - label_width / 2))
            draw_progress()

        body.addOnLayoutChangeListener(self.gear_layout_listener(layout))

        def display(progress, point):
            text = format_value(progress) if format_value is not None else (value_labels or labels)[point]
            value.setText(text)
            seek.setContentDescription(f"{title} {text}")
            for i, (dot, cell, _) in enumerate(nodes):
                active = i == point
                if dot is not None:
                    dot.setAlpha(0.0 if active else 0.62)
                cell.setTextColor(jint(accent if active else label_color))
                cell.setSelected(active)
            draw_progress()

        def update(final, raw, point=None):
            nonlocal selected, locked, last_tick, progress
            raw = min(1.0, max(0.0, raw))
            if steps is not None:
                progress = round(raw * steps) / steps
                if point is not None:
                    seek.setProgress(round(progress * steps))
                selected = next((i for i, node in enumerate(positions) if abs(node - progress) < 0.0001), None)
                display(progress, selected)
                apply(final, progress, selected)
                return
            span = max(1, width_px - 2 * edge) if tick is not None else None
            if point is None:
                point = gear_snap_point(positions, raw, span, locked, self.dp(12 if final else 9), self.dp(15))
            progress = (quantize(raw) if quantize is not None else raw) if point is None else positions[point]
            if point is not None:
                seek.setProgress(round(progress * GEAR_SLIDER_TICKS))
                if selected != point:
                    seek.performHapticFeedback(self.slider_tick(major=True))
            if tick is not None:
                step = tick(progress)
                if point is None and step != last_tick:
                    seek.performHapticFeedback(self.slider_tick())
                last_tick = step
            selected = point
            locked = None if final else point
            display(progress, point)
            apply(final, progress, point)

        seek.setProgress(round(initial * maximum))
        display(initial, selected)
        listener = self.gear_seek_listener(update) if steps is None else self.gear_seek_listener(update, maximum)
        seek.setOnSeekBarChangeListener(listener)
        seek.setOnTouchListener(self.gear_touch_listener())
        for i, (_, cell, _) in enumerate(nodes):
            cell.setOnClickListener(OnClickListener(lambda _, point=i: update(True, positions[point], point)))
        return row

    def slider_tick(self, major=False):
        if self.sdk >= 34:
            return self.haptic.SEGMENT_TICK if major else self.haptic.SEGMENT_FREQUENT_TICK
        return self.haptic.CONTEXT_CLICK if major else self.haptic.CLOCK_TICK

    def make_gear_seek_listener(self):
        listener_type = jclass("android.widget.SeekBar$OnSeekBarChangeListener")

        class Listener(dynamic_proxy(listener_type)):
            def __init__(self, update, maximum=GEAR_SLIDER_TICKS):
                super().__init__()
                self.update = update
                self.maximum = maximum
                self.tracking = False
                self.raw = 0

            def onProgressChanged(self, seek, progress, from_user):
                if from_user:
                    self.raw = progress
                    self.update(not self.tracking, progress / self.maximum)

            def onStartTrackingTouch(self, seek):
                self.tracking = True
                self.raw = seek.getProgress()

            def onStopTrackingTouch(self, seek):
                self.tracking = False
                self.update(True, self.raw / self.maximum)

        return Listener

    def make_gear_layout_listener(self):
        listener_type = jclass("android.view.View$OnLayoutChangeListener")

        class Listener(dynamic_proxy(listener_type)):
            def __init__(self, layout):
                super().__init__()
                self.layout = layout

            def onLayoutChange(self, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
                self.layout(right - left)

        return Listener

    def make_gear_touch_listener(self):
        listener_type = jclass("android.view.View$OnTouchListener")

        class Listener(dynamic_proxy(listener_type)):
            def onTouch(self, view, event):
                if event.getActionMasked() == 0:
                    view.getParent().requestDisallowInterceptTouchEvent(True)
                return False

        return Listener

    def round_background(self, color, radius):
        background = self.pill_background()
        background.setColor(color)
        background.setCornerRadius(float(self.dp(radius)))
        return background


class VideoSeekbarGestureInsets(MediaCapsule, BasePlugin):
    def create_settings(self):
        def change_size(value):
            self.set_setting("thumbnail_size", selected_thumbnail_size(value))
            run_on_ui_thread(lambda: self.thumbnail_size_changed(value))

        def change_thumbnail_state(key, value):
            self.set_setting(key, value)
            run_on_ui_thread(self.configure_thumbnail_state)

        def change_tick(key, value):
            self.set_setting(key, value)
            rate = value if key == "adjustment_tick_rate" else self.get_setting("adjustment_tick_rate", "12")
            percent = value if key == "adjustment_tick_percent" else self.get_setting("adjustment_tick_percent", "1")
            strength = value if key == "adjustment_tick_strength" else self.get_setting("adjustment_tick_strength", "42")
            run_on_ui_thread(lambda: self.configure_adjustment_ticks(rate, percent, strength))

        return [thumbnail_size_setting(change_size), thumbnail_default_state_setting(
                    lambda value: change_thumbnail_state("thumbnail_default_state", value)),
                thumbnail_state_scope_setting(lambda value: change_thumbnail_state("thumbnail_state_scope", value)),
                *adjustment_tick_settings(change_tick)]

