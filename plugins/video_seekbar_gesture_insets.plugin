                    items=["右侧", "屏幕底部"], on_change=on_change)


def thumbnail_dimensions(dp, width_dp, landscape, available_width):
    width = dp(width_dp)
    if available_width > 0:
        cap = available_width * (0.32 if landscape else 0.44)
        width = min(width, max(1, int(cap) - 2 * dp(THUMBNAIL_EDGE_PADDING)))
    return width, max(1, round(width * (0.75 if landscape else 1.2)))


def thumbnail_gaps(width):
    return tuple(max(1, round(width * space / THUMBNAIL_REFERENCE_WIDTH))
                 for space in (THUMBNAIL_SPACING, THUMBNAIL_MESSAGE_GAP, THUMBNAIL_CHAT_GAP))


def thumbnail_entries(messages, tile, message_gap, chat_gap, padding, scope=None):
    entries, peer, block, offset = [], None, None, padding
    for message in messages:
        if message is None or not (message.isPhoto() or message.isVideo()):
            continue
        key = message.currentAccount, message.getDialogId()
        if scope is not None and (key[0] != scope[0] or key[1] not in scope[1]):
            continue
        group = message.getGroupId()
        current_block = (True, group) if group else (False, message.getId())
        if peer is not None:
            if peer != key:
                entries.append((offset, THUMBNAIL_CHAT_DIVIDER))
                offset += chat_gap
            elif block != current_block:
                entries.append((offset, THUMBNAIL_MESSAGE_DIVIDER))
                offset += message_gap
        entries.append((offset, message))
        offset += tile
        peer, block = key, current_block
    return entries, offset + padding


def album_caption_source(message, messages, is_empty, allowed=None):
    group = message.getGroupId()
    if not group or messages is None:
        return None
    account, dialog = message.currentAccount, message.getDialogId()
    source = None
    for index in range(messages.size()):
        item = messages.get(index)
        if (item is not None and item.currentAccount == account and item.getDialogId() == dialog
                and item.getGroupId() == group and not is_empty(item.caption)
                and (allowed is None or allowed(item))
                and (source is None or item.getId() < source.getId())):
            source = item
    return source


def thumbnail_divider(item):
    return item is THUMBNAIL_MESSAGE_DIVIDER or item is THUMBNAIL_CHAT_DIVIDER


def same_thumbnail_item(left, right):
    if left is right:
        return True
    if left is None or right is None or thumbnail_divider(left) or thumbnail_divider(right):
        return False
    # Chaquopy forwards equality to MessageObject.equals, which rejects Python sentinels.
    return left == right


def thumbnail_item_key(item):
    return item.currentAccount, item.getDialogId(), item.getId()


def thumbnail_range(offsets, position, viewport, padding):
    start = max(0, bisect_right(offsets, position - padding) - 1)
    return range(start, bisect_left(offsets, position + viewport + padding))


def needed_lift(bottom, side, native_clearance, padding, fallback):
    if not bottom:
        if side:
            return 0
        bottom = fallback
    return max(padding, bottom + padding - native_clearance)


def row_spacing(row_height, scrubber_lift, tap_inset, gap=0, text_bottom=0):
    gap = max(gap, (scrubber_lift - row_height - tap_inset + text_bottom + 1) // 2)
    return row_height + tap_inset + 2 * gap - text_bottom, tap_inset + gap


def symmetric_rail_bounds(height, top, bottom):
    inset = min(height // 2, max(0, top, height - bottom))
    return inset, height - 2 * inset


def double_tap_action(x, width):
    third = width // 3
    if third <= 0 or third <= x < 2 * third:
        return "play"
    return "back" if x < third else "forward"


def seek_edge_geometry(width, height, dp, left_side):
    depth = min(dp(112), width * 0.20, height * 0.32)
    # Keep the oval wide enough at the top and bottom to reach both edges.
    radius_x, radius_y = 2 * depth, height * 0.65
    x = -depth if left_side else width + depth
    y = height / 2
    label_x = depth / 2 if left_side else width - depth / 2
    return (x - radius_x, y - radius_y, x + radius_x, y + radius_y), label_x, y, depth


def selected_hold_speed(preset, custom):
    try:
        index = int(preset)
        if 0 <= index < len(HOLD_SPEED_PRESETS):
            return HOLD_SPEED_PRESETS[index]
        if index == len(HOLD_SPEED_PRESETS):
            speed = float(str(custom).strip().replace(",", "."))
            if 1.0 <= speed <= 3.402823466e38:
                return speed
    except (ValueError, TypeError, OverflowError):
        pass
    return DEFAULT_HOLD_SPEED


def popup_offsets(left, top, right, anchor_x, anchor_y, anchor_width, anchor_height,
                  content_width, content_height, gap, edge):
    max_left = max(left + edge, right - edge - content_width)
    desired_left = anchor_x + (anchor_width - content_width) // 2
    popup_left = min(max_left, max(left + edge, desired_left))
    popup_height = min(content_height, max(1, anchor_y - gap - top - edge))
    y_offset = -anchor_height - gap - popup_height
    return popup_left - anchor_x, y_offset, popup_height


def side_popup_offsets(left, top, right, bottom, anchor_x, anchor_y, anchor_height,
                       content_width, content_height, gap, edge, vertical_edge, lift):
    left, top, right, bottom = left + edge, top + vertical_edge, right - edge, bottom - vertical_edge
    anchor_bottom = anchor_y + anchor_height
    height_limit = bottom - top
    if right <= left or height_limit <= 0:
        return None
    width, height = min(content_width, right - left), min(content_height, height_limit)
    popup_left = max(left, min(right - width, anchor_x - gap - width))
    popup_top = max(top, min(bottom - height, anchor_y + (anchor_height - height) // 2) - lift)
    return popup_left - anchor_x, popup_top - anchor_bottom, width, height


def fullscreen_swipe(dx, dy, fullscreen, threshold):
    return vertical_swipe(dx, dy, threshold) and (dy > 0) != fullscreen


def vertical_swipe(dx, dy, threshold):
    return abs(dy) >= threshold and abs(dx) * 1.6 <= abs(dy)


def swipe_level(initial, dy, height, minimum):
    return max(minimum, min(1.0, initial - dy / max(1, height * 0.55)))


def adjustment_tick_value(value, default, minimum, maximum):
    try:
        number = int(str(value).strip())
    except (TypeError, ValueError):
        return default
    return number if minimum <= number <= maximum else default


