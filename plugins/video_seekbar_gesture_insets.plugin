            self.hook_method(method(control_type, "onProgressChanged", 1),
                             after=self.after_controls_progress),
        ]

        def install_existing():
            if self.active:
                for name in ("Instance", "Instance2"):
                    current = field(viewer, name).get(None)
                    if current is not None:
                        self.install_row(current)
                        self.hook_orientation_listener(current)
                        self.check_auto_fullscreen(current)

        run_on_ui_thread(install_existing)

    def option(self, key):
        return getattr(self, "flags", {}).get(key, key != "auto_fullscreen_on_switch")

    def navigation_area(self, view):
        insets = view.getRootWindowInsets()
        if insets is None:
            return 0, 0, 0
        if self.sdk >= 30:
            nav = insets.getInsetsIgnoringVisibility(self.nav_type)
            return (max(nav.bottom, insets.getInsets(self.gesture_types).bottom),
                    max(nav.left, nav.right), insets.getInsets(self.nav_type).bottom)
        bottom = insets.getStableInsetBottom()
        if self.sdk == 29:
            bottom = max(bottom, insets.getSystemGestureInsets().bottom,
                         insets.getMandatorySystemGestureInsets().bottom)
        return (bottom, max(insets.getStableInsetLeft(), insets.getStableInsetRight()),
                min(bottom, insets.getSystemWindowInsetBottom()))

    def footer_lift(self, viewer, window, container):
        bottom, side, visible_nav = self.navigation_area(window)
        if not bottom:
            activity = viewer.getParentActivity()
            if activity is not None:
                decor = activity.getWindow().peekDecorView()
                if decor is not None:
                    decor_bottom, decor_side, decor_nav = self.navigation_area(decor)
                    bottom, side = decor_bottom, max(side, decor_side)
                    visible_nav = max(visible_nav, decor_nav)
        native_clearance = max(0, window.getMeasuredHeight() - container.getMeasuredHeight())
        native_clearance += container.getPaddingBottom()
        return (needed_lift(bottom, side, native_clearance, self.padding, self.fallback),
                max(0, visible_nav - native_clearance))

    def scrubber_margins(self, viewer, control, compact=False):
        insets = control.getRootWindowInsets()
        if insets is None:
            activity = viewer.getParentActivity()
            decor = activity.getWindow().peekDecorView() if activity is not None else None
            insets = decor.getRootWindowInsets() if decor is not None else None
        left = right = 0
        if insets is not None:
            left, right = insets.getStableInsetLeft(), insets.getStableInsetRight()
            if self.sdk >= 30:
                gestures = insets.getInsets(self.gesture_types)
                left, right = max(left, gestures.left), max(right, gestures.right)
            elif self.sdk == 29:
                gestures = insets.getSystemGestureInsets()
                left, right = max(left, gestures.left), max(right, gestures.right)
        if compact:
            container = control.getParent()
            window = self.window.get(viewer)
            left_consumed = container.getPaddingLeft() if container is not None else 0
            right_consumed = container.getPaddingRight() if container is not None else 0
            if window is not None:
                left_consumed += window.getPaddingLeft()
                right_consumed += window.getPaddingRight()
            return centered_toolbar_gutters(left, right, left_consumed, right_consumed,
                                           self.dp(28), self.dp(6))
        return max(self.dp(14), left + self.padding), max(self.dp(14), right + self.padding)

    def lookup_row(self, background):
        self.rows = [(b, r) for b, r in self.rows if b.get() is not None and r.get() is not None]
        return next((r.get() for b, r in self.rows if b.get() == background), None)

    def install_row(self, viewer):
        if not self.active:
            return
        background = self.background.get(viewer)
        if background is None or self.lookup_row(background) is not None:
            return
        row = self.linear_layout(background.getContext())
        row.setOrientation(1)
        row.setPadding(self.dp(16), 0, self.dp(16), 0)
        row.setVisibility(8)
        viewer_ref = self.weak_reference(viewer)
        play = (
            ("上一条", self.drawable.baseline_skip_previous_24_white, "previous"),
            ("播放", self.drawable.baseline_play_arrow_36_white, "play"),
            ("下一条", self.drawable.baseline_skip_next_24_white, "next"),
        )
        tools = (
            ("定时停止", self.drawable.msg_timer, "timer"),
            ("视频设置", self.drawable.video_settings, "settings"),
            ("更多", self.drawable.ic_ab_other, "overflow"),
        )
        for index, (buttons, height) in enumerate(((play, self.play_height), (tools, self.tools_height))):
            line = self.linear_layout(row.getContext())
            horizontal = self.dp(24)
            line.setPadding(horizontal, 0, horizontal, 0)
            params = self.linear_params(-1, height)
            if not index:
                params.bottomMargin = self.row_gap
            for label, icon, action in buttons:
                button = self.make_video_control(row.getContext(), label, icon, action, viewer_ref)
                line.addView(button, self.linear_params(0, -1, 1.0))
            row.addView(line, params)
        background.addView(row, self.frame_params(-1, self.row_height, 80))
        self.rows.append((self.weak_reference(background), self.weak_reference(row)))
        self.install_footer_shade(background)
        self.install_fullscreen_button(viewer, viewer_ref, (play[1], play[0], play[2], *tools))

    def make_video_control(self, context, label, icon, action, viewer_ref, compact=False):
        if action == "timer":
            button = self.frame_layout(context)
            button.setTag(VIDEO_TIMER_CONTROL_TAG + (".compact" if compact else ""))
            button.setContentDescription(label)
            button.setBackground(self.theme.createSelectorDrawable(0x24FFFFFF, 1, self.ripple_radius))
            image = self.image_view(context)
            image.setImageResource(icon)
            image.setColorFilter(WHITE)
            button.addView(image, self.frame_params(-1, -1, 17))
        else:
            button = image = self.make_button(context, label, icon)
        self.shrink_icon(image, (VIDEO_TOOL_SIZE - VIDEO_ICON_SIZE) // 2)
        button.setOnClickListener(OnClickListener(
            lambda view: self.on_button(viewer_ref, action, view)))
        return button

    def shrink_icon(self, view, padding):
        pad = self.dp(padding)
        view.setPadding(pad, pad, pad, pad)
        view.setScaleType(self.fit_center)

    def make_button(self, context, label, icon):
        if isinstance(icon, str):
            button = self.text_view(context)
            button.setText(icon)
            button.setTextColor(WHITE)
            button.setTextSize(16)
            button.setGravity(17)
        else:
            button = self.image_view(context)
            button.setImageResource(icon)
            button.setColorFilter(WHITE)
            button.setScaleType(self.center)
        button.setContentDescription(label)
        if self.sdk >= 26:
            button.setTooltipText(label)
        button.setBackground(self.theme.createSelectorDrawable(0x24FFFFFF, 1, self.ripple_radius))
        return button

    def timer_action(self, viewer):
        menu = self.video_menu.get(viewer)
        popup = menu.getPopupLayout() if menu is not None else None
        return popup.findViewWithTag(self.integer(TIMER_MENU_ID)) if popup is not None else None

    def refresh_row(self, viewer):
        row = self.lookup_row(self.background.get(viewer))
        if row is None:
            return
        playback, tools = row.getChildAt(0), row.getChildAt(1)
        playing = bool(self.call(viewer, "isVideoPlaying"))
        can_time = self.timer_action(viewer) is not None
        self.refresh_play_buttons(playback.getChildAt(1), tools.getChildAt(0), playing, can_time)
        compact = self.compact_control(viewer)
        if compact is not None:
            self.refresh_play_buttons(compact.getChildAt(0), compact.getChildAt(3), playing, can_time)
        self.refresh_neighbors(viewer)
        self.refresh_zoom(viewer)
        self.refresh_fullscreen_button(viewer)

    def refresh_play_buttons(self, play, timer, playing, can_time):
        play.setImageResource(
            self.drawable.baseline_pause_36_white if playing else self.drawable.baseline_play_arrow_36_white)
        play.setContentDescription("暂停" if playing else "播放")
        self.enabled(timer, can_time)

    def refresh_neighbors(self, viewer):
        row = self.lookup_row(self.background.get(viewer))
        if row is None:
            return
        playback, compact = row.getChildAt(0), self.compact_control(viewer)
        for action, index, compact_index in (("previous", 0, 1), ("next", 2, 2)):
            available = self.has_neighbor(viewer, action)
            alpha = 1.0 if available else 0.4
            button = playback.getChildAt(index)
            button.setAlpha(alpha)
            if compact is not None:
                compact.getChildAt(compact_index).setAlpha(alpha)

    def after_neighbor_image(self, param):
        viewer, receiver = param.thisObject, param.args[0]
        if receiver == self.left_image.get(viewer) or receiver == self.right_image.get(viewer):
            self.refresh_neighbors(viewer)

    def after_neighbor_bitmap(self, param):
        if not param.getResult():
            return
        receiver = param.thisObject
        container = receiver.getParentView()
        if container is not None and self.drawer_type.isInstance(container):
            viewer = self.outer.get(container)
            if receiver == self.left_image.get(viewer) or receiver == self.right_image.get(viewer):
                self.refresh_neighbors(viewer)
            elif receiver == self.center_image.get(viewer) and self.photo_surface(viewer):
                self.check_auto_fullscreen(viewer)

    def install_fullscreen_button(self, viewer, viewer_ref, compact_items):
        controls = self.controls.get(viewer)
        compact = self.frame_layout(controls.getContext())
        compact.setVisibility(8)
        for label, icon, action in compact_items:
            item = self.make_video_control(controls.getContext(), label, icon, action, viewer_ref, compact=True)
            compact.addView(item, self.frame_params(self.dp(VIDEO_TOOL_SIZE), -1, 83))
        controls.addView(compact, self.frame_params(-1, self.dp(VIDEO_TOOL_SIZE), 80))
        self.compact_controls = [(v, b) for v, b in self.compact_controls if b.get() is not None]
        self.compact_controls.append((viewer_ref, self.weak_reference(compact)))
        button = self.make_video_control(controls.getContext(), "全屏", self.drawable.msg_maxvideo,
                                         "fullscreen", viewer_ref)
        button.setVisibility(8)
        controls.addView(button, self.frame_params(self.dp(VIDEO_TOOL_SIZE), self.dp(VIDEO_TOOL_SIZE), 85))
        self.fullscreen_controls.append((viewer_ref, self.weak_reference(button)))
        seekbar = self.video_seek.get(viewer)
        if seekbar is not None:
            self.seekbars = [(s, v) for s, v in self.seekbars if s.get() is not None]
            self.seekbars.append((self.weak_reference(seekbar), viewer_ref))

    def fullscreen_control(self, viewer):
        return next((b.get() for v, b in self.fullscreen_controls if v.get() == viewer), None)

    def compact_control(self, viewer):
        return next((b.get() for v, b in self.compact_controls if v.get() == viewer), None)

    def refresh_fullscreen_button(self, viewer, progress=None):
        button = self.fullscreen_control(viewer)
        if button is None:
            return
        full = self.is_fullscreen(viewer)
        button.setImageResource(self.drawable.msg_minvideo if full else self.drawable.msg_maxvideo)
        button.setContentDescription("退出全屏" if full else "全屏")
        if progress is not None:
            button.setAlpha(progress)
            compact = self.compact_control(viewer)
            if compact is not None:
                compact.setAlpha(progress)

    def reserve_fullscreen_slot(self, param):
        control = param.thisObject
        viewer = self.control_outer.get(control)
        button = self.fullscreen_control(viewer)
        seek_view = self.video_seek_view.get(viewer)
        if button is not None and seek_view is not None and self.option("video_toolbar") and self.video_surface(viewer):
            self.control_width.setInt(control, max(self.control_width.getInt(control),
                                                   self.control_height.getInt(control) + 1))
            button.setVisibility(0)
            compact = self.compact_control(viewer)
            use_compact = compact is not None and compact.getVisibility() == 0
            left, right = self.scrubber_margins(viewer, control, use_compact)
            seek_params = seek_view.getLayoutParams()
            seek_params.height = self.dp(SCRUBBER_HEIGHT)
            seek_params.leftMargin, seek_params.rightMargin = left, right
            button_params = button.getLayoutParams()
            button_params.height = self.dp(VIDEO_TOOL_SIZE)
            if use_compact:
                width = self.measure_spec.getSize(int(param.args[0]))
                size, right_gutter = self.layout_compact_controls(viewer, compact, width, left, right)
                button_params.width, button_params.rightMargin = size, right_gutter
                gap = self.dp(COMPACT_BOTTOM_GAP)
                button_params.bottomMargin = gap
                compact.getLayoutParams().bottomMargin = gap
            else:
                button_params.width = self.dp(VIDEO_TOOL_SIZE)
                button_params.rightMargin, button_params.bottomMargin = right + self.dp(4), 0
                self.move_time_under_scrubber(viewer, left)
        elif button is not None:
            button.setVisibility(8)
            self.restore_scrubber_view(seek_view)
            self.restore_time(self.video_time.get(viewer))

    def restore_scrubber_view(self, view):
        if view is not None:
            params = view.getLayoutParams()
            params.height, params.leftMargin, params.rightMargin = -1, 0, 0

    def layout_compact_controls(self, viewer, compact, width, left, right):
        time = self.video_time.get(viewer)
        time_width = 0
        if time is not None:
            time.setTextSize(12)
            time_width = int(time.getPaint().measureText(str(time.getText() or "00:00 / 00:00"))) + self.dp(4)
        size = min(self.dp(VIDEO_TOOL_SIZE), max(1, (width - left - right - self.dp(56)) // 7))
        left = max(0, left + self.dp(14) - size // 2)
        right = max(0, right + self.dp(14) - size // 2)
        inset = max(0, min(self.dp(20), (width - left - right - 7 * size - time_width - self.dp(16)) // 2))
        left += inset
        right += inset
        time_width = max(0, min(time_width, width - left - right - 7 * size - self.dp(8)))
        start = left + size + self.dp(2)
        self.move_time_under_scrubber(viewer, left, (start, time_width))
        for index, x in enumerate((left, start + time_width + self.dp(4), start + time_width + self.dp(4) + size)):
            params = compact.getChildAt(index).getLayoutParams()
            params.gravity, params.leftMargin, params.width = 83, x, size
        for index, x in enumerate((right + 3 * size, right + 2 * size, right + size), start=3):
            params = compact.getChildAt(index).getLayoutParams()
            params.gravity, params.rightMargin, params.width = 85, x, size
        return size, right

    def move_time_under_scrubber(self, viewer, left, compact_geometry=None):
        time = self.video_time.get(viewer)
        if time is None:
            return
        params = time.getLayoutParams()
        self.time_layouts = [entry for entry in self.time_layouts if entry[0].get() is not None]
        if not any(ref.get() == time for ref, *_ in self.time_layouts):
            self.time_layouts.append((self.weak_reference(time), params.gravity,
                                      params.leftMargin, params.topMargin, params.rightMargin,
                                      params.bottomMargin, params.width))
            time.setGravity(51)  # SimpleTextView aligns its text separately from the frame.
        params.gravity = 83  # LEFT | BOTTOM
        if compact_geometry is not None:
            params.leftMargin, params.width = compact_geometry
        else:
            time.setTextSize(14)
            params.leftMargin, params.width = left + self.dp(14), -2
        params.topMargin = 0
        params.rightMargin = 0
        params.bottomMargin = self.dp(14 + (COMPACT_BOTTOM_GAP if compact_geometry is not None else 0))

    def restore_time(self, time):
        for index, (ref, gravity, left, top, right, bottom, width) in enumerate(self.time_layouts):
            if ref.get() == time:
                self.time_layouts.pop(index)
                params = time.getLayoutParams()
                params.gravity, params.leftMargin, params.topMargin = gravity, left, top
                params.rightMargin, params.bottomMargin, params.width = right, bottom, width
                time.setGravity(53)  # NagramXF aligns the original time to TOP | RIGHT.
                time.setTextSize(14)
                time.requestLayout()
                return

    def active_seek_view(self, seekbar):
        for seekbar_ref, viewer_ref in self.seekbars:
            if seekbar_ref.get() != seekbar:
                continue
            viewer = viewer_ref.get()
            if viewer is not None:
                button = self.fullscreen_control(viewer)
                if button is not None and button.getVisibility() == 0:
                    return self.video_seek_view.get(viewer)
            break
        return None

    def size_scrubber(self, param):
        view = self.active_seek_view(param.thisObject)
        if view is not None and view.getMeasuredWidth() > 0:
            param.args[0] = self.integer(max(self.dp(25), view.getMeasuredWidth() - self.dp(4)))
            param.args[1] = self.integer(self.dp(SCRUBBER_HEIGHT))

    def offset_scrubber_touch(self, param):
        view = self.active_seek_view(param.thisObject)
        if view is not None:
            local_x = float(param.args[1]) - view.getLayoutParams().leftMargin
            width = view.getMeasuredWidth() - self.dp(4)
            thumb_radius = self.dp(12)
            if int(param.args[0]) == 0 and -self.dp(2) <= local_x <= width + self.dp(2) and width > 2 * thumb_radius:
                local_x = min(width - thumb_radius, max(thumb_radius, local_x))
            param.args[1] = self.float_value(local_x)

    def offset_preview_thumb(self, param):
        view = self.active_seek_view(param.thisObject)
        if view is not None:
            param.setResult(self.integer(int(param.getResult()) + view.getLayoutParams().leftMargin))

    def finish_fullscreen_slot(self, param):
        viewer = self.control_outer.get(param.thisObject)
        button = self.fullscreen_control(viewer)
        if button is not None and button.getVisibility() == 0:
            native = self.exit_fullscreen.get(viewer)
            if native is not None:
                native.setVisibility(4)
            time = self.video_time.get(viewer)
            if time is not None:
                time.getLayoutParams().rightMargin = 0
            self.refresh_fullscreen_button(viewer, float(param.thisObject.getProgress()))

    def hide_floating_fullscreen(self, viewer):
        if self.option("video_toolbar") and self.video_surface(viewer):
            for button in self.fullscreen.get(viewer):
                if button is not None:
                    button.setVisibility(4)

    def enabled(self, button, enabled):
        button.setEnabled(enabled)
        button.setAlpha(1.0 if enabled else 0.4)

    def call(self, viewer, name, *args):
        return self.native[name].invoke(viewer, self.arguments(args))

    def has_neighbor(self, viewer, action):
        receiver = (self.left_image if action == "previous" else self.right_image).get(viewer)
        return receiver is not None and receiver.hasImageSet()

    def open_menu(self, viewer, menu, button):
        if not self.active or menu is None or button is None or not button.isAttachedToWindow():
            return
        if menu == self.overflow.get(viewer):
            self.move_header_share(viewer, True)
        self.hide_header(menu)
        menu.setAnchor(button)
        menu.setShowOnTop(True)
        menu.setSubMenuOpenSide(2)
        menu.setAdditionalYOffset(-self.dp(7))
        try:
            menu.toggleSubMenu()
        except Exception as error:
            self.log(f"Video menu failed: {type(error).__name__}")

    def move_header_share(self, viewer, enabled):
        share, menu = self.header_share.get(viewer), self.overflow.get(viewer)
        if share is None or menu is None:
            return
        self.forward_rows = [entry for entry in self.forward_rows if entry[0].get() is not None]
        entry = next((entry for entry in self.forward_rows if entry[0].get() == share), None)
        row = entry[1].get() if entry is not None and entry[1] is not None else None
        native = self.header_visibility.get(viewer).get(share)
        native_visible = (native if isinstance(native, bool) else native.booleanValue()) if native is not None else None
        desired = (0 if native_visible else 8) if native_visible is not None else (
            entry[2] if entry is not None else share.getVisibility())
        if not enabled:
            if entry is not None:
                if row is not None and row.getParent() is not None:
                    row.getParent().removeView(row)
                share.setVisibility(desired)
                self.forward_rows.remove(entry)
            return
        visible = native_visible and not menu.isSubItemVisible(NATIVE_FORWARD_MENU_ID)
        if row is None and visible:
            row = menu.addSubItem(FORWARD_MENU_ID, self.drawable.msg_header_share,
                                  share.getContentDescription() or "转发")
            row.setColors(WHITE, WHITE)
            external = menu.getPopupLayout().findViewWithTag(self.integer(EXTERNAL_SHARE_MENU_ID))
            parent = row.getParent()
            if external is not None and external.getParent() == parent:
                params = row.getLayoutParams()
                parent.removeView(row)
                parent.addView(row, parent.indexOfChild(external), params)
        if row is not None:
            row.setVisibility(0 if visible else 8)
        if entry is not None:
            self.forward_rows.remove(entry)
        self.forward_rows.append((self.weak_reference(share), self.weak_reference(row) if row is not None else None,
                                  desired, self.weak_reference(viewer)))
        share.setVisibility(8)

    def place_popup(self, param):
        menu = param.thisObject
        if not self.active or not any(ref.get() == menu for ref, *_ in self.gear_state):
            return
        anchor = menu.getAnchor()
        popup = self.popup_window.get(menu)
        if anchor is None or popup is None or not anchor.isAttachedToWindow():
            return
        content = popup.getContentView()
        if content is None or content.getMeasuredWidth() <= 0 or content.getMeasuredHeight() <= 0:
            return
        showing, updating = map(bool, param.args)
        if not showing and (not updating or not popup.isShowing()):
            return
        visible = self.rect()
        anchor.getWindowVisibleDisplayFrame(visible)
        position = self.positions([0, 0])
        anchor.getLocationOnScreen(position)
        x, y, height = popup_offsets(
            visible.left, visible.top, visible.right, position[0], position[1],
            anchor.getWidth(), anchor.getHeight(), content.getMeasuredWidth(),
            content.getMeasuredHeight(), self.dp(8), self.dp(12))
        if showing:
            menu.getPopupLayout().scrollToTop()
            popup.setHeight(height)
            popup.showAsDropDown(anchor, x, y, 3)
        elif updating:
            popup.update(anchor, x, y, -1, height)
        param.setResult(None)

    def hide_header(self, menu):
        if menu is None:
            return
        self.gear_state = [entry for entry in self.gear_state if entry[0].get() is not None]
        for index, entry in enumerate(self.gear_state):
            if entry[0].get() == menu:
                if menu.getVisibility() != 8:
                    self.gear_state[index] = (entry[0], menu.getVisibility(), *entry[2:])
                break
        else:
            anchor = menu.getAnchor()
            self.gear_state.append((self.weak_reference(menu), menu.getVisibility(),
                                    self.weak_reference(anchor) if anchor is not None else None,
                                    menu.isShowOnTop(), self.menu_side.getInt(menu),
                                    self.menu_offset.getInt(menu)))
        menu.setVisibility(8)

    def restore_header(self, menu, show=True):
        for index, (ref, visibility, anchor, above, side, offset) in enumerate(self.gear_state):
            if ref.get() == menu:
                self.gear_state.pop(index)
                self.restore_menu(menu, visibility if show else 8, anchor, above, side, offset)
                return

    def restore_menu(self, menu, visibility, anchor, above, side, offset):
        menu.closeSubMenu()
        menu.setAnchor(anchor.get() if anchor is not None else None)
        menu.setShowOnTop(above)
        menu.setSubMenuOpenSide(side)
        menu.setAdditionalYOffset(offset)
        menu.setVisibility(visibility)

    def hide_timer_in_menu(self, param):
        menu = param.thisObject
        for background, row_ref in self.rows:
            row = row_ref.get()
            if row is None:
                continue
            container = background.get().getParent() if background.get() is not None else None
            if container is None:
                continue
            viewer = self.outer.get(container)
            if self.footer_active(viewer) and self.video_menu.get(viewer) == menu:
                timer = self.timer_action(viewer)
                if timer is not None:
                    timer.setVisibility(8)
                return

    def on_button(self, viewer_ref, action, button=None):
        viewer = viewer_ref.get()
        if not self.active or viewer is None:
            return
        if action in ("settings", "overflow"):
            menu = (self.video_menu if action == "settings" else self.overflow).get(viewer)
            self.open_menu(viewer, menu, button)
            return
        if action in ("previous", "next"):
            if self.has_neighbor(viewer, action):
                self.call(viewer, "switchToNextIndex", self.integer(-1 if action == "previous" else 1),
                          self.boolean(True))
            self.refresh_neighbors(viewer)
            return
        if action == "play":
            if self.has_player(viewer):
                self.manual_pause.setBoolean(viewer, True)
                self.call(viewer, "toggleVideoPlayer")
            else:
                self.call(viewer, "onActionClick", self.boolean(True))
            self.refresh_row(viewer)
            return
        if action == "fullscreen":
            self.toggle_fullscreen(viewer)
            return
        if action == "timer":
            item = self.timer_action(viewer)
            if item is not None and item.isEnabled():
                item.performClick()

    def has_player(self, viewer):
        web = self.web_player.get(viewer)
        return viewer.getVideoPlayer() is not None or (web is not None and web.isControllable())

    def footer_active(self, viewer):
        row = self.lookup_row(self.background.get(viewer)) if self.active else None
        if row is None:
            return False
        compact = self.compact_control(viewer)
        return row.getVisibility() == 0 or (compact is not None and compact.getVisibility() == 0)

    def video_surface(self, viewer):
        if not self.active or self.edit_mode.getInt(viewer) or not viewer.isVisible():
            return False
        message = viewer.getCurrentMessageObject()
        if message is not None and message.isPhoto() and not message.isVideo():
            return False
        return self.has_player(viewer) or (message is not None and message.isVideo())

    def photo_surface(self, viewer):
        if not self.active or self.edit_mode.getInt(viewer) or not viewer.isVisible():
            return False
        message = viewer.getCurrentMessageObject()
        return message is not None and message.isPhoto() and not message.isVideo() and not message.isSponsored()

    def is_fullscreen(self, viewer):
        session = self.fullscreen_session
        window = self.window.get(viewer)
        return ((session is not None and session[0].get() == viewer)
                or viewer.isOpenedFullScreenVideo()
                or (window is not None and window.getWidth() > window.getHeight()))

    def toggle_fullscreen(self, viewer):
        activity = viewer.getParentActivity()
        if activity is None:
            return
        self.auto_processed = (self.weak_reference(viewer), self.current_media_key(viewer), True)
        self.clear_playback_axis(viewer)
        if self.is_fullscreen(viewer):
            if not self.close_fullscreen(viewer):
                button = self.exit_fullscreen.get(viewer)
                if button is not None:
                    button.performClick()
            self.call(viewer, "toggleActionBar", self.boolean(True), self.boolean(True))
            return
        orientation = None
        if self.option("orientation"):
            width, height = self.viewer_video_dimensions(viewer)
            orientation = video_orientation(width, height)
        self.enter_fullscreen(viewer, activity, orientation)

    def swipe_fullscreen(self, viewer, exiting):
        activity = viewer.getParentActivity()
        if activity is None:
            return
        self.auto_processed = (self.weak_reference(viewer), self.current_media_key(viewer), True)
        if exiting:
            self.axis_suspended = self.auto_processed[:2]
            lock = self.axis_lock
            if lock is not None and lock[0].get() == viewer:
                self.previous_native_orientation.setInt(viewer, lock[2])
                self.clear_playback_axis(viewer, restore_orientation=False)
            session = self.fullscreen_session
            if session is not None and session[0].get() == viewer:
                self.previous_native_orientation.setInt(viewer, session[2])
                self.close_fullscreen(viewer, restore_orientation=False)
            button = self.exit_fullscreen.get(viewer)
        else:
            self.axis_suspended = None
            self.clear_playback_axis(viewer)
            buttons = self.fullscreen.get(viewer)
            button = buttons[0] if buttons is not None and len(buttons) else None
        if button is not None and button.performClick() and not exiting and self.option("orientation"):
            activity.setRequestedOrientation(SENSOR_LANDSCAPE)

    def enter_fullscreen(self, viewer, activity, orientation, automatic=False):
        self.fullscreen_session = (self.weak_reference(viewer), self.weak_reference(activity),
                                   activity.getRequestedOrientation())
        self.automatic_fullscreen = automatic
        if orientation is not None:
            activity.setRequestedOrientation(orientation)
        self.call(viewer, "toggleActionBar", self.boolean(True), self.boolean(True))
        self.android.cancelRunOnUIThread(self.auto_hide_controls.get(viewer))
        window = self.window.get(viewer)
        if window is not None:
            window.requestLayout()

    def close_fullscreen(self, viewer, restore_orientation=True):
        session = self.fullscreen_session
        if session is None or session[0].get() != viewer:
            return False
        self.fullscreen_session = None
        self.automatic_fullscreen = False
        activity = session[1].get()
        if restore_orientation and activity is not None and activity.getRequestedOrientation() != session[2]:
            activity.setRequestedOrientation(session[2])
        return True

    def clear_playback_axis(self, viewer, restore_orientation=True):
        session = self.axis_lock
        if session is not None and session[0].get() == viewer:
            self.axis_lock = None
            activity = session[1].get()
            if restore_orientation and activity is not None and activity.getRequestedOrientation() == session[3]:
                activity.setRequestedOrientation(session[2])

    def release_video_orientation(self, viewer, keep_entry=False):
        self.stop_photo_rotation(viewer)
        self.close_fullscreen(viewer)
        self.clear_playback_axis(viewer)
        if self.axis_target is not None and self.axis_target[0].get() == viewer:
            self.axis_target = None
        if self.axis_suspended is not None and self.axis_suspended[0].get() == viewer:
            self.axis_suspended = None
        if self.auto_processed is not None and self.auto_processed[0].get() == viewer:
            self.auto_processed = None
        if not keep_entry and self.auto_entry is not None and self.auto_entry[0].get() == viewer:
            self.auto_entry = None

    def after_video_size(self, param):
        ref = self.auto_viewer
        viewer = ref.get() if ref is not None else None
        if viewer is not None and viewer.getVideoPlayer() == param.thisObject:
            player, size = param.thisObject, param.args[0]
            if self.looper.myLooper() == self.ui_looper:
                self.check_auto_fullscreen(viewer, size)
            else:
                run_on_ui_thread(lambda: self.check_auto_fullscreen(viewer, size)
                                 if viewer.getVideoPlayer() == player else None)

    def after_prepare_video(self, param):
        viewer = param.thisObject
        self.hook_orientation_listener(viewer)
        player = viewer.getVideoPlayer()
        size = player.player.getVideoSize() if player is not None and player.player is not None else None
        self.check_auto_fullscreen(viewer, size)

    def hook_orientation_listener(self, viewer):
        if not self.option("orientation") or self.orientation_hooked:
            return
        listener = self.orientation_listener.get(viewer)
        if listener is not None:
            callback = method(listener.getClass(), "onOrientationChanged", 1)
            self.hooks.append(self.hook_method(callback, before=self.follow_device_orientation))
            self.orientation_hooked = True

    def follow_device_orientation(self, param):
        target = self.axis_target
        if not self.active or not self.option("orientation") or target is None:
            return
        ref, key, direction = target
        viewer = ref.get()
        if viewer is None or not viewer.isVisible() or self.orientation_listener.get(viewer) != param.thisObject:
            return
        param.setResult(None)
        self.apply_sensed_axis(viewer, device_orientation_axis(int(param.args[0])))

    def start_photo_rotation(self, viewer):
        if not self.option("orientation"):
            return
        session = self.photo_sensor
        if session is not None and session[0].get() == viewer:
            return
        self.stop_photo_rotation()
        activity = viewer.getParentActivity()
        if activity is None:
            return
        service = activity.getSystemService("sensor")
        if service is None:
            return
        manager = cast(self.sensor_manager, service)
        sensor = manager.getDefaultSensor(self.accelerometer)
        if sensor is None:
            return
        viewer_ref = self.weak_reference(viewer)
        plugin = self

        class Listener(dynamic_proxy(plugin.sensor_listener)):
            last_axis = None

            def onSensorChanged(self, event):
                current = viewer_ref.get()
                if current is None or not plugin.photo_surface(current):
                    plugin.stop_photo_rotation(current)
                    return
                values = event.values
                axis = gravity_axis(values[0], values[1], values[2])
                if axis is not None and axis != self.last_axis:
                    previous, self.last_axis = self.last_axis, axis
                    if previous is not None:
                        plugin.apply_sensed_axis(current, axis)

            def onAccuracyChanged(self, sensor, accuracy):
                pass

        listener = Listener()
        if manager.registerListener(listener, sensor, self.sensor_manager.SENSOR_DELAY_NORMAL):
            self.photo_sensor = (viewer_ref, manager, listener)

    def stop_photo_rotation(self, viewer=None):
        session = self.photo_sensor
        if session is not None and (viewer is None or session[0].get() == viewer):
            self.photo_sensor = None
            session[1].unregisterListener(session[2])

    def apply_sensed_axis(self, viewer, actual):
        target = self.axis_target
        if target is None or target[0].get() != viewer or target[1] != self.current_media_key(viewer):
            return
        _, key, direction = target
        paused = self.axis_suspended
        if paused is not None and paused[0].get() == viewer and paused[1] == key:
            if actual is not None and actual != direction:
                self.axis_suspended = None
            return
        if actual == direction:
            self.lock_playback_axis(viewer, direction)

    def lock_playback_axis(self, viewer, direction):
        activity = viewer.getParentActivity()
        if (activity is None or activity.isFinishing()
                or (self.sdk >= 24 and activity.isInPictureInPictureMode())):
            return
        requested = activity.getRequestedOrientation()
        if requested == direction:
            return
        lock = self.axis_lock
        session = self.fullscreen_session
        if lock is not None and lock[0].get() == viewer:
            previous = lock[2]
        elif session is not None and session[0].get() == viewer:
            previous = session[2]
        elif self.native_fullscreen_mode.getInt(viewer) != 0:
            previous = self.previous_native_orientation.getInt(viewer)
        else:
            previous = requested
        if session is not None and session[0].get() == viewer:
            self.close_fullscreen(viewer, restore_orientation=False)
        self.axis_lock = (self.weak_reference(viewer), self.weak_reference(activity), previous, direction)
        activity.setRequestedOrientation(direction)

    def check_auto_fullscreen(self, viewer, size=None):
        if (not self.active or not viewer.isVisible()
                or not (self.option("auto_fullscreen") or self.option("orientation"))):
            return
        message = viewer.getCurrentMessageObject()
        photo = self.photo_surface(viewer)
        if photo:
            self.start_photo_rotation(viewer)
        else:
            self.stop_photo_rotation(viewer)
        key = self.current_media_key(viewer)
        entry = self.auto_entry
        if entry is None or entry[0].get() != viewer:
            if message is None:
                return
            entry = self.auto_entry = (self.weak_reference(viewer), key, False)
        if not entry[2] and entry[1] != key:
            entry = self.auto_entry = (entry[0], entry[1], True)
        apply_immediately = self.option("auto_fullscreen") and (
            not entry[2] or self.option("auto_fullscreen_on_switch"))
        activity = viewer.getParentActivity()
        if (message is None or (not photo and not message.isVideo()) or message.isSponsored() or activity is None
                or self.edit_mode.getInt(viewer)
                or (self.sdk >= 24 and activity.isInPictureInPictureMode()) or activity.isFinishing()):
            if self.automatic_fullscreen and apply_immediately:
                self.release_video_orientation(viewer, keep_entry=True)
            else:
                self.axis_target = None
                if self.auto_processed is not None and self.auto_processed[0].get() == viewer:
                    self.auto_processed = None
            return
        self.auto_viewer = self.weak_reference(viewer)
        previous = self.auto_processed
        same_video = previous is not None and previous[0].get() == viewer and previous[1] == key
        if same_video and (size is None or previous[2]):
            return
        width, height, from_player = self.photo_dimensions(viewer, message) if photo else self.video_dimensions(message, size)
        if width <= 0 or height <= 0:
            self.axis_target = None
            return
        session = self.fullscreen_session
        self.auto_processed = (self.auto_viewer, key, from_player)
        direction = auto_video_orientation(width, height)
        self.axis_target = (self.auto_viewer, key, direction) if direction is not None else None
        if direction is None:
            if apply_immediately and same_video and self.automatic_fullscreen:
                self.close_fullscreen(viewer)
            return
        window = self.window.get(viewer)
        horizontal = window is not None and window.getWidth() > window.getHeight()
        if not apply_immediately or (session is not None and session[0].get() == viewer and not self.automatic_fullscreen):
            if self.option("orientation") and horizontal == (direction == SENSOR_LANDSCAPE):
                self.lock_playback_axis(viewer, direction)
            return
        if direction == SENSOR_LANDSCAPE:
            if not horizontal and (session is None or session[0].get() != viewer):
                self.clear_playback_axis(viewer)
                self.enter_fullscreen(viewer, activity, SENSOR_LANDSCAPE, automatic=True)
            elif self.option("orientation"):
                self.lock_playback_axis(viewer, direction)
        elif self.option("orientation") or horizontal:
            self.lock_playback_axis(viewer, direction)

    def video_dimensions(self, message, size):
        if size is not None and size.width > 0 and size.height > 0:
            width, height = size.width * float(size.pixelWidthHeightRatio), size.height
            if size.unappliedRotationDegrees in (90, 270):
                width, height = height, width
            return width, height, True
        document = message.getDocument() if message is not None else None
        if document is not None:
            for attribute in document.attributes:
                if self.video_attribute.isInstance(attribute):
                    return attribute.w, attribute.h, False
        return 0, 0, False

    def photo_dimensions(self, viewer, message):
        photo = message.getPhoto()
        if photo is not None:
            size = self.file_loader.getClosestPhotoSizeWithSize(photo.sizes, self.android.getPhotoSize())
            if size is not None and size.w > 0 and size.h > 0:
                return size.w, size.h, True
        receiver = self.center_image.get(viewer)
        if receiver is not None and receiver.hasBitmapImage():
            return receiver.getBitmapWidth(), receiver.getBitmapHeight(), True
        return 0, 0, False

    def wide_video(self, viewer):
        width, height = self.viewer_video_dimensions(viewer)
        return auto_video_orientation(width, height) == SENSOR_LANDSCAPE

    def viewer_video_dimensions(self, viewer):
        if self.video_size_set.getBoolean(viewer):
            width, height = self.video_width.getInt(viewer), self.video_height.getInt(viewer)
            if width > 0 and height > 0:
                return width, height
        width, height, _ = self.video_dimensions(viewer.getCurrentMessageObject(), None)
        if width > 0 and height > 0:
            return width, height
        image = self.center_image.get(viewer)
        return (image.getImageWidth(), image.getImageHeight()) if image is not None else (0, 0)

    def hide_center_draw(self, param):
        state = self.progress_state.getInt(param.thisObject)
        if state not in PLAY_STATES:
            return
        viewer = self.progress_outer.get(param.thisObject)
        if self.center_progress.get(viewer)[0] == param.thisObject and self.footer_active(viewer):
            param.setResult(None)

    def hide_center_accessibility(self, viewer):
        if self.footer_active(viewer):
            overlay = self.accessibility.get(viewer)
            if overlay is not None:
                overlay.setVisibility(4)

    def center_tap(self, param):
        viewer, event = param.thisObject, param.args[0]
        if not self.footer_active(viewer) or self.discard_tap.getBoolean(viewer):
            return
        message = viewer.getCurrentMessageObject()
        if message is not None and message.isSponsored():
            return
        radius = self.dp(50)
        if (abs(event.getX() - int(self.call(viewer, "getContainerViewWidth")) / 2) <= radius
                and abs(event.getY() - int(self.call(viewer, "getContainerViewHeight")) / 2) <= radius):
            self.call(viewer, "toggleActionBar", self.boolean(not self.action_bar_visible.getBoolean(viewer)),
                      self.boolean(True))
            param.setResult(self.boolean(True))

    def defer_video_single_tap(self, param):
        if self.video_surface(param.thisObject):
            param.setResult(self.boolean(False))

    def before_native_double_tap(self, param):
        viewer, event = param.thisObject, param.args[0]
        if not self.video_surface(viewer):
            return
        action = double_tap_action(event.getX(), int(self.call(viewer, "getContainerViewWidth")))
        if action == "play":
            if self.option("double_tap"):
                self.on_button(self.weak_reference(viewer), "play")
                param.setResult(self.boolean(True))
        elif self.option("double_tap_seek") and self.has_player(viewer):
            target = self.double_tap_target(viewer, action)
            if target is not None:
                position, duration, delta = target
                drawable = self.seek_animation.get(viewer)
                if drawable is not None:
                    drawable.setOneShootAnimation(True)
                    drawable.setLeftSide(action == "back")
                    drawable.addTime(delta)
                self.call(viewer, "seekVideoOrWebTo", self.long(position))
                self.viewer_container.get(viewer).invalidate()
                seek, seek_view = self.video_seek.get(viewer), self.video_seek_view.get(viewer)
                if seek is not None and seek_view is not None:
                    seek.setProgress(jfloat(position / duration), True)
                    seek_view.invalidate()
            param.setResult(self.boolean(True))

    def before_can_double_tap_seek(self, param):
        viewer, event = param.thisObject, param.args[0]
        if self.option("double_tap_seek") and self.video_surface(viewer) and self.has_player(viewer):
            action = double_tap_action(event.getX(), int(self.call(viewer, "getContainerViewWidth")))
            if action != "play":
                param.setResult(self.boolean(self.double_tap_target(viewer, action) is not None))

    def double_tap_target(self, viewer, action):
        current = int(self.call(viewer, "getCurrentVideoPosition"))
        duration = int(self.call(viewer, "getVideoDuration"))
        if current < 0 or duration <= 0:
            return None
        seconds = getattr(self, "double_tap_seconds", DEFAULT_DOUBLE_TAP_SECONDS)
        delta = seconds * 1000
        target = max(0, min(duration, current + (delta if action == "forward" else -delta)))
        return (target, duration, delta) if target != current else None

    def before_touch(self, param):
        viewer = param.thisObject
        override = (self.option("pinch") and param.args[0].getPointerCount() > 1
                    and self.video_surface(viewer) and not self.can_zoom.getBoolean(viewer))
        self.touch_stack.append(override)
        if override:
            self.can_zoom.setBoolean(viewer, True)

    def after_touch(self, param):
        if self.touch_stack.pop():
            self.can_zoom.setBoolean(param.thisObject, False)
        if param.args[0].getPointerCount() > 1 or param.args[0].getActionMasked() in (1, 3):
            self.refresh_zoom(param.thisObject)

    def route_video_touch(self, param):
        window, event = param.thisObject, param.args[0]
        viewer = self.window_outer.get(window)
        action = event.getActionMasked()
        if self.route_speed_touch(param, window, viewer, event, action):
            return
        if self.route_swipe(param, window, viewer, event, action):
            caption = self.top_caption(viewer)
            if caption is not None:
                caption.touch = None
            return
        if self.route_caption_touch(param, window, viewer, event, action):
            self.swipe = None
            return
        if action == 0:
            self.pinch_window = None
        if self.pinch_window is None:
            if (action != 5 or event.getPointerCount() != 2 or not self.option("pinch")
                    or not self.video_surface(viewer)):
                return
            self.cancel_child_touch(param, window, event)
            self.pinch_window = self.weak_reference(window)
        if self.pinch_window.get() != window:
            return
        self.touch_method.invoke(viewer, self.arguments([event]))
        if action in (1, 3):
            self.pinch_window = None
        param.setResult(self.boolean(True))

    def route_speed_touch(self, param, window, viewer, event, action):
        if action == 0:
            self.restore_held_speed()
            self.speed_press = None
            if self.option("hold_speed") and self.video_surface(viewer):
                x, y = event.getX(), event.getY()
                if self.hits_open_video(viewer, window, x, y):
                    self.speed_press = (viewer, x, y)
            return False
        hold = self.speed_hold
        if hold is not None and hold[0] == viewer:
            param.setResult(self.boolean(True))
            if not hold[3]:
                self.speed_hold = (*hold[:3], True)
                self.cancel_child_touch(param, window, event)
            if action != 2 or event.getPointerCount() != 1:
                self.restore_held_speed(viewer)
            return True
        press = self.speed_press
        if press is not None and (action != 2
                or max(abs(event.getX() - press[1]), abs(event.getY() - press[2])) > self.dp(8)):
            self.speed_press = None
        return False

    def hits_open_video(self, viewer, window, x, y):
        top, bottom = self.video_swipe_bounds(viewer, window)
        if not top <= y < bottom:
            return False
        caption = self.top_caption(viewer)
        if caption is not None and caption.scroll is not None and self.hits_view(caption.scroll, window, x, y):
            return False
        frame = self.aspect_frame.get(viewer)
        container = self.viewer_container.get(viewer)
        if frame is None or container is None or frame.getVisibility() != 0:
            return False
        width, height = frame.getMeasuredWidth(), frame.getMeasuredHeight()
        if not width or not height:
            return False
        fit = min(int(self.call(viewer, "getContainerViewWidth")) / width,
                  int(self.call(viewer, "getContainerViewHeight")) / height)
        half_width, half_height = width * fit / 2, height * fit / 2
        bounds = self.rectf(-half_width, -half_height, half_width, half_height)
        self.image_transform.get(viewer).mapRect(bounds)
        origin_x, origin_y = self.view_origin(container, window)
        return bounds.contains(x - origin_x, y - origin_y)

    def start_held_speed(self, param):
        viewer, press = param.thisObject, self.speed_press
        if press is None or press[0] != viewer:
            return
        self.speed_press = None
        if not self.option("hold_speed") or not self.video_surface(viewer):
            return
        player = viewer.getVideoPlayer()
        engine = player.player if player is not None else None
        if engine is None:
            return
        original = engine.getPlaybackParameters()
        speed = getattr(self, "hold_speed", DEFAULT_HOLD_SPEED)
        engine.setPlaybackParameters(self.playback_parameters(jfloat(speed), original.pitch))
        self.speed_hold = (viewer, engine, original, False)
        self.swipe = None
        param.setResult(None)
        self.show_level_hud(viewer, "speed", speed)

    def restore_held_speed(self, viewer=None):
        hold = self.speed_hold
        if hold is not None and (viewer is None or hold[0] == viewer):
            self.speed_hold = None
            hold[1].setPlaybackParameters(hold[2])
            if self.level_hud is not None and self.level_hud[1] == "speed":
                self.hide_level_hud()

    def cancel_child_touch(self, param, window, event):
        cancel = self.motion.obtain(event)
        try:
            cancel.setAction(3)
            self.bridge.invokeOriginalMethod(param.method, window, self.arguments([cancel]))
        finally:
            cancel.recycle()

    def route_swipe(self, param, window, viewer, event, action):
        if action == 0:
            self.swipe = None
            if not self.video_surface(viewer):
                return False
            x, y = event.getX(), event.getY()
            zone = {"back": "brightness", "play": "fullscreen", "forward": "volume"}[
                double_tap_action(x, window.getWidth())]
            top, bottom = self.video_swipe_bounds(viewer, window)
            if not top <= y < bottom or (zone == "fullscreen" and self.hits_caption(viewer, window, x, y)):
                return False
            if self.option(zone + "_swipe"):
                horizontal = window.getWidth() > window.getHeight()
                self.swipe = (x, y, zone, horizontal, False, None)
            return False
        if self.swipe is None:
            return False
        x, y, zone, full, captured, initial = self.swipe
        if event.getPointerCount() != 1:
            self.swipe = None
            self.hide_level_hud()
            return False
        dx, dy = event.getX() - x, event.getY() - y
        volume_anchor = False
        if action == 2 and not captured:
            threshold = self.dp(12 if zone == "fullscreen" else 9)
            if vertical_swipe(dx, dy, threshold):
                self.swipe = (x, y, zone, full, True, None)
                captured = True
                param.setResult(self.boolean(True))
                self.cancel_child_touch(param, window, event)
                if zone != "fullscreen":
                    initial = self.get_adjustment(viewer, window, zone)
                if zone == "volume":
                    y = event.getY()
                    dy = 0.0
                    volume_anchor = True
                self.swipe = (x, y, zone, full, True, initial)
            elif abs(dx) >= threshold and abs(dx) >= abs(dy):
                self.swipe = None
        elif captured:
            param.setResult(self.boolean(True))
        if captured and zone != "fullscreen" and action in (1, 2) and initial is None:
            initial = self.get_adjustment(viewer, window, zone)
            if initial is not None:
                if zone == "volume":
                    y = event.getY()
                    dy = 0.0
                    volume_anchor = True
                self.swipe = (x, y, zone, full, True, initial)
        if captured and zone != "fullscreen" and action in (1, 2) and initial is not None:
            height = window.getHeight()
            if zone == "volume":
                height = min(height, self.dp(400))
            level = swipe_level(initial, dy, height, 0.0)
            applied = initial if volume_anchor else self.set_adjustment(viewer, window, zone, level)
            if applied is not None:
                self.show_level_hud(viewer, zone, applied)
        if action in (1, 3):
            self.swipe = None
            if (captured and zone == "fullscreen" and action == 1
                    and fullscreen_swipe(dx, dy, full, self.dp(34)) and (full or self.wide_video(viewer))):
                self.swipe_fullscreen(viewer, full)
            if zone != "fullscreen":
                self.hide_level_hud(delay=650 if captured and action == 1 else 0)
        return captured

    def video_swipe_bounds(self, viewer, window):
        top, bottom = self.dp(12), window.getHeight() - self.dp(12)
        if self.action_bar_visible.getBoolean(viewer):
            bar, controls = self.action_bar.get(viewer), self.controls.get(viewer)
            if bar is not None and bar.getHeight() > 0 and bar.getParent() is not None:
                top = max(top, self.view_origin(bar, window)[1] + bar.getHeight())
            if (controls is not None and controls.getVisibility() == 0 and controls.getHeight() > 0
                    and controls.getParent() is not None):
                controls_top = self.view_origin(controls, window)[1]
                if controls_top > top:
                    bottom = min(bottom, controls_top)
        return top, bottom

    def view_origin(self, view, window):
        origin, window_origin = self.positions([0, 0]), self.positions([0, 0])
        view.getLocationInWindow(origin)
        window.getLocationInWindow(window_origin)
        return origin[0] - window_origin[0], origin[1] - window_origin[1]

    def hits_view(self, view, window, x, y):
        if view.getVisibility() != 0 or view.getAlpha() <= 0.1 or view.getParent() is None:
            return False
        left, top = self.view_origin(view, window)
        return left <= x < left + view.getWidth() and top <= y < top + view.getHeight()

    def hits_caption(self, viewer, window, x, y):
        entry = self.top_caption(viewer)
        return (entry is not None and entry.scroll is not None
                and self.hits_view(entry.scroll, window, x, y)
                and self.caption_text_at(entry, window, x, y))

    def blank_caption_at(self, viewer, entry, window, x, y):
        bar = self.action_bar.get(viewer)
        if (y < self.view_origin(bar, window)[1] + bar.getHeight()
                or not self.hits_view(entry.shade, window, x, y)):
            return False
        return (entry.scroll is None or not self.hits_view(entry.scroll, window, x, y)
                or not self.caption_text_at(entry, window, x, y))

    def route_caption_touch(self, param, window, viewer, event, action):
        entry = self.top_caption(viewer)
        if entry is None:
            return False
        if action == 0:
            entry.touch = None
            if self.action_bar_visible.getBoolean(viewer):
                x, y = event.getX(), event.getY()
                blank = self.blank_caption_at(viewer, entry, window, x, y)
                collapsed = entry.has_more and not entry.expanded and self.hits_caption(viewer, window, x, y)
                if blank or collapsed:
                    entry.touch = (x, y, blank, collapsed, False)
            return False
        if entry.touch is None:
            return False
        if event.getPointerCount() != 1:
            entry.touch = None
            return False
        x, y, blank, collapsed, captured = entry.touch
        dx, dy = event.getX() - x, event.getY() - y
        if action == 2 and not captured:
            if collapsed and vertical_swipe(dx, dy, self.dp(10)):
                self.cancel_child_touch(param, window, event)
                captured = True
                entry.touch = (x, y, blank, collapsed, True)
            elif max(abs(dx), abs(dy)) > self.dp(10):
                entry.touch = None
        if (action == 1 and not captured and blank and max(abs(dx), abs(dy)) <= self.dp(8)
                and event.getEventTime() - event.getDownTime() < self.tap_timeout
                and self.action_bar_visible.getBoolean(viewer)
                and self.blank_caption_at(viewer, entry, window, event.getX(), event.getY())):
            self.cancel_child_touch(param, window, event)
            self.call(viewer, "toggleActionBar", self.boolean(False), self.boolean(True))
            captured = True
        if action in (1, 3):
            entry.touch = None
        if captured:
            param.setResult(self.boolean(True))
        return captured

    def toggle_caption(self, viewer):
        entry = self.top_caption(viewer)
        if entry is None or not entry.has_more or not self.action_bar_visible.getBoolean(viewer):
            return
        entry.expanded = not entry.expanded
        entry.scroll.stopScrolling()
        entry.scroll.scrollTo(0, 0)
        self.update_caption_button(entry)
        entry.scroll.requestLayout()
        if entry.expanded:
            self.android.cancelRunOnUIThread(self.auto_hide_controls.get(viewer))
        else:
            self.call(viewer, "scheduleActionBarHide")

    def caption_text_at(self, entry, window, x, y):
        text = entry.switcher.getCurrentView()
        layout = text.getLayout() if text is not None else None
        if layout is None or not layout.getLineCount():
            return False
        left, top = self.view_origin(text, window)
        tx = x - left + text.getScrollX() - text.getTotalPaddingLeft()
        ty = y - top + text.getScrollY() - text.getTotalPaddingTop()
        if not 0 <= ty < layout.getHeight():
            return False
        line = layout.getLineForVertical(int(ty))
        return layout.getLineLeft(line) <= tx < layout.getLineRight(line)

    def get_adjustment(self, viewer, window, zone):
        if zone == "volume":
            manager = self.media_audio_manager(window)
            if manager is None:
                return None
            low, high = self.media_volume_limits(manager)
            return (manager.getStreamVolume(self.music_stream) - low) / (high - low) if high > low else None
        params = self.window_params.get(viewer)
        if params is None or window.getParent() is None:
            return None
        if params.screenBrightness >= 0:
            return float(params.screenBrightness)
        settings = self.setting_system
        value = settings.getInt(window.getContext().getContentResolver(), settings.SCREEN_BRIGHTNESS, 128)
        return max(0, min(255, value)) / 255

    def set_adjustment(self, viewer, window, zone, level):
        if zone == "volume":
            return self.set_media_volume(viewer, window, level)
        params = self.window_params.get(viewer)
        activity = viewer.getParentActivity()
        if params is None or activity is None or window.getParent() is None:
            return None
        original = params.screenBrightness
        if original == level:
            return level
        session = self.brightness_session
        if session is not None and session[1].get() != window:
            self.restore_brightness()
            session = None
        params.screenBrightness = jfloat(level)
        try:
            activity.getWindowManager().updateViewLayout(window, params)
        except Exception:
            params.screenBrightness = original
            return None
        if session is None:
            self.brightness_session = (self.weak_reference(viewer), self.weak_reference(window), original)
        return level

    def before_image_index(self, param):
        viewer = param.thisObject
        if int(param.args[0]) != viewer.getCurrentIndex():
            self.speed_press = None
            self.restore_held_speed(viewer)
            self.hide_level_hud()
            self.swipe = None

    def after_image_index(self, param):
        viewer = param.thisObject
        self.refresh_neighbors(viewer)
        self.refresh_zoom(viewer)
        self.check_auto_fullscreen(viewer)

    def current_media_key(self, viewer):
        message = viewer.getCurrentMessageObject()
        if message is not None:
            return message.getDialogId(), message.getId()
        return (viewer.getCurrentIndex(),)

    def before_player_release(self, param):
        self.speed_press = None
        self.restore_held_speed(param.thisObject)

    def media_audio_manager(self, window):
        service = window.getContext().getSystemService("audio")
        return cast(self.audio_manager_type, service) if service is not None else None

    def media_volume_limits(self, manager):
        stream = self.music_stream
        minimum = manager.getStreamMinVolume(stream) if self.sdk >= 28 else 0
        return minimum, manager.getStreamMaxVolume(stream)

    def set_media_volume(self, viewer, window, level):
        manager = self.media_audio_manager(window)
        if manager is None:
            return None
        low, high = self.media_volume_limits(manager)
        if high <= low:
            return None
        session = self.volume_session
        if session is not None and session[0].get() != viewer:
            self.restore_volume()
        stream = self.music_stream
        old = manager.getStreamVolume(stream)
        target = low + int(level * (high - low) + 0.5)
        if target != old and not manager.isVolumeFixed():
            try:
                manager.setStreamVolume(stream, target, 0)
            except Exception as error:
                self.log(f"Media volume: {type(error).__name__}")
                return None
            applied = manager.getStreamVolume(stream)
            if applied != old and self.volume_session is None:
                self.volume_session = (self.weak_reference(viewer), manager, old)
        else:
            applied = old
        return (applied - low) / (high - low)

    def restore_volume(self, viewer=None):
        session = self.volume_session
        if session is None or (viewer is not None and session[0].get() != viewer):
            return
        self.volume_session = None
        _, manager, original = session
        if manager.getStreamVolume(self.music_stream) != original:
            try:
                manager.setStreamVolume(self.music_stream, original, 0)
            except Exception as error:
                self.log(f"Restore media volume: {type(error).__name__}")

    def restore_brightness(self, viewer=None):
        session = self.brightness_session
        if session is None or (viewer is not None and session[0].get() != viewer):
            return
        self.brightness_session = None
        owner, window = session[0].get(), session[1].get()
        if owner is None:
            return
        params = self.window_params.get(owner)
        if params is None:
            return
        params.screenBrightness = jfloat(session[2])
        activity = owner.getParentActivity()
        if activity is not None and window is not None and window.getParent() is not None:
            try:
                activity.getWindowManager().updateViewLayout(window, params)
            except Exception:
                pass

    def leave_adjustments(self, viewer):
        self.speed_press = None
        self.restore_held_speed(viewer)
        self.restore_volume(viewer)
        self.restore_brightness(viewer)
        self.swipe = None
        if self.level_hud is not None and self.level_hud[0].get() == viewer:
            self.remove_level_hud()

    def leave_viewer(self, viewer):
        self.leave_adjustments(viewer)
        self.release_video_orientation(viewer)
        self.restore_top_caption(viewer)
        self.prepare_photo_header(viewer, self.viewer_container.get(viewer), False)

    def round_background(self, color, radius):
        background = self.pill_background()
        background.setColor(color)
        background.setCornerRadius(float(self.dp(radius)))
        return background

    def show_level_hud(self, viewer, zone, level):
        container = self.viewer_container.get(viewer)
        if container is None or container.getHeight() <= 0:
            return
        speed = zone == "speed"
        hud = self.level_hud
        if hud is None or hud[0].get() != viewer or hud[1] != zone or hud[5] != container:
            self.remove_level_hud()
            context = container.getContext()
            card = self.frame_layout(context)
            card.setImportantForAccessibility(2)
            card.setBackground(self.round_background(0xE8212429 - (1 << 32), 18))
            icon = self.image_view(context)
            glyph = {"brightness": self.drawable.msg_brightness_high, "volume": self.drawable.baseline_volume_up_24,
                     "speed": self.drawable.msg_speed}[zone]
            icon.setImageResource(glyph)
            icon.setColorFilter(WHITE)
            icon.setScaleType(self.fit_center)
            params = self.frame_params(self.dp(19), self.dp(19), 19)
            params.leftMargin = self.dp(11)
            card.addView(icon, params)
            fill = None
            if not speed:
                track = self.frame_layout(context)
                track.setBackground(self.round_background(0x43FFFFFF, 4))
                params = self.frame_params(self.dp(86), self.dp(5), 19)
                params.leftMargin = self.dp(41)
                card.addView(track, params)
                fill = self.view_type(context)
                fill.setBackground(self.round_background(WHITE, 4))
                fill.setPivotX(0.0)
                track.addView(fill, self.frame_params(-1, -1, 3))
            value = self.text_view(context)
            value.setTextSize(12)
            value.setGravity(17)
            value.setTextColor(WHITE)
            params = self.frame_params(self.dp(56 if speed else 39), -1, 21)
            params.rightMargin = self.dp(5)
            card.addView(value, params)
            container.getOverlay().add(card)
            hud = self.level_hud = (self.weak_reference(viewer), zone, card, fill, value, container)
        self.hud_generation += 1
        _, _, card, fill, value, _ = hud
        width, height = self.dp(98 if speed else 174), self.dp(36)
        x = (container.getWidth() - width) // 2
        insets = container.getRootWindowInsets()
        top = (insets.getStableInsetTop() if insets is not None else 0) + self.dp(12)
        card.animate().cancel()
        card.setAlpha(1.0)
        card.setVisibility(0)
        exact = self.measure_spec.EXACTLY
        card.measure(self.measure_spec.makeMeasureSpec(width, exact), self.measure_spec.makeMeasureSpec(height, exact))
        card.layout(x, top, x + width, top + height)
        if fill is not None:
            fill.setScaleX(float(level))
        value.setText(f"{level:g}×" if speed else f"{round(level * 100)}%")

    def hide_level_hud(self, delay=0):
        self.hud_generation += 1
        generation = self.hud_generation
        if self.level_hud is None:
            return
        card = self.level_hud[2]
        if not delay:
            card.animate().cancel()
            card.setVisibility(8)
            return

        def fade():
            if generation == self.hud_generation:
                card.animate().alpha(0.0).setDuration(150).start()

        run_on_ui_thread(fade, delay)

    def remove_level_hud(self):
        self.hide_level_hud()
        if self.level_hud is not None:
            _, _, card, _, _, container = self.level_hud
            container.getOverlay().remove(card)
            self.level_hud = None

    def refresh_zoom(self, viewer):
        self.zoom_buttons = [(v, b) for v, b in self.zoom_buttons if v.get() is not None and b.get() is not None]
        button = next((b.get() for v, b in self.zoom_buttons if v.get() == viewer), None)
        show = self.option("pinch") and self.video_surface(viewer) and self.scale.getFloat(viewer) > 1.015
        if not show:
            if button is not None:
                button.setVisibility(8)
            return
        background = self.background.get(viewer)
        container = background.getParent() if background is not None else None
        if container is None:
            return
        if button is None:
            button = self.make_button(container.getContext(), "还原大小", "还原")
            button.setPadding(self.dp(12), 0, self.dp(12), 0)
            pill = self.pill_background()
            pill.setColor(0xA0000000 - (1 << 32))
            pill.setCornerRadius(float(self.dp(19)))
            button.setBackground(pill)
            viewer_ref = self.weak_reference(viewer)

            def reset(view):
                current = viewer_ref.get()
                if current is not None:
                    current.zoomOut()
                    view.setVisibility(8)

            button.setOnClickListener(OnClickListener(reset))
            params = self.frame_params(-2, self.dp(38), 49)
            container.addView(button, params)
            self.zoom_buttons.append((viewer_ref, self.weak_reference(button)))
        button.setVisibility(0)
        self.position_zoom_reset(viewer, button)

    def position_zoom_reset(self, viewer, button):
        container = button.getParent()
        if container is None or container.getHeight() <= 0:
            return
        bottom = container.getHeight() * 0.79
        controls, seek = self.controls.get(viewer), self.video_seek_view.get(viewer)
        if controls is not None and seek is not None and seek.getParent() == controls and seek.getHeight() > 0:
            bottom = min(bottom, controls.getY() + seek.getY() - self.dp(12))
        top = max(0, bottom - self.dp(38))
        if button.getTranslationY() != top:
            button.setTranslationY(float(top))

    def before_container_measure(self, param):
        self.header_height_stack.append(False)
        viewer = self.outer.get(param.thisObject)
        background = self.background.get(viewer)
        video = self.video_surface(viewer)
        photo = self.photo_surface(viewer)
        show = self.option("video_toolbar") and video
        photo_style = self.option("photo_shadows") and photo
        controls = self.controls.get(viewer)
        compact = self.compact_control(viewer)
        width, height = (self.measure_spec.getSize(int(arg)) for arg in param.args)
        use_compact = show and compact is not None and width > height
        self.header_height_stack[-1] = use_compact
        if compact is not None:
            compact.setVisibility(0 if use_compact else 8)
        if controls is not None and self.fullscreen_control(viewer) is not None:
            height = (SCRUBBER_HEIGHT + VIDEO_TOOL_SIZE + COMPACT_BOTTOM_GAP
                      if use_compact else VIDEO_CONTROLS_HEIGHT)
            controls.getLayoutParams().height = self.dp(height if show else 48)
        self.prepare_top_caption(viewer, param.thisObject, show)
        self.prepare_photo_header(viewer, param.thisObject, photo_style)
        self.style_video_shadows(viewer, show or photo_style)
        self.style_album_strip(viewer, self.option("album_thumbnails") and (video or photo), show or photo_style)
        self.style_header_icons(viewer, show)
        self.move_header_share(viewer, show)
        if (show
                and background is not None and background.getVisibility() != 8
                and self.lookup_row(background) is not None):
            self.hide_header(self.video_menu.get(viewer))
            self.hide_header(self.overflow.get(viewer))

    def finish_container_measure(self, param):
        try:
            self.after_container_measure(param)
        finally:
            self.header_height_stack.pop()

    def before_container_layout(self, param):
        self.header_height_stack.append(False)
        viewer = self.outer.get(param.thisObject)
        compact = self.compact_control(viewer)
        self.header_height_stack[-1] = compact is not None and compact.getVisibility() == 0

    def finish_container_layout(self, param):
        try:
            viewer = self.outer.get(param.thisObject)
            self.position_collapsed_scrubber(viewer, self.controls.get(viewer))
            for owner, view in self.zoom_buttons:
                button = view.get()
                if owner.get() == viewer and button is not None and button.getVisibility() == 0:
                    self.position_zoom_reset(viewer, button)
            self.fit_header(viewer)
            self.align_caption_date(viewer)
        finally:
            self.header_height_stack.pop()

    def compact_header_height(self, param):
        if (self.header_height_stack and self.header_height_stack[-1]
                and self.looper.myLooper() == self.ui_looper):
            height = min(int(param.getResult()), self.dp(COMPACT_HEADER_HEIGHT))
            param.setResult(self.integer(height))

    def style_header_icons(self, viewer, enabled):
        icons = [self.header_back.get(viewer)]
        menu = self.header_menu.get(viewer)
        if menu is not None:
            for index in range(menu.getChildCount()):
                item = menu.getChildAt(index)
                if self.menu_item_type.isInstance(item):
                    icons.append(item.getIconView())
        self.header_icons = [entry for entry in self.header_icons if entry[0].get() is not None]
        for icon in icons:
            if icon is None:
                continue
            index = next((i for i, (ref, _, _) in enumerate(self.header_icons) if ref.get() == icon), None)
            if enabled and index is None:
                scale_x, scale_y = icon.getScaleX(), icon.getScaleY()
                drawable = icon.getDrawable()
                if drawable is None:
                    continue
                intrinsic = max(drawable.getIntrinsicWidth(), drawable.getIntrinsicHeight())
                if intrinsic <= 0:
                    continue
                scale = self.dp(VIDEO_ICON_SIZE) / intrinsic
                self.header_icons.append((self.weak_reference(icon), scale_x, scale_y))
                icon.setScaleX(float(scale_x * scale))
                icon.setScaleY(float(scale_y * scale))
            elif not enabled and index is not None:
                _, scale_x, scale_y = self.header_icons.pop(index)
                icon.setScaleX(scale_x)
                icon.setScaleY(scale_y)

    def style_video_shadows(self, viewer, enabled):
        top = self.action_bar.get(viewer)
        colors = ((SHADOW_GRAY, SHADOW_GRAY) if self.top_caption(viewer) is not None or self.photo_header(viewer) is not None
                  else shadow_ramp(1.0, 0.0, TOP_SHADOW_ALPHA))
        gradient = self.manage_shadow_background(top, enabled, lambda: self.pill_background(
            self.shadow_orientation, self.positions(colors)))
        if gradient is not None:
            self.set_shadow_colors(gradient, colors)
        footer = self.background.get(viewer)
        enabled = enabled and self.footer_shade(footer) is not None
        self.manage_shadow_background(footer, enabled, lambda: None)
        if not enabled:
            self.manage_shadow_background(self.navigation_bar.get(viewer), False, lambda: None)

    def style_album_strip(self, viewer, enlarge, blend):
        strip = self.album_strip.get(viewer)
        if strip is None:
            return
        self.album_styles = [entry for entry in self.album_styles if entry[0].get() is not None]
        saved = next((entry for entry in self.album_styles if entry[0].get() == strip), None)
        if saved is None:
            if not enlarge and not blend:
                return
            paint = self.album_paint.get(strip)
            geometry = tuple(part.getInt(strip) for part in self.album_geometry)
            saved = (self.weak_reference(strip), geometry, strip.getLayoutParams().height, paint.getXfermode())
            self.album_styles.append(saved)
        self.apply_album_style(strip, saved, enlarge, blend)
        if not enlarge and not blend:
            self.album_styles.remove(saved)

    def apply_album_style(self, strip, saved, enlarge, blend):
        _, original, height, mode = saved
        if enlarge:
            original = tuple(self.dp(size) for size in (ALBUM_THUMB_WIDTH, ALBUM_THUMB_HEIGHT, ALBUM_THUMB_PADDING))
            height = self.dp(ALBUM_THUMB_HEIGHT + 2 * ALBUM_THUMB_PADDING)
        for part, size in zip(self.album_geometry, original):
            if part.getInt(strip) != size:
                part.setInt(strip, size)
        strip.getLayoutParams().height = height
        paint = self.album_paint.get(strip)
        mode = self.transparent_paint_mode if blend else mode
        if paint.getXfermode() != mode:
            paint.setXfermode(mode)
            strip.invalidate()

    def manage_shadow_background(self, panel, enabled, create):
        if panel is None:
            return None
        self.shadows = [entry for entry in self.shadows if entry[0].get() is not None]
        current = panel.getBackground()
        for index, (ref, original, gradient) in enumerate(self.shadows):
            if ref.get() != panel:
                continue
            if not enabled:
                self.shadows.pop(index)
                if current == gradient:
                    panel.setBackground(original)
            elif current != gradient:
                self.shadows[index] = (ref, current, gradient)
                panel.setBackground(gradient)
            return gradient if enabled else None
        if enabled:
            gradient = create()
            self.shadows.append((self.weak_reference(panel), current, gradient))
            panel.setBackground(gradient)
            return gradient
        return None

    def install_footer_shade(self, footer):
        container = footer.getParent()
        if container is None:
            return
        shade = self.view_type(container.getContext())
        shade.setVisibility(8)
        shade.setImportantForAccessibility(2)
        shade.setBackground(self.pill_background(self.shadow_orientation,
                                                self.positions((SHADOW_GRAY, SHADOW_GRAY))))
        container.addView(shade, container.indexOfChild(footer), self.frame_params(-1, 0, 83))
        self.footer_shades = [(f, s) for f, s in self.footer_shades if s.get() is not None]
        self.footer_shades.append((self.weak_reference(footer), self.weak_reference(shade)))

    def footer_shade(self, footer):
        if footer is not None:
            return next((s.get() for f, s in self.footer_shades if f.get() == footer), None)
        return None

    def layout_footer_shade(self, viewer, container, footer, enabled, photo=False):
        shade = self.footer_shade(footer)
        if shade is None and not photo:
            return
        navigation = self.navigation_bar.get(viewer)
        if photo:
            if shade is not None:
                shade.setVisibility(0)
                self.measure_footer_shadow(shade, container, self.dp(48))
                shade.setAlpha(0.0)
            self.set_navigation_shadow(navigation, (SHADOW_GRAY, SHADOW_GRAY))
            return
        shade.setVisibility(0 if enabled else 8)
        if not enabled:
            self.set_navigation_shadow(navigation, None)
            return
        # Reserve caption space only when the caption is in the native bottom position.
        caption = self.caption_text.get(viewer)
        caption_at_top = self.top_caption(viewer) is not None
        caption_height = (min(self.dp(108 if container.getMeasuredWidth() > container.getMeasuredHeight() else 56),
                              caption.getMeasuredHeight())
                          if not caption_at_top and caption is not None and caption.getTag() is not None else 0)
        extension = self.dp(16) if caption_at_top else max(self.dp(28), caption_height + self.dp(12))
        height = min(container.getMeasuredHeight(), footer.getMeasuredHeight() + extension)
        if height <= 0:
            return
        if shade.getScaleY() != 1.0:
            shade.setScaleY(1.0)
        self.apply_footer_shadow_colors(shade, navigation, height)
        shade.setAlpha(float(footer.getAlpha()))
        self.measure_footer_shadow(shade, container, height)

    def measure_footer_shadow(self, shade, container, height):
        shade.getLayoutParams().height = height
        exact = self.measure_spec.EXACTLY
        content_width = container.getMeasuredWidth() - container.getPaddingLeft() - container.getPaddingRight()
        shade.measure(self.measure_spec.makeMeasureSpec(content_width, exact),
                      self.measure_spec.makeMeasureSpec(height, exact))

    def apply_footer_shadow_colors(self, shade, navigation, height):
        navigation_height = (max(0, navigation.getLayoutParams().height)
                             if navigation is not None and navigation.getVisibility() == 0 else 0)
        footer_colors, nav_colors = footer_gradient_colors(height, navigation_height)
        self.set_shadow_colors(shade.getBackground(), footer_colors)
        self.set_navigation_shadow(navigation, nav_colors if navigation_height > 0 else None)

    def set_navigation_shadow(self, navigation, colors):
        gradient = self.manage_shadow_background(navigation, colors is not None, lambda: self.pill_background(
            self.shadow_orientation, self.positions(colors)))
        if gradient is not None:
            self.set_shadow_colors(gradient, colors)

    def sync_footer_shadow(self, viewer, container):
        footer = self.background.get(viewer)
        shade = self.footer_shade(footer)
        if shade is None or shade.getVisibility() != 0 or shade.getHeight() <= 0:
            return
        strip = self.album_strip.get(viewer)
        bottom, base = shade.getBottom(), shade.getHeight()
        top = bottom - base
        strip_top = None
        if (strip is not None and strip.getVisibility() == 0 and strip.hasPhotos()
                and strip.getAlpha() > 0.01):
            strip_top = strip.getY() - self.dp(20)
            top = min(top, strip_top)
        photo = self.photo_header(viewer) is not None
        navigation = self.navigation_bar.get(viewer)
        restore_colors = False
        if photo:
            caption_top = self.visible_photo_caption_top(viewer)
            tops = [value for value in (strip_top, caption_top) if value is not None and value < bottom]
            alpha = float(self.action_bar.get(viewer).getAlpha()) if tops else 0.0
            previous_alpha = shade.getAlpha()
            if previous_alpha != alpha:
                shade.setAlpha(alpha)
            if alpha <= 0.0:
                self.set_navigation_shadow(navigation, (SHADOW_GRAY, SHADOW_GRAY))
                return
            top = min(tops)
            restore_colors = previous_alpha <= 0.0
        height = min(bottom - container.getPaddingTop(), bottom - round(top))
        if height <= 0:
            return
        scale = height / base
        if abs(shade.getScaleY() - scale) > 0.0001 or shade.getPivotY() != base:
            shade.setPivotY(float(base))
            shade.setScaleY(float(scale))
            restore_colors = True
        if restore_colors:
            self.apply_footer_shadow_colors(shade, navigation, height)

    def visible_photo_caption_top(self, viewer):
        scroll, text = self.caption.get(viewer), self.caption_text.get(viewer)
        if (scroll is None or text is None or text.getTag() is None or text.getVisibility() != 0
                or scroll.getVisibility() != 0 or scroll.getAlpha() <= 0.01):
            return None
        content = self.caption_content.get(viewer)
        if content is None:
            return None
        text_offset = max(0, content.getTop() - scroll.getScrollY() + text.getTranslationY())
        if text_offset >= scroll.getHeight():
            return None
        return scroll.getY() + text_offset - self.dp(26)

    def set_shadow_colors(self, drawable, stops):
        if tuple(drawable.getColors()) != stops:
            drawable.setColors(self.positions(stops))

    def top_caption(self, viewer):
        return next((entry for entry in self.top_captions if entry.viewer_ref.get() == viewer), None)

    def make_header_shade(self, container, bar):
        shade = self.view_type(container.getContext())
        shade.setImportantForAccessibility(2)
        shade.setBackground(self.pill_background(
            self.shadow_orientation, self.positions((CAPTION_SHADE_COLOR, SHADOW_GRAY))))
        container.addView(shade, max(0, container.indexOfChild(bar)), self.frame_params(-1, 0, 51))
        return shade

    def photo_header(self, viewer):
        return next((shade for ref, shade in self.photo_headers if ref.get() == viewer), None)

    def prepare_photo_header(self, viewer, container, enabled):
        shade = self.photo_header(viewer)
        bar = self.action_bar.get(viewer)
        if not enabled or bar is None:
            if shade is not None:
                self.photo_headers = [(ref, child) for ref, child in self.photo_headers if child != shade]
                if shade.getParent() == container:
                    container.removeView(shade)
            return
        if shade is None:
            shade = self.make_header_shade(container, bar)
            self.photo_headers.append((self.weak_reference(viewer), shade))

    def prepare_top_caption(self, viewer, container, enabled):
        entry = self.top_caption(viewer)
        scroll, switcher = self.caption.get(viewer), self.caption_text.get(viewer)
        header, bar = self.header_title.get(viewer), self.action_bar.get(viewer)
        message = viewer.getCurrentMessageObject() if enabled else None
        tag = switcher.getTag() if switcher is not None else None
        if message is None or not message.isVideo() or message.isSponsored() or header is None or bar is None:
            self.restore_top_caption(viewer)
            return
        if (tag is None or scroll is None or scroll.getParent() != container
                or switcher.getParent() != self.caption_content.get(viewer)):
            scroll = None
        if entry is None or entry.scroll != scroll:
            self.restore_top_caption(viewer)
            shade = self.make_header_shade(container, bar)
            viewer_ref = self.weak_reference(viewer)
            button = self.make_button(container.getContext(), "展开说明", self.drawable.arrow_more)
            self.shrink_icon(button, (VIDEO_TOOL_SIZE - VIDEO_ICON_SIZE) // 2)
            button.setOnClickListener(OnClickListener(lambda _: self.toggle_caption(viewer_ref.get())))
            button.setVisibility(4)
            frame = self.frame_params(self.dp(VIDEO_TOOL_SIZE), self.dp(VIDEO_TOOL_SIZE), 85)
            frame.rightMargin = self.dp(12)
            bar.addView(button, frame)
            entry = TopVideoCaption(viewer_ref, scroll, self.header_name.get(header),
                                    self.header_date.get(header), switcher, shade, button)
            self.top_captions.append(entry)
        self.update_caption_state(entry, (message.getDialogId(), message.getId()))
        entry.title.setVisibility(4)
        if scroll is None:
            return
        if self.action_bar_visible.getBoolean(viewer):
            switcher.setVisibility(0)
        for text in (switcher.getCurrentView(), switcher.getNextView()):
            if text is None:
                continue
            if not any(saved == text for saved, _, _ in entry.text_layouts):
                entry.text_layouts.append((text, text.getMaxLines(), text.getEllipsize()))
            if text.getMaxLines() != 2147483647 or text.getEllipsize() is not None:
                text.setSingleLine(False)
                text.setMaxLines(2147483647)
                text.setEllipsize(None)

    def update_caption_state(self, entry, key):
        if entry.caption_key == key:
            return
        entry.caption_key = key
        entry.expanded = entry.has_more = False
        entry.touch = None
        self.update_caption_button(entry)
        if entry.scroll is not None:
            entry.scroll.stopScrolling()
            entry.scroll.scrollTo(0, 0)

    def update_caption_button(self, entry):
        button = entry.button
        visibility = 0 if entry.has_more else 4
        if button.getVisibility() != visibility:
            button.setVisibility(visibility)
        rotation = 180.0 if entry.expanded else 0.0
        if button.getRotation() != rotation:
            button.setRotation(rotation)
            label = "收起说明" if entry.expanded else "展开说明"
            button.setContentDescription(label)
            if self.sdk >= 26:
                button.setTooltipText(label)

    def restore_top_caption(self, viewer):
        entry = self.top_caption(viewer)
        if entry is None:
            return
        self.top_captions.remove(entry)
        if entry.scroll is not None:
            params = entry.scroll.getLayoutParams()
            params.gravity, params.leftMargin, params.topMargin, params.rightMargin = entry.original_frame
            entry.scroll.setFadingEdgeLength(entry.original_fade)
        entry.title.setVisibility(entry.title_visibility)
        entry.subtitle.setTranslationY(entry.subtitle_translation)
        message = viewer.getCurrentMessageObject()
        if (entry.scroll is not None and message is not None
                and entry.caption_key == (message.getDialogId(), message.getId())):
            entry.switcher.setVisibility(entry.caption_visibility)
            for text, lines, ellipsize in entry.text_layouts:
                text.setSingleLine(lines == 1)
                text.setMaxLines(lines)
                text.setEllipsize(ellipsize)
        parent = entry.shade.getParent()
        if parent is not None:
            parent.removeView(entry.shade)
        bar = self.action_bar.get(viewer)
        if entry.button.getParent() == bar:
            bar.removeView(entry.button)
        if entry.scroll is not None:
            self.caption_previous_height.setInt(entry.scroll, -1)
            entry.scroll.requestLayout()

    def pin_caption_top(self, param):
        if self.managed_caption_scroll(param.thisObject) is not None:
            param.setResult(self.integer(0))

    def managed_caption_scroll(self, scroll):
        container = scroll.getParent()
        if container is not None and self.drawer_type.isInstance(container):
            entry = self.top_caption(self.outer.get(container))
            if entry is not None and entry.scroll == scroll:
                return entry
        return None

    def caption_top_fade(self, param):
        scroll = param.thisObject
        if self.managed_caption_scroll(scroll) is not None and scroll.getScrollY() <= 0:
            param.setResult(self.float_value(0.0))

    def caption_bottom_fade(self, param):
        scroll = param.thisObject
        entry = self.managed_caption_scroll(scroll)
        if entry is not None and not entry.preview_fade and not scroll.canScrollVertically(1):
            param.setResult(self.float_value(0.0))

    def sync_caption_shadow(self, param):
        container = param.thisObject
        viewer = self.outer.get(container)
        entry = self.top_caption(viewer)
        shade = entry.shade if entry is not None else self.photo_header(viewer)
        if shade is not None:
            alpha = float(self.action_bar.get(viewer).getAlpha())
            if shade.getAlpha() != alpha:
                shade.setAlpha(alpha)
        self.sync_footer_shadow(viewer, container)

    def measure_top_caption(self, viewer, container, entry):
        bar = self.action_bar.get(viewer)
        header = bar.getMeasuredHeight()
        width = container.getMeasuredWidth() - container.getPaddingLeft() - container.getPaddingRight()
        caption_height = self.measure_caption_viewport(viewer, container, entry, header, width) if entry.scroll is not None else 0
        text_bottom = header + caption_height
        shadow_height = text_bottom + self.dp(30)
        geometry = header, text_bottom
        if entry.shadow_geometry != geometry:
            entry.shadow_geometry = geometry
            self.set_caption_shadow_shape(entry.shade.getBackground(), header, text_bottom, shadow_height)
        self.measure_header_shade(entry.shade, width, shadow_height)
        entry.shade.setAlpha(float(bar.getAlpha()))

    def measure_photo_header(self, viewer, container, shade):
        bar = self.action_bar.get(viewer)
        header = bar.getMeasuredHeight()
        height = header + self.dp(30)
        if shade.getMeasuredHeight() != height:
            self.set_caption_shadow_shape(shade.getBackground(), header, header, height)
        width = container.getMeasuredWidth() - container.getPaddingLeft() - container.getPaddingRight()
        self.measure_header_shade(shade, width, height)
        shade.setAlpha(float(bar.getAlpha()))

    def measure_header_shade(self, shade, width, height):
        shade.getLayoutParams().height = height
        exact = self.measure_spec.EXACTLY
        shade.measure(self.measure_spec.makeMeasureSpec(width, exact), self.measure_spec.makeMeasureSpec(height, exact))

    def measure_caption_viewport(self, viewer, container, entry, header_height, width):
        back = self.header_back.get(viewer)
        switcher = entry.switcher
        text = switcher.getCurrentView()
        frame = entry.scroll.getLayoutParams()
        frame.gravity, frame.topMargin = 51, header_height
        frame.leftMargin = max(self.dp(56), back.getMeasuredWidth() if back is not None else 0)
        frame.rightMargin = self.dp(12)
        exact = self.measure_spec.EXACTLY
        width_spec = self.measure_spec.makeMeasureSpec(max(1, width - frame.leftMargin - frame.rightMargin), exact)
        text.measure(width_spec, self.measure_spec.makeMeasureSpec(0, self.measure_spec.UNSPECIFIED))
        layout = text.getLayout()
        total = text.getMeasuredHeight() + switcher.getPaddingBottom()
        controls = self.controls.get(viewer)
        footer = self.dp(16)
        if controls is not None and controls.getVisibility() == 0:
            footer += controls.getMeasuredHeight() + max(0, controls.getLayoutParams().bottomMargin)
        available = container.getMeasuredHeight() - container.getPaddingBottom() - frame.topMargin - footer
        height, entry.has_more, entry.preview_fade = caption_viewport(
            layout, total, available, text.getTotalPaddingTop(), self.dp(2), entry.expanded)
        self.update_caption_button(entry)
        fade_length = entry.preview_fade or entry.original_fade
        if entry.scroll.getVerticalFadingEdgeLength() != fade_length:
            entry.scroll.setFadingEdgeLength(fade_length)
        self.caption_content.get(viewer).getLayoutParams().topMargin = 0
        entry.scroll.measure(width_spec, self.measure_spec.makeMeasureSpec(height, exact))
        return height

    def set_caption_shadow_shape(self, drawable, header, text_bottom, height):
        colors = [caption_shadow_color(alpha) for alpha in caption_shadow_profile(header, text_bottom, height)]
        drawable.setColors(self.positions(colors))

    def hide_native_caption_backdrop(self, param):
        viewer = param.thisObject
        if self.top_caption(viewer) is not None or self.photo_header(viewer) is not None:
            param.setResult(None)

    def align_caption_date(self, viewer):
        entry = self.top_caption(viewer)
        if entry is None:
            return
        back, header = self.header_back.get(viewer), self.header_title.get(viewer)
        if back is not None and back.getHeight() > 0:
            subtitle = entry.subtitle
            natural_center = header.getTop() + subtitle.getParent().getTop() + subtitle.getTop() + subtitle.getHeight() / 2
            center = back.getTop() + back.getHeight() / 2
            subtitle.setTranslationY(float(center - natural_center))
            button = entry.button
            button.setTranslationY(float(center - button.getTop() - button.getHeight() / 2))

    def hide_native_caption_shadow(self, param):
        self.caption_shadow_stack.append(None)
        caption = param.thisObject
        container = caption.getParent()
        if container is None or not self.drawer_type.isInstance(container):
            return
        viewer = self.outer.get(container)
        shade = self.footer_shade(self.background.get(viewer))
        if (self.top_caption(viewer) is None and self.photo_header(viewer) is None
                and (shade is None or shade.getVisibility() != 0)):
            return
        self.caption_shadow_stack[-1] = (caption, self.caption_alpha.getFloat(caption))
        self.caption_alpha.setFloat(caption, 0.0)

    def expand_landscape_caption(self, param):
        margin = int(param.getResult())
        if margin < 0:
            return
        scroll = param.thisObject
        container = scroll.getParent()
        if container is None or not self.drawer_type.isInstance(container):
            return
        viewer = self.outer.get(container)
        if self.top_caption(viewer) is not None:
            return
        compact = self.compact_control(viewer)
        switcher = self.caption_text.get(viewer)
        if compact is None or compact.getVisibility() != 0 or switcher is None:
            return
        text = switcher.getCurrentView()
        layout = text.getLayout() if text is not None else None
        if layout is None or layout.getLineCount() == 0:
            return
        lines = 0
        for index in range(min(5, layout.getLineCount())):
            if layout.getLineVisibleEnd(index) > layout.getLineStart(index):
                lines += 1
                if lines == 3:
                    break
        height = int(param.args[1])
        lines_height = layout.getLineBottom(index) + text.getCompoundPaddingTop() + text.getCompoundPaddingBottom()
        preview = min(self.dp(108), lines_height + switcher.getPaddingBottom() + self.dp(6))
        param.setResult(self.integer(min(margin, max(0, height - preview))))

    def restore_native_caption_shadow(self, param):
        entry = self.caption_shadow_stack.pop()
        if entry is not None:
            self.caption_alpha.setFloat(*entry)

    def after_controls_progress(self, param):
        control = param.thisObject
        viewer = self.control_outer.get(control)
        progress = float(param.args[0])
        self.position_collapsed_scrubber(viewer, control, progress)
        self.refresh_fullscreen_button(viewer, progress)
        footer = self.background.get(viewer)
        shade = self.footer_shade(footer)
        if shade is not None and shade.getVisibility() == 0 and self.photo_header(viewer) is None:
            shade.setAlpha(float(footer.getAlpha()))

    def position_collapsed_scrubber(self, viewer, control, progress=None):
        if control is None or not control.isSeekBarTransitionEnabled():
            return
        button = self.fullscreen_control(viewer)
        seek = self.video_seek_view.get(viewer)
        container = control.getParent()
        offset = 0.0
        if (button is not None and button.getVisibility() == 0 and seek is not None
                and seek.getParent() == control and seek.getHeight() > 0 and container is not None):
            progress = float(control.getProgress()) if progress is None else progress
            content_bottom = container.getHeight() - container.getPaddingBottom()
            bar_bottom = control.getTop() + seek.getBottom() - self.dp(NATIVE_THIN_BAR_BOTTOM_GAP)
            offset = max(0, content_bottom - bar_bottom) * (1.0 - progress)
        if control.getTranslationY() != offset:
            control.setTranslationY(float(offset))

    def fit_header(self, viewer):
        title, menu = self.header_title.get(viewer), self.header_menu.get(viewer)
        if title is None:
            return
        if not self.footer_active(viewer) or menu is None:
            self.clear_title_clip(title, viewer)
            return
        width = title.getWidth()
        if width <= 0 or title.getHeight() <= 0:
            return
        edge = max(0, width - self.dp(20))
        for index in range(menu.getChildCount()):
            item = menu.getChildAt(index)
            if item.getVisibility() == 0 and item.getWidth() > 0 and item.getAlpha() > 0.01:
                left = round(menu.getX() + item.getX() - title.getX()) - self.dp(12)
                edge = min(edge, max(0, left))
        bounds = title.getClipBounds()
        if bounds is None or bounds.right != edge or bounds.bottom != title.getHeight():
            title.updateRightPadding(float(width - edge), False)
            title.setClipBounds(self.rect(0, 0, edge, title.getHeight()))
            self.clipped_titles = [(t, v) for t, v in self.clipped_titles if t.get() is not None]
            if not any(t.get() == title for t, _ in self.clipped_titles):
                self.clipped_titles.append((self.weak_reference(title), self.weak_reference(viewer)))

    def clear_title_clip(self, title, viewer):
        for index, (ref, _) in enumerate(self.clipped_titles):
            if ref.get() == title:
                self.clipped_titles.pop(index)
                title.setClipBounds(None)
                self.call(viewer, "updateActionBarTitlePadding")
                return

    def after_container_measure(self, param):
        container = param.thisObject
        viewer = self.outer.get(container)
        window = self.window.get(viewer)
        if window is None or container.getParent() != window:
            return

        lift, tap_inset = 0, 0
        controls = self.controls.get(viewer)
        show_row = False
        if controls is not None and self.video_surface(viewer):
            lift, tap_inset = self.footer_lift(viewer, window, container)
            show_row = True
        background = self.background.get(viewer)
        row = self.lookup_row(background)
        if row is not None:
            show_row = show_row and self.option("video_toolbar") and background.getVisibility() != 8
            compact = self.compact_control(viewer)
            use_compact = compact is not None and compact.getVisibility() == 0
            row.setVisibility(0 if show_row and not use_compact else 8)
            if show_row:
                if not use_compact:
                    lift, bottom_margin = row_spacing(self.row_height, lift, tap_inset, self.bottom_gap)
                    row.getLayoutParams().bottomMargin = bottom_margin
                else:
                    lift = 0
                self.hide_header(self.video_menu.get(viewer))
                self.hide_header(self.overflow.get(viewer))
                self.hide_floating_fullscreen(viewer)
                self.refresh_row(viewer)
                self.hide_center_accessibility(viewer)
            else:
                self.refresh_zoom(viewer)
                for control, show in ((self.overflow, True), (self.video_menu, self.has_player(viewer))):
                    menu = control.get(viewer)
                    if menu is not None:
                        self.restore_header(menu, show)
                if not self.option("video_toolbar"):
                    lift = 0
        self.margins = [entry for entry in self.margins if entry.reference.get() is not None]
        top_caption = self.top_caption(viewer)
        extra_height = max(0, controls.getLayoutParams().height - self.dp(48)) if controls is not None else 0
        for footer_field, native_measures_margin in self.footer_fields:
            if top_caption is not None and top_caption.scroll is not None and footer_field == self.caption:
                continue
            view = footer_field.get(viewer)
            if view is not None and view.getParent() == container:
                self.apply_margin(view, lift if view == controls else lift + extra_height,
                                  native_measures_margin and view.getVisibility() != 8)

        if lift or extra_height:
            # Expand the background upward from its native bottom, filling the gap.
            self.resize_footer(background, container, lift + extra_height)
            if top_caption is None or top_caption.scroll is None:
                self.resize_footer(self.caption.get(viewer), container, -lift - extra_height)
        if top_caption is not None:
            self.measure_top_caption(viewer, container, top_caption)
        photo_shade = self.photo_header(viewer)
        if photo_shade is not None:
            self.measure_photo_header(viewer, container, photo_shade)
        self.layout_footer_shade(viewer, container, background,
                                 show_row and row is not None,
                                 photo=photo_shade is not None)

    def resize_footer(self, view, container, delta):
        if view is None or view.getParent() != container or view.getVisibility() == 8:
            return
        exact = self.measure_spec.EXACTLY
        width = self.measure_spec.makeMeasureSpec(view.getMeasuredWidth(), exact)
        height = self.measure_spec.makeMeasureSpec(max(0, view.getMeasuredHeight() + delta), exact)
        view.measure(width, height)

    def apply_margin(self, view, lift, fresh_base):
        params = view.getLayoutParams()
        for entry in self.margins:
            if entry.reference.get() == view:
                entry.update(params, lift, fresh_base)
                return
        if lift:
            entry = ControlMargin(self.weak_reference(view), params.bottomMargin)
            entry.update(params, lift)
            self.margins.append(entry)

    def on_plugin_unload(self):
        if not hasattr(self, "hooks"):
            return
        self.active = False
        for hook in self.hooks:
            self.unhook_method(hook)
        margins, self.margins = self.margins, []
        rows, self.rows = self.rows, []
        zoom_buttons, self.zoom_buttons = self.zoom_buttons, []
        fullscreen_controls, self.fullscreen_controls = self.fullscreen_controls, []
        compact_controls, self.compact_controls = self.compact_controls, []
        shadows, self.shadows = self.shadows, []
        footer_shades, self.footer_shades = self.footer_shades, []
        header_icons, self.header_icons = self.header_icons, []
        clipped_titles, self.clipped_titles = self.clipped_titles, []
        gears, self.gear_state = self.gear_state, []

        def restore():
            self.restore_held_speed()
            self.stop_photo_rotation()
            for _, shade in self.photo_headers:
                if shade.getParent() is not None:
                    shade.getParent().removeView(shade)
            self.photo_headers.clear()
            for saved in self.album_styles:
                strip = saved[0].get()
                if strip is not None:
                    self.apply_album_style(strip, saved, False, False)
                    strip.requestLayout()
            self.album_styles.clear()
            for entry in self.top_captions[:]:
                viewer = entry.viewer_ref.get()
                if viewer is not None:
                    self.restore_top_caption(viewer)
            self.restore_volume()
            self.restore_brightness()
            self.remove_level_hud()
            for _, _, _, viewer_ref in self.forward_rows[:]:
                viewer = viewer_ref.get()
                if viewer is not None:
                    self.move_header_share(viewer, False)
            for _, shade_ref in footer_shades:
                shade = shade_ref.get()
                if shade is not None and shade.getParent() is not None:
                    shade.getParent().removeView(shade)
            for ref, scale_x, scale_y in header_icons:
                icon = ref.get()
                if icon is not None:
                    icon.setScaleX(scale_x)
                    icon.setScaleY(scale_y)
            for ref, original, gradient in shadows:
                panel = ref.get()
                if panel is not None and panel.getBackground() == gradient:
                    panel.setBackground(original)
            for _, compact_ref in compact_controls:
                compact = compact_ref.get()
                if compact is not None and compact.getParent() is not None:
                    compact.getParent().removeView(compact)
            for title_ref, viewer_ref in clipped_titles:
                title, viewer = title_ref.get(), viewer_ref.get()
                if title is not None:
                    title.setClipBounds(None)
                    if viewer is not None:
                        self.call(viewer, "updateActionBarTitlePadding")
            for viewer_ref, button_ref in fullscreen_controls:
                viewer, button = viewer_ref.get(), button_ref.get()
                if button is not None and button.getParent() is not None:
                    button.getParent().removeView(button)
                if viewer is not None:
                    controls = self.controls.get(viewer)
                    if controls is not None:
                        if controls.isSeekBarTransitionEnabled():
                            controls.setTranslationY(0.0)
                        controls.getLayoutParams().height = self.dp(48)
                        self.restore_scrubber_view(self.video_seek_view.get(viewer))
                        controls.requestLayout()
                    self.restore_time(self.video_time.get(viewer))
                    viewer.checkFullscreenButton()
            session = self.fullscreen_session
            if session is not None:
                viewer = session[0].get()
                if viewer is not None:
                    self.close_fullscreen(viewer)
            if self.axis_lock is not None:
                viewer = self.axis_lock[0].get()
                if viewer is not None:
                    self.clear_playback_axis(viewer)
            for ref, visibility, anchor_ref, above, side, offset in gears:
                menu = ref.get()
                if menu is not None:
                    self.restore_menu(menu, visibility, anchor_ref, above, side, offset)
            for _, button_ref in zoom_buttons:
                button = button_ref.get()
                if button is not None and button.getParent() is not None:
                    button.getParent().removeView(button)
            for background_ref, row_ref in rows:
                background, row = background_ref.get(), row_ref.get()
                if background is not None and row is not None and row.getParent() == background:
                    background.removeView(row)
            for entry in margins:
                view = entry.reference.get()
                if view is not None and view.getLayoutParams() is not None:
                    entry.update(view.getLayoutParams(), 0)
                    view.requestLayout()

        run_on_ui_thread(restore)
