    def media_hidden(self, message, chat=None, group=None):
        if message is None or message.messageOwner is None:
            return False
        if message.isRestrictedMessage or message.isHiddenSensitive():
            return True
        dialog = message.getDialogId()
        if self.ayu.isDialogExcluded(dialog):
            return False
        if message.messageOwner.hide:
            return True
        if chat is not None and not self.hide_mode.getBoolean(chat):
            return False
        group_id = message.getGroupId()
        if group is None and group_id and chat is not None:
            group = chat.getGroup(group_id)
        primary = group.findPrimaryMessageObject() if group is not None else None
        primary = primary if primary is not None else message
        if self.ayu.shouldMaskMessage(primary, group):
            return True
        if not self.ayu.shouldHideFilteredMessages():
            return False
        if self.ayu.shouldHideIgnoredBlockedMessages() and dialog < 0:
            peer = self.mc.getInstance(message.currentAccount).getChat(-dialog)
            if self.chat_object.isMegagroup(peer) and self.ayu.isIgnoredBlockedMessage(message):
                return True
        return self.ayu.shouldHideFilteredMessage(primary, group)

    def before_media_add(self, param):
        message, index, _, encrypted = param.args
        if not self.media_hidden(message):
            return
        data = param.thisObject
        offsets = self.media_max.get(data)
        index = int(index)
        maximum, minimum = media_cursor(message.getId(), offsets[index],
                                        self.media_min.getInt(data), bool(encrypted))
        offsets[index] = maximum
        self.media_min.setInt(data, minimum)
        self.remember_media_ref(self.filtered_media_data, data)
        param.setResult(self.java_boolean(False))

    def remember_media_ref(self, references, value):
        references[:] = [ref for ref in references if ref.get() is not None]
        if not any(ref.get() == value for ref in references):
            references.append(self.weak(value))

    def uses_compact_grid(self, layout, data):
        if self.has_suppressed_media(data):
            return True
        dialog = self.media_dialog.getLong(layout)
        merge = self.media_merge.getLong(layout)
        eligible = not self.ayu.isDialogExcluded(dialog) or (merge != 0 and not self.ayu.isDialogExcluded(merge))
        return eligible and (self.ayu.shouldHideFilteredMessages() or self.ayu.shouldHideIgnoredBlockedMessages()
                             or self.ayu.shouldMaskFilteredMessages())

    def has_suppressed_media(self, data):
        return any(ref.get() == data for ref in self.filtered_media_data)

    def after_photo_count(self, param):
        layout = self.photo_outer.get(param.thisObject)
        if param.thisObject not in (self.photo_adapter.get(layout), self.supporting_photo_adapter.get(layout)):
            return
        self.apply_dense_count(param, layout, 0)

    def after_document_count(self, param, empty_row):
        adapter = param.thisObject
        self.apply_dense_count(param, self.document_outer.get(adapter), self.document_type.getInt(adapter), empty_row)

    def apply_dense_count(self, param, layout, kind, empty_row=False):
        datasets = self.shared_data.get(layout)
        if datasets is None or datasets[kind] is None:
            return
        data = datasets[kind]
        self.remember_media_ref(self.media_layouts, layout)
        self.check_existing_media(layout, kind, data)
        if self.uses_compact_grid(layout, data):
            self.media_start.setInt(data, 0)
            self.media_frozen_start.setInt(data, 0)
            count = data.getMessages().size()
            if empty_row and count == 0 and not self.media_loading.getBoolean(data):
                count = 1
            param.setResult(self.integer(count))

    def check_existing_media(self, layout, kind, data):
        if layout.getParent() is None or any(ref.get() == data for ref in self.checked_media_data):
            return
        self.remember_media_ref(self.checked_media_data, data)

        def check():
            if (self.active and layout.getParent() is not None and self.shared_data.get(layout)[kind] == data
                    and self.prune_loaded_media(layout, data)):
                self.media_data_compacted(layout, kind)
                self.continue_media_page(layout, kind)

        run_on_ui_thread(check, 1)

    def media_data_compacted(self, layout, kind):
        adapter = self.media_adapters[kind].get(layout)
        if adapter is not None:
            adapter.notifyDataSetChanged()

    def prune_loaded_media(self, layout, data):
        removed, _ = self.prune_media_items(layout, data, self.media_messages.get(data))
        return removed

    def prune_media_items(self, layout, data, messages):
        merge = int(self.media_merge.getLong(layout))
        removed = hidden = False
        for index in range(messages.size() - 1, -1, -1):
            item = messages.get(index)
            if self.media_hidden(item):
                hidden = True
                load_index = 1 if merge and item.getDialogId() == merge else 0
                if data.deleteMessage(item.getId(), load_index) is not None:
                    removed = True
        if hidden:
            self.remember_media_ref(self.filtered_media_data, data)
        return removed, hidden

    def after_fill_media(self, param):
        layout, kind = param.thisObject, int(param.args[0])
        data = self.shared_data.get(layout)[kind]
        preloader = self.shared_preloader.get(layout)
        copied = preloader.getSharedMediaData() if preloader is not None else None
        if data is not None and copied is not None and self.has_suppressed_media(copied[kind]):
            self.remember_media_ref(self.filtered_media_data, data)
        if data is not None and self.prune_loaded_media(layout, data):
            param.setResult(self.java_boolean(self.media_messages.get(data).size() > 0))
        if data is not None:
            self.remember_media_ref(self.checked_media_data, data)

    def before_media_jump(self, param):
        kind = int(param.args[0])
        if kind in DENSE_MEDIA_TABS:
            layout = param.thisObject
            if self.uses_compact_grid(layout, self.shared_data.get(layout)[kind]):
                param.args[2] = self.integer(0)

    def after_media_jump(self, param):
        kind = int(param.args[0])
        if kind in DENSE_MEDIA_TABS:
            layout = param.thisObject
            if self.uses_compact_grid(layout, self.shared_data.get(layout)[kind]):
                self.continue_media_page(layout, kind)

    def viewer_batch_groups(self, messages, chat):
        buckets = {}
        if chat is not None and not self.hide_mode.getBoolean(chat):
            return buckets
        if not (self.ayu.shouldHideFilteredMessages() or self.ayu.shouldMaskFilteredMessages()):
            return buckets
        for index in range(messages.size()):
            item = messages.get(index)
            group_id = item.getGroupId()
            if group_id:
                buckets.setdefault((item.getDialogId(), group_id), []).append(item)
        groups = {}
        for (dialog, group_id), members in buckets.items():
            native = chat.getGroup(group_id) if chat is not None else None
            if native is not None:
                groups[dialog, group_id] = native
            elif len(members) > 1:
                album = self.album()
                album.groupId = group_id
                for item in members:
                    album.messages.add(item)
                album.calculate()
                groups[dialog, group_id] = album
        return groups

    def split_visible_media(self, messages, chat=None, *, albums=False):
        visible = self.java_list()
        hidden_ids = []
        groups = self.viewer_batch_groups(messages, chat) if albums else {}
        for index in range(messages.size()):
            item = messages.get(index)
            group = groups.get((item.getDialogId(), item.getGroupId())) if groups else None
            if self.media_hidden(item, chat, group):
                hidden_ids.append(int(item.getId()))
            else:
                visible.add(item)
        return visible, hidden_ids

    def before_viewer_open(self, param):
        args = param.args
        message, messages, index, chat = args[0], args[4], int(args[7]), args[9]
        if messages is None or not 0 <= index < messages.size():
            if message is not None and self.media_hidden(message, chat):
                param.setResult(self.java_boolean(False))
            return
        if chat is None:
            parent = self.viewer_chat.get(param.thisObject)
            if parent is not None and parent.getDialogId() == int(args[10]):
                chat = parent
        selected = messages.get(index)
        visible, hidden = self.split_visible_media(messages, chat, albums=True)
        if hidden:
            new_index = visible.indexOf(selected)
            if new_index < 0:
                param.setResult(self.java_boolean(False))
                return
            args[7] = self.integer(new_index)
            args[4] = visible

    def before_viewer_add(self, param):
        viewer = param.thisObject
        if int(param.args[1]) == viewer.getClassGuid() and self.media_hidden(
                param.args[0], self.viewer_chat.get(viewer)):
            param.setResult(None)

    def after_chat_media_list(self, param):
        results = param.getResult()
        if results is not None:
            visible, hidden = self.split_visible_media(results, param.thisObject, albums=True)
            if hidden:
                param.setResult(visible)

    def before_viewer_page(self, param):
        if int(param.args[0]) != self.media_event:
            return
        viewer, args = param.thisObject, param.args[2]
        if len(args) < 8:
            return
        dialog, guid = int(args[0]), int(args[3])
        if not dialog or dialog not in (
                int(self.viewer_dialog.getLong(viewer)), int(self.viewer_merge.getLong(viewer))):
            return
        # TG Fast Viewer routes its own pages through this event before appending them.
        fast_page = (guid <= FAST_VIEWER_PAGE_INDEX and guid == int(args[7]) and viewer.isVisible()
                     and int(args[4]) == self.viewer_media_type.getInt(viewer))
        if guid != int(viewer.getClassGuid()) and not fast_page:
            return
        visible, hidden = self.split_visible_media(args[2], self.viewer_chat.get(viewer), albums=True)
        if not hidden:
            return
        payload = self.object_array([None] * len(args))
        self.system.arraycopy(args, 0, payload, 0, len(args))
        payload[2] = visible
        param.args[2] = payload
        if not fast_page and not visible.size() and not bool(args[5]):
            from_start = bool(args[6])
            encrypted = self.dialog_object.isEncryptedDialog(dialog)
            towards_larger_id = from_start != encrypted
            ids = [mid for mid in hidden if mid != 0]
            if not ids:
                return
            cursor = (max if towards_larger_id else min)(ids)
            key = guid, dialog, from_start
            last = self.viewer_cursors.get(key)
            if last is not None and (cursor <= last if towards_larger_id else cursor >= last):
                return
            try:
                self.media_controller.getInstance(int(param.args[1])).loadMedia(
                    dialog, 40, 0 if from_start else cursor, cursor if from_start else 0,
                    int(args[4]), int(self.viewer_topic.getLong(viewer)), 1, guid, int(args[7]),
                    self.viewer_tag.get(viewer), None)
                self.viewer_cursors[key] = cursor
                param.setResult(None)
            except Exception as error:
                self.log(f"Filtered gallery could not continue: {type(error).__name__}")

    def clear_viewer_cursors(self, param):
        guid = int(param.thisObject.getClassGuid())
        self.viewer_cursors = {key: cursor for key, cursor in self.viewer_cursors.items() if key[0] != guid}

    def before_media_count(self, param):
        adapter = param.thisObject
        for result_field in (self.media_results, self.media_remote):
            messages = result_field.get(adapter)
            if messages is None:
                continue
            size = messages.size()
            identity = int(self.system.identityHashCode(messages))
            if any(ref.get() == messages and cached == (identity, size)
                   for ref, cached in self.media_cached_lists):
                continue
            for index in range(size - 1, -1, -1):
                if self.media_hidden(messages.get(index)):
                    # remove(int) and remove(Object) have different semantics.
                    messages.remove(index)
            self.media_cached_lists = [(ref, cached) for ref, cached in self.media_cached_lists
                                       if ref.get() is not None and cached[0] != identity]
            self.media_cached_lists.append((self.weak(messages), (identity, messages.size())))

    def after_media_page(self, param):
        if int(param.args[0]) != self.media_event:
            return
        layout, args = param.thisObject, param.args[2]
        if len(args) < 8:
            return
        if int(args[3]) != self.media_parent.get(layout).getClassGuid():
            return
        kind = int(args[4])
        if kind in (6, 7):
            kind = 0
        data = self.shared_data.get(layout)[kind]
        if int(args[7]) != self.media_request.getInt(data):
            return
        messages = args[2]
        if messages is None:
            return
        if kind in DENSE_MEDIA_TABS:
            removed, hidden = self.prune_media_items(layout, data, messages)
            if removed:
                self.media_data_compacted(layout, kind)
        else:
            hidden = any(self.media_hidden(messages.get(i)) for i in range(messages.size()))
        if hidden and not bool(args[5]):
            self.continue_media_page(layout, kind)

    def continue_media_page(self, layout, kind):
        def continue_visible():
            if not self.active or layout.getParent() is None:
                return
            page = self.media_pages.get(layout)[0]
            if page is None or self.media_selected.getInt(page) != kind:
                return
            listing = self.media_list.get(page)
            if listing is not None and listing.getLayoutManager() is not None:
                self.media_more.invoke(layout, self.object_array(
                    [page, listing, listing.getLayoutManager()]))

        run_on_ui_thread(continue_visible, 8)

    def position_type(self, adapter, position):
        return int(self.original(self.view_type, adapter,
                                 self.object_array([self.integer(position)])))

    def pinned_hidden(self, chat, message):
        if message is None or message.messageOwner is None:
            return False
        group = None
        if message.getGroupId():
            group = chat.getGroup(message.getGroupId())
            if group is None:
                group = chat.getValidGroupedMessage(message)
        primary = group.findPrimaryMessageObject() if group is not None else None
        primary = primary if primary is not None else message
        previous = primary.skipAyuFiltering
        primary.skipAyuFiltering = not self.hide_mode.getBoolean(chat)
        try:
            return self.media_hidden(message, chat, group)
        finally:
            primary.skipAyuFiltering = previous

    def pinned_message(self, chat, mid):
        entry = self.pinned_objects.get(chat).get(self.integer(mid))
        return entry if entry is not None else self.message_dict.get(chat)[0].get(mid)

    def visible_pins(self, chat, source):
        guid = int(chat.getClassGuid())
        hiding = self.hide_mode.getBoolean(chat)
        previous = self.pin_projections.get(guid)
        if previous is not None and previous[0] == hiding and source.equals(previous[1]):
            return previous[2], previous[3]
        visible = self.java_list()
        loaded = self.java_list()
        for i in range(source.size()):
            mid = int(source.get(i))
            message = self.pinned_message(chat, mid)
            if not self.pinned_hidden(chat, message):
                boxed = self.integer(mid)
                visible.add(boxed)
                if message is not None:
                    loaded.add(boxed)
        # Save a copy because the native list can be updated in place.
        self.pin_projections[guid] = hiding, self.java_list(source), visible, loaded
        return visible, loaded

    def nearest_pin(self, chat, visible, loaded, target, index):
        candidates = visible if loaded.isEmpty() else loaded
        return int(self.original(self.find_pin, chat,
                                 self.object_array([candidates, self.integer(target), index])))

    def after_choose_pin(self, param):
        chat = param.thisObject
        source, target, index = param.args
        if chat.getChatMode() != 0 or source != self.pinned_ids.get(chat):
            return
        mid = int(param.getResult())
        if not mid:
            return
        visible, loaded = self.visible_pins(chat, source)
        if visible.contains(self.integer(mid)):
            return
        replacement = self.nearest_pin(chat, visible, loaded, int(target), index)
        index[0] = source.indexOf(self.integer(replacement)) if replacement else max(0, source.size() - 1)
        param.setResult(self.integer(replacement))

    def watch_pinned_chat(self, chat):
        self.pinned_chats = [record for record in self.pinned_chats if record[0].get() is not None]
        record = next((entry for entry in self.pinned_chats if entry[0].get() == chat), None)
        if record is None:
            record = [self.weak(chat), self.hide_mode.getBoolean(chat)]
            self.pinned_chats.append(record)
        return record

    def native_pin_dismissed(self, chat, source):
        preferences = self.mc.getNotificationsSettings(chat.getCurrentAccount())
        return preferences.getInt(f"pin_{chat.getDialogId()}", 0) == int(source.get(0))

    def before_pinned_ui(self, param, role):
        chat = param.thisObject
        previous = self.pinned_frames[-1] if self.pinned_frames else None
        frame = [chat, role, None]
        self.pinned_frames.append(frame)
        if chat.getChatMode() != 0 or (previous is not None and previous[0] == chat and previous[2] is not None):
            return
        self.watch_pinned_chat(chat)
        if (role == "banner" and chat.isThreadChat() and not chat.isTopic
                and self.pinned_hidden(chat, chat.getThreadMessage())):
            if self.original(self.hide_pin_view, chat, self.object_array([self.java_boolean(False)])):
                self.original(self.check_pin_paddings, chat, self.object_array([]))
            param.setResult(None)
            return
        source = self.pinned_ids.get(chat)
        if source.isEmpty():
            return
        visible, loaded = self.visible_pins(chat, source)
        if visible.size() == source.size():
            return
        # NagramXF stores dismissal against the newest original pin.
        if role == "banner" and self.native_pin_dismissed(chat, source):
            return
        frame[2] = (source, visible, self.loaded_pin_count.getInt(chat), self.total_pin_count.getInt(chat))
        self.pinned_ids.set(chat, visible)
        if role != "button":
            self.loaded_pin_count.setInt(chat, visible.size())
            self.total_pin_count.setInt(chat, visible.size())
        if role == "banner":
            index = self.pin_index.get(chat)
            mid = self.current_pin.getInt(chat)
            if mid and not visible.contains(self.integer(mid)):
                mid = self.nearest_pin(chat, visible, loaded, mid, index)
                self.current_pin.setInt(chat, mid)
            index[0] = max(0, visible.indexOf(self.integer(mid)))
            param.args[0], param.args[1] = self.java_boolean(False), self.integer(0)

    def after_pinned_ui(self, param):
        chat, role, projection = self.pinned_frames.pop()
        if projection is None:
            return
        source, visible, loaded, total = projection
        if self.pinned_ids.get(chat) != visible:
            return
        self.pinned_ids.set(chat, source)
        if role != "button":
            self.loaded_pin_count.setInt(chat, loaded)
            self.total_pin_count.setInt(chat, total)
        if role == "banner":
            index = self.pin_index.get(chat)
            index[0] = max(0, source.indexOf(self.integer(self.current_pin.getInt(chat))))

    def inherit_pinned_filter(self, param):
        if not self.pinned_frames or len(param.args) != 1:
            return
        parent, role, _ = self.pinned_frames[-1]
        args = param.args[0]
        if role == "open" and args is not None and args.getInt("chatMode") == PINNED_CHAT_MODE:
            chat = param.thisObject
            self.hide_mode.setBoolean(chat, self.hide_mode.getBoolean(parent))
            self.watch_pinned_chat(chat)

    def after_pinned_count(self, param):
        chat = param.thisObject
        if chat.getChatMode() == PINNED_CHAT_MODE:
            source = self.pinned_ids.get(chat)
            visible, _ = self.visible_pins(chat, source)
            if visible.size() < source.size():
                param.setResult(self.integer(visible.size()))

    def after_pinned_mode_change(self, param):
        chat = self.outer.get(param.thisObject)
        for record in self.pinned_chats:
            if record[0].get() == chat:
                hiding = self.hide_mode.getBoolean(chat)
                if hiding != record[1]:
                    record[1] = hiding
                    run_on_ui_thread(lambda: self.refresh_pinned_chat(chat), 1)
                return

    def refresh_pinned_chat(self, chat):
        if not self.active or chat.getFragmentView() is None:
            return
        if chat.getChatMode() == 0:
            chat.updateMessagesVisiblePart(False)
            chat.updatePinnedMessageView(False)
        elif chat.getChatMode() == PINNED_CHAT_MODE:
            adapter = self.adapter.get(chat)
            if adapter is not None:
                adapter.notifyDataSetChanged(False)

    def is_date(self, chat, msg):
        return (msg is not None and msg.isDateObject and msg.type == self.message.TYPE_DATE
                and not msg.isVideoConversionObject and msg != self.reply_header.get(chat))

    def day_visible(self, adapter, messages, index, start):
        return day_has_visible_message(
            messages, index, messages.get(index).dateKeyInt,
            lambda row: self.position_type(adapter, start + row) >= 0,
        )

    def after_view_type(self, param):
        result = int(param.getResult())
        if result == HIDDEN_ROW:
            return
        adapter, position = param.thisObject, int(param.args[0])
        start = self.start.getInt(adapter)
        if not start <= position < self.end.getInt(adapter):
            return
        chat = self.outer.get(adapter)
        pinned = chat.getChatMode() == PINNED_CHAT_MODE
        date_candidate = result == 1 and self.ayu.shouldHideFilteredMessages() and self.hide_mode.getBoolean(chat)
        if not pinned and not date_candidate:
            return
        messages = adapter.getMessages()
        index = position - start
        if index >= messages.size():
            return
        msg = messages.get(index)
        if pinned and self.pinned_hidden(chat, msg):
            param.setResult(self.integer(HIDDEN_ROW))
            return
        if not date_candidate:
            return
        if not self.is_date(chat, msg):
            return
        visible = self.day_visible(adapter, messages, index, start)
        if self.date_adapter is None or self.date_adapter.get() != adapter:
            self.date_adapter = self.weak(adapter)
            self.date_visibility = {}
        self.date_visibility[int(msg.stableId)] = visible
        if not visible:
            param.setResult(self.integer(HIDDEN_ROW))

    def forget_pin_projection(self, param):
        self.pin_projections.pop(int(param.thisObject.getClassGuid()), None)

    def before_pin_change(self, param):
        if self.pin_projections and int(param.args[0]) in self.pin_projection_events:
            self.forget_pin_projection(param)

    def after_chat_event(self, param):
        event = int(param.args[0])
        if event == self.messages_loaded and self.latest_read_request is not None:
            self.after_latest_load(param.thisObject, param.args[2])
        if event in self.pinned_events:
            chat, payload = param.thisObject, param.args[2]
            if len(payload) and int(payload[0]) == chat.getDialogId():
                run_on_ui_thread(lambda: self.refresh_pinned_chat(chat), 1)
        if (event not in self.date_events or self.date_refresh_pending
                or self.date_adapter is None
                or self.date_adapter.get() != self.adapter.get(param.thisObject)):
            return
        self.date_refresh_pending = True
        run_on_ui_thread(self.refresh_dates, 1)

    def before_page_down(self, param):
        chat = param.thisObject
        view = chat.getChatListView()
        if (self.active and chat.getChatMode() == 0 and not chat.isFeedSearch()
                and view is not None and not view.isFastScrollAnimationRunning()):
            self.latest_read_request = None
            self.page_down_context = chat, self.latest_query.getInt(chat)

    def after_page_down(self, param):
        self.page_down_context = None

    def after_scroll_to_latest(self, param):
        chat = param.thisObject
        context = self.page_down_context
        if context is None or context[0] != chat:
            return
        query = self.latest_query.getInt(chat)
        if query > 0 and query != context[1]:
            self.latest_read_request = self.weak(chat), query
        elif query == 0:
            self.read_hidden_latest(chat)

    def after_latest_load(self, chat, payload):
        ref, query = self.latest_read_request
        if (ref.get() != chat or len(payload) < 15 or int(payload[0]) != chat.getDialogId()
                or int(payload[10]) != chat.getClassGuid() or abs(int(payload[11])) != query):
            return
        next_query = self.latest_query.getInt(chat)
        if next_query == query:
            return
        self.latest_read_request = None
        if self.latest_query_canceled.getBoolean(chat) or self.postponed_message.getInt(chat):
            return
        if next_query > 0:
            # An incomplete cache page can be replaced by the host's network request.
            self.latest_read_request = ref, next_query
        else:
            self.read_hidden_latest(chat)

    def read_hidden_latest(self, chat):
        if (not self.active or chat.getChatMode() != 0 or chat.isFeedSearch() or chat.isSecretChat()
                or chat.isTopic or chat.isThreadChat() or chat.isInPreviewMode()
                or self.chat_paused.getBoolean(chat) or self.chat_first_loading.getBoolean(chat)
                or not self.hide_mode.getBoolean(chat) or not self.forward_end.get(chat)[0]):
            return
        dialog_id = int(chat.getDialogId())
        if self.ayu.isDialogExcluded(dialog_id):
            return
        controller = self.mc.getInstance(chat.getCurrentAccount())
        if controller.ignoreSetOnline:
            return
        dialog = controller.dialogs_dict.get(dialog_id)
        if dialog is None or dialog.unread_count <= 0 or dialog.top_message <= 0:
            return
        latest = int(dialog.top_message)
        message = self.message_dict.get(chat)[0].get(latest)
        adapter = self.adapter.get(chat)
        if message is None or message.messageOwner is None or adapter is None or adapter.isFiltered or adapter.isFrozen:
            return
        index = adapter.getMessages().indexOf(message)
        start = self.start.getInt(adapter)
        if index < 0 or start + index >= self.end.getInt(adapter):
            return
        if self.position_type(adapter, start + index) == HIDDEN_ROW:
            # Use the server-backed top ID and the native storage, badge, and read-receipt flow.
            controller.markDialogAsRead(dialog_id, latest, latest, message.messageOwner.date,
                                        False, 0, dialog.unread_count, True, 0)

    def refresh_dates(self):
        self.date_refresh_pending = False
        adapter = self.date_adapter.get() if self.active and self.date_adapter else None
        if adapter is None:
            return
        chat = self.outer.get(adapter)
        if not self.hide_mode.getBoolean(chat) or not self.ayu.shouldHideFilteredMessages():
            return
        messages = adapter.getMessages()
        start = self.start.getInt(adapter)
        observed = {}
        for index in range(messages.size()):
            msg = messages.get(index)
            if msg is None or not msg.isDateObject:
                continue
            stable_id = int(msg.stableId)
            if stable_id in self.date_visibility and self.is_date(chat, msg):
                if self.position_type(adapter, start + index) != 1:
                    continue
                visible = self.day_visible(adapter, messages, index, start)
                if visible != self.date_visibility[stable_id]:
                    adapter.notifyItemChanged(start + index)
                observed[stable_id] = visible
        self.date_visibility = observed

    def preview_scope(self, cell):
        if not cell.isDialogCell or cell.insideCommunityListNoDialog:
            return None
        if cell.isDialogFolder() or cell.isDialogCommunity():
            return None
        return int(self.account.getInt(cell)), int(cell.getDialogId())

    def preview_key(self, cell, scope=None):
        scope = self.preview_scope(cell) if scope is None else scope
        if scope is None or self.cell_message.get(cell) != self.dummies[scope[0]]:
            return None
        account, dialog_id = scope
        controller = self.mc.getInstance(account)
        dialog = controller.dialogs_dict.get(dialog_id)
        return self.dialog_preview_key(account, dialog_id, dialog, controller)

    def dialog_top_message(self, account, dialog_id, controller):
        group = controller.dialogMessage.get(dialog_id)
        message = group.get(0) if group is not None and group.size() else None
        if message is None and hasattr(self, "ayu_messages"):
            message = self.ayu_messages.getInstance().getLastMessageCached(account, dialog_id)
        return message

    def dialog_preview_key(self, account, dialog_id, dialog, controller, top=None):
        if dialog is None or not dialog.top_message:
            return None
        if dialog.top_message < 0 and not self.dialog_object.isEncryptedDialog(dialog_id):
            return None
        if top is None:
            top = self.dialog_top_message(account, dialog_id, controller)
        edit_date = int(top.messageOwner.edit_date) if top is not None else 0
        group_id = int(top.messageOwner.grouped_id) if top is not None else 0
        return account, dialog_id, int(dialog.top_message), int(dialog.last_message_date), edit_date, group_id

    def before_layout(self, param):
        self.layouts.append(None)
        cell = param.thisObject
        scope = self.preview_scope(cell)
        if scope is None:
            return
        key = self.preview_key(cell, scope)
        if key is None:
            self.remember_native_preview(cell, scope)
            return
        checked, retry_at, candidate = self.cache.get(scope, (None, None, None))
        if checked != key and candidate is not None and not self.allowed(*candidate, scope):
            checked = retry_at = candidate = None
            self.store_preview(scope, checked, retry_at, candidate)
        if checked != key or (retry_at is not None and retry_at <= monotonic()):
            self.schedule(cell, key)
        else:
            self.track_cell(cell, key)
        if candidate is None:
            return
        self.cache.move_to_end(scope)
        message, group = candidate
        self.layouts[-1] = (cell, self.cell_message.get(cell), self.cell_group.get(cell),
                            self.cell_date.getInt(cell))
        self.cell_message.set(cell, message)
        self.cell_group.set(cell, group.messages if group is not None else None)
        self.cell_date.setInt(cell, message.messageOwner.date)

    def store_preview(self, scope, checked, retry_at, candidate):
        self.cache[scope] = checked, retry_at, candidate
        self.cache.move_to_end(scope)
        if len(self.cache) > PREVIEW_CACHE_SIZE:
            self.cache.popitem(last=False)

    def preview_rank(self, scope, message):
        mid = int(message.getId())
        return (-mid if self.dialog_object.isEncryptedDialog(scope[1]) else mid,
                int(message.messageOwner.edit_date))

    def preview_members(self, candidate):
        message, group = candidate
        if group is None:
            return (message,)
        return tuple(group.messages.get(i) for i in range(group.messages.size()))

    def make_preview_group(self, group_id, members):
        group = self.album()
        group.groupId = group_id
        for member in members:
            group.messages.add(member)
        group.calculate()
        return group

    def remember_native_preview(self, cell, scope):
        message = self.cell_message.get(cell)
        if (message is None or message == self.dummies[scope[0]] or message.messageOwner is None
                or message.getDialogId() != scope[1]):
            return
        if scope not in self.cache and not (self.ayu.shouldHideFilteredMessages()
                                             or self.ayu.shouldHideIgnoredBlockedMessages()):
            return
        checked, retry_at, previous = self.cache.get(scope, (None, None, None))
        rank = self.preview_rank(scope, message)
        if rank[0] <= 0 or (previous is not None and rank <= self.preview_rank(scope, previous[0])):
            return
        group_id, members = message.getGroupId(), self.cell_group.get(cell)
        group = None
        if group_id and members is not None and members.size() > 1:
            group = self.make_preview_group(group_id, (members.get(i) for i in range(members.size())))
        if self.allowed(message, group, scope):
            self.store_preview(scope, checked, retry_at, (message, group))

    def after_layout(self, param):
        saved = self.layouts.pop()
        if saved is not None:
            cell, message, group, date = saved
            self.cell_message.set(cell, message)
            self.cell_group.set(cell, group)
            self.cell_date.setInt(cell, date)

    def track_cell(self, cell, key):
        self.cells[int(self.system.identityHashCode(cell))] = (self.weak(cell), key)

    def after_cell_attach(self, param):
        cell = param.thisObject
        if len(self.attached) >= 96:
            self.attached = {key: ref for key, ref in self.attached.items()
                             if (attached := ref.get()) is not None and attached.isAttachedToWindow()}
        self.attached[int(self.system.identityHashCode(cell))] = self.weak(cell)
        key = self.preview_key(cell)
        if key is not None:
            checked, retry_at, _ = self.cache.get(key[:2], (None, None, None))
            if checked != key or (retry_at is not None and retry_at <= monotonic()):
                self.schedule(cell, key)
            else:
                self.track_cell(cell, key)

    def rebuild_cell(self, cell):
        if self.active and cell.isAttachedToWindow():
            cell.buildLayout()
            cell.invalidate()

    def schedule(self, cell, key):
        self.track_cell(cell, key)
        lookup = self.running.get(key)
        if lookup is not None:
            lookup.prefetch = False
        elif self.queued.get(key) is not False:
            self.queued[key] = False
            self.queued.move_to_end(key, last=False)
            self.request_preview_drain()

    def request_preview_drain(self):
        if not self.preview_drain_pending:
            self.preview_drain_pending = True
            run_on_ui_thread(self.drain_queue, 32)

    def matching_cells(self, key=None):
        for identity, (ref, previous) in list(self.cells.items()):
            cell = ref.get()
            if cell is None or self.preview_key(cell) != previous:
                self.cells.pop(identity, None)
            elif cell.isAttachedToWindow() and (key is None or key == previous):
                yield cell

    def drain_queue(self):
        self.preview_drain_pending = False
        for _ in range(4):
            if not self.active or not self.queued or len(self.running) >= 2:
                return
            key, prefetch = next(iter(self.queued.items()))
            if prefetch and self.running:
                return
            del self.queued[key]
            if prefetch:
                account, dialog_id = key[:2]
                controller = self.mc.getInstance(account)
                if (account != int(self.preview_account.selectedAccount)
                        or self.dialog_preview_key(account, dialog_id, controller.dialogs_dict.get(dialog_id), controller) != key):
                    continue
            elif not any(True for _ in self.matching_cells(key)):
                continue
            lookup = PreviewSearch(self, key, prefetch)
            self.running[key] = lookup
            lookup.next_page()
        if self.queued and len(self.running) < 2:
            self.request_preview_drain()

    def schedule_preview_warm(self, account, *, changed=False):
        if not self.active or account != int(self.preview_account.selectedAccount):
            return
        if not (self.ayu.shouldHideFilteredMessages() or self.ayu.shouldHideIgnoredBlockedMessages()):
            return
        if account in self.preview_warm_accounts:
            if changed:
                self.preview_warm_dirty.add(account)
            return
        now = monotonic()
        delay = max(PREVIEW_WARM_START_MS, round(1000 * (self.preview_warm_at.get(account, 0) - now)))
        ticket = self.preview_warm_accounts[account] = object()
        run_on_ui_thread(lambda: self.warm_preview_rows(account, ticket), delay)

    def preview_warm_dialogs(self, account, controller):
        first_folders = (controller.getDialogs(0), controller.getDialogs(1))
        for index in range(PREVIEW_WARM_ROWS):
            for listing in first_folders:
                if index < listing.size():
                    yield listing.get(index)

        instance = self.account_instance.getInstance(account)
        filters = controller.getDialogFilters()
        quotas = [[folder, PREVIEW_WARM_ROWS] for i in range(filters.size())
                  if not (folder := filters.get(i)).isDefault()]
        # Use native folder membership for tabs that haven't been opened yet.
        dialogs = controller.getAllDialogs()
        for index in range(dialogs.size()):
            if not quotas or index >= dialogs.size():
                break
            dialog = dialogs.get(index)
            matched = False
            if self.preview_dialog_type.isInstance(dialog):
                dialog_id = int(dialog.id)
                for quota in quotas:
                    folder, remaining = quota
                    if folder.includesDialog(instance, dialog_id, dialog):
                        quota[1] = remaining - 1
                        matched = True
                if matched:
                    quotas = [quota for quota in quotas if quota[1]]
            # Yield after each row, including non-matches, to bound the UI work.
            yield dialog if matched else None

        for index in range(dialogs.size()):
            if index >= dialogs.size():
                break
            yield dialogs.get(index)

    def warm_preview_rows(self, account, ticket):
        if not self.active or self.preview_warm_accounts.get(account) is not ticket:
            return
        controller = self.mc.getInstance(account)
        check_regex = self.ayu.shouldHideFilteredMessages()
        check_blocked = self.ayu.shouldHideIgnoredBlockedMessages()
        rows = self.preview_warm_dialogs(account, controller)
        seen = set()
        self.preview_warm_at[account] = monotonic() + 2

        def scan():
            if not self.active or self.preview_warm_accounts.get(account) is not ticket:
                return
            if account != int(self.preview_account.selectedAccount):
                self.preview_warm_accounts.pop(account, None)
                self.preview_warm_dirty.discard(account)
                return
            if len(self.queued) >= PREVIEW_WARM_QUEUE_LIMIT:
                run_on_ui_thread(scan, 100)
                return
            deadline = monotonic() + PREVIEW_WARM_BUDGET
            for _ in range(PREVIEW_WARM_ROWS_PER_STEP):
                try:
                    dialog = next(rows)
                except StopIteration:
                    self.preview_warm_accounts.pop(account, None)
                    if account in self.preview_warm_dirty:
                        self.preview_warm_dirty.discard(account)
                        self.schedule_preview_warm(account)
                    return
                if dialog is not None and dialog.top_message and self.preview_dialog_type.isInstance(dialog):
                    dialog_id = int(dialog.id)
                    if dialog_id not in seen:
                        seen.add(dialog_id)
                        self.warm_dialog_preview(account, dialog_id, dialog, controller, check_regex, check_blocked)
                if monotonic() >= deadline or len(self.queued) >= PREVIEW_WARM_QUEUE_LIMIT:
                    break
            run_on_ui_thread(scan, PREVIEW_WARM_STEP_MS)

        scan()

    def warm_dialog_preview(self, account, dialog_id, dialog, controller, check_regex, check_blocked):
        message = self.dialog_top_message(account, dialog_id, controller)
        if message is None:
            return
        key = self.dialog_preview_key(account, dialog_id, dialog, controller, message)
        if key is None or key in self.queued or key in self.running:
            return
        scope = key[:2]
        checked, retry_at, _ = self.cache.get(scope, (None, None, None))
        if checked == key and (retry_at is None or retry_at > monotonic()):
            return
        if self.preview_warm_checked.get(scope) == key:
            return
        if not ((check_regex and self.ayu.shouldHideFilteredMessage(message, None))
                or (check_blocked and dialog_id < 0 and self.chat_object.isMegagroup(controller.getChat(-dialog_id))
                    and self.ayu.isIgnoredBlockedMessage(message))):
            self.preview_warm_checked[scope] = key
            self.preview_warm_checked.move_to_end(scope)
            if len(self.preview_warm_checked) > 2 * PREVIEW_CACHE_SIZE:
                self.preview_warm_checked.popitem(last=False)
            return
        self.queued[key] = True
        self.request_preview_drain()

    def allowed(self, message, group, key):
        account, dialog_id = key[:2]
        members = group.messages if group is not None else [message]
        chat = self.mc.getInstance(account).getChat(-dialog_id) if dialog_id < 0 else None
        block_enabled = self.ayu.shouldHideIgnoredBlockedMessages() and self.chat_object.isMegagroup(chat)
        for i in range(members.size() if group is not None else 1):
            member = members.get(i) if group is not None else members[i]
            if (member.messageOwner.hide or member.isHiddenSensitive()
                    or (block_enabled and self.ayu.isIgnoredBlockedMessage(member))):
                return False
        primary = group.findPrimaryMessageObject() if group is not None else None
        return not self.ayu.shouldHideFilteredMessage(primary if primary is not None else message, group)

    def refresh_previews(self, *, rebind=False, scopes=None, invalid_ids=()):
        if not self.active:
            return
        if scopes is None:
            self.preview_warm_accounts.clear()
            self.preview_warm_at.clear()
            self.preview_warm_dirty.clear()
            self.preview_warm_checked.clear()
        else:
            for scope in scopes:
                self.preview_warm_checked.pop(scope, None)
        for scope, (_, _, candidate) in list(self.cache.items()):
            if scopes is None or scope in scopes:
                if candidate is not None and any(member.getId() in invalid_ids for member in self.preview_members(candidate)):
                    candidate = None
                self.cache[scope] = None, None, candidate
        for key in tuple(self.queued):
            if scopes is None or key[:2] in scopes:
                self.queued.pop(key)
        for key in tuple(self.running):
            if scopes is None or key[:2] in scopes:
                self.running.pop(key).cancel()
        if rebind:
            for ref in list(self.attached.values()):
                cell = ref.get()
                if cell is not None and cell.isAttachedToWindow() and cell.isDialogCell:
                    cell.update(0, False)
                    self.rebuild_cell(cell)
        else:
            for cell in list(self.matching_cells()):
                if scopes is None or self.preview_scope(cell) in scopes:
                    self.rebuild_cell(cell)
        if scopes is None:
            self.schedule_preview_warm(int(self.preview_account.selectedAccount))
        else:
            for account in {scope[0] for scope in scopes}:
                self.schedule_preview_warm(account, changed=True)

    def queue_preview_rule_refresh(self, rebind=False):
        if self.preview_rules_pending is not None:
            self.preview_rules_pending |= rebind
            return
        self.preview_rules_pending = rebind

        def refresh():
            update = self.preview_rules_pending
            self.preview_rules_pending = None
            self.refresh_previews(rebind=update)

        run_on_ui_thread(refresh, 1)

    def after_filter_change(self, param, refresh_previews=True):
        if refresh_previews:
            self.queue_preview_rule_refresh(rebind=True)

        def refresh():
            if not self.active:
                return
            self.pin_projections.clear()
            self.media_cached_lists.clear()
            for ref, _ in self.pinned_chats[:]:
                chat = ref.get()
                if chat is not None:
                    self.refresh_pinned_chat(chat)
            for ref in self.media_layouts[:]:
                layout = ref.get()
                if layout is not None and layout.getParent() is not None:
                    datasets = self.shared_data.get(layout)
                    for kind, adapter_field in self.media_adapters.items():
                        self.prune_loaded_media(layout, datasets[kind])
                        adapter = adapter_field.get(layout)
                        if adapter is not None:
                            adapter.notifyDataSetChanged()
                        self.continue_media_page(layout, kind)

        run_on_ui_thread(refresh, 1)

    def after_preview_edit(self, param):
        mid, dialog = map(int, param.args)

        def refresh():
            scopes = {scope for scope, (_, _, candidate) in self.cache.items()
                      if scope[1] == dialog and (candidate is None
                          or any(member.getId() == mid for member in self.preview_members(candidate))
                          or (abs(mid) >= self.preview_rank(scope, candidate[0])[0]))}
            if scopes:
                self.refresh_previews(scopes=scopes, invalid_ids={mid})

        run_on_ui_thread(refresh, 1)
        self.after_filter_change(param, refresh_previews=False)

    def delete_previews(self, account, ids, channel):
        controller = self.mc.getInstance(account)
        scopes = {scope for scope, (_, _, candidate) in self.cache.items()
                  if scope[0] == account and candidate is not None
                  and any(member.getId() in ids for member in self.preview_members(candidate))
                  and (scope[1] == -channel if channel else (
                      scope[1] > 0 or not self.chat_object.isChannel(controller.getChat(-scope[1]))))}
        if scopes:
            self.refresh_previews(scopes=scopes, invalid_ids=ids)

    def after_dialogs_event(self, param):
        event, account, payload = param.args
        if event == self.filters_changed:
            self.queue_preview_rule_refresh(rebind=True)
        elif event in (self.dialogs_loaded, self.dialog_folders_changed):
            self.schedule_preview_warm(int(account), changed=True)
        elif event == self.messages_deleted and len(payload) >= 3 and not payload[2]:
            ids = payload[0]
            deleted_ids = {int(ids.get(i)) for i in range(ids.size())}
            channel = int(payload[1])
            run_on_ui_thread(lambda: self.delete_previews(int(account), deleted_ids, channel), 1)

    def on_plugin_unload(self):
        self.active = False
        self.page_down_context = None
        self.latest_read_request = None
        for hook in self.hooks:
            self.unhook_method(hook)

        def restore():
            self.pin_projections.clear()
            for ref, _ in self.pinned_chats:
                chat = ref.get()
                if chat is not None and chat.getFragmentView() is not None and chat.getChatMode() == 0:
                    chat.updateMessagesVisiblePart(False)
                    chat.updatePinnedMessageView(False)
            self.pinned_chats.clear()
            for lookup in self.running.values():
                lookup.cancel()
            self.running.clear()
            self.queued.clear()
            self.preview_warm_accounts.clear()
            self.preview_warm_dirty.clear()
            self.preview_warm_checked.clear()
            self.cache.clear()
            adapter = self.date_adapter.get() if self.date_adapter else None
            if adapter is not None:
                adapter.notifyDataSetChanged()
            for ref, _ in self.cells.values():
                cell = ref.get()
                if cell is not None and cell.isAttachedToWindow():
                    cell.buildLayout()
                    cell.invalidate()
            self.cells.clear()
            self.attached.clear()

        run_on_ui_thread(restore)


class PreviewSearch:
    def __init__(self, plugin, key, prefetch=False):
        self.plugin = plugin
        self.key = key
        self.account, self.dialog_id, self.top, _, _, self.top_group = key
        self.controller = plugin.mc.getInstance(self.account)
        self.connection = plugin.conn.getInstance(self.account)
        self.offset = min(self.top + 1, 2147483647)
        self.encrypted = bool(plugin.dialog_object.isEncryptedDialog(self.dialog_id))
        self.local_offset = self.top - 1
        self.pages = AlbumPages()
        self.ticket = None
        self.token = 0
        self.prefetch = prefetch
        self.prefetch_pages = 2
        self.local_checked = False

    def active_scope(self):
        p = self.plugin
        if self.prefetch:
            dialog = self.controller.dialogs_dict.get(self.dialog_id)
            return p.dialog_preview_key(self.account, self.dialog_id, dialog, self.controller) == self.key
        return next(iter(p.matching_cells(self.key)), None) is not None

    def next_page(self):
        p = self.plugin
        if not p.active or p.running.get(self.key) is not self:
            return
        if self.prefetch and int(p.preview_account.selectedAccount) != self.account:
            self.finish(retain=False)
            return
        if not self.encrypted and not self.local_checked:
            self.local_checked = True
            self.read_local_page()
            return
        if self.prefetch:
            if self.prefetch_pages <= 0:
                self.finish(retain=False)
                return
            self.prefetch_pages -= 1
        if self.encrypted:
            self.read_local_page()
            return
        request = p.history()
        request.peer = self.controller.getInputPeer(self.dialog_id)
        if request.peer is None:
            self.finish(retry=True)
            return
        request.offset_id = self.offset
        request.limit = PAGE_SIZE
        ticket = self.ticket = object()
        delegate = RequestCallback(
            lambda result, error: run_on_ui_thread(lambda: self.receive(ticket, result, error)),
            self.account,
        )
        self.token = self.connection.sendRequest(request, delegate)
        run_on_ui_thread(lambda: self.timeout(ticket), 7000)

    def read_local_page(self):
        # Reuse native message storage. Secret chats have no server history endpoint.
        p = self.plugin
        ticket = self.ticket = object()
        storage = p.storage.getInstance(self.account)
        start = self.local_offset

        def read():
            ids = []
            try:
                if self.encrypted:
                    query = (f"AND mid > {start} AND mid < 0 ORDER BY mid ASC LIMIT {PAGE_SIZE}")
                else:
                    query = (f"AND mid > 0 AND mid < {self.top} ORDER BY mid DESC LIMIT {PREVIEW_LOCAL_ROWS}")
                cursor = storage.getDatabase().queryFinalized(
                    f"SELECT mid FROM messages_v2 WHERE uid = {self.dialog_id} {query}")
                try:
                    while cursor.next():
                        ids.append(int(cursor.intValue(0)))
                finally:
                    cursor.dispose()
                batch = [storage.getMessageLegit(self.dialog_id, mid) for mid in ids]
                batch = [raw for raw in batch if raw is not None]
                result = (batch, ids[-1] if ids else None)
            except Exception:
                result = None
            run_on_ui_thread(lambda: self.receive_local(ticket, result))

        storage.getStorageQueue().postRunnable(R(read))
        run_on_ui_thread(lambda: self.timeout(ticket), 7000)

    def receive_local(self, ticket, result):
        p = self.plugin
        if ticket is not self.ticket or not p.active:
            return
        self.ticket = None
        if not self.active_scope():
            self.finish(retain=False)
        elif not self.encrypted:
            batch = [] if result is None else [raw for raw in result[0] if not raw.grouped_id]

            def checked(candidate):
                if candidate is not None:
                    self.keep_preview(candidate, list(p.matching_cells(self.key)), provisional=True)
                run_on_ui_thread(self.next_page, 12)

            # A local page can contain gaps or part of an album. Show valid standalone
            # messages provisionally while the normal server query confirms the latest result.
            self.check_batch(batch, AlbumPages(), checked, complete=True)
        elif result is None:
            self.finish(retry=True)
        else:
            batch, self.local_offset = result
            end = self.local_offset is None
            def checked(match):
                if match is not None or end:
                    self.finish(match)
                else:
                    run_on_ui_thread(self.next_page, 1)

            self.check_batch(batch, self.pages, checked, complete=end)

    def receive(self, ticket, response, error):
        p = self.plugin
        if ticket is not self.ticket or not p.active:
            return
        self.ticket, self.token = None, 0
        if not self.active_scope():
            self.finish(retain=False)
            return
        if error is not None or response is None or not hasattr(response, "messages"):
            self.finish(retry=True)
            return

        self.controller.removeDeletedMessagesFromArray(self.dialog_id, response.messages)
        items = {}
        for index in range(response.messages.size()):
            raw = response.messages.get(index)
            if raw is not None and 0 < raw.id < self.offset and raw.id <= self.top:
                items[int(raw.id)] = raw
        if items:
            self.controller.putUsers(response.users, True)
            self.controller.putChats(response.chats, True)
        ordered = [items[mid] for mid in sorted(items, reverse=True)]
        def checked(candidate):
            if candidate is not None or not ordered:
                self.finish(candidate)
            else:
                self.offset = int(ordered[-1].id)
                run_on_ui_thread(self.next_page, 1)

        self.check_batch(ordered, self.pages, checked, complete=not ordered)

    def check_batch(self, rows, pages, ready, *, complete):
        def scan(start):
            p = self.plugin
            if not p.active or p.running.get(self.key) is not self:
                return
            end = min(start + 4, len(rows)) if self.prefetch else len(rows)
            match = pages.consume(rows[start:end], self.choose, end=complete and end == len(rows))
            if match is not None or end == len(rows):
                ready(match)
            else:
                run_on_ui_thread(lambda: scan(end), 16)

        scan(0)

    def choose(self, raw_messages):
        p = self.plugin
        if any(raw.id == self.top or (self.top_group and raw.grouped_id == self.top_group)
               for raw in raw_messages):
            return None
        if any(raw.hide or p.empty_message.isInstance(raw) for raw in raw_messages):
            return None
        messages = []
        for raw in raw_messages:
            raw.dialog_id = self.dialog_id
            messages.append(p.message(self.account, raw, False, False))
        group = None
        if raw_messages[0].grouped_id:
            group = p.make_preview_group(raw_messages[0].grouped_id, messages)
        if p.allowed(messages[0], group, self.key):
            return messages[0], group
        return None

    def timeout(self, ticket):
        if ticket is self.ticket:
            self.cancel()
            self.finish(retry=True)

    def cancel(self):
        self.ticket = None
        if self.token:
            self.connection.cancelRequest(self.token, True)
            self.token = 0

    def finish(self, candidate=None, *, retry=False, retain=True):
        p = self.plugin
        if p.running.get(self.key) is not self:
            return
        del p.running[self.key]
        cells = list(p.matching_cells(self.key)) if retain else []
        if cells or (retain and self.prefetch and self.active_scope()):
            self.keep_preview(candidate, cells, retry=retry)
        p.request_preview_drain()

    def keep_preview(self, candidate, cells, *, provisional=False, retry=False):
        p = self.plugin
        scope = self.key[:2]
        checked, retry_at, previous = p.cache.get(scope, (None, None, None))
        if previous is not None and not p.allowed(*previous, scope):
            previous = None
        newest = (candidate if candidate is not None and
                  (previous is None or p.preview_rank(scope, candidate[0]) > p.preview_rank(scope, previous[0]))
                  else previous)
        if not provisional:
            checked, retry_at = self.key, monotonic() + 8 if retry else None
        p.store_preview(scope, checked, retry_at, newest)
        if newest is not previous:
            for cell in cells:
                p.rebuild_cell(cell)
