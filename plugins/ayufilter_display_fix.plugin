PAGE_SIZE = 32
PREVIEW_CACHE_SIZE = 768
PREVIEW_WARM_ROWS = 16
PREVIEW_WARM_QUEUE_LIMIT = 24
PREVIEW_WARM_START_MS = 380
PREVIEW_WARM_STEP_MS = 40
PREVIEW_WARM_BUDGET = 0.0015
PREVIEW_WARM_ROWS_PER_STEP = 4
PREVIEW_LOCAL_ROWS = 12
HIDDEN_ROW = -1000
DENSE_MEDIA_TABS = (0, 1, 2, 4)
FAST_VIEWER_PAGE_INDEX = -1000000
PINNED_CHAT_MODE = 2


def field(owner, name):
    result = owner.getDeclaredField(name)
    result.setAccessible(True)
    return result


def method(owner, name, arity):
    result, = (m for m in owner.getDeclaredMethods()
               if m.getName() == name and len(m.getParameterTypes()) == arity)
    result.setAccessible(True)
    return result


def media_cursor(mid, maximum, minimum, encrypted):
    if encrypted:
        return max(mid, maximum), min(mid, minimum)
    if mid > 0:
        return min(mid, maximum), max(mid, minimum)
    return maximum, minimum


def day_has_visible_message(messages, index, day, visible):
    for step in (-1, 1):
        offset = index + step
        while 0 <= offset < messages.size():
            msg = messages.get(offset)
            if (msg is not None and msg.messageOwner is not None
                    and not msg.isDateObject and msg.contentType != 2 and msg.getId() != 0):
                if msg.dateKeyInt != day:
                    break
                if visible(offset):
                    return True
            offset += step
    return False


class AlbumPages:
    def __init__(self):
        self.pending = []

    def consume(self, batch, choose, *, end=False):
        for raw in batch:
            if self.pending and (not raw.grouped_id
                                 or raw.grouped_id != self.pending[0].grouped_id):
                match = choose(self.pending)
                if match is not None:
                    return match
                self.pending = []
            if raw.grouped_id:
                self.pending.append(raw)
            else:
                match = choose([raw])
                if match is not None:
                    return match
        if end and self.pending:
            album, self.pending = self.pending, []
            return choose(album)
        return None


